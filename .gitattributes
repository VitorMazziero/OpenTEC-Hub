# CAD files are not tracked at all (see .gitignore). External-Devices media and
# documents stay in Git LFS. Source code and Markdown remain normal text.
External-Devices/**/*.png filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.jpg filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.JPG filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.JPEG filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.pdf filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.docx filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.pptx filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.ods filter=lfs diff=lfs merge=lfs -text
External-Devices/**/*.zip filter=lfs diff=lfs merge=lfs -text
