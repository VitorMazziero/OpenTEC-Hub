<UserControl x:Class="TecnalHub.Controls.StateChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:ctl="clr-namespace:TecnalHub.Controls"
             x:Name="Root">

    <!-- Dot plus word. The dot uses the FILL brush; the word uses the darkened
         TEXT variant, because the fills are tuned for a mark at 3:1 and would
         fail 4.5:1 as type. -->

    <UserControl.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:StateToLabelConverter x:Key="StateToLabel" />
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ctl:StateDot State="{Binding State, ElementName=Root}"
                      Margin="0,0,6,0" />
        <TextBlock VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Text="{Binding State, ElementName=Root, Converter={StaticResource StateToLabel}}"
                   Foreground="{Binding State, ElementName=Root,
                                Converter={StaticResource StateToBrush}, ConverterParameter=Text}" />
    </StackPanel>
</UserControl>
