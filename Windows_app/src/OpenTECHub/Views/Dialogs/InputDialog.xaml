<Window x:Class="OpenTECHub.Views.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Entrada"
        Width="440" Height="230"
        MinWidth="380" MinHeight="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
    </Window.Resources>

    <DockPanel>
        <!-- Custom Top Bar -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionMinimizeButtonStyle}" Click="OnMinimizeWindow" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseWindow" />
                </StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                           Text="Salvar Predefinição"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
        </Border>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptTextBlock"
                       Grid.Row="0"
                       Text="Digite um nome para a predefinição:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap" />

            <TextBox x:Name="InputTextBox"
                     Grid.Row="1"
                     Padding="8,6"
                     FontSize="{DynamicResource FontSizeBody}"
                     KeyDown="OnInputTextBoxKeyDown" />

            <!-- Spacer -->
            <Grid Grid.Row="2" />

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="Cancelar"
                        MinWidth="90"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button Content="Salvar"
                        MinWidth="100"
                        Margin="10,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
