                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedPumpSpeedPercent, TargetNullValue='—', StringFormat='F0'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding PumpSpeedPercentText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="%" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="0–99 %" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Habilitar bomba de nutrientes" />
                                </Grid>

                                <!-- Dropdown Drawer: Nutrientes -->
                                <Border Visibility="{Binding DataContext.IsExpandedNutrient, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <WrapPanel>
                                            <StackPanel Width="130" Margin="0,0,12,6">
                                                <TextBlock Text="Operação (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding OperationSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s (padrão: 999)" />
                                            </StackPanel>
                                            <StackPanel Width="130" Margin="0,0,12,6">
                                                <TextBlock Text="Mistura (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding MixSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s (padrão: 1)" />
                                            </StackPanel>
                                            <StackPanel Width="140" Margin="0,0,12,6">
                                                <TextBlock Text="Operação ciclo (min)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding OperationCyclesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 min (padrão: 500)" />
                                            </StackPanel>
                                            <StackPanel Width="140" Margin="0,0,12,6">
                                                <TextBlock Text="Mistura ciclo (min)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding MixCyclesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 min (padrão: 1)" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ValidationError}" Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                                   Foreground="{DynamicResource StateAlarmTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 7. Dosagem de Antiespumante (com dropdown) -->
                            <StackPanel DataContext="{Binding AntifoamControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedAntifoam, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações de dosagem de antiespumante" />
                                    <ctl:StateDot Grid.Column="1" State="Ok" Size="8" VerticalAlignment="Center" Label="Antiespumante" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ctl:Icon Key="Foam" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Dosagem de Antiespumante" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LiveAntifoamText}" Style="{StaticResource NumericTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedPumpSpeedPercent, TargetNullValue='—', StringFormat='F0'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding PumpSpeedPercentText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="%" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="0–99 %" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Habilitar bomba de antiespumante" />
                                </Grid>

                                <!-- Dropdown Drawer: Antiespumante -->
                                <Border Visibility="{Binding DataContext.IsExpandedAntifoam, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <WrapPanel>
                                            <StackPanel Width="140" Margin="0,0,12,6">
                                                <TextBlock Text="Operação (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding OperationSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 a 999 s (padrão: 2)" />
                                            </StackPanel>
                                            <StackPanel Width="140" Margin="0,0,12,6">
                                                <TextBlock Text="Mistura (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding MixSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s (padrão: 2)" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ValidationError}" Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                                   Foreground="{DynamicResource StateAlarmTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════════════════ -->
                            <!-- Section 2: Dispositivos Externos                    -->
                            <!-- ═══════════════════════════════════════════════════ -->
                            <TextBlock Text="Dispositivos Externos"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       Margin="2,24,0,10" />

                            <Grid Margin="0,0,0,6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="Dispositivo" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Valor Lido" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Setpoint" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="Novo Setpoint" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="Unidade" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="Faixa" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="8" Text="Ativo" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource StrokeDefaultBrush}" Margin="0,0,0,6" />

                            <!-- 8. Vazão de Ar (com dropdown) -->
                            <StackPanel>
                                <Grid Margin="0,4" VerticalAlignment="Center" DataContext="{Binding FlowRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedFlow, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Opções do fluxômetro de massa (válvulas, N2, maxFlow)" />
                                    <ctl:StateDot Grid.Column="1" State="{Binding Subsystem.Variable.State}" Size="8" VerticalAlignment="Center" Label="Vazão de Ar" />
                                    <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenVariableFromControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Subsystem.Variable}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ctl:Icon Key="Airflow" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Vazão de Ar" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Fluxômetro de massa e controle de aeração" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}" Style="{StaticResource NumericTextStyle}" />
                                            <TextBlock Text="{Binding Subsystem.Unit}" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding Subsystem.FormattedAppliedSetpoint}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding Subsystem.ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOverriddenByCascade}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="ToolTip" Value="Controle bloqueado pela cascata de oxigênio." />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <ctl:ProvenanceBadge Text="cascata" Margin="4,0,0,0" Visibility="{Binding IsOverriddenByCascade, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="{Binding Subsystem.Unit}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subsystem.RangeHint}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding EffectiveActive, Mode=TwoWay}">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverriddenByCascade}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="Controlado pela cascata de oxigênio." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>

                                <!-- Dropdown Drawer: Fluxômetro / Válvulas -->
                                <Border Visibility="{Binding IsExpandedFlow, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10"
                                        DataContext="{Binding FlowControl}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Válvula auxiliar" FontWeight="SemiBold" />
                                            <ToggleButton Margin="0,6,0,0"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding RequestedValve1, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.FlowSubsystem.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBlock Text="{Binding Valve1ActualText, StringFormat='Telemetria: {0}'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Válvula de N₂" FontWeight="SemiBold" />
                                            <ToggleButton Margin="0,6,0,0"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding RequestedValve2, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.FlowSubsystem.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBlock Text="{Binding Valve2ActualText, StringFormat='Telemetria: {0}'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Respiro · v_Flow" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding VentActualText}"
                                                       Style="{StaticResource NumericTextStyle}"
                                                       Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding VentRuleText}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,12,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="maxFlow" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBox Width="80"
                                                         Text="{Binding MaxFlowText, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{Binding ValidationError}" />
                                                <TextBlock Text="L/min"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DataContext.FlowRequestError, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Visibility="{Binding DataContext.FlowRequestError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}"
                                                       Foreground="{DynamicResource StateAlarmTextBrush}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 9. Sensor de Distância (Controle de espuma) -->
                            <StackPanel DataContext="{Binding FoamControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedDistance, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações do sensor de distância / espuma" />
                                    <ctl:StateDot Grid.Column="1" State="Ok" Size="8" VerticalAlignment="Center" Label="Distância" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ctl:Icon Key="Level" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Sensor de Distância" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Sensor de espuma via distância" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LiveDistanceText}" Style="{StaticResource NumericTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedReferenceMillimetres, TargetNullValue='—', StringFormat='F0'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding ReferenceMillimetresText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="mm" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="0–999 mm" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding SensorEnabled, Mode=TwoWay}" ToolTip="Ativar sensor de distância/espuma" />
                                </Grid>

                                <!-- Dropdown Drawer: Sensor de Distância -->
                                <Border Visibility="{Binding DataContext.IsExpandedDistance, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <WrapPanel>
                                            <StackPanel Width="140" Margin="0,0,12,6">
                                                <TextBlock Text="Atraso inicial (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding StartDelaySecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 a 3600 s" />
                                            </StackPanel>
                                            <StackPanel Width="130" Margin="0,0,12,6">
                                                <TextBlock Text="Pulso (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding PulseSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s" />
                                            </StackPanel>
                                            <StackPanel Width="130" Margin="0,0,12,6">
                                                <TextBlock Text="Intervalo (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding IntervalSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="ℹ O sensor de distância é utilizado como sensor de espuma e utiliza a bomba de nutrientes como atuador de antiespumante para controle da espuma."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding ValidationError}" Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                                   Foreground="{DynamicResource StateAlarmTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 10. Bomba Dosadora Externa (roadmap) -->
                            <StackPanel>
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding IsExpandedExternalPump, Mode=TwoWay}"
                                                  IsEnabled="True"
                                                  ToolTip="Visualizar opções da bomba dosadora externa" />
                                    <ctl:StateDot Grid.Column="1" State="Idle" Size="8" VerticalAlignment="Center" Label="Bomba Externa" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ctl:Icon Key="Pump" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Bomba Dosadora Externa" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="—" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="—" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="5" Width="90" Text="—" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="—" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="—" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="False" IsEnabled="False" />
                                </Grid>

                                <!-- Dropdown Drawer: Bomba Externa -->
                                <Border Visibility="{Binding IsExpandedExternalPump, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="Disponível na lista para identificação; o controle ainda não está implementado."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                                        <TextBlock Text="Modos de Operação (v.6):" Style="{StaticResource DosingFieldLabel}" />
                                        <WrapPanel Margin="0,4,0,0" IsEnabled="False">
                                            <Button Content="Constante" Margin="0,0,6,6" Padding="8,4" />
                                            <Button Content="Linear" Margin="0,0,6,6" Padding="8,4" />
                                            <Button Content="Exponencial" Margin="0,0,6,6" Padding="8,4" />
                                            <Button Content="Polinomial" Margin="0,0,6,6" Padding="8,4" />
                                            <Button Content="Piecewise" Margin="0,0,6,6" Padding="8,4" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 11. Sensor de Biomassa -->
                            <StackPanel DataContext="{Binding BiomassControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedBiomass, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações do sensor de biomassa" />
                                    <ctl:StateDot Grid.Column="1" State="Ok" Size="8" VerticalAlignment="Center" Label="Biomassa" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ctl:Icon Key="Biomass" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Sensor de Biomassa" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AbsorbanceText}" Style="{StaticResource NumericTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedOptimalThreshold, TargetNullValue='—'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding OptimalText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Optimal Raw threshold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="AU" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="10000–40000" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Habilitar comunicação de biomassa" />
                                </Grid>

                                <!-- Dropdown Drawer: Biomassa -->
                                <Border Visibility="{Binding DataContext.IsExpandedBiomass, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,8">
                                            <TextBlock Text="Abs: " Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{Binding AbsorbanceText}" FontWeight="SemiBold" Margin="0,0,16,0" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="Raw: " Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{Binding RawText}" FontWeight="SemiBold" Margin="0,0,16,0" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="IT: " Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{Binding IntegrationTimeText}" FontWeight="SemiBold" Margin="0,0,16,0" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="PWM: " Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{Binding PwmText}" FontWeight="SemiBold" Style="{StaticResource CaptionTextStyle}" />
                                        </WrapPanel>
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Min Alcance" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding LowText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Min Alcance" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Max Alcance" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding HighText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Max Alcance" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Optimal Raw" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding OptimalText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optimal Raw" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Atualizar thresholds" Command="{Binding ApplyThresholdsCommand}" Margin="0,0,6,0" />
                                            <Button Content="Branco" Command="{Binding BlankCommand}" Margin="0,0,6,0" />
                                            <Button Content="Iniciar" Command="{Binding StartCommand}" Margin="0,0,6,0" />
                                            <Button Content="Parar" Command="{Binding StopCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 12. Frasco Agitador -->
                            <StackPanel DataContext="{Binding FlaskAgitator}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedFlaskAgitator, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações do agitador de frasco" />
                                    <ctl:StateDot Grid.Column="1" State="Ok" Size="8" VerticalAlignment="Center" Label="Frasco Agitador" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ctl:Icon Key="Impeller" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Frasco Agitador" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Dispositivo de bancada separado" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding MagnitudePercentText}" Style="{StaticResource NumericTextStyle}" />
                                            <TextBlock Text="%" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <ctl:ProvenanceBadge Text="comandado" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedMagnitudePercent, TargetNullValue='—', StringFormat='F0'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding MagnitudePercentText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="%" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="0–100 %" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Ligar o agitador de frasco" />
                                </Grid>

                                <!-- Dropdown Drawer: Frasco Agitador -->
                                <Border Visibility="{Binding DataContext.IsExpandedFlaskAgitator, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Intensidade (%)" Style="{StaticResource DosingFieldLabel}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Minimum="0" Maximum="100"
                                                            VerticalAlignment="Center"
                                                            Value="{Binding MagnitudePercent, Mode=TwoWay}"
                                                            ToolTip="Magnitude 0–100; o sentido é enviado separadamente" />
                                                    <TextBox Grid.Column="1" Width="56" Margin="10,0,0,0"
                                                             Text="{Binding MagnitudePercentText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="0–100%" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="Sentido" Style="{StaticResource DosingFieldLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <RadioButton Content="Horário" GroupName="AgitatorDir"
                                                                 IsChecked="{Binding Clockwise, Mode=TwoWay}"
                                                                 VerticalAlignment="Center" />
                                                    <RadioButton Content="Anti-horário" GroupName="AgitatorDir"
                                                                 Margin="12,0,0,0"
                                                                 IsChecked="{Binding CounterClockwise, Mode=TwoWay}"
                                                                 VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Automático" Style="{StaticResource DosingFieldLabel}" />
                                                <ToggleButton Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0"
                                                              IsChecked="{Binding IsAutomatic, Mode=TwoWay}"
                                                              ToolTip="Modo automático pelo potenciômetro" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding ValidationError}"
                                                   Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                                   Foreground="{DynamicResource StateAlarmTextBrush}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextWrapping="Wrap" Margin="0,8,0,4" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Reativar potenciômetro"
                                                    Command="{Binding ReEnablePotCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action & Safety Bar -->
            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Predefinições Group -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Predefinição:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox Width="200"
                                      ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                      Margin="0,0,6,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Carregar"
                                    ToolTip="Carregar valores da predefinição selecionada"
                                    Command="{Binding LoadPresetCommand}"
                                    Margin="0,0,6,0" />
                            <Button Content="Salvar como..."
                                    ToolTip="Salvar configuração atual em uma nova predefinição"
                                    Command="{Binding SavePresetCommand}"
                                    Margin="0,0,16,0" />
                        </StackPanel>

                        <!-- Spacer -->
                        <Grid Grid.Column="1" />

                        <!-- Parada Segura / Emergência -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Segurança:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button Content="Parada segura"
                                    ToolTip="Desliga todos os atuadores com segurança"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding SafeStopCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Margin="2,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
