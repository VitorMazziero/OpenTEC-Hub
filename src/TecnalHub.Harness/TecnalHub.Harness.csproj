<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 0 hardware harness. Console only - it exists to prove the C# protocol
    stack talks to a real ESP32-S3 before any UI is written, and to capture a
    wire trace that can be byte-compared against v.6's command_logs.

    Not shipped. Excluded from the installer; delete or keep as a diagnostic tool
    once Phase 1 lands.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TecnalHub.Harness</RootNamespace>
    <AssemblyName>tecnal-harness</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TecnalHub.Protocol\TecnalHub.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
