# ==============================================================================
# Monorepo Root .gitignore - Projeto TECNAL
# ==============================================================================

# .NET / Windows_app build output
**/bin/
**/obj/
**/[Dd]ebug/
!**/src/debug/
!**/src/debug/**
**/[Rr]elease/
**/x64/
**/publish/
*.user
*.suo
.vs/
*.DotSettings.user

# Installer & self-contained outputs
installer/Output/
tools/wifi-test/
**/executavel/

# Flutter / Android build output
**/build/
**/.dart_tool/
**/ephemeral/
**/.gradle/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/local.properties
*.iml

# Arduino & C++ build output
tools/.bin/
External-Devices/tools/.arduino-user/
External-Devices/tools/.build/
External-Devices/tools/arduino-cli.local.yaml
*.bin
*.elf
*.map
*.obj

# External-device imported toolchain output
External-Devices/**/*.o
External-Devices/**/*.a
External-Devices/**/*.d
External-Devices/**/*.dep
External-Devices/**/*.axf
External-Devices/**/*.hex
External-Devices/**/*.iex
External-Devices/**/*.lnp
External-Devices/**/*.lst
External-Devices/**/*.Administrator
External-Devices/**/*.dbgconf
External-Devices/**/runs/
External-Devices/**/test_runs/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime data & logs
logs/
*.log
preferences.local.json
Configuracoes/
Sessoes/
harness-trace-*.log
**/.Lixeira/

# Git backups
**/.git_backup/
**/.git_backup/**

# OS & Editor files
.idea/
.vscode/
Thumbs.db
desktop.ini
Desktop.ini
*.swp
/scratch/
/test_*.cs

# ---------------------------------------------------------------------------
# CAD, malhas e arquivos de fatiador ficam FORA do git (2026-09-23).
# Nao sao versionados: vivem apenas na pasta do OneDrive. Padroes sem distincao
# de maiusculas para valer tambem fora do Windows.
# ---------------------------------------------------------------------------
