<UserControl x:Class="OpenTECHub.Views.PHControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenTECHub.Converters"
             xmlns:ctl="clr-namespace:OpenTECHub.Controls"
             xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:PHControlViewModel}">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <Style x:Key="PHFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource StrokeDefaultBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}" Padding="18">
        <StackPanel Margin="0,0,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ctl:Icon Key="Ph" Size="20" Margin="0,0,8,0" />
                    <TextBlock Text="pH" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="OnToggleClicked"
                              AutomationProperties.Name="Ativar ou desligar controle de pH"
                              ToolTip="Ativar ou desligar; o comando é enviado imediatamente" />
                <ctl:StateChip Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                               State="{Binding DataContext.SelectedVariable.State, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Grid.Column="3" Margin="10,0,0,0" Padding="4" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="Fechar painel" ToolTip="Fechar"
                        Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
            </Grid>

            <Grid Margin="0,16,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="12" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PV" Style="{StaticResource CaptionTextStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LivePHText}" Style="{StaticResource ReadoutTextStyle}" />
                        <TextBlock Text="pH" Margin="5,0,0,5" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,3" VerticalAlignment="Bottom">
                    <TextBlock Text="SP" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding SetpointText}" Style="{StaticResource NumericTextStyle}" FontSize="18" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,0,3" VerticalAlignment="Bottom">
                    <TextBlock Text="Δ" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding FormattedDeviation}" Style="{StaticResource NumericTextStyle}"
                               FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <ctl:TrendSpark Margin="0,14,0,0" PlotHeight="120"
                            Channel="{Binding DataContext.SelectedVariable.Channel, RelativeSource={RelativeSource AncestorType=Window}}"
                            Setpoint="{Binding AppliedSetpoint}"
                            History="{Binding DataContext.History, RelativeSource={RelativeSource AncestorType=Window}}" />

            <Separator Margin="0,16,0,4" />
            <Expander Header="Controle" IsExpanded="True">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Width="142" Margin="0,0,10,10">
                            <TextBlock Text="Setpoint (pH)" Style="{StaticResource PHFieldLabel}" />
                            <TextBox Text="{Binding SetpointText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Faixa 1–14 pH" />
                        </StackPanel>
                        <StackPanel Width="142" Margin="0,0,10,10">
                            <TextBlock Text="Banda inativa (pH)" Style="{StaticResource PHFieldLabel}" />
                            <TextBox Text="{Binding InactiveBandText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maior que 0 e menor que 2" />
                        </StackPanel>
                        <StackPanel Width="142" Margin="0,0,10,10">
                            <TextBlock Text="Bomba ligada (s)" Style="{StaticResource PHFieldLabel}" />
                            <TextBox Text="{Binding OperationSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Inteiro de 1 a 999 s" />
                        </StackPanel>
                        <StackPanel Width="142" Margin="0,0,10,10">
                            <TextBlock Text="Repouso/mistura (s)" Style="{StaticResource PHFieldLabel}" />
                            <TextBox Text="{Binding MixSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Inteiro de 1 a 999 s" />
                        </StackPanel>
                        <StackPanel Width="142" Margin="0,0,10,10">
                            <TextBlock Text="Velocidade da bomba (%)" Style="{StaticResource PHFieldLabel}" />
                            <TextBox Text="{Binding PumpSpeedPercentText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="0–99%; o protocolo envia percentual × 10" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding ValidationError}"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                               Foreground="{DynamicResource StateAlarmTextBrush}"
                               FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>
            </Expander>

            <Expander Header="Calibração">
                <Button Content="Abrir calibração de pH" HorizontalAlignment="Left"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding DataContext.OpenCalibrationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="ph" />
            </Expander>
            <Expander Header="Saúde do sensor">
                <ctl:SensorHealthView DataContext="{Binding DataContext.SelectedVariable, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
