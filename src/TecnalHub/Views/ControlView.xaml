<UserControl x:Class="TecnalHub.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:ctl="clr-namespace:TecnalHub.Controls"
             xmlns:views="clr-namespace:TecnalHub.Views"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ControlViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <Style x:Key="DosingFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Controle"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Text="Confira e aplique toda a configuração do ensaio e dos parâmetros de cultivo."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMedium}"
                                    Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="Parâmetros do processo"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               FontWeight="SemiBold"
                                               Margin="4,0,0,8" />

                                    <ListView ItemsSource="{Binding Rows}"
                                              Height="286"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem"
                                                   BasedOn="{StaticResource {x:Type ListViewItem}}">
                                                <Setter Property="Padding" Value="0,3" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="False">
                                                <GridViewColumn Width="30">
                                                    <GridViewColumn.Header>
                                                        <TextBlock Text=" " />
                                                    </GridViewColumn.Header>
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <ctl:StateDot State="{Binding Subsystem.Variable.State}"
                                                                          Size="8"
                                                                          VerticalAlignment="Center"
                                                                          Label="{Binding Subsystem.DisplayName}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Variável" Width="130">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <Button Padding="2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    HorizontalContentAlignment="Left"
                                                                    Command="{Binding DataContext.OpenVariableFromControlCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Subsystem.Variable}"
                                                                    VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ctl:Icon Key="{Binding IconKey}" Size="18" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Subsystem.DisplayName}"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip="{Binding Subsystem.Description}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="PV" Width="95">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}"
                                                                               Style="{StaticResource NumericTextStyle}" />
                                                                    <TextBlock Text="{Binding Subsystem.Unit}"
                                                                               Margin="4,0,0,0"
                                                                               Style="{StaticResource CaptionTextStyle}"
                                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                                </StackPanel>
                                                                <ctl:ProvenanceBadge Text="comandado"
                                                                                     Visibility="{Binding Subsystem.Variable.IsCommandedOnly,
                                                                                                  Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="SP aplicado" Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <TextBlock Text="{Binding Subsystem.FormattedAppliedSetpoint}"
                                                                       Style="{StaticResource NumericTextStyle}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Novo SP" Width="160">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBox Width="88"
                                                                         VerticalAlignment="Center"
                                                                         Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="{Binding Subsystem.ValidationError}">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsOverriddenByCascade}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                    <Setter Property="ToolTip" Value="Controle bloqueado pela cascata de oxigênio." />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <ctl:ProvenanceBadge Text="cascata"
                                                                                     Margin="4,0,0,0"
                                                                                     Visibility="{Binding IsOverriddenByCascade, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Unidade" Width="70">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <TextBlock Text="{Binding Subsystem.Unit}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Faixa" Width="120">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <TextBlock Text="{Binding Subsystem.RangeHint}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Subsystem.RangeHint}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Ativo" Width="58">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <Grid VerticalAlignment="Center">
                                                                <!-- Non-oxygen rows: subsystem enable, forced on and locked while the cascade drives it -->
                                                                <ToggleButton VerticalAlignment="Center"
                                                                              Visibility="{Binding IsOxygenRow, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                                                              IsChecked="{Binding EffectiveActive, Mode=TwoWay}">
                                                                    <ToggleButton.Style>
                                                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOverriddenByCascade}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                    <Setter Property="ToolTip" Value="Controlado pela cascata de oxigênio." />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ToggleButton.Style>
                                                                </ToggleButton>
                                                                <!-- Oxygen row: engages/disengages the cascade (single activation point) -->
                                                                <ToggleButton VerticalAlignment="Center"
                                                                              Visibility="{Binding IsOxygenRow, Converter={StaticResource BoolToVis}}"
                                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                                              IsChecked="{Binding IsCascadeEngaged, Mode=TwoWay}"
                                                                              ToolTip="Ativa o controle automático de oxigênio (cascata)." />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header=" " Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <Button Content="Aplicar"
                                                                    Padding="12,4"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding Subsystem.ApplyCommand}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Modo" Width="150">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ControlParameterRowViewModel}">
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding IsOxygenRow, Converter={StaticResource BoolToVis}}">
                                                                <ComboBox ItemsSource="{Binding OxygenModeOptions}"
                                                                          SelectedItem="{Binding SelectedOxygenMode}"
                                                                          IsEnabled="{Binding CanEditOxygenMode}"
                                                                          Width="92"
                                                                          ToolTip="Trave: o modo só muda com o controle de oxigênio desativado."
                                                                          VerticalAlignment="Center" />
                                                                <Button Margin="6,0,0,0"
                                                                        Padding="6,4"
                                                                        ToolTip="Configuração do Controle de Oxigênio"
                                                                        Command="{Binding DataContext.OpenOxygenConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                    <ctl:Icon Key="Gear" Size="14" />
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </Border>


                            <TextBlock Text="Auxiliares de Cultivo"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       Margin="2,20,0,0" />

                            <!-- Valve writes are a complete desired flow state. The vent valve is
                                 read-only because v_Flow is derived and inverted on the wire. -->
                            <Border Margin="0,12,0,0"
                                    Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMedium}"
                                    Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ctl:Icon Key="Airflow" Size="20" Margin="0,0,8,0" />
                                            <TextBlock Text="Fluxômetro"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Válvula auxiliar" FontWeight="SemiBold" />
                                        <ToggleButton Margin="0,8,0,0"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding FlowControl.RequestedValve1, Mode=TwoWay}"
                                                      IsEnabled="{Binding FlowSubsystem.IsEnabled}" />
                                        <TextBlock Text="{Binding FlowControl.Valve1ActualText, StringFormat='Telemetria: {0}'}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Válvula de N₂" FontWeight="SemiBold" />
                                        <ToggleButton Margin="0,8,0,0"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding FlowControl.RequestedValve2, Mode=TwoWay}"
                                                      IsEnabled="{Binding FlowSubsystem.IsEnabled}" />
                                        <TextBlock Text="{Binding FlowControl.Valve2ActualText, StringFormat='Telemetria: {0}'}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Respiro · v_Flow" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FlowControl.VentActualText}"
                                                   Style="{StaticResource NumericTextStyle}"
                                                   Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding FlowControl.VentRuleText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,12,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="maxFlow" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBox Width="82"
                                                     Text="{Binding FlowControl.MaxFlowText,
                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding FlowControl.ValidationError}" />
                                            <TextBlock Text="L/min"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FlowRequestError}"
                                                   Visibility="{Binding FlowRequestError, Converter={StaticResource NullToVis}}"
                                                   Foreground="{DynamicResource StateAlarmTextBrush}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            Content="Aplicar vazão e válvulas"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding ApplyFlowStateCommand}" />
                                </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ WP7 cultivation auxiliaries ═════════════════════════
                                 Nutrient and antifoam pumps and the flask agitator take part
                                 in the bulk apply and the safe-stop; the level/foam sensor is
                                 configuration and applies on its own. -->

                            <!-- Dosagem — Nutriente -->
                            <Border Margin="0,10,0,0"
                                    Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMedium}"
                                    Padding="16"
                                    DataContext="{Binding NutrientControl}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ctl:Icon Key="Nutrient" Size="20" Margin="0,0,8,0" />
                                            <TextBlock Text="Dosagem — Nutriente"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ctl:ProvenanceBadge Text="comandado" Margin="10,0,0,0"
                                                                 VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" Margin="0,6,0,0"
                                                          ToolTip="Habilitar dosagem de nutriente" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Operação (s)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding OperationSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Inteiro de 1 a 999 s" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Mistura (s)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding MixSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Inteiro de 1 a 999 s" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Ciclo op." Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding OperationCyclesText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Inteiro de 1 a 999" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Ciclo mist." Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding MixCyclesText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Inteiro de 1 a 999" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Intensidade (%)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding PumpSpeedPercentText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="0–99%" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ValidationError}"
                                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Reverter" Command="{Binding RevertCommand}" Margin="0,0,6,0" />
                                            <Button Content="Aplicar" Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding ApplyCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Dosagem — Antiespumante -->
                            <Border Margin="0,12,0,0"
                                    Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMedium}"
                                    Padding="16"
                                    DataContext="{Binding AntifoamControl}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ctl:Icon Key="Foam" Size="20" Margin="0,0,8,0" />
                                            <TextBlock Text="Dosagem — Antiespumante"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LiveAntifoamText, StringFormat='Antifoam: {0}'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" Margin="0,6,0,0"
                                                          ToolTip="Habilitar bomba de antiespumante" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <StackPanel Width="150" Margin="0,0,10,10">
                                            <TextBlock Text="Operação (s)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding OperationSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Inteiro de 0 a 999 s" />
                                        </StackPanel>
                                        <StackPanel Width="150" Margin="0,0,10,10">
                                            <TextBlock Text="Mistura (s)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding MixSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Inteiro de 1 a 999 s" />
                                        </StackPanel>
                                        <StackPanel Width="150" Margin="0,0,10,10">
                                            <TextBlock Text="Intensidade (%)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding PumpSpeedPercentText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="0–99%" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ValidationError}"
                                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Reverter" Command="{Binding RevertCommand}" Margin="0,0,6,0" />
                                            <Button Content="Aplicar" Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding ApplyCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Controle de espuma (level/foam sensor + automatic response) -->
                            <Border Margin="0,12,0,0"
                                    Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMedium}"
                                    Padding="16"
                                    DataContext="{Binding FoamControl}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ctl:Icon Key="Level" Size="20" Margin="0,0,8,0" />
                                            <TextBlock Text="Controle de espuma"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LiveDistanceText, StringFormat='Nível: {0} mm'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding SensorEnabled, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" Margin="0,6,0,0"
                                                          ToolTip="Ativar o sensor de nível/espuma" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Referência (mm)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding ReferenceMillimetresText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="0 a 999 mm" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Atraso inicial (s)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding StartDelaySecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="0 a 3600 s" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Pulso (s)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding PulseSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="1 a 999 s" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Intervalo (s)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding IntervalSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="1 a 999 s" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="O sensor de nível/espuma segue ativo mesmo em parada segura, para não perder o monitoramento."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ValidationError}"
                                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Reverter" Command="{Binding RevertCommand}" Margin="0,0,6,0" />
                                            <Button Content="Aplicar" Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding ApplyCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Agitador de frasco (a separate bench device) -->
                            <Border Margin="0,12,0,0"
                                    Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusMedium}"
                                    Padding="16"
                                    DataContext="{Binding FlaskAgitator}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:Icon Key="Impeller" Size="20" Margin="0,0,8,0" />
                                                <TextBlock Text="Agitador de frasco"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Dispositivo de bancada separado; não é o impelidor do reator."
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,4,12,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" Margin="0,6,0,0"
                                                          ToolTip="Ligar o agitador de frasco" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="Intensidade (%)" Style="{StaticResource DosingFieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" Minimum="0" Maximum="100"
                                                        VerticalAlignment="Center"
                                                        Value="{Binding MagnitudePercent, Mode=TwoWay}"
                                                        ToolTip="Magnitude 0–100; o sentido é enviado separadamente" />
                                                <TextBox Grid.Column="1" Width="56" Margin="10,0,0,0"
                                                         Text="{Binding MagnitudePercentText, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="0–100%" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <TextBlock Text="Sentido" Style="{StaticResource DosingFieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Horário" GroupName="AgitatorDir"
                                                             IsChecked="{Binding Clockwise, Mode=TwoWay}"
                                                             VerticalAlignment="Center" />
                                                <RadioButton Content="Anti-horário" GroupName="AgitatorDir"
                                                             Margin="12,0,0,0"
                                                             IsChecked="{Binding CounterClockwise, Mode=TwoWay}"
                                                             VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Automático" Style="{StaticResource DosingFieldLabel}" />
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding IsAutomatic, Mode=TwoWay}"
                                                          ToolTip="Modo automático pelo potenciômetro" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding ValidationError}"
                                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap" Margin="0,12,0,8" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Reativar potenciômetro"
                                                    Command="{Binding ReEnablePotCommand}" Margin="0,0,6,0" />
                                            <Button Content="Reverter" Command="{Binding RevertCommand}" Margin="0,0,6,0" />
                                            <Button Content="Aplicar" Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding ApplyCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource StrokeDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Padding="14,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Predefinições Group -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Predefinição:"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <ComboBox Width="200"
                                              ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                              Margin="0,0,6,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="Carregar"
                                            ToolTip="Carregar valores da predefinição selecionada"
                                            Command="{Binding LoadPresetCommand}"
                                            Margin="0,0,6,0" />
                                    <Button Content="Salvar como..."
                                            ToolTip="Salvar configuração atual em uma nova predefinição"
                                            Command="{Binding SavePresetCommand}"
                                            Margin="0,0,16,0" />
                                </StackPanel>

                                <!-- Spacer -->
                                <Grid Grid.Column="1" />

                                <!-- Ações em Lote -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Ações:"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <Button Content="Reverter tudo"
                                            ToolTip="Reverter todas as alterações pendentes"
                                            Command="{Binding RevertAllCommand}"
                                            Margin="0,0,6,0" />
                                    <Button Content="{Binding ApplyAllLabel}"
                                            ToolTip="Aplicar todas as alterações pendentes ao biorreator"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding ApplyAllCommand}"
                                            Margin="0,0,16,0" />
                                </StackPanel>

                                <!-- Parada Segura / Emergência -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Segurança:"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <Button Content="Parada segura"
                                            ToolTip="Desliga todos os atuadores com segurança"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding SafeStopCommand}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Margin="2,8,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
        </Grid>
    </Grid>
</UserControl>
