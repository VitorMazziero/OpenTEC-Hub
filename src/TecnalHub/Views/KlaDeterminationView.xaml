<UserControl x:Class="TecnalHub.Views.KlaDeterminationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:kla="clr-namespace:TecnalHub.Services.KlaTesting"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:KlaDeterminationViewModel}"
             d:DesignHeight="850" d:DesignWidth="1500">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="KlaHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="KlaHeaderValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="KlaCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Top Header Strip ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource KlaCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Active Test info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Determinação de kLa" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Margin="12,0,0,0" Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayPhase}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <Border Margin="8,0,0,0" Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SIMULAÇÃO" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource StateWarningTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding StatusMessage}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding SimulationDescription}" FontWeight="SemiBold"
                               Foreground="{DynamicResource StateWarningTextBrush}"
                               Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Middle: Telemetry & Timers -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="OD Dissolvido" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding CurrentDO, StringFormat={}{0:F1} %}" Style="{StaticResource KlaHeaderValue}" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Vazão Atual" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding CurrentFlow, StringFormat={}{0:F2} L/min}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Tempo da Fase" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding FormattedPhaseTime}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Tempo Total" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding FormattedTotalTime}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Novo Teste" Margin="4,0" Style="{StaticResource AccentButtonStyle}" Command="{Binding OpenCreateDialogCommand}" />
                    <Button Content="Parar e Revisar" Margin="4,0" Command="{Binding StopRunCommand}" IsEnabled="{Binding IsRunning}" />
                    <Button Content="Concluir Teste" Margin="4,0" Command="{Binding CompleteTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                    <Button Content="Abortar" Margin="4,0" Command="{Binding AbortTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Area: Split View ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="340" MaxWidth="500" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left Column: Conditions Matrix & Settings ─────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Condition Matrix Card -->
                <Border Grid.Row="0" Style="{StaticResource KlaCard}" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Matriz de Condições Experimentais" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />

                        <!-- Condition Table -->
                        <DataGrid ItemsSource="{Binding Conditions}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  BorderThickness="1" BorderBrush="{DynamicResource StrokeDefaultBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="30" IsReadOnly="True" />
                                <DataGridTextColumn Header="N (rpm)" Binding="{Binding AgitationRpm, StringFormat={}{0:F0}}" Width="65" IsReadOnly="True" />
                                <DataGridTextColumn Header="Q (L/min)" Binding="{Binding AirflowLpm, StringFormat={}{0:F2}}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Reps alvo" Binding="{Binding RequestedReplicates, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Ação" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Executar" Padding="6,2" FontSize="11"
                                                    Command="{Binding DataContext.StartConditionRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanExecute}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Bottom Config & Manual Add -->
                <StackPanel Grid.Row="1">
                    <!-- Manual Condition Add -->
                    <Border Style="{StaticResource KlaCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Adicionar Condição Manual" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="N (rpm)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding NewConditionRpm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="Q (L/min)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding NewConditionFlow, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0">
                                    <TextBlock Text="Reps" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding NewConditionReplicates, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="+" FontWeight="Bold" Width="32" Height="32" VerticalAlignment="Bottom"
                                        Command="{Binding AddManualConditionCommand}" IsEnabled="{Binding HasActiveTest}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Real-time Thresholds -->
                    <Border Style="{StaticResource KlaCard}">
                        <StackPanel>
                            <TextBlock Text="Limiares de Operação" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="DO Mín (%)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingDOMin, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="DO Máx (%)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingDOMax, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0">
                                    <TextBlock Text="N Desox (rpm)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingDegassingAgitation, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Suavização (ímpar)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingSmoothingWindow, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="Máx. N₂ (min)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingMaxDegassingMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Máx. Ar (min)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingMaxReoxygenationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Aplicar Limiares" Margin="0,6,0,0" Command="{Binding ApplyLiveSettingsCommand}" IsEnabled="{Binding HasActiveTest}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ── Right Column: 3 Synchronized Plots & Review Drawer ────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="1.5*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Chart 1: DO vs Time -->
                <Border x:Name="ChartDoHost" Grid.Row="0" Margin="0,0,0,6" Style="{StaticResource KlaCard}" />

                <!-- Chart 2: Log-Linear OLS Fit -->
                <Border x:Name="ChartLogLinearHost" Grid.Row="1" Margin="0,0,0,6" Style="{StaticResource KlaCard}" />

                <!-- Chart 3: Instantaneous kLa -->
                <Border x:Name="ChartInstantKlaHost" Grid.Row="2" Margin="0,0,0,6" Style="{StaticResource KlaCard}" />

                <!-- ── Review Drawer (Visible during Review) ─────────────────── -->
                <Border Grid.Row="3" Style="{StaticResource KlaCard}" Background="{DynamicResource SurfaceCardBrush}"
                        Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drawer Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Revisão Científica e Aceite da Corrida" FontWeight="Bold" FontSize="14" />
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding ReviewQuality}" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                        </DockPanel>

                        <!-- Drawer Parameters & Scientific Results -->
                        <Grid Grid.Row="1" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Interactive Tuning Controls -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ceq (%)" Style="{StaticResource KlaHeaderLabel}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Content="Manual" IsChecked="{Binding ReviewCeqIsManual}" />
                                </Grid>
                                <TextBox Text="{Binding ReviewCeq, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ReviewCeqIsManual}" />

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Ceq t_ini (s)" Style="{StaticResource KlaHeaderLabel}" />
                                        <TextBox Text="{Binding ReviewCeqTStart, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Ceq t_fim (s)" Style="{StaticResource KlaHeaderLabel}" />
                                        <TextBox Text="{Binding ReviewCeqTEnd, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="t_ini (s)" Style="{StaticResource KlaHeaderLabel}" />
                                        <TextBox Text="{Binding ReviewTStart, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="t_fim (s)" Style="{StaticResource KlaHeaderLabel}" />
                                        <TextBox Text="{Binding ReviewTEnd, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Button Content="Recalcular OLS" Margin="0,6,0,0" Command="{Binding RecomputeReviewAnalysisCommand}" />
                            </StackPanel>

                            <!-- Scientific Fit Metrics -->
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="kLa Estimado" Style="{StaticResource KlaHeaderLabel}" />
                                        <TextBlock Text="{Binding ReviewKla, StringFormat={}{0:F1} h⁻¹}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding ReviewCi95Low, StringFormat={}IC 95%: [{0:F1}; }" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Qualidade do Ajuste" Style="{StaticResource KlaHeaderLabel}" />
                                        <TextBlock Text="{Binding ReviewR2, StringFormat='R²: {0:F4}'}" Style="{StaticResource KlaHeaderValue}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding ReviewRmse, StringFormat='RMSE: {0:F4}'}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sensibilidade Ceq ± 1%" Style="{StaticResource KlaHeaderLabel}" />
                                        <TextBlock Text="{Binding ReviewSensLow, StringFormat={}[{0:F1}; }" Style="{StaticResource KlaHeaderValue}" />
                                        <TextBlock Text="{Binding ReviewSensHigh, StringFormat={}{0:F1}] h⁻¹}" Style="{StaticResource KlaHeaderValue}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Justificativa / Motivo" Style="{StaticResource KlaHeaderLabel}" />
                                        <TextBox Text="{Binding ReviewRejectionReason, UpdateSourceTrigger=PropertyChanged}" Height="45" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Drawer Action Buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Repetir Corrida" Margin="4,0" Command="{Binding RepeatCurrentRunCommand}" />
                            <Button Content="Rejeitar Corrida" Margin="4,0" Command="{Binding RejectCurrentRunCommand}" />
                            <Button Content="Aceitar Corrida (Salvar e Avançar)" Margin="4,0" Style="{StaticResource AccentButtonStyle}" Command="{Binding AcceptCurrentRunCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Modal: Novo Teste ──────────────────────────────────────────────── -->
        <Grid Grid.RowSpan="2" Background="{DynamicResource SurfaceBaseBrush}" Opacity="0.95" Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource KlaCard}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Criar Novo Teste de kLa" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                    <TextBlock Text="Nome do Teste (Pasta em Testes-kLa/)" Style="{StaticResource KlaHeaderLabel}" />
                    <TextBox Text="{Binding NewTestName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                    <TextBlock Text="Válvula Conectada ao N₂" Style="{StaticResource KlaHeaderLabel}" />
                    <ComboBox SelectedItem="{Binding SelectedN2Valve}" Margin="0,2,0,10">
                        <kla:NitrogenValve>Valve1</kla:NitrogenValve>
                        <kla:NitrogenValve>Valve2</kla:NitrogenValve>
                    </ComboBox>

                    <TextBlock Text="Importar Condições de Mapa Existente (Opcional)" Style="{StaticResource KlaHeaderLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableMaps}" SelectedItem="{Binding SelectedMapForImport}" DisplayMemberPath="Snapshot.Name" Margin="0,2,0,10" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="DO Mín (%)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDOMin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="DO Máx (%)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDOMax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="N Desox (rpm)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDegassingAgitation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Margin="0,0,8,0" Command="{Binding CloseCreateDialogCommand}" />
                        <Button Content="Criar Teste" Style="{StaticResource AccentButtonStyle}" Command="{Binding CreateNewTestCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
