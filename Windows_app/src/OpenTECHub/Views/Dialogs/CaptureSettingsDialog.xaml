<Window x:Class="OpenTECHub.Views.Dialogs.CaptureSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OpenTECHub.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Critérios de Parada e Opções de Captura"
        Width="520" Height="580"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

    </Window.Resources>

    <DockPanel>
        <!-- Top Bar -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionMinimizeButtonStyle}" Click="OnMinimizeWindow" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseWindow" />
                </StackPanel>
                <TextBlock Text="Critérios de Parada e Opções de Captura"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Padding="16,12"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Button Content="Concluir" MinWidth="95" Padding="14,6" HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Click="OnCloseClick" />
        </Border>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12,16,12">
            <StackPanel>
                <TextBlock Text="Critérios Estatísticos (Dois-Portões §12)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Controlam a identificação automática de regime permanente e parada estatística do ponto de ensaio."
                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- Faixa 1: IC rel., Piso, n mín. -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="IC rel. (%)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding RelativeCiPercent, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Piso στ (×)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding CiFloorSigmaMultiple, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="n mín." Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MinimumSamples, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </Grid>

                <!-- Faixa 2: t máx, Tentativas, Janela -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="t máx. (s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxCaptureSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Tentativas" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxTries, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Janela (s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationarityWindowSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </Grid>

                <!-- Faixa 3: Deriva, Confirmações -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Deriva (%/s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationaritySlopeTolerance, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Confirmações" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationarityRequiredSamples, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </Grid>

                <Separator Margin="0,16,0,12" Background="{DynamicResource StrokeDefaultBrush}" />

                <TextBlock Text="Opções de Operação" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                <CheckBox Margin="0,0,0,8" Content="Aceite automático dos pontos" IsChecked="{Binding AutoAcceptRuns}"
                          ToolTip="Aceita cada ponto capturado sem revisão e emenda direto na próxima condição, deixando o ensaio rodar sozinho até o fim da tabela. Sem isso, cada ponto para em 'Revisando' e espera o operador. Falhas de sequência (alívio, válvulas, rotação, limites) continuam parando para revisão." />
                <CheckBox Margin="20,0,0,8" Content="Falha de sequência em modo autônomo: repetir uma vez, depois pular"
                          IsChecked="{Binding RetryThenSkipOnSequenceFailure}"
                          IsEnabled="{Binding AutoAcceptRuns}"
                          ToolTip="Com o aceite automático, um tempo limite de alívio, de válvula ou de rotação rejeita a corrida, repete a condição uma vez e, se falhar de novo, marca a condição como pulada e segue. Sem esta opção o ensaio para em 'Revisando'. Limite de torque ou rotação continua parando sempre — é segurança, não sequência." />
                <CheckBox Margin="0,0,0,8" Content="Leitura manual de energia após cada ponto"
                          IsChecked="{Binding ManualEnergyCaptureEnabled}"
                          IsEnabled="{Binding AutoAcceptRuns, Converter={StaticResource InverseBool}}"
                          ToolTip="Mantém cada ponto parado à espera da leitura do wattímetro. Incompatível com o aceite automático, que por isso desabilita esta opção." />
                <CheckBox Margin="0,0,0,8" Content="Retomar automaticamente ao reconectar Wi-Fi"
                          IsChecked="{Binding AutoResumeOnLinkRestore}"
                          ToolTip="Se houver perda de conexão, tenta reaver o ensaio no mesmo ponto quando a telemetria do motor voltar a ficar estável." />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Limite de tolerância à queda do link (s):" Style="{StaticResource PowerLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Width="60" HorizontalAlignment="Left" Style="{StaticResource CompactField}" Text="{Binding LinkRecoveryTimeoutSeconds, UpdateSourceTrigger=LostFocus}" ToolTip="Se a conexão cair, aguarda até esse tempo em segundos antes de abortar o ensaio." />
                </Grid>
                <TextBlock Margin="0,4,0,2" Text="Pré-estabilização por C (condições gaseificadas)" Style="{StaticResource PowerLabel}" FontWeight="SemiBold" />
                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                           Text="Toda condição gaseificada sobe a vazão pela saída B/C — o pulso do fluxômetro sai pela descarga (C) — e só a vazão assentada é comutada para o reator (A), numa frame só. Neste ensaio a linha B fica pinçada ou desconectada: não há N₂." />
                <TextBlock Margin="0,0,0,6" Text="{Binding GasRigDescription}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />

                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Padding="10"
                        Margin="0,2,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tol. (L/min)" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding PrestageFlowToleranceLpm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Amostras" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding PrestageFlowStableSamples, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="N em C (rpm)" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding PrestageAgitationRpm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="t máx. (s)" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding MaxPrestageSeconds, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" ToolTip="Estabilidade: desvio-padrão máximo das últimas N leituras para considerar a vazão estabilizada mesmo fora da banda de tolerância">
                                <TextBlock Text="σ máx. (L/min)" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding PrestageFlowStabilityStdDevLpm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" ToolTip="Estabilidade: distância máxima entre a média das últimas N leituras e o alvo">
                                <TextBlock Text="|erro| máx. (L/min)" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding PrestageFlowStabilityMaxErrorLpm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <TextBlock Grid.Column="4" VerticalAlignment="Bottom" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                                       Text="Comuta para A quando N leituras estão na banda OU quando σ e |erro| ficam abaixo destes limites (o controlador tem offset de ~+0,08 L/min)." />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource StateWarningTextBrush}"
                                   Visibility="{Binding IsPrestageTimeoutShort, Converter={StaticResource BoolToVis}}"
                                   Text="Abaixo de ~150 s a pré-estabilização tende a expirar: ao abrir C, a vazão sobe a ~2,3× o alvo e decai com τ ≈ 45 s, levando 110–170 s para entrar na banda (bancada de 11/09/2026)." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
