<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure protocol/transport library: NO WPF, NO UI types.

    This is deliberately a separate assembly from the app so the ESP32-S3 contract
    can be unit-tested headlessly and so nothing in it can accidentally take a
    dependency on the UI. If a type here needs a Dispatcher, it is in the wrong project.

    Overrides the repo-wide net10.0-windows: this library is platform-neutral.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TecnalHub.Protocol</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serial (USB CDC) support. Not in the base framework since .NET Core. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

</Project>
