# ==============================================================================
# Monorepo Root .gitignore - Projeto TECNAL
# ==============================================================================

# .NET / Windows_app build output
**/bin/
**/obj/
**/[Dd]ebug/
!**/src/debug/
!**/src/debug/**
**/[Rr]elease/
**/x64/
**/publish/
*.user
*.suo
.vs/
*.DotSettings.user

# Installer & self-contained outputs
installer/Output/
tools/wifi-test/
**/executavel/

# Flutter / Android build output
**/build/
.dart_tool/

# Arduino & C++ build output
tools/.bin/
*.bin
*.elf
*.map

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime data & logs
logs/
*.log
preferences.local.json
Configuracoes/
Sessoes/
harness-trace-*.log

# Git backups
**/.git_backup/
**/.git_backup/**

# OS & Editor files
.idea/
.vscode/
Thumbs.db
desktop.ini
Desktop.ini
*.swp
/scratch/
/test_*.cs
