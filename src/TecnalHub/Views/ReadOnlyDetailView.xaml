<UserControl x:Class="TecnalHub.Views.ReadOnlyDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:ctl="clr-namespace:TecnalHub.Controls"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProcessVariableViewModel}">

    <!-- ══════════════════════════════════════════════════════════════════════
         The detail pane for a variable with nothing to command.

         pH and pressure are measured and logged, but this phase has no control
         loop for either. Showing the reading is honest; showing an empty setpoint
         field would imply a control the application does not have, which is the
         same class of lie as showing a commanded figure as though it were
         measured. See docs/UI_DESIGN.md section 6.1.
         ══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Padding="18"
            VerticalAlignment="Top"
            CornerRadius="{DynamicResource RadiusMedium}"
            Background="{DynamicResource SurfaceCardBrush}"
            BorderBrush="{DynamicResource StrokeDefaultBrush}"
            BorderThickness="1">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                           FontSize="{DynamicResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ctl:StateChip Grid.Column="1" State="{Binding State}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="{Binding FormattedValue}"
                           Style="{StaticResource ReadoutTextStyle}" />
                <TextBlock Text="{Binding Unit}"
                           Margin="6,0,0,5"
                           VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <!-- A commanded-only pump (nutrient) never has a measured value; say so. -->
            <ctl:ProvenanceBadge Margin="0,8,0,0"
                                 Visibility="{Binding IsCommandedOnly, Converter={StaticResource BoolToVis}}" />

            <ctl:TrendSpark Margin="0,14,0,0"
                            PlotHeight="120"
                            Channel="{Binding Channel}"
                            History="{Binding DataContext.History,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />

            <Separator Margin="0,16,0,12" />

            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap"
                       Text="{Binding DetailNote}" />
        </StackPanel>
    </Border>
</UserControl>
