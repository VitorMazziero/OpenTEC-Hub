                                <TextBlock Grid.Column="6" Text="Unidade" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="Faixa" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="8" Text="Ativo" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource StrokeDefaultBrush}" Margin="0,0,0,6" />

                            <!-- 8. Vazão de Ar (com dropdown) -->
                            <StackPanel>
                                <Grid Margin="0,4" VerticalAlignment="Center" DataContext="{Binding FlowRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedFlow, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Opções do fluxômetro de massa (válvulas, N2, maxFlow)" />
                                    <ctl:StateDot Grid.Column="1" Size="8" VerticalAlignment="Center" Label="Vazão de Ar">
                                        <ctl:StateDot.State>
                                            <!-- Same converter as the other external rows, so this dot cannot
                                                 contradict the chip beside it. The trailing variable state is
                                                 the flowmeter's alone: it is the one external device with a
                                                 measured band, and that band still shows once the link is
                                                 healthy. -->
                                            <MultiBinding Converter="{StaticResource ExternalDeviceState}">
                                                <Binding Path="EffectiveActive" />
                                                <Binding Path="DataContext.FlowControl.Status.IsOffline" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                <Binding Path="DataContext.FlowControl.Status.ShowPendingChip" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                <Binding Path="DataContext.FlowControl.Status.ShowRoutingChipOnly" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                <Binding Path="Subsystem.Variable.State" />
                                            </MultiBinding>
                                        </ctl:StateDot.State>
                                    </ctl:StateDot>
                                    <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenVariableFromControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Subsystem.Variable}" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ctl:Icon Grid.Column="0" Key="Airflow" Style="{StaticResource ProcessRowIconStyle}" />
                                            <TextBlock Grid.Column="1" Text="Vazão de Ar" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="Fluxômetro de massa e controle de aeração" />
                                            <!-- The same chips as every other external device, including the
                                                 routing one: the Hub persists flowComm in NVS and the app
                                                 persists this row's switch, so they can diverge exactly as the
                                                 others do — and FlowControlEnabled is what the Fluxômetro
                                                 offline alarm is conditioned on. -->
                                            <ctl:ExternalDeviceChips Grid.Column="2" Status="{Binding DataContext.FlowControl.Status, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Grid>
                                    </Button>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}" Style="{StaticResource NumericTextStyle}" />
                                            <TextBlock Text="{Binding Subsystem.Unit}" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding Subsystem.FormattedAppliedSetpoint}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding Subsystem.ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ExternalDeviceEntryStyle}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding DataContext.FlowControl.CanSendFlowCommands, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                <Condition Binding="{Binding IsOverriddenByCascade}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="IsEnabled" Value="True" />
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <ctl:ProvenanceBadge Text="{Binding OwnerBadgeText}" Explanation="{Binding OwnerLockReason}" Margin="4,0,0,0" Visibility="{Binding HasOwnerBadge, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="{Binding Subsystem.Unit}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subsystem.RangeHint}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding EffectiveActive, Mode=TwoWay}">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ExternalDeviceToggleStyle}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.FlowControl.CanSendFlowCommands, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                            <Condition Binding="{Binding IsOverriddenByCascade}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>

                                <!-- Dropdown Drawer: Fluxômetro / Válvulas -->
                                <Border Visibility="{Binding DataContext.IsExpandedFlow, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: gas destination, then the raw inputs under Avançado -->
                                        <StackPanel Grid.Column="0" DataContext="{Binding FlowControl}" Margin="0,0,16,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- The operator commands a destination, not a pin (plan A/B/C §3.2). -->
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="Válvulas do fluxômetro" FontWeight="SemiBold" />
                                                    <TextBlock Text="A = ar ao reator · B = N₂ ou nada · C = purga de ar. Escolha a entrada acionada."
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                                ToolTip="Os papéis das válvulas são fixos; o que muda é qual entrada do fluxômetro está acionada. B e C abrem juntas na mesma entrada.">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="RadioButton" BasedOn="{StaticResource CompactSectionTabStyle}">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DataContext.FlowSubsystem.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                            <Condition Binding="{Binding CanSendFlowCommands}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <RadioButton Content="Fechado" GroupName="GasRoute" IsChecked="{Binding IsRouteClosed, Mode=TwoWay}" />
                                                        <RadioButton Content="{Binding Input1Choice}" GroupName="GasRoute" IsChecked="{Binding IsInput1Requested, Mode=TwoWay}" />
                                                        <RadioButton Content="{Binding Input2Choice}" GroupName="GasRoute" IsChecked="{Binding IsInput2Requested, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}">
                                                        <Run Text="Telemetria: " Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Run Text="{Binding ObservedRouteText, Mode=OneWay}" FontWeight="SemiBold">
                                                            <Run.Style>
                                                                <Style TargetType="Run">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsObservedRouteAnomalous}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StateAlarmTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run>
                                                        <Run Text=" · " Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Run Text="{Binding WireText, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding RigDescription, StringFormat='{}{0} (Documentação › Gás e válvulas)'}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding DataContext.FlowRouteWarning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Visibility="{Binding DataContext.FlowRouteWarning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}"
                                                               Foreground="{DynamicResource StateWarningTextBrush}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="maxFlow" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBox Width="80"
                                                                 IsEnabled="{Binding CanSendFlowCommands}"
                                                                 Text="{Binding MaxFlowText, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="{Binding ValidationError}" />
                                                        <TextBlock Text="L/min"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DataContext.FlowRequestError, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Visibility="{Binding DataContext.FlowRequestError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}"
                                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Avançado: the two inputs and the line shutoff, raw. Free operation has no
                                                 interlock (plan §3.3): any combination is sent; the warning above is the
                                                 only word about it. -->
                                            <Expander Header="Avançado" Margin="0,10,0,0" IsExpanded="False"
                                                      ToolTip="Bancada: as entradas 1 e 2 uma a uma e o fechamento da linha. Qualquer combinação é enviada — as duas acionadas ou a linha sem saída só geram aviso.">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Resources>
                                                        <Style x:Key="RawInputToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.FlowSubsystem.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                        <Condition Binding="{Binding CanSendFlowCommands}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Resources>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Input1Label}" FontWeight="SemiBold" />
                                                        <ToggleButton Margin="0,6,0,0" Style="{StaticResource RawInputToggle}" IsChecked="{Binding RequestedValve1, Mode=TwoWay}" />
                                                        <TextBlock Text="{Binding Valve1ActualText, StringFormat='Telemetria: {0}'}"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Input2Label}" FontWeight="SemiBold" />
                                                        <ToggleButton Margin="0,6,0,0" Style="{StaticResource RawInputToggle}" IsChecked="{Binding RequestedValve2, Mode=TwoWay}" />
                                                        <TextBlock Text="{Binding Valve2ActualText, StringFormat='Telemetria: {0}'}"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Fechar linha (v_Flow)" FontWeight="SemiBold" />
                                                        <ToggleButton Margin="0,6,0,0" Style="{StaticResource RawInputToggle}" IsChecked="{Binding RequestedMainValveClosed, Mode=TwoWay}" />
                                                        <TextBlock Text="{Binding MainValveActualText, StringFormat='Telemetria: {0}'}"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Expander>

                                            <!-- Sintonia do controlador (Hub 10.2 / Nó v11) -->
                                            <Expander Header="Sintonia do controlador" Margin="0,10,0,0" IsExpanded="False"
                                                      ToolTip="{Binding TuningUnavailableText}">
                                                <StackPanel Margin="0,8,0,0">
                                                    <WrapPanel>
                                                        <StackPanel Width="100" Margin="0,0,10,6">
                                                            <TextBlock Text="Kp" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="90" HorizontalAlignment="Left"
                                                                     IsEnabled="{Binding CanSendTuning}"
                                                                     Text="{Binding KpText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ganho proporcional (ex: 0.8)" />
                                                            <TextBlock Text="{Binding AppliedKpText, StringFormat='Telemetria: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="100" Margin="0,0,10,6">
                                                            <TextBlock Text="Ki" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="90" HorizontalAlignment="Left"
                                                                     IsEnabled="{Binding CanSendTuning}"
                                                                     Text="{Binding KiText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ganho integral (ex: 0.15)" />
                                                            <TextBlock Text="{Binding AppliedKiText, StringFormat='Telemetria: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="110" Margin="0,0,10,6">
                                                            <TextBlock Text="Ganho FF" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="90" HorizontalAlignment="Left"
                                                                     IsEnabled="{Binding CanSendTuning}"
                                                                     Text="{Binding FfGainText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ganho de feed-forward (ex: 0.106)" />
                                                            <TextBlock Text="{Binding AppliedFfGainText, StringFormat='Telemetria: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="110" Margin="0,0,10,6">
                                                            <TextBlock Text="Offset FF" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="90" HorizontalAlignment="Left"
                                                                     IsEnabled="{Binding CanSendTuning}"
                                                                     Text="{Binding FfOffsetText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Offset de feed-forward (ex: 0.01033)" />
                                                            <TextBlock Text="{Binding AppliedFfOffsetText, StringFormat='Telemetria: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="140" Margin="0,0,10,6">
                                                            <TextBlock Text="Taxa de rampa" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="90" HorizontalAlignment="Left"
                                                                     IsEnabled="{Binding CanSendTuning}"
                                                                     Text="{Binding RampRateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rampa em L/min/s (ex: 2.0)" />
                                                            <TextBlock Text="{Binding AppliedRampRateText, StringFormat='Telemetria: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                                            <TextBlock Text="Saída do controlador: " Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding FlowOutputText}" FontWeight="SemiBold" Style="{StaticResource CaptionTextStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                                            <TextBlock Text="Setpoint corrigido: " Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding FlowSetpointCorrectedText}" FontWeight="SemiBold" Style="{StaticResource CaptionTextStyle}" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Content="Enviar sintonia"
                                                                Command="{Binding SendTuningCommand}"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                Margin="0,0,8,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TuningValidationError}"
                                                               Visibility="{Binding TuningValidationError, Converter={StaticResource NullToVis}}"
                                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                                               FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding TuningStatusText}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="A sintonia é persistida no nó e afeta os próximos ensaios."
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>

                                        <!-- Right: Calibration & Sensor Health -->
                                        <StackPanel Grid.Column="1" MinWidth="260">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Calibração" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Button Content="Calibrar Vazão" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.OpenCalibrationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="flow" />
                                            </StackPanel>
                                            <TextBlock Text="Saúde do Sensor" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ctl:SensorHealthView DataContext="{Binding DataContext.FlowVariable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Rede: who the node is on the Hub's network (Hub 10.1). Own card below the drawer,
                                     same visibility, so the drawer's layout is untouched. -->
                                <Border Visibility="{Binding DataContext.IsExpandedFlow, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,0,8,8"
                                        Padding="14,2,14,10">
                                    <ctl:NodeNetworkPanel Status="{Binding DataContext.FlowControl.Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CanReachNodes="{Binding DataContext.IsHubOnWiFi, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          OpenCommand="{Binding DataContext.OpenNodeDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CopyCommand="{Binding DataContext.CopyNodeIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                            </StackPanel>

                            <!-- 9. Distância (Controle de espuma) -->
                            <StackPanel DataContext="{Binding FoamControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedDistance, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações do sensor de distância / espuma" />
                                    <ctl:StateDot Grid.Column="1" Size="8" VerticalAlignment="Center" Label="Distância">
                                        <ctl:StateDot.State>
                                            <MultiBinding Converter="{StaticResource ExternalDeviceState}">
                                                <Binding Path="SensorEnabled" />
                                                <Binding Path="Status.IsOffline" />
                                                <Binding Path="Status.ShowPendingChip" />
                                                <Binding Path="Status.ShowRoutingChipOnly" />
                                            </MultiBinding>
                                        </ctl:StateDot.State>
                                    </ctl:StateDot>
                                    <!-- The foam keys are Hub-side configuration, so this row is never
                                         blocked on presence: losing the node must not also cost the operator
                                         the ability to configure what happens when it comes back. -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Trailing spacer: keeps the chip beside the name it
                                                 describes rather than pinned to the cell's right edge,
                                                 where it read as though it belonged to Valor Lido. -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ctl:Icon Grid.Column="0" Key="Level" Style="{StaticResource ProcessRowIconStyle}" />
                                        <!-- The name yields first. A chip pushed out of a horizontal
                                             stack would take the device's state with it, and the state
                                             is the part the operator cannot reconstruct. -->
                                        <TextBlock Grid.Column="1" Text="{x:Static vm:DeviceNames.Distance}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                   ToolTip="Sensor de espuma via distância" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ctl:ExternalDeviceChips Status="{Binding Status}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LiveDistanceText}" Style="{StaticResource NumericTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedReferenceMillimetres, TargetNullValue='—', StringFormat='F0'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding ReferenceMillimetresText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ValidationError}">
                                            <TextBox.Style>
                                                 <Style TargetType="TextBox" BasedOn="{StaticResource ConnectedExternalDeviceEntryStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="mm" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="0–999 mm" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ConnectedExternalDeviceToggleStyle}"
                                                  IsChecked="{Binding SensorEnabled, Mode=TwoWay}" ToolTip="Ativar sensor de distância/espuma" />
                                </Grid>

                                <!-- Dropdown Drawer: Distância -->
                                <Border Visibility="{Binding DataContext.IsExpandedDistance, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Distance/Foam controls -->
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <WrapPanel>
                                                <StackPanel Width="140" Margin="0,0,12,6">
                                                    <TextBlock Text="Atraso inicial (s)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Style="{StaticResource ConnectedExternalDeviceEntryStyle}"
                                                             Text="{Binding StartDelaySecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 a 3600 s" />
                                                </StackPanel>
                                                <StackPanel Width="130" Margin="0,0,12,6">
                                                    <TextBlock Text="Pulso (s)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Style="{StaticResource ConnectedExternalDeviceEntryStyle}"
                                                             Text="{Binding PulseSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s" />
                                                </StackPanel>
                                                <StackPanel Width="130" Margin="0,0,12,6">
                                                    <TextBlock Text="Intervalo (s)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Style="{StaticResource ConnectedExternalDeviceEntryStyle}"
                                                             Text="{Binding IntervalSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s" />
                                                </StackPanel>
                                            </WrapPanel>
                                            <TextBlock Text="ℹ O sensor de distância é utilizado como sensor de espuma e utiliza a bomba de nutrientes como atuador de antiespumante para controle da espuma."
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding ValidationError}" Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                                       Foreground="{DynamicResource StateAlarmTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" />

                                            <!-- Configuração do nó (Hub 10.2 / Nó v11) -->
                                            <Expander Header="Configuração do nó" Margin="0,10,0,0" IsExpanded="False"
                                                      ToolTip="{Binding NodeConfigUnavailableText}">
                                                <Expander.Style>
                                                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status.CanSend}" Value="True" />
                                                                    <Condition Binding="{Binding CanEditNodeConfig}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="IsEnabled" Value="True" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Expander.Style>
                                                <StackPanel Margin="0,8,0,0">
                                                    <WrapPanel>
                                                        <StackPanel Width="140" Margin="0,0,12,6">
                                                            <TextBlock Text="Offset (mm)" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="120" HorizontalAlignment="Left"
                                                                     Text="{Binding OffsetMmText, UpdateSourceTrigger=PropertyChanged}" ToolTip="-50 a 200 mm" />
                                                            <TextBlock Text="{Binding AppliedOffsetText, StringFormat='Telemetria: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="165" Margin="0,0,12,6">
                                                            <TextBlock Text="Período de amostragem (ms)" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="120" HorizontalAlignment="Left"
                                                                     Text="{Binding SamplePeriodMsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="100 a 60000 ms" />
                                                            <TextBlock Text="{Binding AppliedSamplePeriodMsText, StringFormat='Telemetria: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="165" Margin="0,0,12,6">
                                                            <TextBlock Text="Período de envio (ms)" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="120" HorizontalAlignment="Left"
                                                                     Text="{Binding SendPeriodMsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="100 a 60000 ms" />
                                                            <TextBlock Text="{Binding AppliedSendPeriodMsText, StringFormat='Telemetria: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Content="Enviar configuração do nó"
                                                                Command="{Binding SendNodeConfigCommand}"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="Restaurar padrões do nó"
                                                                Command="{Binding ResetNodeConfigCommand}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding NodeConfigValidationError}"
                                                               Visibility="{Binding NodeConfigValidationError, Converter={StaticResource NullToVis}}"
                                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                                               FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding NodeConfigSyncText}"
                                                               Visibility="{Binding IsNodeConfigSyncing, Converter={StaticResource BoolToVis}}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource StateWarningTextBrush}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding NodeConfigStatusText}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>

                                        <!-- Right: Sensor Health -->
                                        <StackPanel Grid.Column="1" MinWidth="260">
                                            <TextBlock Text="Saúde do Sensor" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ctl:SensorHealthView DataContext="{Binding DataContext.DistanceVariable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Rede: who the node is on the Hub's network (Hub 10.1). Own card below the drawer,
                                     same visibility, so the drawer's layout is untouched. -->
                                <Border Visibility="{Binding DataContext.IsExpandedDistance, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,0,8,8"
                                        Padding="14,2,14,10">
                                    <ctl:NodeNetworkPanel Status="{Binding DataContext.FoamControl.Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CanReachNodes="{Binding DataContext.IsHubOnWiFi, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          OpenCommand="{Binding DataContext.OpenNodeDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CopyCommand="{Binding DataContext.CopyNodeIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                            </StackPanel>

                            <!-- 10. Bomba Externa (roadmap) -->
                            <StackPanel DataContext="{Binding PumpControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedExternalPump, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações da bomba dosadora externa" />
                                    <ctl:StateDot Grid.Column="1" Size="8" VerticalAlignment="Center" Label="{x:Static vm:DeviceNames.ExternalPump}">
                                        <ctl:StateDot.State>
                                            <MultiBinding Converter="{StaticResource ExternalDeviceState}">
                                                <Binding Path="IsEnabled" />
                                                <Binding Path="Status.IsOffline" />
                                                <Binding Path="Status.ShowPendingChip" />
                                                <Binding Path="Status.ShowRoutingChipOnly" />
                                            </MultiBinding>
                                        </ctl:StateDot.State>
                                    </ctl:StateDot>
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Trailing spacer: keeps the chip beside the name it
                                                 describes rather than pinned to the cell's right edge,
                                                 where it read as though it belonged to Valor Lido. -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ctl:Icon Grid.Column="0" Key="Pump" Style="{StaticResource ProcessRowIconStyle}" />
                                        <!-- The name yields first. A chip pushed out of a horizontal
                                             stack would take the device's state with it, and the state
                                             is the part the operator cannot reconstruct. -->
                                        <TextBlock Grid.Column="1" Text="{x:Static vm:DeviceNames.ExternalPump}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                   ToolTip="Bomba peristáltica externa de alimentação" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ctl:ExternalDeviceChips Status="{Binding Status}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding PumpFlowText}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding PumpVolumeText}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <ComboBox Width="90"
                                                  Height="40"
                                                  ItemsSource="{Binding ModeOptions}"
                                                  SelectedItem="{Binding SelectedModeOption, Mode=TwoWay}"
                                                  DisplayMemberPath="Label"
                                                  ToolTip="Modo do perfil de dosagem">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                    <Setter Property="IsEnabled" Value="{Binding Status.IsOnline}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <ctl:ProvenanceBadge Text="{Binding OwnerBadgeText}" Explanation="{Binding OwnerLockReason}" Margin="4,0,0,0" Visibility="{Binding HasOwnerBadge, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="mL/min" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="5 perfis + gás prop." Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Ativar a bomba externa">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ConnectedExternalDeviceToggleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>
                                <Border Visibility="{Binding DataContext.IsExpandedExternalPump, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <!-- The pump cannot be commanded while its node is offline, so every
                                             input in the drawer stays disabled — and dimmed — until it reports
                                             online, the same rule as the row switch and the Enviar/Reverter
                                             buttons. Scoped here so it reaches the mode selector and each entry
                                             without repeating the binding on every control. -->
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ConnectedExternalDeviceEntryStyle}" />
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="IsEnabled" Value="{Binding Status.IsOnline}" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <!-- The primary row already carries on/off, live flow and volume.
                                         Keep only the node-specific diagnostics here so the drawer does not
                                         duplicate the row or present a second switch. -->
                                    <WrapPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding PumpTargetVolumeText, StringFormat='Alvo no nó: {0} mL'}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PumpModeText, StringFormat='Modo no nó: {0}'}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PumpRunStateText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <Button Content="Zerar volume" Command="{Binding ResetVolumeCommand}"
                                                Padding="8,2" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                                                ToolTip="Zera o volume acumulado registrado no nó da bomba (espera confirmação pela telemetria)" />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,12,0,0">
                                        <StackPanel Width="170" Margin="0,0,10,10">
                                            <TextBlock Text="Modo" Style="{StaticResource DosingFieldLabel}" />
                                            <ComboBox ItemsSource="{Binding ModeOptions}"
                                                      SelectedItem="{Binding SelectedModeOption, Mode=TwoWay}"
                                                      DisplayMemberPath="Label" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Tempo inicial (min)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding InitMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Minutos ≥ 0" />
                                        </StackPanel>
                                        <StackPanel Width="130" Margin="0,0,10,10">
                                            <TextBlock Text="Tempo final (min)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding FinalMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Maior que o inicial" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- Per-mode parameters -->
                                    <WrapPanel Visibility="{Binding ShowConstant, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Width="160" Margin="0,0,10,10">
                                            <TextBlock Text="λ (mL/min)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding LambdaConstText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Visibility="{Binding ShowLinear, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Width="160" Margin="0,0,10,10">
                                            <TextBlock Text="λ (mL/min)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding LambdaLinearText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="160" Margin="0,0,10,10">
                                            <TextBlock Text="φ (mL/min²)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding PhiLinearText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Visibility="{Binding ShowExponential, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Width="160" Margin="0,0,10,10">
                                            <TextBlock Text="λ (mL/min)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding LambdaExpText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="160" Margin="0,0,10,10">
                                            <TextBlock Text="φ (1/min)" Style="{StaticResource DosingFieldLabel}" />
                                            <TextBox Text="{Binding PhiExpText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <StackPanel Visibility="{Binding ShowPolynomial, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Coeficientes p0..p20 (vírgula)" Style="{StaticResource DosingFieldLabel}" />
                                        <TextBox Text="{Binding PolynomialCoefficientsText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="p0, p1, p2, … — até 21 valores, ordem crescente de grau"
                                                 Margin="0,0,0,10" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowPiecewise, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Tempos t0..tN [min] (vírgula; t0 = 0, crescentes)" Style="{StaticResource DosingFieldLabel}" />
                                        <TextBox Text="{Binding PiecewiseTimesText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                        <TextBlock Text="Vazões q0..qN [mL/min] (vírgula)" Style="{StaticResource DosingFieldLabel}" />
                                        <TextBox Text="{Binding PiecewiseFlowsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                    </StackPanel>

                                    <!-- Flow / accumulated-volume preview -->
                                    <ctl:PumpPreviewChart Preview="{Binding Preview}" PlotHeight="200" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding PeakFlowText, StringFormat='Pico: {0} mL/min'}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding TotalVolumeText, StringFormat='Volume total: {0} mL'}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Proportional-gas coupling: drives the air flow from the pump volume -->
                                    <Border Margin="0,12,0,0" Padding="12"
                                            Background="{DynamicResource SurfaceSunkenBrush}"
                                            CornerRadius="{DynamicResource RadiusSmall}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                              IsEnabled="{Binding Status.IsOnline}"
                                                              IsChecked="{Binding GasProportionalEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center" />
                                                <TextBlock Text="Gás proporcional — Q_g = (V₀ + Vol/1000)·vvm"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <WrapPanel Margin="0,10,0,0">
                                                <StackPanel Width="150" Margin="0,0,10,10">
                                                    <TextBlock Text="Vol. inicial V₀ (L)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Text="{Binding InitialVolumeText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Width="150" Margin="0,0,10,10">
                                                    <TextBlock Text="vvm" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Text="{Binding VvmText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Width="150" Margin="0,0,10,10">
                                                    <TextBlock Text="Q_g calculado (L/min)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBlock Text="{Binding GasFlowText}" Style="{StaticResource NumericTextStyle}" />
                                                </StackPanel>
                                            </WrapPanel>
                                            <TextBlock Text="Quando ativo, comanda a aeração pelo mesmo árbitro do controle manual/cascata. É recusado se a cascata detiver a aeração."
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="PID de volume do nó" Margin="0,8,0,0" IsExpanded="False">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="O nó fecha a malha sobre o volume estimado do ciclo (integral do perfil × volume integrado do duty). Corrige a execução, não a calibração. Padrões de fábrica: Kp 0,5 · Ki 0,05 · Kd 0,001."
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding PidUnavailableText}"
                                                       Visibility="{Binding PidUnavailableText, Converter={StaticResource NullToVis}}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource StateWarningTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <WrapPanel IsEnabled="{Binding CanEditPid}">
                                                <StackPanel Width="120" Margin="0,0,10,6">
                                                    <TextBlock Text="Kp" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Text="{Binding PidKpText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Width="120" Margin="0,0,10,6">
                                                    <TextBlock Text="Ki" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Text="{Binding PidKiText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Width="120" Margin="0,0,10,6">
                                                    <TextBlock Text="Kd" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Text="{Binding PidKdText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </WrapPanel>
                                            <DockPanel Margin="0,2,0,0">
                                                <Button DockPanel.Dock="Right" Content="Enviar PID" Command="{Binding SendPidCommand}" />
                                                <TextBlock Text="{Binding AppliedPidText}" VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Bench potentiometers: a calibration run locks them out on the node
                                         until the operator hands the motor back. -->
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Potenciômetros" Command="{Binding TogglePotentiometersCommand}"
                                                ToolTip="Alterna o comando manual de bancada. Ligar devolve o motor aos potenciômetros e esquece a velocidade manual; desligar trava os potenciômetros." />
                                        <TextBlock Text="{Binding PotentiometersText}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding ValidationError}"
                                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap" Margin="0,10,0,8" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                   Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    IsEnabled="{Binding Status.IsOnline}">
                                            <Button Content="Reverter" Command="{Binding RevertCommand}" Margin="0,0,6,0" />
                                            <Button Content="Enviar perfil" Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding ApplyProfileCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                                <!-- Rede: who the node is on the Hub's network (Hub 10.1). Own card below the drawer,
                                     same visibility, so the drawer's layout is untouched. -->
                                <Border Visibility="{Binding DataContext.IsExpandedExternalPump, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,0,8,8"
                                        Padding="14,2,14,10">
                                    <ctl:NodeNetworkPanel Status="{Binding DataContext.PumpControl.Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CanReachNodes="{Binding DataContext.IsHubOnWiFi, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          OpenCommand="{Binding DataContext.OpenNodeDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CopyCommand="{Binding DataContext.CopyNodeIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                            </StackPanel>

                            <!-- 11. Absorbância -->
                            <StackPanel DataContext="{Binding BiomassControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedBiomass, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações do sensor de biomassa" />
                                    <ctl:StateDot Grid.Column="1" Size="8" VerticalAlignment="Center" Label="Biomassa">
                                        <ctl:StateDot.State>
                                            <MultiBinding Converter="{StaticResource ExternalDeviceState}">
                                                <Binding Path="IsEnabled" />
                                                <Binding Path="Status.IsOffline" />
                                                <Binding Path="Status.ShowPendingChip" />
                                                <Binding Path="Status.ShowRoutingChipOnly" />
                                            </MultiBinding>
                                        </ctl:StateDot.State>
                                    </ctl:StateDot>
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ctl:Icon Grid.Column="0" Key="Biomass" Style="{StaticResource ProcessRowIconStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Static vm:DeviceNames.Absorbance}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                   ToolTip="Sensor óptico de biomassa (absorbância)" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ctl:ExternalDeviceChips Status="{Binding Status}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding AbsorbanceText}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding RawText}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBox Width="90"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding OptimalThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Limiar ótimo: maior que o baixo e menor que o alto">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ConnectedExternalDeviceEntryStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <ctl:ProvenanceBadge Text="{Binding OwnerBadgeText}" Explanation="{Binding OwnerLockReason}" Margin="4,0,0,0" Visibility="{Binding HasOwnerBadge, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="AU" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="Abs / Raw / IT / PWM" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Ativar o sensor de biomassa">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ConnectedExternalDeviceToggleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>

                                <!-- Dropdown Drawer: Biomassa -->
                                <Border Visibility="{Binding DataContext.IsExpandedBiomass, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Biomass settings -->
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <!-- Live readouts -->
                                            <WrapPanel>
                                                <StackPanel Width="110" Margin="0,0,10,10">
                                                    <TextBlock Text="Abs (AU)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBlock Text="{Binding AbsorbanceText}" Style="{StaticResource NumericTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Width="110" Margin="0,0,10,10">
                                                    <TextBlock Text="Raw" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBlock Text="{Binding RawText}" Style="{StaticResource NumericTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Width="110" Margin="0,0,10,10">
                                                    <TextBlock Text="IT (ms)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBlock Text="{Binding IntegrationTimeText}" Style="{StaticResource NumericTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Width="110" Margin="0,0,10,10">
                                                    <TextBlock Text="PWM (%)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBlock Text="{Binding PwmText}" Style="{StaticResource NumericTextStyle}" />
                                                </StackPanel>
                                            </WrapPanel>

                                            <!-- Momentary actions (enabled only while the sensor is on) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="Capturar branco" Command="{Binding BlankCommand}" Margin="0,0,6,0" />
                                                <Button Content="Iniciar" Command="{Binding StartCommand}" Margin="0,0,6,0" />
                                                <Button Content="Parar" Command="{Binding StopCommand}" />
                                            </StackPanel>

                                            <!-- Integration thresholds (raw counts), applied atomically -->
                                            <WrapPanel Margin="0,14,0,0">
                                                <StackPanel Width="150" Margin="0,0,10,10">
                                                    <TextBlock Text="Limiar baixo" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Style="{StaticResource ConnectedExternalDeviceEntryStyle}"
                                                             Text="{Binding LowThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Contagens brutas; menor que o alto" />
                                                </StackPanel>
                                                <StackPanel Width="150" Margin="0,0,10,10">
                                                    <TextBlock Text="Limiar alto" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Style="{StaticResource ConnectedExternalDeviceEntryStyle}"
                                                             Text="{Binding HighThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Contagens brutas; maior que o baixo" />
                                                </StackPanel>
                                                <StackPanel Width="150" Margin="0,0,10,10">
                                                    <TextBlock Text="Limiar ótimo" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Style="{StaticResource ConnectedExternalDeviceEntryStyle}"
                                                             Text="{Binding OptimalThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Contagens brutas; entre baixo e alto" />
                                                </StackPanel>
                                                <!-- The buttons act on the three fields beside them, so they sit
                                                     on the same line, aligned with the text boxes. -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,10,10"
                                                            IsEnabled="{Binding Status.IsOnline}">
                                                    <Button Content="Reverter" Command="{Binding RevertCommand}" Margin="0,0,6,0" />
                                                    <Button Content="Enviar limiares" Style="{StaticResource AccentButtonStyle}"
                                                            Command="{Binding ApplyThresholdsCommand}" />
                                                </StackPanel>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding ValidationError}"
                                                       Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                                       Foreground="{DynamicResource StateAlarmTextBrush}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />

                                            <Expander Header="Parâmetros de aquisição" Margin="0,10,0,0" IsExpanded="False">
                                                <StackPanel Margin="0,8,0,0">
                                                    <WrapPanel>
                                                        <StackPanel Width="130" Margin="0,0,10,6">
                                                            <TextBlock Text="IT (ms)" Style="{StaticResource DosingFieldLabel}" />
                                                            <!-- A list, not a free field: the wire takes a code 0..5, and the six
                                                                 times are the only values that code can name. -->
                                                            <ComboBox Width="110" HorizontalAlignment="Left"
                                                                      ItemsSource="{Binding IntegrationTimeOptions}"
                                                                      SelectedItem="{Binding SelectedIntegrationTimeMs, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanEditAcquisition}"
                                                                      ToolTip="Tempo de integração do VEML7700 aplicado ao slot de IT selecionado pela marcha" />
                                                            <TextBlock Text="{Binding AppliedITText, StringFormat='Nó: {0} ms'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="130" Margin="0,0,10,6">
                                                            <TextBlock Text="PWM (%)" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="110" HorizontalAlignment="Left"
                                                                     Text="{Binding AcquisitionPwmText, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding CanEditAcquisition}" ToolTip="0.0 a 100.0 %" />
                                                            <TextBlock Text="{Binding AppliedPwmText, StringFormat='Nó: {0} %'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="190" Margin="0,0,10,6">
                                                            <TextBlock Text="Marcha óptica (slot IT × slot PWM)" Style="{StaticResource DosingFieldLabel}" />
                                                            <!-- The operator picks the two slots; the view model does IT × 8 + PWM.
                                                                 Order matters downstream: set_gear goes first, then set_it and
                                                                 set_pwm land on the slots this marcha selected. -->
                                                            <StackPanel Orientation="Horizontal">
                                                                <ComboBox Width="60" ItemsSource="{Binding GearItSlots}"
                                                                          SelectedItem="{Binding GearItSlot, Mode=TwoWay}"
                                                                          IsEnabled="{Binding CanEditAcquisition}" ToolTip="Slot de tempo de integração (0..3)" />
                                                                <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0" />
                                                                <ComboBox Width="60" ItemsSource="{Binding GearPwmSlots}"
                                                                          SelectedItem="{Binding GearPwmSlot, Mode=TwoWay}"
                                                                          IsEnabled="{Binding CanEditAcquisition}" ToolTip="Slot de PWM do LED (0..7)" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding GearPreviewText}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                                <Run Text="Nó: marcha " /><Run Text="{Binding AppliedGearText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding AppliedGearDetailText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Width="130" Margin="0,0,10,6">
                                                            <TextBlock Text="Fator EMA" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="110" HorizontalAlignment="Left"
                                                                     Text="{Binding AcquisitionEmaFactorText, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding CanEditAcquisition}" ToolTip="0.01 a 1.00" />
                                                            <TextBlock Text="{Binding AppliedEmaText, StringFormat='Nó: {0}'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Width="140" Margin="0,0,10,6">
                                                            <TextBlock Text="Período sonda (ms)" Style="{StaticResource DosingFieldLabel}" />
                                                            <TextBox Width="110" HorizontalAlignment="Left"
                                                                     Text="{Binding AcquisitionProbePeriodMsText, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding CanEditAcquisition}" ToolTip="100 a 3600000 ms; o firmware pode elevar ao piso térmico seguro" />
                                                            <TextBlock Text="{Binding AppliedProbePeriodText, StringFormat='Nó: {0} ms'}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Content="Gravar no nó"
                                                                Command="{Binding ApplyAcquisitionCommand}"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="Reverter"
                                                                Command="{Binding RevertAcquisitionCommand}"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="Cancelar envio"
                                                                Command="{Binding CancelAcquisitionCommand}"
                                                                Visibility="{Binding CanCancelAcquisition, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding AcquisitionValidationError}"
                                                               Visibility="{Binding AcquisitionValidationError, Converter={StaticResource NullToVis}}"
                                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                                               FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" />
                                                    <TextBlock Text="Alterar IT ou PWM modifica a tabela óptica e invalida o branco armazenado; refaça a captura de branco antes de medir."
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource StateWarningTextBrush}"
                                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Text="Auto-range" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                                  IsChecked="{Binding IsAutoRange, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanActuate}"
                                                                  ToolTip="Ligado: o nó procura sozinho a marcha quando o sinal sai da faixa. Desligado: a marcha gravada fica travada. Gravar uma marcha desliga o auto-range." />
                                                        <TextBlock Text="{Binding AutoRangeModeText}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>

                                        <!-- Right: Calibration & Sensor Health -->
                                        <StackPanel Grid.Column="1" MinWidth="260">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Calibração" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Button Content="Calibrar Biomassa" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.OpenCalibrationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="biomass" />
                                            </StackPanel>
                                            <TextBlock Text="Saúde do Sensor" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ctl:SensorHealthView DataContext="{Binding DataContext.BiomassVariable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Rede: who the node is on the Hub's network (Hub 10.1). Own card below the drawer,
                                     same visibility, so the drawer's layout is untouched. -->
                                <Border Visibility="{Binding DataContext.IsExpandedBiomass, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,0,8,8"
                                        Padding="14,2,14,10">
                                    <ctl:NodeNetworkPanel Status="{Binding DataContext.BiomassControl.Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CanReachNodes="{Binding DataContext.IsHubOnWiFi, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          OpenCommand="{Binding DataContext.OpenNodeDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CopyCommand="{Binding DataContext.CopyNodeIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                            </StackPanel>

                            <!-- 12. Frasco Agitador -->
                            <StackPanel DataContext="{Binding FlaskAgitator}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedFlaskAgitator, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações do agitador de frasco" />
                                    <ctl:StateDot Grid.Column="1" Size="8" VerticalAlignment="Center" Label="Frasco Agitador">
                                        <ctl:StateDot.State>
                                            <MultiBinding Converter="{StaticResource ExternalDeviceState}">
                                                <Binding Path="IsEnabled" />
                                                <Binding Path="Status.IsOffline" />
                                                <Binding Path="Status.ShowPendingChip" />
                                                <Binding Path="Status.ShowRoutingChipOnly" />
                                            </MultiBinding>
                                        </ctl:StateDot.State>
                                    </ctl:StateDot>
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Trailing spacer: keeps the chip beside the name it
                                                 describes rather than pinned to the cell's right edge,
                                                 where it read as though it belonged to Valor Lido. -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ctl:Icon Grid.Column="0" Key="Impeller" Style="{StaticResource ProcessRowIconStyle}" />
                                        <!-- The name yields first. A chip pushed out of a horizontal
                                             stack would take the device's state with it, and the state
                                             is the part the operator cannot reconstruct. -->
                                        <TextBlock Grid.Column="1" Text="Frasco Agitador" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                   ToolTip="Dispositivo de bancada separado" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ctl:ExternalDeviceChips Status="{Binding Status}" />
                                            <!-- The knob outranks the app whenever it is live, so this
                                                 cannot be a tooltip: the staged percent beside it is not
                                                 what the motor holds. -->
                                            <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                                    BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1"
                                                    ToolTip="{Binding PotentiometerWarning}"
                                                    Visibility="{Binding IsPotentiometerInControl, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="potenciômetro" FontSize="10"
                                                           Foreground="{DynamicResource StateWarningTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- The node's reported magnitude, not the staged one. This column is
                                                 headed "Valor Lido"; showing what the operator typed there was the
                                                 same defect this whole change set exists to remove, and it is now
                                                 fixable because the node actually reports. -->
                                            <TextBlock Text="{Binding ActualPercentText}" Style="{StaticResource NumericTextStyle}" />
                                            <TextBlock Text="%" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedMagnitudePercent, TargetNullValue='—', StringFormat='F0'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding MagnitudePercentText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ValidationError}">
                                            <TextBox.Style>
                                                  <Style TargetType="TextBox" BasedOn="{StaticResource ConnectedExternalDeviceEntryStyle}">
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                             <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                             <Setter Property="BorderThickness" Value="2" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                             <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                             <Setter Property="BorderThickness" Value="2" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                             <Setter Property="IsEnabled" Value="False" />
                                                             <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                            </TextBox.Style>
                                         </TextBox>
                                         <ctl:ProvenanceBadge Text="{Binding OwnerBadgeText}" Explanation="{Binding OwnerLockReason}" Margin="4,0,0,0" Visibility="{Binding HasOwnerBadge, Converter={StaticResource BoolToVis}}" />
                                     </StackPanel>
                                     <TextBlock Grid.Column="6" Text="%" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                     <TextBlock Grid.Column="7" Text="0–100 %" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                     <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Ligar o agitador de frasco">
                                         <ToggleButton.Style>
                                             <Style TargetType="ToggleButton" BasedOn="{StaticResource ConnectedExternalDeviceToggleStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>

                                <!-- Dropdown Drawer: Frasco Agitador -->
                                <Border Visibility="{Binding DataContext.IsExpandedFlaskAgitator, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <Grid Margin="0,2,0,0" IsEnabled="{Binding Status.IsOnline}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Intensidade (%)" Style="{StaticResource DosingFieldLabel}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Minimum="0" Maximum="100"
                                                            Style="{StaticResource AppSliderStyle}"
                                                            VerticalAlignment="Center"
                                                            Value="{Binding MagnitudePercent, Mode=TwoWay}"
                                                            ToolTip="Magnitude 0–100; o sentido é enviado separadamente" />
                                                    <TextBox Grid.Column="1" Width="56" Margin="10,0,0,0"
                                                             Style="{StaticResource ConnectedExternalDeviceEntryStyle}"
                                                             Text="{Binding MagnitudePercentText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="0–100%" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="Sentido" Style="{StaticResource DosingFieldLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <RadioButton Content="Horário"
                                                                 IsChecked="{Binding Clockwise, Mode=TwoWay}"
                                                                 VerticalAlignment="Center" />
                                                    <RadioButton Content="Anti-horário"
                                                                 Margin="12,0,0,0"
                                                                 IsChecked="{Binding CounterClockwise, Mode=TwoWay}"
                                                                 VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Automação por espuma" Style="{StaticResource DosingFieldLabel}" />
                                                <ToggleButton Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0"
                                                              IsChecked="{Binding IsAutomatic, Mode=TwoWay}"
                                                              ToolTip="Permite que o Hub acione o agitador automaticamente pela lógica do sensor de distância/espuma. O potenciômetro é o comando manual local." />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding ValidationError}"
                                                   Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                                   Foreground="{DynamicResource StateAlarmTextBrush}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextWrapping="Wrap" Margin="0,8,0,4" />
                                        <!-- Read-back from the node. Empty against a Hub without the
                                             /agitatorData handler, which is honest: that Hub knows nothing
                                             about this device and the row says so. -->
                                        <Border Margin="0,10,0,0" Padding="10,8"
                                                Background="{DynamicResource SurfaceSunkenBrush}"
                                                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSmall}">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding ActualPercentText, StringFormat='Telemetria: {0} %'}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding ActualDirectionText, StringFormat='Sentido: {0}'}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding ActualSourceText, StringFormat='Comandado por: {0}'}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding PotentiometerWarning}"
                                                           Visibility="{Binding PotentiometerWarning, Converter={StaticResource NullToVis}}"
                                                           Foreground="{DynamicResource StateWarningTextBrush}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding Status.StatusText}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Reativar potenciômetro"
                                                    Command="{Binding ReEnablePotCommand}"
                                                    ToolTip="Devolve o controle ao potenciômetro de bancada. A parada segura o bloqueia." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Rede: who the node is on the Hub's network (Hub 10.1). Own card below the drawer,
                                     same visibility, so the drawer's layout is untouched. -->
                                <Border Visibility="{Binding DataContext.IsExpandedFlaskAgitator, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,0,8,8"
                                        Padding="14,2,14,10">
                                    <ctl:NodeNetworkPanel Status="{Binding DataContext.FlaskAgitator.Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CanReachNodes="{Binding DataContext.IsHubOnWiFi, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          OpenCommand="{Binding DataContext.OpenNodeDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CopyCommand="{Binding DataContext.CopyNodeIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action & Safety Bar -->
            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Presets take the slack, safety takes what it needs: an Auto
                                 column is measured before a star one, so "Parada segura" can
                                 never be the control pushed off the edge in a narrow window. -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Predefinições Group -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Predefinição:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox MinWidth="130" MaxWidth="200"
                                      ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                      Margin="0,0,6,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Carregar"
                                    ToolTip="Carregar valores da predefinição selecionada"
                                    Command="{Binding LoadPresetCommand}"
                                    Margin="0,0,6,0" />
                            <Button Content="Salvar como..."
                                    ToolTip="Salvar configuração atual em uma nova predefinição"
                                    Command="{Binding SavePresetCommand}"
                                    Margin="0,0,16,0" />
                        </StackPanel>

                        <!-- Spacer -->
                        <Grid Grid.Column="1" />

                        <!-- Parada Segura / Emergência -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Segurança:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button Content="Parada segura"
                                    ToolTip="Desliga todos os atuadores com segurança"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding SafeStopCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Margin="2,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
