<UserControl x:Class="TecnalHub.Controls.RangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             Height="24" Focusable="True">

    <UserControl.Resources>
        <ControlTemplate x:Key="RangeSliderThumbTemplate" TargetType="Thumb">
            <Border x:Name="ThumbBorder"
                    Width="16" Height="16"
                    CornerRadius="8"
                    Background="{Binding ThumbBrush, ElementName=Root}"
                    BorderBrush="{Binding RangeBrush, ElementName=Root}"
                    BorderThickness="2.5"
                    Cursor="SizeWE"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" />
                </Border.Effect>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbBorder" Property="Width" Value="18" />
                    <Setter TargetName="ThumbBorder" Property="Height" Value="18" />
                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="9" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbBorder" Property="Width" Value="18" />
                    <Setter TargetName="ThumbBorder" Property="Height" Value="18" />
                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="9" />
                    <Setter TargetName="ThumbBorder" Property="BorderThickness" Value="3" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid x:Name="TrackGrid" VerticalAlignment="Center" Height="24" Background="Transparent">
        <!-- Background Track -->
        <Border Height="4" Margin="8,0"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                BorderThickness="1"
                CornerRadius="2"
                VerticalAlignment="Center" />

        <Canvas x:Name="SliderCanvas" Height="24" VerticalAlignment="Center" ClipToBounds="False">
            <!-- Selected Range Bar -->
            <Border x:Name="RangeHighlight"
                    Height="4"
                    Canvas.Top="10"
                    CornerRadius="2"
                    Background="{Binding RangeBrush, ElementName=Root}"
                    Cursor="Hand" />

            <!-- Lower Thumb -->
            <Thumb x:Name="LowerThumb"
                   Canvas.Top="4"
                   Template="{StaticResource RangeSliderThumbTemplate}"
                   DragDelta="OnLowerThumbDragDelta"
                   DragStarted="OnThumbDragStarted"
                   DragCompleted="OnThumbDragCompleted" />

            <!-- Upper Thumb -->
            <Thumb x:Name="UpperThumb"
                   Canvas.Top="4"
                   Template="{StaticResource RangeSliderThumbTemplate}"
                   DragDelta="OnUpperThumbDragDelta"
                   DragStarted="OnThumbDragStarted"
                   DragCompleted="OnThumbDragCompleted" />
        </Canvas>
    </Grid>
</UserControl>
