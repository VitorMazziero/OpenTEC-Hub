<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stand-in for the ESP32-S3 and the bioreactor behind it. Speaks the documented
    PC-side protocol over HTTP (localhost, no setup) or serial (virtual COM pair).

    Not shipped. It is a development and control-tuning instrument - see
    docs/SIMULATOR.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TecnalHub.Simulator</RootNamespace>
    <AssemblyName>tecnal-simulator</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shares the protocol assembly so the simulator's wire format is held to the
         same golden-string tests as the app's. A simulator that drifted from the
         contract would quietly certify a broken client. -->
    <ProjectReference Include="..\TecnalHub.Protocol\TecnalHub.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

</Project>
