<UserControl x:Class="TecnalHub.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EventsViewModel}">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}">
            <WrapPanel>
                <ComboBox Width="145" ItemsSource="{Binding SourceOptions}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}" />
                <ComboBox Width="155" Margin="8,0,0,0" ItemsSource="{Binding SeverityOptions}"
                          SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}" />
                <TextBox Width="190" Margin="8,0,0,0" ToolTip="Pesquisar mensagem ou detalhe"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Seguir novas entradas" Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding FollowNewEntries, Mode=TwoWay}" />
                <CheckBox Content="Pausar" Margin="14,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsPaused, Mode=TwoWay}" />
                <Button Content="Copiar" Margin="14,0,0,0" Command="{Binding CopySelectedCommand}" />
                <Button Content="Exportar" Margin="8,0,0,0" Command="{Binding ExportVisibleCommand}" />
                <Button Content="Limpar visualização" Margin="8,0,0,0" Command="{Binding ClearViewCommand}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="8"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}">
            <ListView x:Name="EventList" ItemsSource="{Binding VisibleEvents}"
                      SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                      AutomationProperties.Name="Eventos da aplicação">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Hora" Width="92" DisplayMemberBinding="{Binding TimestampText}" />
                        <GridViewColumn Header="Fonte" Width="105" DisplayMemberBinding="{Binding SourceLabel}" />
                        <GridViewColumn Header="Severidade" Width="92" DisplayMemberBinding="{Binding SeverityLabel}" />
                        <GridViewColumn Header="Mensagem" Width="620" DisplayMemberBinding="{Binding Message}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVis}}">
            <StackPanel>
                <TextBlock Text="Detalhe / bytes exatos" FontWeight="SemiBold" />
                <TextBox Text="{Binding SelectedEvent.Detail, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="{DynamicResource FontMono}" TextWrapping="Wrap"
                         MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="12"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StateIdleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogging}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource StateOkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding LoggingStateText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SessionRowsText, StringFormat=' · {0} linhas'}"
                               Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding SessionSizeText, StringFormat=' · {0}'}"
                               Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding SessionPathText}" Margin="16,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextStyle}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Iniciar / parar" Command="{Binding ToggleLoggingCommand}" />
                    <Button Content="Novo arquivo" Margin="8,0,0,0" Command="{Binding NewSessionFileCommand}" />
                    <Button Content="Abrir pasta" Margin="8,0,0,0" Command="{Binding OpenSessionFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}" HorizontalAlignment="Left"
                   Margin="4,6,0,0" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextStyle}" />
    </Grid>
</UserControl>
