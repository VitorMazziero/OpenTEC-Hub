<UserControl x:Class="TecnalHub.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:ctl="clr-namespace:TecnalHub.Controls"
             xmlns:views="clr-namespace:TecnalHub.Views"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ControlViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <Style x:Key="DosingFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="RowExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSmall}">
                            <Path x:Name="Chevron"
                                  Data="M 0 0 L 4 4.5 L 8 0"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Controle"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Text="Confira e aplique toda a configuração do ensaio e dos parâmetros de cultivo."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                    <!-- Unified Process Parameters Card -->
                    <Border Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource StrokeDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Padding="16,14">
                        <StackPanel>

                            <!-- Section 1: Parâmetros do processo -->
                            <TextBlock Text="Parâmetros do processo"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,10" />

                            <!-- Table Header -->
                            <Grid Margin="0,0,0,6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="Variável" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Valor Lido" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Setpoint" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="Novo Setpoint" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="Unidade" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="Faixa" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="8" Text="Ativo" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource StrokeDefaultBrush}" Margin="0,0,0,6" />

                            <!-- 1. Agitação -->
                            <Grid Margin="0,4" VerticalAlignment="Center" DataContext="{Binding AgitationRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ctl:StateDot Grid.Column="1" State="{Binding Subsystem.Variable.State}" Size="8" VerticalAlignment="Center" Label="{Binding Subsystem.DisplayName}" />
                                <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.OpenVariableFromControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Subsystem.Variable}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:Icon Key="{Binding IconKey}" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Subsystem.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Subsystem.Description}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}" Style="{StaticResource NumericTextStyle}" />
                                        <TextBlock Text="{Binding Subsystem.Unit}" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ctl:ProvenanceBadge Text="comandado" Visibility="{Binding Subsystem.Variable.IsCommandedOnly, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Subsystem.FormattedAppliedSetpoint}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="90" VerticalAlignment="Center"
                                             Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding Subsystem.ValidationError}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOverriddenByCascade}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="Controle bloqueado pela cascata de oxigênio." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <ctl:ProvenanceBadge Text="cascata" Margin="4,0,0,0" Visibility="{Binding IsOverriddenByCascade, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="6" Text="{Binding Subsystem.Unit}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="7" Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subsystem.RangeHint}" />
                                <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding EffectiveActive, Mode=TwoWay}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverriddenByCascade}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="ToolTip" Value="Controlado pela cascata de oxigênio." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>

                            <!-- 2. Temperatura -->
                            <Grid Margin="0,4" VerticalAlignment="Center" DataContext="{Binding TemperatureRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ctl:StateDot Grid.Column="1" State="{Binding Subsystem.Variable.State}" Size="8" VerticalAlignment="Center" Label="{Binding Subsystem.DisplayName}" />
                                <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.OpenVariableFromControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Subsystem.Variable}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:Icon Key="{Binding IconKey}" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Subsystem.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Subsystem.Description}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}" Style="{StaticResource NumericTextStyle}" />
                                        <TextBlock Text="{Binding Subsystem.Unit}" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Subsystem.FormattedAppliedSetpoint}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="90" VerticalAlignment="Center"
                                             Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding Subsystem.ValidationError}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                                <TextBlock Grid.Column="6" Text="{Binding Subsystem.Unit}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="7" Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subsystem.RangeHint}" />
                                <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding EffectiveActive, Mode=TwoWay}" ToolTip="Habilitar controle de temperatura" />
                            </Grid>

                            <!-- 3. pH (com dropdown) -->
                            <StackPanel DataContext="{Binding PHControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedPH, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações detalhadas de pH" />
                                    <ctl:StateDot Grid.Column="1" State="Ok" Size="8" VerticalAlignment="Center" Label="pH" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ctl:Icon Key="Ph" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="pH" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LivePHText}" Style="{StaticResource NumericTextStyle}" />
                                        <TextBlock Text="pH" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedSetpoint, TargetNullValue='—', StringFormat='F2'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="pH" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="1,00–14,00" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Habilitar controle de pH" />
                                </Grid>

                                <!-- Dropdown Drawer: pH -->
                                <Border Visibility="{Binding DataContext.IsExpandedPH, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <WrapPanel>
                                            <StackPanel Width="130" Margin="0,0,12,6">
                                                <TextBlock Text="Histerese (±)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding InactiveBandText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Banda inativa: 0,01 a 2,00 pH" />
                                            </StackPanel>
                                            <StackPanel Width="140" Margin="0,0,12,6">
                                                <TextBlock Text="Operação da bomba (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding OperationSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s" />
                                            </StackPanel>
                                            <StackPanel Width="130" Margin="0,0,12,6">
                                                <TextBlock Text="Mistura (s)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding MixSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s" />
                                            </StackPanel>
                                            <StackPanel Width="130" Margin="0,0,12,6">
                                                <TextBlock Text="Intensidade (%)" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBox Text="{Binding PumpSpeedPercentText, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 a 99%" />
                                            </StackPanel>
                                            <StackPanel Width="100" Margin="0,0,12,6" VerticalAlignment="Center">
                                                <TextBlock Text="Leitura Bruta" Style="{StaticResource DosingFieldLabel}" />
                                                <TextBlock Text="{Binding LiveRawText, StringFormat='Raw: {0}'}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ValidationError}" Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                                   Foreground="{DynamicResource StateAlarmTextBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 4. Pressão -->
                            <Grid Margin="0,4" VerticalAlignment="Center" DataContext="{Binding PressureRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ctl:StateDot Grid.Column="1" State="{Binding Subsystem.Variable.State}" Size="8" VerticalAlignment="Center" Label="{Binding Subsystem.DisplayName}" />
                                <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.OpenVariableFromControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Subsystem.Variable}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:Icon Key="{Binding IconKey}" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Subsystem.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Subsystem.Description}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}" Style="{StaticResource NumericTextStyle}" />
                                        <TextBlock Text="{Binding Subsystem.Unit}" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Subsystem.FormattedAppliedSetpoint}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="90" VerticalAlignment="Center"
                                             Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding Subsystem.ValidationError}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                                <TextBlock Grid.Column="6" Text="{Binding Subsystem.Unit}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="7" Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subsystem.RangeHint}" />
                                <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding EffectiveActive, Mode=TwoWay}" ToolTip="Habilitar controle de pressão" />
                            </Grid>

                            <!-- 5. Oxigênio -->
                            <Grid Margin="0,4" VerticalAlignment="Center" DataContext="{Binding OxygenRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ctl:StateDot Grid.Column="1" State="{Binding Subsystem.Variable.State}" Size="8" VerticalAlignment="Center" Label="{Binding Subsystem.DisplayName}" />
                                <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.OpenVariableFromControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Subsystem.Variable}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:Icon Key="{Binding IconKey}" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Subsystem.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Subsystem.Description}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}" Style="{StaticResource NumericTextStyle}" />
                                        <TextBlock Text="{Binding Subsystem.Unit}" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="—" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                
                                <!-- Modo + Engrenagem juntos ocupando a largura padrão (90px) -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Width="90" HorizontalAlignment="Left">
                                    <ComboBox ItemsSource="{Binding OxygenModeOptions}"
                                              SelectedItem="{Binding SelectedOxygenMode}"
                                              IsEnabled="{Binding CanEditOxygenMode}"
                                              Width="62"
                                              ToolTip="Modo: Agitação, Aeração, Cascata ou Mapa"
                                              VerticalAlignment="Center" />
                                    <Button Margin="4,0,0,0"
                                            Padding="4,3"
                                            Width="24" Height="26"
                                            ToolTip="Configuração do Controle de Oxigênio"
                                            Command="{Binding DataContext.OpenOxygenConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ctl:Icon Key="Gear" Size="13" />
                                    </Button>
                                </StackPanel>
                                
                                <TextBlock Grid.Column="6" Text="{Binding Subsystem.Unit}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="7" Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subsystem.RangeHint}" />
                                <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsCascadeEngaged, Mode=TwoWay}"
                                              ToolTip="Ativa o controle automático de oxigênio (cascata)." />
                            </Grid>

                            <!-- 6. Dosagem de Nutrientes (com dropdown) -->
                            <StackPanel DataContext="{Binding NutrientControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedNutrient, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
