<UserControl x:Class="TecnalHub.Views.SynopticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             d:DesignWidth="760" d:DesignHeight="620"
             AutomationProperties.Name="Sinóptico operacional do biorreator">

    <!--
        The equipment render is deliberately neutral: it contains no liquid level,
        colour-coded state, text or commanded value. Every operational fact remains a
        native WPF overlay so it can theme, update, focus and expose automation text.

        The overlay uses a calibrated 600 x 470 coordinate space. Normalized source
        anchors live beside the PNG in Resources/Images/reactor-anchors.json so a future
        render can be replaced without guessing what each leader line represents.
    -->
    <UserControl.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="InstrumentTagTemplate">
            <StackPanel Width="116">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="13,1,0,0">
                    <TextBlock Text="{Binding FormattedValue}"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="17" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{Binding Unit}" Margin="4,0,0,2"
                               VerticalAlignment="Bottom" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Text="COMANDO SEM FEEDBACK" Margin="13,2,0,0"
                           FontSize="7.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding IsCommandedOnly,
                                                Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Compact, keyboard-accessible instrument card pinned to real hardware. -->
        <Style x:Key="InstrumentTagStyle" TargetType="Button">
            <Setter Property="Width" Value="132" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="ContentTemplate" Value="{StaticResource InstrumentTagTemplate}" />
            <Setter Property="AutomationProperties.HelpText"
                    Value="Seleciona a variável e abre seus detalhes operacionais" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Local process identity remains visible even when the detail pane changes. -->
        <Border Grid.Row="0" Padding="16,12"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="RESUMO DO BIORREATOR"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Visão física · leituras e comandos ao vivo"
                               Margin="0,2,0,0" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding SystemState,
                                                Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding SystemStateText}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastUpdateText,
                                              StringFormat='Atualização: {0}'}"
                               HorizontalAlignment="Right" Margin="0,2,0,0"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Cards on the left (Two columns) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,32,0">
                    
                    <!-- First Column -->
                    <StackPanel Margin="0,0,8,0">
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Motor}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Rotação comandada; sem realimentação de RPM"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="motor" Margin="0,0,0,8" />
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Temperature}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Temperatura do processo e da camisa térmica"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="temperature" Margin="0,0,0,8" />
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Ph}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Sonda de pH"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="ph" Margin="0,0,0,8" />
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Oxygen}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Sonda de oxigênio dissolvido"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="oxygen" Margin="0,0,0,8" />
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Pressure}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Pressão do headspace"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="pressure" Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- Second Column -->
                    <StackPanel>
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Nutrient}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Dosagem de nutriente (comando sem realimentação)"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="nutrient" Margin="0,0,0,8" />
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Antifoam}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Dosagem de antiespumante"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="antifoam" Margin="0,0,0,8" />
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Flow}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Aeração pelo sparger anular"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="flow" Margin="0,0,0,8" />
                        <Button Style="{StaticResource InstrumentTagStyle}"
                                DataContext="{Binding Level}" Content="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip="Sensor de nível/espuma (distância)"
                                Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="level" />
                    </StackPanel>
                </StackPanel>

                <Canvas Grid.Column="1" Width="312" Height="470">
                    <!-- Equipment bay: a token-driven stage behind the transparent asset. -->
                    <Border Canvas.Left="0" Canvas.Top="2" Width="312" Height="466"
                            CornerRadius="150"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource StrokeSubtleBrush}"
                            BorderThickness="1" Opacity="0.72" />

                    <!-- Bundled fallback shown only if the raster resource cannot decode. -->
                    <Canvas x:Name="VectorFallback" Visibility="Collapsed"
                            IsHitTestVisible="False" Canvas.Left="-144" Canvas.Top="0">
                        <Border Canvas.Left="190" Canvas.Top="130" Width="220" Height="250"
                                CornerRadius="32" BorderThickness="6"
                                BorderBrush="{DynamicResource StrokeStrongBrush}"
                                Background="Transparent" />
                        <Border Canvas.Left="199" Canvas.Top="140" Width="202" Height="230"
                                CornerRadius="26" BorderThickness="2"
                                BorderBrush="{DynamicResource TextSecondaryBrush}"
                                Background="{DynamicResource SurfaceSunkenBrush}" />
                        <Rectangle Canvas.Left="180" Canvas.Top="117" Width="240" Height="16"
                                   RadiusX="5" RadiusY="5"
                                   Fill="{DynamicResource StrokeStrongBrush}" />
                        <Border Canvas.Left="266" Canvas.Top="20" Width="68" Height="82"
                                CornerRadius="8" BorderThickness="2"
                                BorderBrush="{DynamicResource StrokeStrongBrush}"
                                Background="{DynamicResource SurfaceElevatedBrush}" />
                        <Rectangle Canvas.Left="296" Canvas.Top="98" Width="8" Height="210"
                                   Fill="{DynamicResource TextSecondaryBrush}" />
                        <Rectangle Canvas.Left="261" Canvas.Top="222" Width="78" Height="7"
                                   RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource TextSecondaryBrush}" />
                        <Rectangle Canvas.Left="261" Canvas.Top="286" Width="78" Height="7"
                                   RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource TextSecondaryBrush}" />
                        <Ellipse Canvas.Left="249" Canvas.Top="336" Width="102" Height="18"
                                 Stroke="{DynamicResource PathGasBrush}" StrokeThickness="3"
                                 Fill="Transparent" />
                        <Polyline Points="350,345 382,345 382,128"
                                  Stroke="{DynamicResource PathGasBrush}" StrokeThickness="2"
                                  Fill="Transparent" />
                        <Rectangle Canvas.Left="237" Canvas.Top="128" Width="6" Height="150"
                                   Fill="{DynamicResource PathInstrumentBrush}" />
                        <Rectangle Canvas.Left="356" Canvas.Top="128" Width="6" Height="138"
                                   Fill="{DynamicResource PathInstrumentBrush}" />
                    </Canvas>

                    <Image x:Name="ReactorRender"
                           Canvas.Left="6" Canvas.Top="10" Width="300" Height="450"
                           Source="/TecnalHub;component/Resources/Images/reactor-neutral.png"
                           ImageFailed="OnReactorRenderFailed"
                           Stretch="Uniform" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Biorreator TECNAL" />

                    <!-- Impelidores sobrepostos -->
                    <Image x:Name="ReactorImpellers"
                           Canvas.Left="6" Canvas.Top="10" Width="300" Height="450"
                           Source="/TecnalHub;component/Resources/Images/reactor-impellers.png"
                           Stretch="Uniform" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Canvas>
            </Grid>
        </Viewbox>

        <!-- Honest process legend: the generated equipment carries no live state. -->
        <Border Grid.Row="2" Padding="14,8"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathInstrumentBrush}" />
                    <TextBlock Text="Instrumentação" Margin="0,0,12,0"
                               FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathGasBrush}" />
                    <TextBlock Text="Aeração" Margin="0,0,12,0"
                               FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathHeatingBrush}" />
                    <TextBlock Text="Utilidade térmica" Margin="0,0,12,0" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathFeedBrush}" />
                    <TextBlock Text="Alimentação" Margin="0,0,12,0" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathAntifoamBrush}" />
                    <TextBlock Text="Antiespuma" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Nível/espuma pelo sensor de distância, quando ativo · agitador de frasco em Controle"
                           Margin="16,0,0,0" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
