<Window x:Class="OpenTECHub.Views.Dialogs.CaptureSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OpenTECHub.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Critérios de Parada e Opções de Captura"
        Width="520" Height="580"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CaptionButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="CaptionMinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonBase}">
            <Setter Property="ToolTip" Value="Minimizar" />
            <Setter Property="AutomationProperties.Name" Value="Minimizar" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <Path Width="10" Height="10" Stretch="None"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                  Data="M0,5 H10" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonBase}">
            <Setter Property="ToolTip" Value="Fechar" />
            <Setter Property="AutomationProperties.Name" Value="Fechar" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <Path x:Name="Glyph" Width="10" Height="10" Stretch="None"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                  Data="M0,0 L10,10 M0,10 L10,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource CaptionCloseHoverBrush}" />
                                <Setter TargetName="Glyph" Property="Stroke"
                                        Value="{DynamicResource CaptionCloseGlyphBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Bar -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionMinimizeButtonStyle}" Click="OnMinimizeWindow" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseWindow" />
                </StackPanel>
                <TextBlock Text="Critérios de Parada e Opções de Captura"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Padding="16,12"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Button Content="Concluir" MinWidth="95" Padding="14,6" HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" IsCancel="True" Click="OnCloseClick" />
        </Border>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12,16,12">
            <StackPanel>
                <TextBlock Text="Critérios Estatísticos (Dois-Portões §12)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Controlam a identificação automática de regime permanente e parada estatística do ponto de ensaio."
                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- Faixa 1: IC rel., Piso, n mín. -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="IC rel. (%)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding RelativeCiPercent, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Piso στ (×)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding CiFloorSigmaMultiple, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="n mín." Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MinimumSamples, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </Grid>

                <!-- Faixa 2: t máx, Tentativas, Janela -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="t máx. (s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxCaptureSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Tentativas" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxTries, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Janela (s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationarityWindowSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </Grid>

                <!-- Faixa 3: Deriva, Confirmações -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Deriva (%/s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationaritySlopeTolerance, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Confirmações" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationarityRequiredSamples, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </Grid>

                <Separator Margin="0,16,0,12" Background="{DynamicResource StrokeDefaultBrush}" />

                <TextBlock Text="Opções de Operação" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                <CheckBox Margin="0,0,0,8" Content="Leitura manual de energia após cada ponto" IsChecked="{Binding ManualEnergyCaptureEnabled}" />
                <CheckBox Margin="0,0,0,8" Content="Estabilização no alívio" IsChecked="{Binding VentStabilizationEnabled}" IsEnabled="{Binding CanEditPlan}"
                          ToolTip="Estabiliza a vazão direcionada ao alívio antes de alimentar o reator" />

                <Border Visibility="{Binding VentStabilizationEnabled, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Padding="10"
                        Margin="0,2,0,0">
                    <StackPanel>
                        <TextBlock Text="Válvula de alívio:" Style="{StaticResource PowerLabel}" />
                        <ComboBox Margin="0,2,0,8" ItemsSource="{Binding VentValves}"
                                  SelectedValue="{Binding SelectedVentValve}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label" Height="26" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tol. (L/min)" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding VentFlowToleranceLpm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Amostras" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding VentFlowStableSamples, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="N alívio" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding VentAgitationRpm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="t máx. (s)" Style="{StaticResource PowerLabel}" />
                                <TextBox Style="{StaticResource CompactField}" Text="{Binding MaxVentStabilizationSeconds, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
