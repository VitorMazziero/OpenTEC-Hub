<UserControl x:Class="TecnalHub.Views.KlaDeterminationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:kla="clr-namespace:TecnalHub.Services.KlaTesting"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:KlaDeterminationViewModel}"
             d:DesignHeight="850" d:DesignWidth="1500">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="KlaHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="KlaHeaderValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="KlaCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Top Header Strip ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,6" Style="{StaticResource KlaCard}" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Active Test info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Determinação de kLa" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Margin="10,0,0,0" Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayPhase}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <Border Margin="8,0,0,0" Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SIMULAÇÃO" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource StateWarningTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding StatusMessage}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding SimulationDescription}" FontWeight="SemiBold"
                               Foreground="{DynamicResource StateWarningTextBrush}"
                               Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Middle: Telemetry & Timers -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="OD Dissolvido" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding CurrentDO, StringFormat={}{0:F1} %}" Style="{StaticResource KlaHeaderValue}" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Vazão Atual" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding CurrentFlow, StringFormat={}{0:F2} L/min}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Tempo da Fase" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding FormattedPhaseTime}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Tempo Total" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding FormattedTotalTime}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Novo Teste" Margin="4,0" Style="{StaticResource AccentButtonStyle}" Command="{Binding OpenCreateDialogCommand}" />
                    <Button Content="Parar e Revisar" Margin="4,0" Command="{Binding StopRunCommand}" IsEnabled="{Binding IsRunning}" />
                    <Button Content="Concluir Teste" Margin="4,0" Command="{Binding CompleteTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                    <Button Content="Abortar" Margin="4,0" Command="{Binding AbortTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Area: Split View ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="340" MaxWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left Column: Conditions & Settings (Scrollable) + Review (Pinned Bottom) ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Scrollable Top Area: Conditions Matrix & Thresholds Only -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>
                        <!-- 1. Matriz de Condições Experimentais (com adição manual integrada) -->
                        <Border Style="{StaticResource KlaCard}" Margin="0,0,0,6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Matriz de Condições Experimentais" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />

                                <!-- Condition Table -->
                                <DataGrid ItemsSource="{Binding Conditions}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          MaxHeight="170" MinHeight="90"
                                          BorderThickness="1" BorderBrush="{DynamicResource StrokeDefaultBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="28" IsReadOnly="True" />
                                        <DataGridTextColumn Header="N (rpm)" Binding="{Binding AgitationRpm, StringFormat={}{0:F0}}" Width="60" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Q (L/min)" Binding="{Binding AirflowLpm, StringFormat={}{0:F2}}" Width="65" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Reps" Binding="{Binding RequestedReplicates, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="Ação" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Executar" Padding="4,1" FontSize="10" Height="22"
                                                            Command="{Binding DataContext.StartConditionRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanExecute}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Integrated Manual Add Row (below table) -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock Text="N (rpm)" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding NewConditionRpm, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0">
                                        <TextBlock Text="Q (L/min)" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding NewConditionFlow, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="3,0">
                                        <TextBlock Text="Reps" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding NewConditionReplicates, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="+" FontWeight="Bold" Width="26" Height="22" VerticalAlignment="Bottom"
                                            Command="{Binding AddManualConditionCommand}" IsEnabled="{Binding HasActiveTest}"
                                            ToolTip="Adicionar condição manual" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Limiares de Operação (Compacto) -->
                        <Border Style="{StaticResource KlaCard}" Margin="0,0,0,6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Limiares de Operação" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock Text="DO Mín (%)" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding SettingDOMin, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0">
                                        <TextBlock Text="DO Máx (%)" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding SettingDOMax, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                        <TextBlock Text="N Desox (rpm)" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding SettingDegassingAgitation, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock Text="Suavização" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding SettingSmoothingWindow, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0">
                                        <TextBlock Text="Máx. N₂ (min)" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding SettingMaxDegassingMinutes, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                        <TextBlock Text="Máx. Ar (min)" Style="{StaticResource KlaHeaderLabel}" FontSize="9.5" />
                                        <TextBox Text="{Binding SettingMaxReoxygenationMinutes, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Aplicar Limiares" Margin="0,6,0,0" Height="24" FontSize="11"
                                        Command="{Binding ApplyLiveSettingsCommand}" IsEnabled="{Binding HasActiveTest}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Card de Revisão Científica e Aceite (Fixado na base da coluna esquerda) -->
                <Border Grid.Row="1" Style="{StaticResource KlaCard}" Margin="0,0,4,0" Padding="10,8"
                        Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Header -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Revisão Científica e Aceite" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="{Binding ReviewQuality}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </DockPanel>

                        <!-- Parâmetros de Ajuste Manual / OLS -->
                        <Grid Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,3,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ceq (%)" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                    <CheckBox Margin="3,0,0,0" IsChecked="{Binding ReviewCeqIsManual}" ToolTip="Manual" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Text="{Binding ReviewCeq, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ReviewCeqIsManual}" Height="22" Padding="2,1" FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="3,0,3,3">
                                <TextBlock Text="t_ini (s)" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                <TextBox Text="{Binding ReviewTStart, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="3,0,0,3">
                                <TextBlock Text="t_fim (s)" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                <TextBox Text="{Binding ReviewTEnd, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,3,0">
                                <TextBlock Text="Ceq t_ini (s)" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                <TextBox Text="{Binding ReviewCeqTStart, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="3,0,3,0">
                                <TextBlock Text="Ceq t_fim (s)" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                <TextBox Text="{Binding ReviewCeqTEnd, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Height="22" Padding="2,1" FontSize="11" />
                            </StackPanel>

                            <Button Grid.Row="1" Grid.Column="2" Content="Recalcular" Margin="3,0,0,0"
                                    Height="22" FontSize="10" VerticalAlignment="Bottom"
                                    Command="{Binding RecomputeReviewAnalysisCommand}" />
                        </Grid>

                        <!-- Métricas Científicas -->
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="kLa Estimado" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                        <TextBlock Text="{Binding ReviewKla, StringFormat={}{0:F1} h⁻¹}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding ReviewCi95Low, StringFormat={}IC 95%: [{0:F1}; }" Style="{StaticResource CaptionTextStyle}" FontSize="9" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Qualidade do Ajuste" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                        <TextBlock Text="{Binding ReviewR2, StringFormat='R²: {0:F4}'}" Style="{StaticResource KlaHeaderValue}" FontSize="11.5" />
                                        <TextBlock Text="{Binding ReviewRmse, StringFormat='RMSE: {0:F4}'}" Style="{StaticResource CaptionTextStyle}" FontSize="9" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Sensibilidade Ceq ± 1%" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                <TextBlock Text="{Binding ReviewSensLow, StringFormat={}[{0:F1}; }" Style="{StaticResource KlaHeaderValue}" FontSize="10.5" />
                                <TextBlock Text="{Binding ReviewSensHigh, StringFormat={}{0:F1}] h⁻¹}" Style="{StaticResource KlaHeaderValue}" FontSize="10.5" Margin="0,0,0,4" />

                                <TextBlock Text="Justificativa / Motivo" Style="{StaticResource KlaHeaderLabel}" FontSize="9" />
                                <TextBox Text="{Binding ReviewRejectionReason, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Vertical">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Repetir" Margin="0,0,2,0" Height="25" FontSize="10.5" Command="{Binding RepeatCurrentRunCommand}" />
                                <Button Grid.Column="1" Content="Rejeitar" Margin="2,0,0,0" Height="25" FontSize="10.5" Command="{Binding RejectCurrentRunCommand}" />
                            </Grid>
                            <Button Content="Aceitar Corrida (Salvar e Avançar)" Height="26" FontSize="11" Style="{StaticResource AccentButtonStyle}" Command="{Binding AcceptCurrentRunCommand}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ── Right Column: 3 Synchronized Plots (100% Height) ────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="100" />
                    <RowDefinition Height="1*" MinHeight="100" />
                    <RowDefinition Height="1*" MinHeight="100" />
                </Grid.RowDefinitions>

                <!-- Chart 1: DO vs Time -->
                <Border Grid.Row="0" Margin="0,0,0,4"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="4,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- External Legend Strip (Above Plot) -->
                        <DockPanel Grid.Row="0" Margin="4,2,4,2">
                            <TextBlock Text="Oxigênio Dissolvido" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- OD Bruto -->
                                <Border Width="12" Height="2" Background="{DynamicResource Series5Brush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBlock Text="OD Bruto" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <!-- OD Filtrado -->
                                <Border Width="14" Height="3" Background="{DynamicResource ChartPvBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                                <TextBlock Text="OD Filtrado" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <!-- DO Mín -->
                                <Border Width="12" Height="2" Background="{DynamicResource StateAlarmBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                                <TextBlock Text="DO Mín" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <!-- DO Máx -->
                                <Border Width="12" Height="2" Background="{DynamicResource StateOkBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                                <TextBlock Text="DO Máx" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <!-- Ajuste Exp kLa (Pink dashed) -->
                                <Border Width="14" Height="2" Background="{DynamicResource Series4Brush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                                <TextBlock Text="Ajuste Exp (kLa)" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Plot Host -->
                        <Border x:Name="ChartDoHost" Grid.Row="1" />

                        <!-- Interactive Slider Strip: C* Region Selection (Below Plot) -->
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="6,2" Margin="2,0,2,2"
                                Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Região de Ajuste de C*:" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="{Binding ReviewMinTime}" Maximum="{Binding ReviewMaxTime}" Value="{Binding ReviewCeqTStart, UpdateSourceTrigger=PropertyChanged}" SmallChange="0.5" LargeChange="2" ToolTip="Início da Região C*" />
                                    <Slider Grid.Column="2" Minimum="{Binding ReviewMinTime}" Maximum="{Binding ReviewMaxTime}" Value="{Binding ReviewCeqTEnd, UpdateSourceTrigger=PropertyChanged}" SmallChange="0.5" LargeChange="2" ToolTip="Fim da Região C*" />
                                </Grid>

                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource AccentBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="[{0:F1}s — {1:F1}s]">
                                            <Binding Path="ReviewCeqTStart" />
                                            <Binding Path="ReviewCeqTEnd" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chart 2: Log-Linear OLS Fit -->
                <Border Grid.Row="1" Margin="0,0,0,4"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="4,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- External Legend Strip (Above Plot) -->
                        <DockPanel Grid.Row="0" Margin="4,2,4,2">
                            <TextBlock Text="Regressão Log-Linear: ln(Ceq - C)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- ln(Ceq - C) -->
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PathAntifoamBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBlock Text="ln(Ceq - C)" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <!-- Ajuste OLS -->
                                <Border Width="16" Height="3" Background="{DynamicResource StateAlarmBrush}" VerticalAlignment="Center" Margin="10,0,3,0" />
                                <TextBlock Text="Ajuste OLS" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Plot Host -->
                        <Border x:Name="ChartLogLinearHost" Grid.Row="1" />

                        <!-- Interactive Slider Strip: Linear Region Selection (Below Plot) -->
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="6,2" Margin="2,0,2,2"
                                Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Seleção da Região Linear:" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="{Binding ReviewMinTime}" Maximum="{Binding ReviewMaxTime}" Value="{Binding ReviewTStart, UpdateSourceTrigger=PropertyChanged}" SmallChange="0.5" LargeChange="2" ToolTip="Início da Região Linear (t_ini)" />
                                    <Slider Grid.Column="2" Minimum="{Binding ReviewMinTime}" Maximum="{Binding ReviewMaxTime}" Value="{Binding ReviewTEnd, UpdateSourceTrigger=PropertyChanged}" SmallChange="0.5" LargeChange="2" ToolTip="Fim da Região Linear (t_fim)" />
                                </Grid>

                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource AccentBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="[{0:F1}s — {1:F1}s]">
                                            <Binding Path="ReviewTStart" />
                                            <Binding Path="ReviewTEnd" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chart 3: Instantaneous kLa -->
                <Border Grid.Row="2" Margin="0,0,0,4"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="4,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- External Legend Strip (Above Plot) -->
                        <DockPanel Grid.Row="0" Margin="4,2,4,2">
                            <TextBlock Text="kLa Instantâneo Diagnóstico" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- kLa Inst -->
                                <Border Width="14" Height="3" Background="{DynamicResource StateOkBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBlock Text="kLa Inst" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <!-- kLa Final -->
                                <Border Width="14" Height="2" Background="{DynamicResource StateAlarmBrush}" VerticalAlignment="Center" Margin="10,0,3,0" />
                                <TextBlock Text="kLa Final" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Plot Host -->
                        <Border x:Name="ChartInstantKlaHost" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Modal: Novo Teste ──────────────────────────────────────────────── -->
        <Grid Grid.RowSpan="2" Background="{DynamicResource SurfaceBaseBrush}" Opacity="0.95" Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource KlaCard}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Criar Novo Teste de kLa" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                    <TextBlock Text="Nome do Teste (Pasta em Testes-kLa/)" Style="{StaticResource KlaHeaderLabel}" />
                    <TextBox Text="{Binding NewTestName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                    <TextBlock Text="Válvula Conectada ao N₂" Style="{StaticResource KlaHeaderLabel}" />
                    <ComboBox SelectedItem="{Binding SelectedN2Valve}" Margin="0,2,0,10">
                        <kla:NitrogenValve>Valve1</kla:NitrogenValve>
                        <kla:NitrogenValve>Valve2</kla:NitrogenValve>
                    </ComboBox>

                    <TextBlock Text="Importar Condições de Mapa Existente (Opcional)" Style="{StaticResource KlaHeaderLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableMaps}" SelectedItem="{Binding SelectedMapForImport}" DisplayMemberPath="Snapshot.Name" Margin="0,2,0,10" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="DO Mín (%)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDOMin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="DO Máx (%)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDOMax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="N Desox (rpm)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDegassingAgitation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Margin="0,0,8,0" Command="{Binding CloseCreateDialogCommand}" />
                        <Button Content="Criar Teste" Style="{StaticResource AccentButtonStyle}" Command="{Binding CreateNewTestCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
