# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
publish/
*.user
*.suo

# IDE
.vs/
.idea/
*.DotSettings.user

# Installer output
installer/Output/

# Self-contained publish of the Wi-Fi test harness (~78 MB). Regenerate with:
#   dotnet publish src/OpenTECHub.Harness -c Release -r win-x64 --self-contained true -o tools/wifi-test
# tools/RunWiFiTest.cmd falls back to 'dotnet run' when it is absent.
tools/wifi-test/

# Runtime data - never commit lab data or machine-specific settings
logs/
*.log
preferences.local.json

# OS
Thumbs.db
desktop.ini
harness-trace-*.log
shot*.png

# Throwaway probes dropped at the root while chasing a behaviour ("what does this
# store write?", "what is this ScottPlot default?"). All real code lives under src/
# or tests/, so a .cs file here is always scratch - and the answer belongs in a test,
# where it keeps being checked. Root only: nothing inside the projects is hidden.
/test_*.cs
