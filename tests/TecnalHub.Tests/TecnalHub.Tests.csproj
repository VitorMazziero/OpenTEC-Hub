<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows + UseWPF so the app's ViewModels can be tested. The setpoint
         validation is safety-critical - it is what stands between a typo and a
         setpoint reaching a reactor - and leaving it untested because the assembly was
         awkward to reference would be the wrong trade. No test starts an Application;
         the ViewModels take interfaces, so they run headless. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TecnalHub.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Tests assert on protocol wire format; a stray culture must not turn
         "0.5" into "0,5" and silently pass. Pinned explicitly in the tests. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TecnalHub.Protocol\TecnalHub.Protocol.csproj" />
    <ProjectReference Include="..\..\src\TecnalHub.Simulator\TecnalHub.Simulator.csproj" />
    <ProjectReference Include="..\..\src\TecnalHub\TecnalHub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
