<Window x:Class="OpenTECHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OpenTECHub.Converters"
        xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
        xmlns:ctl="clr-namespace:OpenTECHub.Controls"
        xmlns:views="clr-namespace:OpenTECHub.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenTEC-Hub"
        Icon="pack://application:,,,/Resources/Icons/app_icon.ico"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBaseBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Custom chrome: drop the OS caption but keep resize, snap and the taskbar. The top
         48 px is the drag region (matching the header height); the app draws its own
         minimise / maximise / close in that header. See docs/UI_DESIGN.md section 4.1. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:TrendToGlyphConverter x:Key="TrendToGlyph" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EqualsToVisibilityConverter x:Key="EqualsToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Variable rail row: Option B's live instrument index. -->
        <DataTemplate x:Key="RailRowTemplate" DataType="{x:Type vm:ProcessVariableViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}"
                                   FontFamily="{DynamicResource FontNumeric}"
                                   FontSize="16"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Unit}" Margin="4,0,0,2"
                                   VerticalAlignment="Bottom"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <!-- The status dot is the only colour in a normal row. -->
                <ctl:StateDot Grid.Column="1" State="{Binding State}"
                              Label="{Binding DisplayName}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- ══ Window caption buttons ══
             Vector glyphs, no icon font (the project has none), themed to the header.
             Only the close button departs from the neutral hover, into the close red. -->
        <Style x:Key="CaptionButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="CaptionMinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonBase}">
            <Setter Property="ToolTip" Value="Minimizar" />
            <Setter Property="AutomationProperties.Name" Value="Minimizar" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <Path Width="10" Height="10" Stretch="None"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                  Data="M0,5 H10" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionMaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonBase}">
            <Setter Property="ToolTip" Value="Maximizar" />
            <Setter Property="AutomationProperties.Name" Value="Maximizar ou restaurar" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <Grid Width="10" Height="10"
                                  VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Maximize: one square. -->
                                <Path x:Name="MaxGlyph" Stretch="None"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                      Data="M0,0 H10 V10 H0 Z" />
                                <!-- Restore: two overlapping squares. -->
                                <Path x:Name="RestoreGlyph" Stretch="None" Visibility="Collapsed"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                      Data="M0,2 H8 V10 H0 Z M2,2 V0 H10 V8 H8" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="Maximized">
                                <Setter TargetName="MaxGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonBase}">
            <Setter Property="ToolTip" Value="Fechar" />
            <Setter Property="AutomationProperties.Name" Value="Fechar" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <Path x:Name="Glyph" Width="10" Height="10" Stretch="None"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                  Data="M0,0 L10,10 M0,10 L10,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource CaptionCloseHoverBrush}" />
                                <Setter TargetName="Glyph" Property="Stroke"
                                        Value="{DynamicResource CaptionCloseGlyphBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel x:Name="ShellRoot">

        <!-- ══ Title bar: identity, run clock, connection chip, window controls ══
             This whole 48 px strip is the WindowChrome caption (drag region). Interactive
             controls carry shell:WindowChrome.IsHitTestVisibleInChrome so they stay
             clickable; everything else drags the window. -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Minimise / maximise / close, flush to the window edge, full height. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionMinimizeButtonStyle}" Click="OnMinimizeWindow" />
                    <Button Style="{StaticResource CaptionMaximizeButtonStyle}" Click="OnMaximizeRestoreWindow" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseWindow" />
                </StackPanel>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Application Icon -->
                    <Image Source="pack://application:,,,/Resources/Icons/app_icon.ico"
                           Width="24" Height="24"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Application Title -->
                    <TextBlock Text="OpenTEC"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontDisplay}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold" />
                    <!-- Version from Git/MSBuild -->
                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}"
                               VerticalAlignment="Bottom"
                               Margin="8,0,0,2"
                               Foreground="{DynamicResource TextCaptionBrush}"
                               FontSize="{DynamicResource FontSizeCaption}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Tempo de processo" Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ElapsedText}"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center" />
                    <!-- Local display/log offset only: never resets the device clock, never
                         rewrites samples already logged. Disabled with no live link. -->
                    <Button Content="Zerar"
                            Margin="10,0,0,0" Padding="8,2"
                            FontSize="{DynamicResource FontSizeCaption}"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ZeroSessionTimeCommand}"
                            ToolTip="Zera o tempo da sessão (deslocamento local; não altera o relógio do equipamento nem os dados já gravados)." />
                    <Button Content="Nova Etapa / Corrida"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="8,0,0,0" Padding="8,2"
                            FontSize="{DynamicResource FontSizeCaption}"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding StartQuickSessionCommand}"
                            ToolTip="Inicia uma nova etapa de ensaio com nome personalizado em um novo arquivo e zera o tempo do processo." />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Sensor-module health is independent of the PC link: USB can be
                         perfectly healthy while the module's internal UART is down. -->
                    <Border Padding="8,3" Margin="0,0,8,0"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            ToolTip="O ESP32 não está recebendo dados do módulo de sensores."
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsSensorModuleOffline, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{DynamicResource StateWarningBrush}" />
                            <TextBlock Text="Módulo de sensores offline"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Connection chip. Clicking opens the popover; Configurações is
                         no longer where anyone goes just to connect. -->
                    <ToggleButton x:Name="ConnectionChip"
                                  FocusVisualStyle="{StaticResource KeyboardFocusVisualStyle}"
                                  Padding="10,4"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                  BorderThickness="1"
                                  Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Fill="{Binding Connection.StateKey, Converter={StaticResource StateToBrush}}" />
                            <TextBlock Text="{Binding Connection.StatusText}" VerticalAlignment="Center" />
                            <TextBlock Text="⌄" Margin="7,-3,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=ConnectionChip, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ConnectionChip}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           HorizontalOffset="-180">
                        <Border Width="320" Margin="8"
                                Padding="16"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
                            </Border.Effect>
                            <StackPanel DataContext="{Binding Connection}">

                                <RadioButton Content="USB" GroupName="Medium" Margin="0,0,0,6"
                                             IsChecked="{Binding UseUsb, Mode=TwoWay}" />
                                <Grid Margin="18,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailablePorts}"
                                              SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="⟳" Margin="6,0,0,0" Padding="8,2"
                                            ToolTip="Atualizar portas"
                                            Command="{Binding RefreshPortsCommand}" />
                                </Grid>

                                <RadioButton Content="Wi-Fi" GroupName="Medium" Margin="0,0,0,6"
                                             IsChecked="{Binding UseWiFi, Mode=TwoWay}" />
                                <TextBox Margin="18,0,0,12"
                                         Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <Separator Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Quadros" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FramesReceived}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Comandos" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommandsSent}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Último erro" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastError}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               MaxWidth="190" Style="{StaticResource CaptionTextStyle}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Procurar" Margin="0,0,6,0" Padding="10,4"
                                            Command="{Binding DiscoverCommand}" />
                                    <Button Content="Conectar" Margin="0,0,6,0" Padding="10,4"
                                            Command="{Binding ConnectCommand}" />
                                    <Button Content="Parar" Padding="10,4"
                                            Command="{Binding DisconnectCommand}" />
                                </StackPanel>


                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Content="Buscar" Margin="8,0,0,0" Padding="10,4"
                            ToolTip="Pesquisar páginas e comandos (Ctrl+K)"
                            AutomationProperties.Name="Pesquisar páginas e comandos"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OpenCommandPalette_Click" />

                    <Button Margin="8,0,0,0" Padding="10,4" ToolTip="Alternar entre tema claro e escuro" shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleThemeCommand}"><ctl:Icon Key="Theme" Size="20" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                </StackPanel>
            </Grid>
            </DockPanel>
        </Border>

        <!-- ══ Alarm banner (WP4) — full width, above the rails ══
             Shows whenever a system alarm is latched. Reconhecer acknowledges every
             alarm; Silenciar mutes the audible for a window, never permanently. -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{Binding AlarmState, Converter={StaticResource StateToBrush}}"
                BorderThickness="0,0,0,2"
                Padding="16,7">
            <!-- Two columns, not one cell with two overlapping children. Overlapped, the
                 detail ran underneath the buttons: a horizontal StackPanel hands its child
                 infinite width, so the TextTrimming on it could never fire and the end of
                 the sentence was simply hidden. Bounded by a star column the detail wraps
                 instead, and the banner grows a line rather than losing the text. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctl:StateDot Grid.Column="0" State="{Binding AlarmState}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding AlarmHeadlineText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{Binding AlarmState, Converter={StaticResource StateToBrush}, ConverterParameter=Text}" />
                    <TextBlock Grid.Column="2" Text="{Binding AlarmMoreText}" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="3" Text="{Binding AlarmHeadlineDetail}" Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextStyle}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Silenciar áudio (10 min)" Padding="10,4" Margin="0,0,8,0"
                            Visibility="{Binding IsAlarmAudible, Converter={StaticResource BoolToVis}}"
                            Command="{Binding SilenceAlarmsCommand}" />
                    <Button Content="Reconhecer"
                            Padding="10,4"
                            IsEnabled="{Binding HasUnacknowledgedAlarms}"
                            Command="{Binding AcknowledgeAlarmsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Navigation rail ══ -->
        <Border x:Name="NavigationRail" DockPanel.Dock="Left"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="184" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNavigationCompact}" Value="True">
                            <Setter Property="Width" Value="52" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- A ListBox rather than templated RadioButtons: selection is exactly what
                 SelectedValue/SelectedValuePath express, and it avoids binding
                 ConverterParameter, which is not a DependencyProperty and throws at
                 parse time. -->
            <DockPanel>
                <DockPanel.Resources>
                    <CollectionViewSource x:Key="NavItems" Source="{Binding NavigationItems}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="GroupName" />
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </DockPanel.Resources>

            <!-- ══ Rail footer: Active Session Name ══ -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource StrokeSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,10"
                    Visibility="{Binding IsNavigationCompact,
                                         Converter={StaticResource BoolToVis},
                                         ConverterParameter=Invert}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ctl:Icon Key="File" Size="14" Margin="0,0,6,0" Stroke="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Nome da Sessão" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <TextBox Text="{Binding ActiveSessionName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nome da sessão gravada em Sessoes/. Pressione Enter ou clique em Aplicar."
                             AutomationProperties.Name="Nome da Sessão Ativa"
                             Height="28" Padding="6,2" FontSize="11.5" Margin="0,0,0,6">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding UpdateActiveSessionNameCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Aplicar" HorizontalAlignment="Stretch" Height="28" Padding="8,2" FontSize="11.5"
                            Command="{Binding UpdateActiveSessionNameCommand}"
                            ToolTip="Implementar novo nome de sessão" />
                    <TextBlock Text="✓ Sessão atualizada"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource StateOkBrush}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"
                               Visibility="{Binding IsSessionNameSavedNotificationVisible, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding LoggingSummary}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Source={StaticResource NavItems}}"
                     SelectedValuePath="Id"
                     SelectedValue="{Binding SelectedNavigationId, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" 
                                           FontWeight="SemiBold" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextMutedBrush}" 
                                           Margin="12,8,12,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavigationCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Margin" Value="8,12" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationCompact}" Value="True">
                                <Setter Property="Margin" Value="4,12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
                        <!-- On the CONTAINER, not on a child in the DataTemplate: the
                             item's automation peer takes its name from the bound object,
                             so without this a screen reader announces the record's
                             ToString - "NavigationItem { Id = dashboard, Label = ... }". -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="{Binding Label}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Border x:Name="Marker" Width="3"
                                                    HorizontalAlignment="Left"
                                                    Margin="-8,0,0,0"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SurfaceSelectedBrush}" />
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsNavigationCompact,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Padding" Value="8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavigationItem}">
                        <StackPanel Orientation="Horizontal">
                            <ctl:Icon Key="{Binding Glyph}" Size="20"
                                      Stroke="{Binding GroupColor}" />
                            <TextBlock Text="{Binding Label}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding
                                           RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                           Path=Foreground}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsNavigationCompact,
                                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ Status bar: run and system context, true on every page ══ -->
        <Border DockPanel.Dock="Bottom"
                Height="32"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Receita:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding RecipeName}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Fase:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding PhaseName}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Decorrido:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding ElapsedText}" Margin="5,0,0,0"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Próxima ação:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding NextActionText}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               ToolTip="Somente o motor de receitas pode saber isto — Fase 3." />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Registro:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding LoggingSummary}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ctl:StateDot State="{Binding SystemState}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SystemStateText}" Style="{StaticResource CaptionTextStyle}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />

                    <!-- A frozen link that keeps showing the last good frame is the
                         failure this application exists to prevent, so the age of the
                         newest frame is permanently on screen. -->
                    <TextBlock Text="Última atualização" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding LastUpdateText}" Margin="5,0,0,0"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTelemetryStale}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StateWarningTextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Variable rail: the variable display ══
             Since D-011 this is where live values are read on every page but Receitas:
             a value beside the drawing of the equipment that produced it. Selection
             here and on the synoptic are one selection seen two ways. -->
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowVariableRail}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Controle already carries every live PV in its table. Hiding
                             the duplicate rail is what "full width" in UI_DESIGN §5.2
                             means and keeps the complete run configuration visible at
                             the 1280 px acceptance width. -->
                        <DataTrigger Binding="{Binding SelectedNavigationId}" Value="control">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedNavigationId}" Value="calibrations">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="12,12,8,12">
                <TextBlock DockPanel.Dock="Top" Text="Variáveis"
                           FontWeight="SemiBold"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,0,0,8" />
                <ListBox ItemsSource="{Binding Variables}"
                         SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                         ItemTemplate="{StaticResource RailRowTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <StackPanel>
                                            <Border Height="1" Margin="4,6,4,7"
                                                    Background="{DynamicResource StrokeSubtleBrush}"
                                                    Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVis}}" />
                                            <Border x:Name="Chrome" Background="Transparent"
                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Border x:Name="Marker" Width="3"
                                                            HorizontalAlignment="Left" Margin="-6,0,0,0"
                                                            CornerRadius="2"
                                                            Background="{DynamicResource AccentBrush}"
                                                            Visibility="Collapsed" />
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ Content: one page at a time, chosen by the nav rail ══ -->
        <Grid>
        <Grid>

            <!-- Painel -->
            <Grid Visibility="{Binding SelectedNavigationId, Converter={StaticResource EqualsToVis},
                                       ConverterParameter=dashboard}"
                  Margin="16,4,16,16">
                <views:SynopticView />
            </Grid>

            <!-- Controle -->
            <views:ControlView DataContext="{Binding Control}"
                               Visibility="{Binding DataContext.SelectedNavigationId,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource EqualsToVis},
                                                    ConverterParameter=control}" />

            <!-- Históricos: file inventory and contract preview. The dual graph remains
                 its own dedicated page and receives a selected session on request. -->
            <views:HistoricalView DataContext="{Binding Historical}"
                                  Visibility="{Binding DataContext.SelectedNavigationId,
                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                       Converter={StaticResource EqualsToVis},
                                                       ConverterParameter=history}" />

            <!-- Eventos: app-known audit trail, useful over both USB and Wi-Fi. -->
            <views:EventsView DataContext="{Binding Events}"
                              Visibility="{Binding DataContext.SelectedNavigationId,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource EqualsToVis},
                                                   ConverterParameter=events}" />

            <!-- Calibrações: pH/O2 are app-side; the flow curve is sent to hardware. -->
            <views:CalibrationView DataContext="{Binding Calibration}"
                                   Visibility="{Binding DataContext.SelectedNavigationId,
                                                        RelativeSource={RelativeSource AncestorType=Window},
                                                        Converter={StaticResource EqualsToVis},
                                                        ConverterParameter=calibrations}" />

            <!-- Configurações -->
            <Grid Margin="16"
                  Visibility="{Binding SelectedNavigationId, Converter={StaticResource EqualsToVis},
                                       ConverterParameter=settings}">
                <Border CornerRadius="{StaticResource RadiusMedium}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Border>
            </Grid>

            <!-- Gassing-out kLa experimental testing and regression -->
            <views:KlaDeterminationView DataContext="{Binding KlaDetermination}"
                                        Visibility="{Binding DataContext.SelectedNavigationId,
                                                             RelativeSource={RelativeSource AncestorType=Window},
                                                             Converter={StaticResource EqualsToVis},
                                                             ConverterParameter=kla-determination}" />

            <!-- D-008: experimental map reconstruction and immutable path publication. -->
            <views:KlaMappingView DataContext="{Binding KlaMapping}"
                                  Visibility="{Binding DataContext.SelectedNavigationId,
                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                       Converter={StaticResource EqualsToVis},
                                                       ConverterParameter=kla-mapping}" />

            <!-- Receitas: graphical recipe editor and execution engine (WP4). -->
            <views:ReceitasView DataContext="{Binding Receitas}"
                                Visibility="{Binding DataContext.SelectedNavigationId,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource EqualsToVis},
                                                     ConverterParameter=recipes}" />
        </Grid>

        <!-- Ctrl+K command palette. It stays a Popup so it overlays every destination
             without forcing each page into a second layout container. -->
        <Popup x:Name="CommandPalettePopup"
               IsOpen="{Binding IsCommandPaletteOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=ShellRoot}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="CommandPalettePopup_Opened"
               Closed="CommandPalettePopup_Closed">
            <Border Width="520" MaxHeight="430" Margin="16" Padding="16"
                    DataContext="{Binding DataContext, ElementName=ShellRoot}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.30" />
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Páginas e comandos" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeSubtitle}" />
                            <TextBlock Text="Digite para filtrar · Enter executa · Esc fecha"
                                       Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Fechar" Padding="9,4"
                                Command="{Binding CloseCommandPaletteCommand}" />
                    </Grid>

                    <TextBox x:Name="CommandPaletteSearchBox" DockPanel.Dock="Top"
                             Text="{Binding CommandSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Pesquisar páginas e comandos"
                             PreviewKeyDown="CommandPaletteSearch_PreviewKeyDown" />

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding SelectedCommandPaletteEntry.UnavailableReason}"
                               Margin="4,8,4,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Style="{StaticResource CaptionTextStyle}" />

                    <ListBox x:Name="CommandPaletteResults"
                             Margin="0,10,0,0"
                             MaxHeight="300"
                             ItemsSource="{Binding CommandPaletteResults}"
                             SelectedItem="{Binding SelectedCommandPaletteEntry, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Resultados de comandos"
                             MouseDoubleClick="CommandPaletteResults_MouseDoubleClick"
                             PreviewKeyDown="CommandPaletteResults_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CommandPaletteEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Hint}"
                                               Margin="16,0,0,0"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
        </Grid>
    </DockPanel>
</Window>

