<Application x:Class="TecnalHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Slot 0 is the ACTIVE theme and is swapped at runtime by
                     ThemeService. Tokens.Light.xaml here is only the boot default;
                     App.OnStartup replaces it before the first window is shown. -->
                <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
                <ResourceDictionary Source="Themes/Tokens.Shared.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
