<UserControl x:Class="OpenTECHub.Views.DetailPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenTECHub.Converters"
             xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
             xmlns:ctl="clr-namespace:OpenTECHub.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SubsystemViewModel}">

    <!-- ══════════════════════════════════════════════════════════════════════
         DETAIL PANE
         The selected subsystem's controls. One subsystem at a time - that is what
         stops twelve of them becoming the wall the v.6 card board was.

         The hierarchy is fixed and the same for every device:
             what is happening now   -> PV / SP / Δ
             how has it behaved      -> trend
             how is it controlled    -> mode and the section tabs
             what engineering exists -> calibration, health, advanced
         Only WHICH sections appear varies, and it varies with what the device can
         actually do. See docs/UI_DESIGN.md section 6.1.
         ══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Read-only label/value rows for the oxygen cascade tabs. -->
        <Style x:Key="CascadeLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CascadeValue" TargetType="TextBlock" BasedOn="{StaticResource NumericTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- SP & Limites. Shown inside the segmented strip where one exists, and
             directly where it does not - same template either way, so the two
             paths cannot drift. -->
        <DataTemplate x:Key="SetpointSectionTemplate" DataType="{x:Type vm:SubsystemViewModel}">
            <StackPanel>
                <ctl:SetpointField Label="Setpoint"
                                   Visibility="{Binding HasSetpointEntry, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Saída. Only flow has one in Phase 1: it is the single core subsystem
             whose actuator state comes back on the wire. -->
        <DataTemplate x:Key="OutputSectionTemplate" DataType="{x:Type vm:SubsystemViewModel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Comandado pelo aplicativo"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                               Style="{StaticResource NumericTextStyle}" FontSize="11"
                               Text="{Binding AppliedSetpoint, TargetNullValue=—}" />

                    <!-- The device echoes the setpoint it accepted. When this disagrees
                         with the line above, the command did not land - which is exactly
                         the case v.6 could not show. -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Eco do equipamento"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                               Style="{StaticResource NumericTextStyle}" FontSize="11"
                               Text="{Binding Variable.FormattedSetpoint}" />
                </Grid>

                <!-- The observed gas destination, in the hardware's names (plan A/B/C §3.2). A
                     setpoint sent from here keeps whatever route the meter is on. -->
                <Grid Margin="0,4,0,0" DataContext="{Binding DataContext.FlowControl, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Destino do gás" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"
                               Text="{Binding ObservedRouteText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsObservedRouteAnomalous}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StateAlarmTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="O destino (A / B+C / fechado) e a linha (v_Flow) mudam em Controle, na gaveta Vazão de Ar." />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceCardBrush}"
            BorderBrush="{DynamicResource StrokeDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}"
            Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">

                <!-- ── Header ─────────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1" Margin="10,0,0,0"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Click="OnToggleClicked"
                                  AutomationProperties.Name="{Binding DisplayName, StringFormat='Ativar ou desligar {0}'}"
                                  ToolTip="Ativar ou desligar; o comando é enviado imediatamente" />
                    <ctl:StateChip Grid.Column="2" Margin="10,0,0,0"
                                   State="{Binding Variable.State}"
                                   VerticalAlignment="Center" />
                    <Button Grid.Column="3" Margin="10,0,0,0" Padding="4"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Fechar painel"
                            ToolTip="Fechar"
                            Command="{Binding DataContext.ClearSelectionCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="✕" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                </Grid>

                <!-- ── PV / SP / Δ ────────────────────────────────────────────
                     The three numbers that answer "what is happening now". PV
                     dominates: the operator's eye should find the measurement
                     without reading a label. -->
                <Grid Margin="0,16,4,0">
                    <Grid.ColumnDefinitions>
                        <!-- PV takes only what it needs and the slack sits between the
                             readout and its two companions, so SP and Δ stay a pair
                             rather than drifting apart with the pane width. -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PV" Style="{StaticResource CaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Variable.FormattedValue}"
                                       Style="{StaticResource ReadoutTextStyle}" />
                            <TextBlock Text="{Binding Unit}" Margin="5,0,0,5"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,16,3"
                                Visibility="{Binding HasSetpointEntry, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="SP" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding Variable.FormattedSetpoint}"
                                   Style="{StaticResource NumericTextStyle}"
                                   FontSize="18" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                Visibility="{Binding HasSetpointEntry, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Δ" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding FormattedDeviation}"
                                   Style="{StaticResource NumericTextStyle}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- ── Trend ──────────────────────────────────────────────── -->
                <ctl:TrendSpark Margin="0,14,0,0"
                                PlotHeight="120"
                                Channel="{Binding Variable.Channel}"
                                Setpoint="{Binding Variable.Setpoint}"
                                History="{Binding DataContext.History,
                                          RelativeSource={RelativeSource AncestorType=Window}}" />

                <Separator Margin="0,16,0,14" />

                <!-- ── Control ────────────────────────────────────────────── -->
                <TextBlock Text="Controle" FontWeight="SemiBold"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,10" />

                <!-- The segmented strip appears only where there is more than one
                     section to choose between. Most Phase 1 subsystems have just
                     "SP & Limites", and a one-segment control is a heading
                     pretending to be a choice. -->
                <TabControl Style="{StaticResource SegmentedControlStyle}"
                            Visibility="{Binding ShowTabStrip, Converter={StaticResource BoolToVis}}">
                    <TabItem Header="SP &amp; Limites">
                        <ContentControl ContentTemplate="{StaticResource SetpointSectionTemplate}"
                                        Content="{Binding}" />
                    </TabItem>
                    <TabItem Header="Saída"
                             Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <!-- Flow: the device's setpoint echo. Oxygen: the cascade's effort
                                 and the actuators it allocated. -->
                            <ContentControl ContentTemplate="{StaticResource OutputSectionTemplate}"
                                            Content="{Binding}"
                                            Visibility="{Binding HasCascade, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <StackPanel Visibility="{Binding HasCascade, Converter={StaticResource BoolToVis}}">
                                <StackPanel DataContext="{Binding DataContext.CascadeDetail, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Text="{Binding StateText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Saída (esforço)" Style="{StaticResource CascadeLabel}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OutputText}" Style="{StaticResource CascadeValue}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Agitação alocada" Style="{StaticResource CascadeLabel}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AgitationText}" Style="{StaticResource CascadeValue}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Aeração alocada" Style="{StaticResource CascadeLabel}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AerationText}" Style="{StaticResource CascadeValue}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Controle O₂"
                             Visibility="{Binding HasCascade, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding DataContext.CascadeDetail, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="{Binding StateText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Modo" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModeText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Setpoint de O₂" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SetpointText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="kLa demandado" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KlaDemandText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Agitação alocada" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AgitationText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Aeração alocada" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AerationText}" Style="{StaticResource CascadeValue}" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Sintonia, modo e ativação ficam em Controle → Controle de oxigênio." />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="PID"
                             Visibility="{Binding HasPid, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding DataContext.CascadeDetail, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Erro" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="P" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProportionalText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="I" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IntegralText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="D" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DerivativeText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="dSaída" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DeltaOutputText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Saída" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OutputText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="DOT previsto" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PredictedText}" Style="{StaticResource CascadeValue}" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Taxa de O₂" Style="{StaticResource CascadeLabel}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding RateText}" Style="{StaticResource CascadeValue}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding IsSaturated, Converter={StaticResource BoolToVis}}">
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource StateWarningBrush}" />
                                <TextBlock Text="Saída saturada no limite do atuador" Margin="6,0,0,0"
                                           Foreground="{DynamicResource StateWarningTextBrush}"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <ContentControl ContentTemplate="{StaticResource SetpointSectionTemplate}"
                                Content="{Binding}"
                                Visibility="{Binding ShowTabStrip,
                                             Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                <!-- ── Engineering ────────────────────────────────────────────
                     Progressively denser toward the bottom: overview, control,
                     then the things looked at once a week. -->
                <Separator Margin="0,16,0,4" />

                <Expander Visibility="{Binding HasCalibration, Converter={StaticResource BoolToVis}}">
                    <Expander.Header>
                        <TextBlock Text="Calibração" />
                    </Expander.Header>
                    <Button Content="Abrir calibração"
                            HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding DataContext.OpenCalibrationCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding CalibrationTarget}" />
                </Expander>

                <Expander Visibility="{Binding HasHealth, Converter={StaticResource BoolToVis}}">
                    <Expander.Header>
                        <TextBlock Text="Saúde do sensor" />
                    </Expander.Header>
                    <ctl:SensorHealthView DataContext="{Binding Variable}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
