<UserControl x:Class="TecnalHub.Views.SynopticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}">

    <!-- ══════════════════════════════════════════════════════════════════════
         SYNOPTIC
         The reactor drawn to scale, with each live value pinned at the hardware
         it comes from: jacket, impeller, probes, sparger, headplate. Clicking any
         element selects it into the detail pane.

         Vector, not an image: it themes with the tokens, scales to any window, and
         a value can be bound directly to the thing that produces it.

         Coordinates are inside a 520x420 Viewbox, so everything below is in that
         fixed space and the whole drawing scales as one.
         ══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />

        <!-- A value pinned beside its hardware. Clicking selects the variable. -->
        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" Margin="12">
        <Canvas Width="520" Height="420">

            <!-- ── Jacket: the outer thermal envelope ─────────────────────── -->
            <Border Canvas.Left="150" Canvas.Top="70" Width="220" Height="250"
                    CornerRadius="10"
                    BorderThickness="7"
                    BorderBrush="{DynamicResource StrokeStrongBrush}"
                    Background="Transparent"
                    ToolTip="Camisa térmica" />

            <!-- ── Vessel wall ────────────────────────────────────────────── -->
            <Border Canvas.Left="161" Canvas.Top="81" Width="198" Height="228"
                    CornerRadius="6"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource TextSecondaryBrush}"
                    Background="{DynamicResource SurfaceSunkenBrush}" />

            <!-- Broth. Height is fixed for now; a level sensor would drive it. -->
            <Rectangle Canvas.Left="163" Canvas.Top="150" Width="194" Height="157"
                       RadiusX="4" RadiusY="4"
                       Opacity="0.30"
                       Fill="{DynamicResource AccentBrush}" />

            <!-- ── Headplate ──────────────────────────────────────────────── -->
            <Rectangle Canvas.Left="145" Canvas.Top="62" Width="230" Height="14"
                       RadiusX="4" RadiusY="4"
                       Fill="{DynamicResource StrokeStrongBrush}" />

            <!-- ── Agitator: shaft and two Rushton turbines ───────────────── -->
            <Rectangle Canvas.Left="256" Canvas.Top="40" Width="8" Height="230"
                       Fill="{DynamicResource TextSecondaryBrush}" />

            <!-- Motor housing -->
            <Border Canvas.Left="232" Canvas.Top="16" Width="56" Height="28"
                    CornerRadius="4"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource StrokeStrongBrush}"
                    BorderThickness="1.5" />

            <Rectangle Canvas.Left="228" Canvas.Top="196" Width="64" Height="7"
                       RadiusX="2" RadiusY="2"
                       Fill="{DynamicResource TextSecondaryBrush}" />
            <Rectangle Canvas.Left="228" Canvas.Top="252" Width="64" Height="7"
                       RadiusX="2" RadiusY="2"
                       Fill="{DynamicResource TextSecondaryBrush}" />

            <!-- ── Sparger ring, below the lowest impeller ────────────────── -->
            <Ellipse Canvas.Left="212" Canvas.Top="278" Width="96" Height="16"
                     Stroke="{DynamicResource TextSecondaryBrush}"
                     StrokeThickness="2.5"
                     Fill="Transparent" />
            <Rectangle Canvas.Left="120" Canvas.Top="284" Width="94" Height="3"
                       Fill="{DynamicResource TextSecondaryBrush}" />

            <!-- ── Probe bodies entering through the headplate ────────────── -->
            <Rectangle Canvas.Left="196" Canvas.Top="70" Width="7" Height="120"
                       Fill="{DynamicResource TextSecondaryBrush}" />
            <Rectangle Canvas.Left="318" Canvas.Top="70" Width="7" Height="120"
                       Fill="{DynamicResource TextSecondaryBrush}" />

            <!-- ══ Live tags ══════════════════════════════════════════════ -->

            <!-- Temperature, at the jacket -->
            <Border Canvas.Left="14" Canvas.Top="120"
                    Style="{StaticResource TagStyle}"
                    DataContext="{Binding Temperature}"
                    ToolTip="Camisa térmica">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectByIdCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="temperature" />
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}" FontSize="15"
                                   FontFamily="{DynamicResource FontNumeric}" />
                        <TextBlock Text="{Binding Unit}" FontSize="9" Margin="3,0,0,2"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Line X1="112" Y1="140" X2="150" Y2="150"
                  Stroke="{DynamicResource StrokeDefaultBrush}" StrokeThickness="1"
                  StrokeDashArray="3 2" />

            <!-- Agitation, at the motor -->
            <Border Canvas.Left="316" Canvas.Top="8"
                    Style="{StaticResource TagStyle}"
                    DataContext="{Binding Motor}"
                    ToolTip="Sem realimentação de rotação: valor comandado">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectByIdCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="motor" />
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}" FontSize="15"
                                   FontFamily="{DynamicResource FontNumeric}" />
                        <TextBlock Text="{Binding Unit}" FontSize="9" Margin="3,0,0,2"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="comandado" FontSize="8"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Line X1="290" Y1="30" X2="316" Y2="30"
                  Stroke="{DynamicResource StrokeDefaultBrush}" StrokeThickness="1"
                  StrokeDashArray="3 2" />

            <!-- Dissolved oxygen, at the right-hand probe -->
            <Border Canvas.Left="392" Canvas.Top="120"
                    Style="{StaticResource TagStyle}"
                    DataContext="{Binding Oxygen}"
                    ToolTip="Sonda polarográfica de OD">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectByIdCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="oxygen" />
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}" FontSize="15"
                                   FontFamily="{DynamicResource FontNumeric}" />
                        <TextBlock Text="{Binding Unit}" FontSize="9" Margin="3,0,0,2"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Line X1="325" Y1="140" X2="392" Y2="140"
                  Stroke="{DynamicResource StrokeDefaultBrush}" StrokeThickness="1"
                  StrokeDashArray="3 2" />

            <!-- Pressure, at the headplate -->
            <Border Canvas.Left="392" Canvas.Top="46"
                    Style="{StaticResource TagStyle}"
                    DataContext="{Binding Pressure}"
                    ToolTip="Pressão do headspace">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectByIdCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="pressure" />
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}" FontSize="15"
                                   FontFamily="{DynamicResource FontNumeric}" />
                        <TextBlock Text="{Binding Unit}" FontSize="9" Margin="3,0,0,2"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Line X1="375" Y1="66" X2="392" Y2="66"
                  Stroke="{DynamicResource StrokeDefaultBrush}" StrokeThickness="1"
                  StrokeDashArray="3 2" />

            <!-- Air flow, at the sparger inlet -->
            <Border Canvas.Left="14" Canvas.Top="264"
                    Style="{StaticResource TagStyle}"
                    DataContext="{Binding Flow}"
                    ToolTip="Aeração pelo sparger">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectByIdCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="flow" />
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}" FontSize="15"
                                   FontFamily="{DynamicResource FontNumeric}" />
                        <TextBlock Text="{Binding Unit}" FontSize="9" Margin="3,0,0,2"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Caption -->
            <TextBlock Canvas.Left="150" Canvas.Top="336"
                       Width="220" TextAlignment="Center"
                       Text="Biorreator TECNAL"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Canvas>
    </Viewbox>
</UserControl>
