<Window x:Class="TecnalHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TecnalHub.Converters"
        xmlns:vm="clr-namespace:TecnalHub.ViewModels"
        xmlns:ctl="clr-namespace:TecnalHub.Controls"
        xmlns:views="clr-namespace:TecnalHub.Views"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TECNAL-Hub"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBaseBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:TrendToGlyphConverter x:Key="TrendToGlyph" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EqualsToVisibilityConverter x:Key="EqualsToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Variable rail row: Option B's live instrument index. -->
        <DataTemplate x:Key="RailRowTemplate" DataType="{x:Type vm:ProcessVariableViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}"
                                   FontFamily="{DynamicResource FontNumeric}"
                                   FontSize="16"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Unit}" Margin="4,0,0,2"
                                   VerticalAlignment="Bottom"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <!-- The status dot is the only colour in a normal row. -->
                <ctl:StateDot Grid.Column="1" State="{Binding State}"
                              Label="{Binding DisplayName}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- ══ Title bar: identity, run clock, connection chip ══ -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="TECNAL-Hub"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontSize="{DynamicResource FontSizeSubtitle}"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Tempo de processo" Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ElapsedText}"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Sensor-module health is independent of the PC link: USB can be
                         perfectly healthy while the module's internal UART is down. -->
                    <Border Padding="8,3" Margin="0,0,8,0"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            ToolTip="O ESP32 não está recebendo dados do módulo de sensores."
                            Visibility="{Binding IsSensorModuleOffline, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{DynamicResource StateWarningBrush}" />
                            <TextBlock Text="Módulo de sensores offline"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Connection chip. Clicking opens the popover; Configurações is
                         no longer where anyone goes just to connect. -->
                    <ToggleButton x:Name="ConnectionChip"
                                  Padding="10,4"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                  BorderThickness="1"
                                  Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Fill="{Binding Connection.StateKey, Converter={StaticResource StateToBrush}}" />
                            <TextBlock Text="{Binding Connection.StatusText}" VerticalAlignment="Center" />
                            <TextBlock Text="⌄" Margin="7,-3,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=ConnectionChip, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ConnectionChip}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           HorizontalOffset="-180">
                        <Border Width="320" Margin="8"
                                Padding="16"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
                            </Border.Effect>
                            <StackPanel DataContext="{Binding Connection}">

                                <RadioButton Content="USB" GroupName="Medium" Margin="0,0,0,6"
                                             IsChecked="{Binding UseUsb, Mode=TwoWay}" />
                                <Grid Margin="18,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailablePorts}"
                                              SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="⟳" Margin="6,0,0,0" Padding="8,2"
                                            ToolTip="Atualizar portas"
                                            Command="{Binding RefreshPortsCommand}" />
                                </Grid>

                                <RadioButton Content="Wi-Fi" GroupName="Medium" Margin="0,0,0,6"
                                             IsChecked="{Binding UseWiFi, Mode=TwoWay}" />
                                <TextBox Margin="18,0,0,12"
                                         Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <Separator Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Quadros" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FramesReceived}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Comandos" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommandsSent}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Último erro" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastError}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               MaxWidth="190" Style="{StaticResource CaptionTextStyle}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Procurar" Margin="0,0,6,0" Padding="10,4"
                                            Command="{Binding DiscoverCommand}" />
                                    <Button Content="Conectar" Margin="0,0,6,0" Padding="10,4"
                                            Command="{Binding ConnectCommand}" />
                                    <Button Content="Parar" Padding="10,4"
                                            Command="{Binding DisconnectCommand}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Configurações avançadas" Padding="10,4"
                                            Command="{Binding DataContext.NavigateCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="settings" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Content="Tema" Margin="8,0,0,0" Padding="10,4"
                            ToolTip="Alternar entre tema claro e escuro"
                            Command="{Binding ToggleThemeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Navigation rail ══ -->
        <Border DockPanel.Dock="Left"
                Width="184"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0">
            <!-- A ListBox rather than templated RadioButtons: selection is exactly what
                 SelectedValue/SelectedValuePath express, and it avoids binding
                 ConverterParameter, which is not a DependencyProperty and throws at
                 parse time. -->
            <DockPanel>

            <!-- ══ Rail footer: command ownership ══
                 Load-bearing, not decoration. One command queue, one owner: a running
                 recipe and an operator must never be able to fight over the link. -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource StrokeSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Modo" Style="{StaticResource CaptionTextStyle}" />
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{Binding ModeOptions}"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <!-- Disabled with the reason, never hidden: the model the
                                     application is built around should be visible from
                                     the start. -->
                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="{Binding ModeDetail}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding NavigationItems}"
                     SelectedValuePath="Id"
                     SelectedValue="{Binding SelectedNavigationId, Mode=TwoWay}"
                     Margin="8,12"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- On the CONTAINER, not on a child in the DataTemplate: the
                             item's automation peer takes its name from the bound object,
                             so without this a screen reader announces the record's
                             ToString - "NavigationItem { Id = dashboard, Label = ... }". -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Border x:Name="Marker" Width="3"
                                                    HorizontalAlignment="Left"
                                                    Margin="-8,0,0,0"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SurfaceSelectedBrush}" />
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavigationItem}">
                        <StackPanel>
                            <!-- Group rule, no heading: at four destinations a heading
                                 per group costs more height than the grouping saves. -->
                            <Border Height="1" Margin="4,6,4,7"
                                    Background="{DynamicResource StrokeSubtleBrush}"
                                    Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal">
                            <ctl:Icon Key="{Binding Glyph}" Size="20"
                                      Margin="0,0,12,0"
                                      Stroke="{Binding
                                          RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                          Path=Foreground}" />
                            <TextBlock Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding
                                           RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                           Path=Foreground}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ Status bar: run and system context, true on every page ══ -->
        <Border DockPanel.Dock="Bottom"
                Height="32"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Receita:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding RecipeName}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Fase:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding PhaseName}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Decorrido:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding ElapsedText}" Margin="5,0,0,0"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Próxima ação:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding NextActionText}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               ToolTip="Somente o motor de receitas pode saber isto — Fase 3." />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Registro:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding LoggingSummary}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ctl:StateDot State="{Binding SystemState}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SystemStateText}" Style="{StaticResource CaptionTextStyle}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />

                    <!-- A frozen link that keeps showing the last good frame is the
                         failure this application exists to prevent, so the age of the
                         newest frame is permanently on screen. -->
                    <TextBlock Text="Última atualização" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding LastUpdateText}" Margin="5,0,0,0"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTelemetryStale}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StateWarningTextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Variable rail: the variable display ══
             Since D-011 this is where live values are read on every page but Receitas:
             a value beside the drawing of the equipment that produced it. Selection
             here and on the synoptic are one selection seen two ways. -->
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,12,8,12">
                <TextBlock DockPanel.Dock="Top" Text="Variáveis"
                           FontWeight="SemiBold"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,0,0,8" />
                <ListBox ItemsSource="{Binding Variables}"
                         SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                         ItemTemplate="{StaticResource RailRowTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Border x:Name="Marker" Width="3"
                                                        HorizontalAlignment="Left" Margin="-6,0,0,0"
                                                        CornerRadius="2"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Visibility="Collapsed" />
                                                <ContentPresenter />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ Content: one page at a time, chosen by the nav rail ══ -->
        <Grid>

            <!-- Painel -->
            <Grid Visibility="{Binding SelectedNavigationId, Converter={StaticResource EqualsToVis},
                                       ConverterParameter=dashboard}">
        <!-- ══ Content: synoptic + detail pane ══
                 Responsive. At >=1200 px the detail pane sits beside the synoptic so
                 process context is never lost while tuning. Below that it becomes a
                 drawer over the diagram - the same ViewModel in a different template,
                 so behaviour is identical and only presentation changes. -->
            <Grid x:Name="ContentRoot" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SynopticColumn" Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="380" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="DrawerRow" Height="0" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1">
                    <views:SynopticView />
                </Border>

                <!-- Side pane: wide windows.
                     The HOST is what the responsive switch shows or hides; which of the
                     two panes appears inside it is a data question, decided by whether
                     the selected variable has anything to command. Setting Visibility on
                     the pane itself from code-behind would overwrite the binding with a
                     local value and it would never bind again. -->
                <Grid x:Name="SideDetailHost" Grid.Row="0" Grid.Column="1" Margin="16,0,0,0">
                    <views:DetailPaneView
                        DataContext="{Binding SelectedSubsystem}"
                        Visibility="{Binding DataContext.SelectedSubsystem,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource NullToVis}}" />
                    <views:ReadOnlyDetailView
                        DataContext="{Binding SelectedVariable}"
                        Visibility="{Binding DataContext.SelectedSubsystem,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                </Grid>

                <!-- Drawer: narrow windows. Same two panes, same rules - the same
                     ViewModel in a different position, so behaviour is identical and
                     only presentation changes. -->
                <Grid x:Name="DrawerDetailHost" Grid.Row="1" Grid.ColumnSpan="2"
                      Margin="0,12,0,0" Visibility="Collapsed">
                    <views:DetailPaneView
                        DataContext="{Binding SelectedSubsystem}"
                        Visibility="{Binding DataContext.SelectedSubsystem,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource NullToVis}}" />
                    <views:ReadOnlyDetailView
                        DataContext="{Binding SelectedVariable}"
                        Visibility="{Binding DataContext.SelectedSubsystem,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                </Grid>

            </Grid>
            </Grid>

            <!-- Gráficos -->
            <views:ChartsView DataContext="{Binding Charts}"
                              Visibility="{Binding DataContext.SelectedNavigationId,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource EqualsToVis},
                                                   ConverterParameter=charts}" />

            <!-- Registro -->
            <Grid Margin="16"
                  Visibility="{Binding SelectedNavigationId, Converter={StaticResource EqualsToVis},
                                       ConverterParameter=log}">
                <Border CornerRadius="{StaticResource RadiusMedium}"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Iniciar/parar registro"
                                    Command="{Binding ToggleLoggingCommand}" />
                            <TextBlock Text="{Binding SessionLogPath}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="Mensagens do equipamento"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,0,0,6" />

                        <ListBox ItemsSource="{Binding DeviceLog}"
                                 Background="{DynamicResource SurfaceSunkenBrush}"
                                 BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                 BorderThickness="1"
                                 FontFamily="{DynamicResource FontNumeric}"
                                 FontSize="11" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Configurações -->
            <Grid Margin="16"
                  Visibility="{Binding SelectedNavigationId, Converter={StaticResource EqualsToVis},
                                       ConverterParameter=settings}">
                <Border CornerRadius="{StaticResource RadiusMedium}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
