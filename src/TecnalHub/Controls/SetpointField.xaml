<UserControl x:Class="TecnalHub.Controls.SetpointField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:SubsystemViewModel}">

    <!-- ══════════════════════════════════════════════════════════════════════
         The validated setpoint entry. ONE implementation, used by the detail
         pane, the Controle table and later the recipe blocks.

         The rules it enforces are in docs/UI_DESIGN.md section 9, and they exist
         because v.6 wrapped every setpoint parse in a bare except that
         substituted a plausible default - a typo in the pH field sent setpoint 7
         to the reactor and said nothing.
         ══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Style="{StaticResource CaptionTextStyle}"
                   Visibility="{Binding ShowLabel, ElementName=Root, Converter={StaticResource BoolToVis}}" />

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SetpointText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{DynamicResource FontNumeric}"
                     FontSize="15"
                     Typography.NumeralAlignment="Tabular">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <!-- Invalid input is shown as invalid. It is never quietly
                                 replaced with a plausible default, and the command is
                                 not sent. -->
                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <!-- Typed but unacknowledged looks different from confirmed.
                                 v.6 gave no indication at all. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsValid}" Value="True" />
                                    <Condition Binding="{Binding HasPendingChange}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyCommand}" />
                    <KeyBinding Key="Esc" Command="{Binding RevertCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Grid.Column="1" Text="{Binding Unit}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>

        <!-- Range hint, replaced by the error when there is one: two lines of
             advice competing for the same glance is one line too many. -->
        <TextBlock Text="{Binding RangeHint}"
                   Style="{StaticResource CaptionTextStyle}"
                   Margin="0,4,0,0"
                   Visibility="{Binding ValidationError, Converter={StaticResource NullToVis},
                                ConverterParameter=Invert}" />

        <TextBlock Text="{Binding ValidationError}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource StateAlarmTextBrush}"
                   Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}" />

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding HasPendingChange, Converter={StaticResource BoolToVis}}">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                     Fill="{DynamicResource StateWarningBrush}" />
            <TextBlock Text="não aplicado"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource StateWarningTextBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
