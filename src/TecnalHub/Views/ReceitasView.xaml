<UserControl x:Class="TecnalHub.Views.ReceitasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             mc:Ignorable="d" Focusable="True"
             d:DesignHeight="900" d:DesignWidth="1600">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- One scalar editor, chosen from the schema kind. -->
        <DataTemplate x:Key="ScalarFieldTemplate" DataType="{x:Type vm:RecipeParameterFieldViewModel}">
            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                <TextBox Text="{Binding NumberValue, UpdateSourceTrigger=LostFocus}"
                         Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}"
                         Background="{DynamicResource SurfaceInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource StrokeDefaultBrush}" Padding="6,4" />
                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"
                         Background="{DynamicResource SurfaceInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource StrokeDefaultBrush}" Padding="6,4" />
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}" />
                <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" Content="{Binding Label}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- A full field: a scalar, or a repeating list with add/remove rows. -->
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type vm:RecipeParameterFieldViewModel}">
            <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScalarFieldTemplate}"
                                Visibility="{Binding IsList, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                <StackPanel Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecipeListRowViewModel}">
                                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding VisibleFields}"
                                                      ItemTemplate="{StaticResource ScalarFieldTemplate}" />
                                        <Button Content="Remover" Command="{Binding RemoveCommand}"
                                                HorizontalAlignment="Right" Padding="8,2" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Adicionar" Command="{Binding AddRowCommand}" HorizontalAlignment="Left" Padding="10,4" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource SurfaceBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Action bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StrokeDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Receitas" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Content="Salvar" Command="{Binding SaveRecipeCommand}" Margin="20,0,0,0" Padding="12,6" />
                    <Button Content="Carregar" Command="{Binding OpenLibraryCommand}" Margin="8,0,0,0" Padding="12,6" />
                    <Rectangle Width="1" Margin="12,4" Fill="{DynamicResource StrokeDefaultBrush}" />
                    <Button Content="Excluir bloco" Command="{Binding DeleteSelectedCommand}" Padding="12,6" />
                    <Button Content="↶" ToolTip="Desfazer (Ctrl+Z)" Command="{Binding UndoCommand}" Margin="8,0,0,0" Padding="10,6" />
                    <Button Content="↷" ToolTip="Refazer (Ctrl+Y)" Command="{Binding RedoCommand}" Margin="4,0,0,0" Padding="10,6" />
                    <ToggleButton Content="📋 JSON &amp; Validação" IsChecked="{Binding ShowJsonPanel, Mode=TwoWay}" Margin="12,0,0,0" Padding="10,6" ToolTip="Exibir ou ocultar o painel inferior de JSON e Validação" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedTab.ValidationSummary}" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="▶ Iniciar" Command="{Binding StartCommand}" Padding="12,6"
                            Background="{DynamicResource StateOkBrush}" Foreground="{DynamicResource TextOnAccentBrush}" />
                    <Button Content="⏸ Pausar / Retomar" Command="{Binding PauseCommand}" Margin="8,0,0,0" Padding="12,6"
                            Background="{DynamicResource StateWarningBrush}" Foreground="{DynamicResource TextOnAccentBrush}" />
                    <Button Content="⏹ Parar" Command="{Binding StopCommand}" Margin="8,0,0,0" Padding="12,6"
                            Background="{DynamicResource StateAlarmBrush}" Foreground="{DynamicResource TextOnAccentBrush}" />
                    <Border Margin="16,0,0,0" Padding="10,4" CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ElapsedText}" Margin="12,0,0,0"
                                       FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Tabs bar ────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource SurfaceSunkenBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StrokeDefaultBrush}">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Left" Content="Minhas Receitas"
                              IsChecked="{Binding IsLibrarySelected, Mode=OneWay}"
                              Command="{Binding OpenLibraryCommand}" Padding="14,5" Margin="0,0,6,0">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1,1,1,0" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4,4,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1,1,1,2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button DockPanel.Dock="Right" Content="+ Nova Receita" Command="{Binding NewRecipeCommand}" Padding="12,5"
                        Background="{DynamicResource StateOkBrush}" Foreground="{DynamicResource TextOnAccentBrush}" Margin="4,0,0,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecipeTabViewModel}">
                                <Border Margin="0,0,4,0" CornerRadius="4,4,0,0" Padding="0"
                                        Background="{DynamicResource SurfaceCardBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1,1,1,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding TabTitle}" Padding="12,5" BorderThickness="0" Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                                Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                MouseDoubleClick="OnTabTitleDoubleClick" />
                                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                 Padding="12,5" BorderThickness="0" FontSize="12"
                                                 Background="{DynamicResource SurfaceInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 KeyDown="OnTabRenameKeyDown" LostFocus="OnTabRenameLostFocus"
                                                 IsVisibleChanged="OnTabRenameVisibleChanged" />
                                        <Button Content="✕" Padding="6,5" BorderThickness="0" Background="Transparent" FontSize="11"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Library │ Canvas │ Properties ───────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Block palette -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource StrokeDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Library}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BlockLibraryGroup}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,4" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BlockLibraryItem}">
                                                <Button Command="{Binding DataContext.AddBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Type}" HorizontalContentAlignment="Left"
                                                        Background="Transparent" BorderThickness="0" Padding="6,5" ToolTip="Adicionar bloco">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding CategoryColor, Converter={StaticResource HexToBrush}}" />
                                                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Canvas -->
            <Border Grid.Column="1" x:Name="ViewportBorder" ClipToBounds="True" Background="{DynamicResource SurfaceSunkenBrush}"
                    Visibility="{Binding ShowCanvas, Converter={StaticResource BoolToVis}}"
                    MouseDown="OnViewportMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnViewportMouseUp"
                    MouseWheel="OnViewportWheel">
                <Canvas x:Name="CanvasRoot" Background="Transparent">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTransform" />
                            <TranslateTransform x:Name="PanTransform" />
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- Connections -->
                    <ItemsControl ItemsSource="{Binding SelectedTab.Connections}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecipeConnectionViewModel}">
                                <Canvas>
                                    <!-- transparent hit area -->
                                    <Path Data="{Binding RouteGeometry}" Stroke="Transparent" StrokeThickness="12"
                                          MouseLeftButtonDown="OnConnectionMouseDown" />
                                    <Path Data="{Binding RouteGeometry}" StrokeThickness="2" IsHitTestVisible="False">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="{DynamicResource StrokeStrongBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExecuted}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource StateOkBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Polygon Points="{Binding ArrowPoints}" IsHitTestVisible="False">
                                        <Polygon.Style>
                                            <Style TargetType="Polygon">
                                                <Setter Property="Fill" Value="{DynamicResource StrokeStrongBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExecuted}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource StateOkBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Polygon.Style>
                                    </Polygon>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Nodes -->
                    <ItemsControl ItemsSource="{Binding SelectedTab.Nodes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecipeNodeViewModel}">
                                <Border Width="234" Height="{Binding Height}" CornerRadius="6"
                                        Background="{DynamicResource SurfaceCardBrush}" Cursor="Hand"
                                        MouseLeftButtonDown="OnNodeMouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Evaluating">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateActuatingBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Completed">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateOkBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionState}" Value="Error">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <StackPanel>
                                            <Border CornerRadius="6,6,0,0" Height="34"
                                                    Background="{Binding HeaderColor, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextOnAccentBrush}"
                                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="12,0" />
                                            </Border>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Margin="12,8,12,8"
                                                       Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVis}}"
                                                       TextWrapping="Wrap" LineHeight="16" Foreground="{DynamicResource TextSecondaryBrush}" />

                                            <!-- Intervenção Manual button & explanation -->
                                            <StackPanel Visibility="{Binding IsManualIntervention, Converter={StaticResource BoolToVis}}" Margin="10,8,10,0">
                                                <Button Background="{Binding ManualButtonColor, Converter={StaticResource HexToBrush}}"
                                                        BorderThickness="0" Padding="8,6" Cursor="Hand"
                                                        Command="{Binding ToggleManualGateCommand}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding ManualButtonIcon}" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ManualButtonText}" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Text="{Binding ManualExplanationText}" FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,6,2,0" LineHeight="13" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Ports}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding OffsetX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding OffsetY}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:RecipePortViewModel}">
                                                    <Canvas>
                                                        <!-- Glowing ring when connectable target -->
                                                        <Ellipse Width="24" Height="24" Canvas.Left="-12" Canvas.Top="-12"
                                                                 Fill="{DynamicResource StateOkBrush}" Opacity="0.35"
                                                                 IsHitTestVisible="False"
                                                                 Visibility="{Binding IsConnectableTarget, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse.Effect>
                                                                <BlurEffect Radius="6" />
                                                            </Ellipse.Effect>
                                                        </Ellipse>

                                                        <!-- Port anchor dot -->
                                                        <Ellipse x:Name="PortDot" Width="12" Height="12"
                                                                 Fill="{DynamicResource StrokeStrongBrush}"
                                                                 Stroke="{DynamicResource SurfaceCardBrush}" StrokeThickness="1.5"
                                                                 Canvas.Left="-6" Canvas.Top="-6" Cursor="Cross" ToolTip="{Binding Label}"
                                                                 MouseLeftButtonDown="OnPortMouseDown">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource StrokeStrongBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnectableTarget}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource StateOkBrush}" />
                                                                            <Setter Property="Stroke" Value="{DynamicResource StateOkBrush}" />
                                                                            <Setter Property="Width" Value="16" />
                                                                            <Setter Property="Height" Value="16" />
                                                                            <Setter Property="Canvas.Left" Value="-8" />
                                                                            <Setter Property="Canvas.Top" Value="-8" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Stroke" Value="{DynamicResource TextOnAccentBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>

                                                        <!-- Port label text -->
                                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Canvas.Top="-7" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Canvas.Left" Value="12" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnLeft}" Value="False">
                                                                            <Setter Property="Canvas.Left" Value="-58" />
                                                                            <Setter Property="TextAlignment" Value="Right" />
                                                                            <Setter Property="Width" Value="48" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsConnectableTarget}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Connection drag preview -->
                    <Line x:Name="DragPreviewLine" Visibility="Collapsed"
                          Stroke="{DynamicResource StrokeStrongBrush}" StrokeThickness="2"
                          StrokeDashArray="4 2" IsHitTestVisible="False" />
                </Canvas>
            </Border>

            <!-- Minhas Receitas library list -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBaseBrush}"
                    Visibility="{Binding IsLibrarySelected, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="Minhas Receitas" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LibraryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                                                    <Run Text="{Binding BlockCount, Mode=OneWay}" /><Run Text=" blocos · " /><Run Text="{Binding ModifiedUtc, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="Abrir" Padding="10,4"
                                                        Command="{Binding DataContext.OpenRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Duplicar" Padding="10,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.DuplicateRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Excluir" Padding="10,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.DeleteRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Properties -->
            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource StrokeDefaultBrush}">
                <Grid>
                    <TextBlock Text="Selecione um bloco para editar suas propriedades." Margin="16" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding SelectedTab.HasNodeSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedTab.HasNodeSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="16">
                            <TextBlock Text="{Binding SelectedTab.SelectedNode.Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Propriedades do Bloco" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                            <!-- Intervenção Manual properties button & explanation -->
                            <StackPanel Visibility="{Binding SelectedTab.SelectedNode.IsManualIntervention, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                <Button Background="{Binding SelectedTab.SelectedNode.ManualButtonColor, Converter={StaticResource HexToBrush}}"
                                        BorderThickness="0" Padding="12,8" Cursor="Hand"
                                        Command="{Binding SelectedTab.SelectedNode.ToggleManualGateCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedTab.SelectedNode.ManualButtonIcon}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedTab.SelectedNode.ManualButtonText}" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="{Binding SelectedTab.SelectedNode.ManualExplanationText}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,8,2,0" LineHeight="15" />
                            </StackPanel>

                            <!-- Controle Cascata Custom Properties Editor (Dividido em Submenus) -->
                            <StackPanel Visibility="{Binding SelectedTab.SelectedNode.IsCascadeControl, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                
                                <!-- 1. Parâmetros de Operação -->
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <Expander Header="Parâmetros de Operação" IsExpanded="True"
                                              FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="Setpoint de O₂ (%)" FontSize="11" FontWeight="Normal"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="65" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False"
                                                        Value="{Binding SelectedTab.SelectedNode.CascadeSpO2, Mode=TwoWay}"
                                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Grid.Column="1" Text="{Binding SelectedTab.SelectedNode.CascadeSpO2, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}"
                                                         Background="{DynamicResource SurfaceInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                         BorderBrush="{DynamicResource StrokeDefaultBrush}" Padding="4,3" TextAlignment="Center" />
                                            </Grid>

                                            <!-- Intervalo do PID -->
                                            <ContentControl Content="{Binding SelectedTab.SelectedNode.CascadeIntervalField}"
                                                            ContentTemplate="{StaticResource ScalarFieldTemplate}"
                                                            Visibility="{Binding SelectedTab.SelectedNode.CascadeIntervalField, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- 2. Atuadores e Janelas de Atuação -->
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <Expander Header="Atuadores e Faixas de Atuação" IsExpanded="True"
                                              FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="Modo de atuação" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding SelectedTab.SelectedNode.CascadeModoField.Options}"
                                                      SelectedItem="{Binding SelectedTab.SelectedNode.CascadeModoField.SelectedOption, Mode=TwoWay}"
                                                      DisplayMemberPath="Label" Margin="0,0,0,8" />

                                            <!-- Janelas percentuais de alocação: só no modo Cascata -->
                                            <StackPanel Visibility="{Binding SelectedTab.SelectedNode.CascadeUsesWindows, Converter={StaticResource BoolToVis}}">
                                            <!-- Diagrama Visual de Alocação -->
                                            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="4" Padding="8,8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <!-- Barra da Agitação -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Left" Text="Agitação" FontSize="10" Width="50" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <Grid Height="14" Background="{DynamicResource SurfaceSunkenBrush}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding SelectedTab.SelectedNode.AgitationBarStart}" />
                                                                <ColumnDefinition Width="{Binding SelectedTab.SelectedNode.AgitationBarSpan}" />
                                                                <ColumnDefinition Width="{Binding SelectedTab.SelectedNode.AgitationBarRest}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                                    ToolTip="Faixa da Agitação" />
                                                        </Grid>
                                                    </DockPanel>

                                                    <!-- Barra da Aeração -->
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Left" Text="Aeração" FontSize="10" Width="50" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <Grid Height="14" Background="{DynamicResource SurfaceSunkenBrush}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding SelectedTab.SelectedNode.AerationBarStart}" />
                                                                <ColumnDefinition Width="{Binding SelectedTab.SelectedNode.AerationBarSpan}" />
                                                                <ColumnDefinition Width="{Binding SelectedTab.SelectedNode.AerationBarRest}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="1" Background="{DynamicResource StateOkBrush}" CornerRadius="2"
                                                                    ToolTip="Faixa da Aeração" />
                                                        </Grid>
                                                    </DockPanel>

                                                    <!-- Eixo 0 .. 100 -->
                                                    <Grid Margin="50,0,0,0">
                                                        <TextBlock Text="0%" FontSize="9" HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="50%" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="100%" FontSize="9" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>

                                                    <!-- Resumo da sobreposição -->
                                                    <TextBlock Text="{Binding SelectedTab.SelectedNode.CascadeOverlapSummary}" FontSize="10" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" LineHeight="14" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Faixa da Agitação -->
                                            <TextBlock Text="Faixa da Agitação (% do output)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,4" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Início (%)" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding SelectedTab.SelectedNode.CascadeAgitOutMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}"
                                                             Background="{DynamicResource SurfaceInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                             BorderBrush="{DynamicResource StrokeDefaultBrush}" Padding="4,3" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Fim (%)" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding SelectedTab.SelectedNode.CascadeAgitOutMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}"
                                                             Background="{DynamicResource SurfaceInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                             BorderBrush="{DynamicResource StrokeDefaultBrush}" Padding="4,3" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Faixa da Aeração -->
                                            <TextBlock Text="Faixa da Aeração (% do output)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StateOkBrush}" Margin="0,2,0,4" />
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Início (%)" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding SelectedTab.SelectedNode.CascadeAerOutMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}"
                                                             Background="{DynamicResource SurfaceInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                             BorderBrush="{DynamicResource StrokeDefaultBrush}" Padding="4,3" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Fim (%)" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding SelectedTab.SelectedNode.CascadeAerOutMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}"
                                                             Background="{DynamicResource SurfaceInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                             BorderBrush="{DynamicResource StrokeDefaultBrush}" Padding="4,3" />
                                                </StackPanel>
                                            </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- 3. Limites Físicos dos Atuadores -->
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <Expander Header="Limites dos Atuadores" IsExpanded="False"
                                              FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ItemsControl ItemsSource="{Binding SelectedTab.SelectedNode.CascadePhysicalLimitsFields}"
                                                      ItemTemplate="{StaticResource FieldTemplate}" Margin="0,8,0,0" />
                                    </Expander>
                                </Border>

                                <!-- 4. Ganhos por Atuador -->
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <Expander Header="Fatores de Ganho por Atuador" IsExpanded="False"
                                              FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ItemsControl ItemsSource="{Binding SelectedTab.SelectedNode.CascadeRelativeGainsFields}"
                                                      ItemTemplate="{StaticResource FieldTemplate}" Margin="0,8,0,0" />
                                    </Expander>
                                </Border>

                                <!-- 5. Ganhos do Loop Externo e Predição -->
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <Expander Header="Ganhos do Loop Externo / Pred" IsExpanded="False"
                                              FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ItemsControl ItemsSource="{Binding SelectedTab.SelectedNode.CascadeExternalGainsFields}"
                                                      ItemTemplate="{StaticResource FieldTemplate}" Margin="0,8,0,0" />
                                    </Expander>
                                </Border>

                                <!-- 6. Ganhos do Loop Interno (PID) -->
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <Expander Header="Ganhos do Loop Interno (PID)" IsExpanded="False"
                                              FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ItemsControl ItemsSource="{Binding SelectedTab.SelectedNode.CascadeInternalPidFields}"
                                                      ItemTemplate="{StaticResource FieldTemplate}" Margin="0,8,0,0" />
                                    </Expander>
                                </Border>

                                <!-- 7. Anti-Windup e Integrador -->
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <Expander Header="Anti-Windup e Janelas" IsExpanded="False"
                                              FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ItemsControl ItemsSource="{Binding SelectedTab.SelectedNode.CascadeAntiWindupFields}"
                                                      ItemTemplate="{StaticResource FieldTemplate}" Margin="0,8,0,0" />
                                    </Expander>
                                </Border>

                                <!-- 8. Método de Derivação e Taxa -->
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <Expander Header="Método de Derivação / Taxa" IsExpanded="False"
                                              FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ItemsControl ItemsSource="{Binding SelectedTab.SelectedNode.CascadeRateEstimationFields}"
                                                      ItemTemplate="{StaticResource FieldTemplate}" Margin="0,8,0,0" />
                                    </Expander>
                                </Border>

                            </StackPanel>

                            <!-- Generic Fields (for all other nodes) -->
                            <ItemsControl ItemsSource="{Binding SelectedTab.SelectedNode.Fields}"
                                          ItemTemplate="{StaticResource FieldTemplate}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.SelectedNode.IsManualIntervention}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTab.SelectedNode.IsCascadeControl}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ── JSON + findings ─────────────────────────────────────────────── -->
        <Border Grid.Row="3" Height="150" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StrokeDefaultBrush}"
                Visibility="{Binding ShowJsonPanel, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="JSON da Receita" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,6" />
                    <TextBox Text="{Binding SelectedTab.JsonText, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="{DynamicResource FontMono}" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{DynamicResource SurfaceSunkenBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0" Margin="12,0,12,12" />
                </DockPanel>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Validação" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,6" />
                    <ListBox ItemsSource="{Binding SelectedTab.Findings}" Background="Transparent" BorderThickness="0"
                             Margin="12,0,12,12" Foreground="{DynamicResource TextPrimaryBrush}"
                             SelectionChanged="OnFindingSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
