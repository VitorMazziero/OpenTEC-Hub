<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match the app's Windows 10 baseline + UseWPF so its ViewModels can be tested. The setpoint
         validation is safety-critical - it is what stands between a typo and a
         setpoint reaching a reactor - and leaving it untested because the assembly was
         awkward to reference would be the wrong trade. No test starts an Application;
         the ViewModels take interfaces, so they run headless. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OpenTECHub.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Stubs implement interface events that individual tests may not raise. -->
    <NoWarn>$(NoWarn);CS0067</NoWarn>
    <!-- Tests assert on protocol wire format; a stray culture must not turn
         "0.5" into "0,5" and silently pass. Pinned explicitly in the tests. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTECHub.Protocol\OpenTECHub.Protocol.csproj" />
    <ProjectReference Include="..\..\src\OpenTECHub.Simulator\OpenTECHub.Simulator.csproj" />
    <ProjectReference Include="..\..\src\OpenTECHub\OpenTECHub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paper data is test-only: it must never enter the app profile store or selector. -->
    <None Include="..\..\docs\plans\receitas-r61\examples\*.recipe.json"
          Link="RecipeExamples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\fixtures\kla-reference-scipy.json"
                      LogicalName="OpenTECHub.Tests.fixtures.kla-reference-scipy.json" />
    <None Include="..\fixtures\kla-e0\**\*"
          Link="Fixtures\KlaE0\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\kla-e3-python-v1.json"
          Link="Fixtures\kla-e3-python-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
