<Window x:Class="OpenTECHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OpenTECHub.Converters"
        xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
        xmlns:ctl="clr-namespace:OpenTECHub.Controls"
        xmlns:views="clr-namespace:OpenTECHub.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenTEC-Hub"
        Icon="pack://application:,,,/OpenTECHub;component/Resources/Icons/app_icon.ico"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBaseBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Custom chrome: drop the OS caption but keep resize, snap and the taskbar. The top
         48 px is the drag region (matching the header height); the app draws its own
         minimise / maximise / close in that header. See docs/UI_DESIGN.md section 4.1. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:TrendToGlyphConverter x:Key="TrendToGlyph" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EqualsToVisibilityConverter x:Key="EqualsToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Variable rail row: Option B's live instrument index. -->
        <DataTemplate x:Key="RailRowTemplate" DataType="{x:Type vm:ProcessVariableViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}"
                                   FontFamily="{DynamicResource FontNumeric}"
                                   FontSize="16"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Unit}" Margin="4,0,0,2"
                                   VerticalAlignment="Bottom"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <!-- The status dot is the only colour in a normal row. -->
                <ctl:StateDot Grid.Column="1" State="{Binding State}"
                              Label="{Binding DisplayName}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <DockPanel x:Name="ShellRoot">

        <!-- ══ Title bar: identity, run clock, connection chip, window controls ══
             This whole 48 px strip is the WindowChrome caption (drag region). Interactive
             controls carry shell:WindowChrome.IsHitTestVisibleInChrome so they stay
             clickable; everything else drags the window. -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Minimise / maximise / close, flush to the window edge, full height. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Height="48" Style="{StaticResource CaptionMinimizeButtonStyle}" Click="OnMinimizeWindow" />
                    <Button Height="48" Style="{StaticResource CaptionMaximizeButtonStyle}" Click="OnMaximizeRestoreWindow" />
                    <Button Height="48" Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseWindow" />
                </StackPanel>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Application Icon -->
                    <Image Source="pack://application:,,,/OpenTECHub;component/Resources/Icons/app_icon.ico"
                           Width="24" Height="24"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Application Title -->
                    <TextBlock Text="OpenTEC"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontDisplay}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold" />
                    <!-- Version from Git/MSBuild. Short in the header, full in the tooltip. -->
                    <TextBlock Text="{Binding AppVersionShort, StringFormat='v{0}'}"
                               ToolTip="{Binding AppVersion, StringFormat='Build {0}'}"
                               VerticalAlignment="Bottom"
                               Margin="8,0,0,2"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSizeCaption}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Tempo de processo" Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ElapsedText}"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center" />
                    <!-- Local display/log offset only: never resets the device clock, never
                         rewrites samples already logged. Disabled with no live link. -->
                    <Button Content="Zerar"
                            Margin="10,0,0,0" Padding="8,2"
                            FontSize="{DynamicResource FontSizeCaption}"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ZeroSessionTimeCommand}"
                            ToolTip="Zera o tempo da sessão (deslocamento local; não altera o relógio do equipamento nem os dados já gravados)." />
                    <Button Content="Nova Etapa / Corrida"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="8,0,0,0" Padding="8,2"
                            FontSize="{DynamicResource FontSizeCaption}"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding StartQuickSessionCommand}"
                            ToolTip="Inicia uma nova etapa de ensaio com nome personalizado em um novo arquivo e zera o tempo do processo." />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Sensor-module health is independent of the PC link: USB can be
                         perfectly healthy while the module's internal UART is down. -->
                    <Border Padding="8,3" Margin="0,0,8,0"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            ToolTip="O ESP32 não está recebendo dados do módulo de sensores."
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsSensorModuleOffline, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{DynamicResource StateWarningBrush}" />
                            <TextBlock Text="Módulo de sensores offline"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Connection chip. Clicking opens the popover; Configurações is
                         no longer where anyone goes just to connect. -->
                    <ToggleButton x:Name="ConnectionChip"
                                  FocusVisualStyle="{StaticResource KeyboardFocusVisualStyle}"
                                  Padding="10,4"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                  BorderThickness="1"
                                  Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Fill="{Binding Connection.StateKey, Converter={StaticResource StateToBrush}}" />
                            <TextBlock Text="{Binding Connection.StatusText}" VerticalAlignment="Center" />
                            <TextBlock Text="⌄" Margin="7,-3,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=ConnectionChip, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ConnectionChip}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           HorizontalOffset="-180">
                        <Border Width="320" Margin="8"
                                Padding="16"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
                            </Border.Effect>
                            <StackPanel DataContext="{Binding Connection}">

                                <RadioButton Content="USB" Margin="0,0,0,6"
                                             IsChecked="{Binding UseUsb, Mode=TwoWay}" />
                                <Grid Margin="18,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailablePorts}"
                                              SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="⟳" Margin="6,0,0,0" Padding="8,2"
                                            ToolTip="Atualizar portas"
                                            Command="{Binding RefreshPortsCommand}" />
                                </Grid>

                                <RadioButton Content="Wi-Fi" Margin="0,0,0,6"
                                             IsChecked="{Binding UseWiFi, Mode=TwoWay}" />
                                <TextBox Margin="18,0,0,12"
                                         Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <Separator Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Quadros" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FramesReceived}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Comandos" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommandsSent}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Latência" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatencyText}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Último erro" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastError}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               MaxWidth="190" Style="{StaticResource CaptionTextStyle}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Procurar" Margin="0,0,6,0" Padding="10,4"
                                            Command="{Binding DiscoverCommand}" />
                                    <Button Content="Conectar" Margin="0,0,6,0" Padding="10,4"
                                            Command="{Binding ConnectCommand}" />
                                    <Button Content="Parar" Padding="10,4"
                                            Command="{Binding DisconnectCommand}" />
                                </StackPanel>


                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Content="Buscar" Margin="8,0,0,0" Padding="10,4"
                            ToolTip="Pesquisar páginas e comandos (Ctrl+K)"
                            AutomationProperties.Name="Pesquisar páginas e comandos"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OpenCommandPalette_Click" />

                    <Button Margin="8,0,0,0" Padding="10,4" ToolTip="Alternar entre tema claro e escuro" shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleThemeCommand}"><ctl:Icon Key="Theme" Size="20" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                </StackPanel>
            </Grid>
            </DockPanel>
        </Border>

        <!-- ══ Alarm banner (WP4) — full width, above the rails ══
             Shows whenever a system alarm is latched. Each row carries its own Reconhecer,
             so alarms are cleared one at a time; Silenciar is global, lives on this first
             row and only greys out (never disappears) once the audible is off. The chevron
             on the right expands the rest of the currently latched alarms. -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{Binding AlarmState, Converter={StaticResource StateToBrush}}"
                BorderThickness="0,0,0,2"
                Padding="16,7">
            <StackPanel>
                <!-- Headline row. Two columns, not one cell with two overlapping children.
                     Overlapped, the detail ran underneath the buttons: a horizontal
                     StackPanel hands its child infinite width, so the TextTrimming on it
                     could never fire and the end of the sentence was simply hidden. Bounded
                     by a star column the detail wraps instead, and the banner grows a line
                     rather than losing the text. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ctl:StateDot Grid.Column="0" State="{Binding AlarmState}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding AlarmHeadlineText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding AlarmState, Converter={StaticResource StateToBrush}, ConverterParameter=Text}" />
                        <!-- Latch state, so a recovered-but-unacknowledged alarm reads as
                             "Normalizado" rather than as a live fault. -->
                        <TextBlock Grid.Column="2" Text="{Binding AlarmHeadlineStateText}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Column="3" Text="{Binding AlarmMoreText}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Column="4" Text="{Binding AlarmHeadlineDetail}" Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Global, and it stays put: only disabled once nothing is audible. -->
                        <Button Content="Silenciar áudio (10 min)" Padding="10,4" Margin="0,0,8,0"
                                IsEnabled="{Binding IsAlarmAudible}"
                                Command="{Binding SilenceAlarmsCommand}" />
                        <!-- Acknowledges just this headline alarm. -->
                        <Button Content="Reconhecer"
                                Padding="10,4"
                                IsEnabled="{Binding CanAcknowledgeHeadline}"
                                Command="{Binding AcknowledgeHeadlineCommand}" />
                        <!-- Dropdown: reveals every other latched alarm as its own row. -->
                        <Button Margin="8,0,0,0" Padding="10,4"
                                Content="{Binding AlarmExpandLabel}"
                                Visibility="{Binding HasMultipleAlarms, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ToggleAlarmListCommand}"
                                ToolTip="Mostrar ou ocultar os demais alarmes ativos" />
                    </StackPanel>
                </Grid>

                <!-- Expanded: the other currently latched alarms, one row each with its own
                     Reconhecer. -->
                <ItemsControl ItemsSource="{Binding OtherAlarms}"
                              Margin="26,8,0,2"
                              Visibility="{Binding IsAlarmListExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AlarmListItem}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctl:StateDot Grid.Column="0" State="{Binding State}" Margin="0,0,10,0"
                                              VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding State, Converter={StaticResource StateToBrush}, ConverterParameter=Text}" />
                                <TextBlock Grid.Column="2" Text="{Binding StateText}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" Margin="16,0,12,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextStyle}" />
                                <Button Grid.Column="4" Content="Reconhecer" Padding="8,3"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanAcknowledge}"
                                        Command="{Binding DataContext.AcknowledgeAlarmCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══ Navigation rail ══ -->
        <Border x:Name="NavigationRail" DockPanel.Dock="Left"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="200" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNavigationCompact}" Value="True">
                            <Setter Property="Width" Value="56" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- A ListBox rather than templated RadioButtons: selection is exactly what
                 SelectedValue/SelectedValuePath express, and it avoids binding
                 ConverterParameter, which is not a DependencyProperty and throws at
                 parse time. -->
            <DockPanel>
                <DockPanel.Resources>
                    <CollectionViewSource x:Key="NavItems" Source="{Binding NavigationItems}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="GroupName" />
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </DockPanel.Resources>

                <!-- Compact drawer open button: visible when rail is compact -->
                <Button DockPanel.Dock="Top" Height="40" Background="Transparent" BorderThickness="0"
                        Command="{Binding ToggleNavDrawerCommand}"
                        ToolTip="Expandir menu de navegação"
                        Visibility="{Binding IsNavigationCompact, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Stretch" Cursor="Hand">
                    <ctl:Icon Key="Menu" Size="18" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Compact session button: visible when rail is compact -->
                <Button DockPanel.Dock="Bottom" Height="42" Background="Transparent" BorderThickness="0"
                        Command="{Binding ToggleNavDrawerCommand}"
                        ToolTip="{Binding ActiveSessionName, StringFormat='Sessão: {0} (clique para editar)'}"
                        Visibility="{Binding IsNavigationCompact, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Stretch" Cursor="Hand">
                    <ctl:Icon Key="File" Size="18" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

            <!-- ══ Rail footer: Active Session Name (wide mode) ══ -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource StrokeSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,10"
                    Visibility="{Binding IsNavigationCompact,
                                         Converter={StaticResource BoolToVis},
                                         ConverterParameter=Invert}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ctl:Icon Key="File" Size="14" Margin="0,0,6,0" Stroke="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Nome da Sessão" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <TextBox Text="{Binding ActiveSessionName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nome da sessão gravada em Sessoes/. Pressione Enter ou clique em Aplicar."
                             AutomationProperties.Name="Nome da Sessão Ativa"
                             Height="28" Padding="6,2" FontSize="11.5" Margin="0,0,0,6">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding UpdateActiveSessionNameCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Aplicar" HorizontalAlignment="Stretch" Height="28" Padding="8,2" FontSize="11.5"
                            Command="{Binding UpdateActiveSessionNameCommand}"
                            ToolTip="Implementar novo nome de sessão" />
                    <TextBlock Text="✓ Sessão atualizada"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource StateOkBrush}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"
                               Visibility="{Binding IsSessionNameSavedNotificationVisible, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding LoggingSummary}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Source={StaticResource NavItems}}"
                     SelectedValuePath="Id"
                     SelectedValue="{Binding SelectedNavigationId, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" 
                                           FontWeight="SemiBold" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextMutedBrush}" 
                                           Margin="12,8,12,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavigationCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Margin" Value="8,12" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationCompact}" Value="True">
                                <Setter Property="Margin" Value="4,12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
                        <!-- On the CONTAINER, not on a child in the DataTemplate: the
                             item's automation peer takes its name from the bound object,
                             so without this a screen reader announces the record's
                             ToString - "NavigationItem { Id = dashboard, Label = ... }". -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="{Binding Label}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Border x:Name="Marker" Width="3"
                                                    HorizontalAlignment="Left"
                                                    Margin="-8,0,0,0"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SurfaceSelectedBrush}" />
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsNavigationCompact,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Padding" Value="8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavigationItem}">
                        <StackPanel Orientation="Horizontal">
                            <ctl:Icon Key="{Binding Glyph}" Size="20"
                                      Stroke="{Binding GroupColor}" />
                            <TextBlock Text="{Binding Label}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding
                                           RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                           Path=Foreground}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsNavigationCompact,
                                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ Status bar: run and system context, true on every page ══
             A little bottom padding keeps the text off the very edge of the window. -->
        <Border DockPanel.Dock="Bottom"
                Height="34"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,0,0,4">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Receita:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding RecipeName}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Fase:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding PhaseName}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Decorrido:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding ElapsedText}" Margin="5,0,0,0"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Próxima ação:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding NextActionText}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               ToolTip="Somente o motor de receitas pode saber isto — Fase 3." />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />
                    <TextBlock Text="Registro:" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding LoggingSummary}" Margin="5,0,0,0"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ctl:StateDot State="{Binding SystemState}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SystemStateText}" Style="{StaticResource CaptionTextStyle}" />

                    <Rectangle Width="1" Height="14" Margin="14,0"
                               Fill="{DynamicResource StrokeSubtleBrush}" />

                    <!-- A frozen link that keeps showing the last good frame is the
                         failure this application exists to prevent, so the age of the
                         newest frame is permanently on screen. -->
                    <TextBlock Text="Última atualização" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding LastUpdateText}" Margin="5,0,0,0"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTelemetryStale}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StateWarningTextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Variable rail: the variable display ══
             Since D-011 this is where live values are read on every page but Receitas:
             a value beside the drawing of the equipment that produced it. Selection
             here and on the synoptic are one selection seen two ways. -->
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowVariableRail}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Controle already carries every live PV in its table. Hiding
                             the duplicate rail is what "full width" in UI_DESIGN §5.2
                             means and keeps the complete run configuration visible at
                             the 1280 px acceptance width. -->
                        <DataTrigger Binding="{Binding SelectedNavigationId}" Value="control">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedNavigationId}" Value="calibrations">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="12,12,8,12">
                <TextBlock DockPanel.Dock="Top" Text="Variáveis"
                           FontWeight="SemiBold"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,0,0,8" />
                <ListBox ItemsSource="{Binding Variables}"
                         SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                         ItemTemplate="{StaticResource RailRowTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <StackPanel>
                                            <Border Height="1" Margin="4,6,4,7"
                                                    Background="{DynamicResource StrokeSubtleBrush}"
                                                    Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVis}}" />
                                            <Border x:Name="Chrome" Background="Transparent"
                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Border x:Name="Marker" Width="3"
                                                            HorizontalAlignment="Left" Margin="-6,0,0,0"
                                                            CornerRadius="2"
                                                            Background="{DynamicResource AccentBrush}"
                                                            Visibility="Collapsed" />
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ Content: one page at a time, chosen by the nav rail ══ -->
        <Grid>
        <Grid>

            <!-- Painel -->
            <ctl:DeferredPageHost PageId="dashboard"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <Grid Margin="16,4,16,16">
                            <views:SynopticView />
                        </Grid>
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- Controle -->
            <ctl:DeferredPageHost PageId="control"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <views:ControlView DataContext="{Binding Control}" />
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- Históricos: inventário de arquivos e prévia de contrato. O gráfico duplo
     permanece numa página própria e recebe a sessão escolhida sob demanda. -->
            <ctl:DeferredPageHost PageId="history"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <views:HistoricalView DataContext="{Binding Historical}" />
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- Eventos: trilha de auditoria conhecida pelo app, útil em USB e Wi-Fi. -->
            <ctl:DeferredPageHost PageId="events"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <views:EventsView DataContext="{Binding Events}" />
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- Calibrações: pH/O2 são do app; a curva de vazão vai para o hardware. -->
            <ctl:DeferredPageHost PageId="calibrations"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <views:CalibrationView DataContext="{Binding Calibration}" />
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- Configurações -->
            <ctl:DeferredPageHost PageId="settings"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <Grid Margin="16">
                            <Border CornerRadius="{StaticResource RadiusMedium}"
                                    Background="{DynamicResource SurfaceBaseBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1">
                                <views:SettingsView DataContext="{Binding Settings}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- Ensaio e regressão de kLa por gassing-out -->
            <ctl:DeferredPageHost PageId="kla-determination"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <views:KlaDeterminationView DataContext="{Binding KlaDetermination}" />
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- D-008: reconstrução experimental do mapa e publicação imutável da trajetória. -->
            <ctl:DeferredPageHost PageId="kla-mapping"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <views:KlaMappingView DataContext="{Binding KlaMapping}" />
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- Aquisição de potência de impelidor. -->
            <ctl:DeferredPageHost PageId="power"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <views:PowerView DataContext="{Binding PowerTest}" />
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>

            <!-- Receitas: editor gráfico e motor de execução (WP4). -->
            <ctl:DeferredPageHost PageId="recipes"
                                  SelectedPageId="{Binding SelectedNavigationId}">
                <ctl:DeferredPageHost.PageTemplate>
                    <DataTemplate>
                        <views:ReceitasView DataContext="{Binding Receitas}" />
                    </DataTemplate>
                </ctl:DeferredPageHost.PageTemplate>
            </ctl:DeferredPageHost>
        </Grid>

        <!-- ══ Overlay Drawer (compact mode) ══
             Lives in the content Grid, not in the DockPanel flow, so opening it
             overlays the page instead of pushing the layout sideways and
             re-measuring every form the operator is typing into. -->
        <Border Background="{DynamicResource OverlayScrimBrush}" Panel.ZIndex="99"
                Visibility="{Binding IsNavDrawerOpen, Converter={StaticResource BoolToVis}}"
                MouseDown="OnDrawerBackdropMouseDown" />

        <Border HorizontalAlignment="Left" Width="220" Panel.ZIndex="100"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsNavDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="0" Opacity="0.25" />
            </Border.Effect>
            <DockPanel>
                <DockPanel.Resources>
                    <!-- The drawer needs its OWN grouped view: the rail's NavItems key is
                         scoped to the rail DockPanel, and sharing one CollectionViewSource
                         between two Selectors makes them fight over the current item. -->
                    <CollectionViewSource x:Key="NavItemsDrawer" Source="{Binding NavigationItems}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="GroupName" />
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </DockPanel.Resources>

                <Border DockPanel.Dock="Top" Height="40" Padding="12,0"
                        BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Navegação" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloseNavDrawerCommand}" ToolTip="Recolher menu">
                            <ctl:Icon Key="ChevronLeft" Size="16" Stroke="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource StrokeSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ctl:Icon Key="File" Size="14" Margin="0,0,6,0" Stroke="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Nome da Sessão" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBox Text="{Binding ActiveSessionName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nome da sessão gravada em Sessoes/."
                                 AutomationProperties.Name="Nome da Sessão Ativa"
                                 Height="28" Padding="6,2" FontSize="11.5" Margin="0,0,0,6">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding UpdateActiveSessionNameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="Aplicar" HorizontalAlignment="Stretch" Height="28" Padding="8,2" FontSize="11.5"
                                Command="{Binding UpdateActiveSessionNameCommand}"
                                ToolTip="Implementar novo nome de sessão" />
                        <TextBlock Text="✓ Sessão atualizada"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource StateOkBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsSessionNameSavedNotificationVisible, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding LoggingSummary}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Source={StaticResource NavItemsDrawer}}"
                         SelectedValuePath="Id"
                         SelectedValue="{Binding SelectedNavigationId, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="SemiBold" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextMutedBrush}" 
                                               Margin="10,6,10,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Margin" Value="0,0,0,3" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="{Binding Label}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Border x:Name="Marker" Width="3" HorizontalAlignment="Left"
                                                        Margin="-6,0,0,0" CornerRadius="2"
                                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                                <ContentPresenter />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <StackPanel Orientation="Horizontal">
                                <ctl:Icon Key="{Binding Glyph}" Size="18" Stroke="{Binding GroupColor}" />
                                <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Ctrl+K command palette. It stays a Popup so it overlays every destination
             without forcing each page into a second layout container. -->
        <Popup x:Name="CommandPalettePopup"
               IsOpen="{Binding IsCommandPaletteOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=ShellRoot}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="CommandPalettePopup_Opened"
               Closed="CommandPalettePopup_Closed">
            <Border Width="520" MaxHeight="430" Margin="16" Padding="16"
                    DataContext="{Binding DataContext, ElementName=ShellRoot}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.30" />
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Páginas e comandos" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeSubtitle}" />
                            <TextBlock Text="Digite para filtrar · Enter executa · Esc fecha"
                                       Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Fechar" Padding="9,4"
                                Command="{Binding CloseCommandPaletteCommand}" />
                    </Grid>

                    <TextBox x:Name="CommandPaletteSearchBox" DockPanel.Dock="Top"
                             Text="{Binding CommandSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Pesquisar páginas e comandos"
                             PreviewKeyDown="CommandPaletteSearch_PreviewKeyDown" />

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding SelectedCommandPaletteEntry.UnavailableReason}"
                               Margin="4,8,4,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Style="{StaticResource CaptionTextStyle}" />

                    <ListBox x:Name="CommandPaletteResults"
                             Margin="0,10,0,0"
                             MaxHeight="300"
                             ItemsSource="{Binding CommandPaletteResults}"
                             SelectedItem="{Binding SelectedCommandPaletteEntry, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Resultados de comandos"
                             MouseDoubleClick="CommandPaletteResults_MouseDoubleClick"
                             PreviewKeyDown="CommandPaletteResults_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CommandPaletteEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Hint}"
                                               Margin="16,0,0,0"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
        </Grid>
    </DockPanel>
</Window>

