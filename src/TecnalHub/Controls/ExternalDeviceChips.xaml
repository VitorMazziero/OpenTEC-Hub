<UserControl x:Class="TecnalHub.Controls.ExternalDeviceChips"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             x:Name="Root">

    <!-- The three things an operator has to be able to see about an external node,
         in one place. Written once because the flowmeter row's hand-built version was
         twenty lines of Border/TextBlock, and five hand-written copies is how one of
         them eventually stops matching the others. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                DataContext="{Binding Status, ElementName=Root}">

        <!-- Amber: a command left but nothing has confirmed it yet. -->
        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1"
                ToolTip="{Binding PendingStatusText}"
                Visibility="{Binding ShowPendingChip, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="aguardando"
                       FontSize="{Binding ChipFontSize, ElementName=Root}"
                       Foreground="{DynamicResource StateWarningTextBrush}" />
        </Border>

        <!-- Red: the Hub says the node stopped answering. Absent evidence is NOT this
             chip - a device the Hub has never mentioned shows nothing here, because
             telling an operator a device failed when nothing was claimed about it is
             worse than telling them nothing. -->
        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StateAlarmBrush}" BorderThickness="1"
                ToolTip="{Binding PresenceText}"
                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="desconectado"
                       FontSize="{Binding ChipFontSize, ElementName=Root}"
                       Foreground="{DynamicResource StateAlarmTextBrush}" />
        </Border>

        <!-- Amber: the Hub's routing flag and this switch disagree. The Hub persists its
             flags in NVS and the app persists the switches on the PC, so a Hub reboot can
             leave them differing - and from then on the Hub drops that device's
             sub-commands without any reply at all. -->
        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1"
                ToolTip="{Binding CommMismatchText}"
                Visibility="{Binding ShowRoutingChipOnly, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="roteamento"
                       FontSize="{Binding ChipFontSize, ElementName=Root}"
                       Foreground="{DynamicResource StateWarningTextBrush}" />
        </Border>
    </StackPanel>
</UserControl>
