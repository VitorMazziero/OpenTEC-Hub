<Window x:Class="TecnalHub.Views.Dialogs.StartRecipeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Receita"
        Width="560" Height="340"
        MinWidth="480" MinHeight="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Iniciar Execução da Receita"
                   FontFamily="{DynamicResource FontDisplay}"
                   FontSize="{DynamicResource FontSizeTitle}"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Text="{Binding Subtitle}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,8,0,16" />

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}"
                Padding="14"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Como deseja iniciar a operação?" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="• Desligar malhas e Iniciar: Desliga as malhas ativas e zera atuadores antes de iniciar o fluxo da receita."
                           TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Text="• Apenas Iniciar: Inicia a receita mantendo os atuadores e setpoints atuais do biorreator sem modificá-los previamente."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    MinWidth="90"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="Apenas Iniciar"
                    MinWidth="130"
                    Margin="10,0,0,0"
                    Click="StartPreserving_Click" />
            <Button Content="Desligar malhas e Iniciar"
                    MinWidth="180"
                    Margin="10,0,0,0"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="ResetAndStart_Click" />
        </StackPanel>
    </Grid>
</Window>
