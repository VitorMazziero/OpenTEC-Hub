<UserControl x:Class="OpenTECHub.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:OpenTECHub.Converters"
             xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
             xmlns:power="clr-namespace:OpenTECHub.Services.PowerTesting"
             xmlns:views="clr-namespace:OpenTECHub.Views"
             xmlns:ctl="clr-namespace:OpenTECHub.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PowerTestViewModel}"
             d:DesignHeight="900" d:DesignWidth="1500">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <Style x:Key="PowerCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <!-- Subdivisão de um card: um assunto por moldura, em vez de uma pilha de
             rótulos soltos. A coluna tem ~300 DIP úteis, então tudo aqui dentro é
             largura fluida - nada de linha com rótulo e botões disputando a mesma faixa. -->
        <Style x:Key="PowerSubCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="Padding" Value="9" />
        </Style>

        <!-- Atalho para a documentação. A explicação que ficava impressa no card mora
             em Configurações -> Documentação; o card guarda só o caminho até ela. -->
        <Style x:Key="DocHelpButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="?" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Abrir a documentação desta seção" />
        </Style>

        <Style x:Key="PowerMetric" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="PowerTabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Padding="12,4" CornerRadius="{DynamicResource RadiusSmall}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,7" Style="{StaticResource PowerCard}" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <!-- Linha superior: Título, Seletor de abas e Badges contextuais -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Potência" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                        <!-- O assunto acompanha a aba: a página abriga dois destinos. -->
                        <Button Content="?" Width="22" Height="22" Padding="0" Margin="8,0,0,0" FontWeight="SemiBold"
                                VerticalAlignment="Center" ToolTip="Abrir a documentação desta página"
                                Command="{Binding DataContext.OpenDocumentationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="potencia"
                                Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}" />
                        <Button Content="?" Width="22" Height="22" Padding="0" Margin="8,0,0,0" FontWeight="SemiBold"
                                VerticalAlignment="Center" ToolTip="Abrir a documentação do Mapa de Potência"
                                Command="{Binding DataContext.OpenDocumentationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="potencia-mapa"
                                Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                        <!-- Seletor de abas: Mapeamento de Potência | Modelos e Ajustes -->
                        <Border Margin="14,0,10,0" Padding="2"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Mapeamento de Potência"
                                             GroupName="PowerTopTabs"
                                             IsChecked="{Binding IsMappingTabSelected, Mode=TwoWay}"
                                             Style="{StaticResource PowerTabRadioButton}"
                                             ToolTip="Ensaio e aquisição: montagem, telemetria ao vivo, tabela de condições e validação de kLa" />
                                <RadioButton Content="Modelos e Ajustes"
                                             GroupName="PowerTopTabs"
                                             IsChecked="{Binding IsModelsTabSelected, Mode=TwoWay}"
                                             Style="{StaticResource PowerTabRadioButton}"
                                             ToolTip="Superfície de potência interpolada, correlações kLa, gráficos 2D/3D e comparação de impelidores" />
                            </StackPanel>
                        </Border>

                        <!-- Badges contextuais de Mapeamento de Potência -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}">
                            <Border Margin="6,0,0,0" Padding="8,2" Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="{Binding PhaseLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Border Margin="7,0,0,0" Padding="8,2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4">
                                <TextBlock Text="{Binding ResultModeLabel}" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <!-- Badges contextuais de Modelos e Ajustes -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsModelsTabSelected, Converter={StaticResource BoolToVis}}">
                            <Border Margin="6,0,0,0" Padding="8,2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4">
                                <TextBlock Text="{Binding MapViewModel.GridResolutionLabel}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Margin="7,0,0,0" Padding="8,2" CornerRadius="4"
                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1"
                                    Visibility="{Binding MapViewModel.IsSurfaceStale, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Malha desatualizada — reconstrua" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource StateWarningTextBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Linha de status para Mapeamento de Potência -->
                    <StackPanel Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,3,0,0" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Linha de status para Modelos e Ajustes -->
                    <StackPanel Visibility="{Binding IsModelsTabSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,4,0,0" Text="{Binding MapViewModel.StatusMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- Ações contextuais de Mapeamento de Potência -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}">
                    <Button Content="▶ Iniciar/continuar" Margin="3,0" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding StartOrContinueCommand}" IsEnabled="{Binding CanStartOrContinue}" />
                    <Button Content="{Binding PauseButtonLabel}" Margin="3,0" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding CanPause}" />
                    <Button Content="Pular" Margin="3,0" Command="{Binding SkipCurrentCommand}" IsEnabled="{Binding CanSkipCurrent}" />
                    <Button Content="Parar e revisar" Margin="3,0" Command="{Binding StopAndReviewCommand}" IsEnabled="{Binding CanStop}" />
                    <Button Content="Concluir ensaio" Margin="3,0" Command="{Binding CompleteTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                    <Button Content="Interromper" Margin="3,0" Style="{StaticResource DangerButtonStyle}" Command="{Binding AbortTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                </StackPanel>

                <!-- Ações contextuais de Modelos e Ajustes -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsModelsTabSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Novo mapa" VerticalAlignment="Center" Margin="3,0,5,0" Style="{StaticResource PowerLabel}" />
                    <TextBox Width="180" Margin="0,0,5,0" VerticalAlignment="Center" Style="{StaticResource CompactField}"
                             Text="{Binding MapViewModel.NewMapName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nome do mapa que será criado" />
                    <Button Content="Novo mapa" Margin="3,0" Command="{Binding MapViewModel.CreateMapCommand}" />
                    <Button Content="Salvar" Margin="3,0" Command="{Binding MapViewModel.SaveMapCommand}"
                            IsEnabled="{Binding MapViewModel.HasMap}" />
                    <Button Content="↻ Reconstruir superfície" Margin="3,0" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding MapViewModel.ReconstructSurfaceCommand}" IsEnabled="{Binding MapViewModel.HasMap}" />
                    <Button Content="Excluir" Margin="3,0" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding MapViewModel.DeleteMapCommand}" IsEnabled="{Binding MapViewModel.HasMap}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- Conteúdo da Aba 1: Mapeamento de Potência (ensaio, montagem, aquisição, gráficos ao vivo, tabela) -->
            <Grid Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="320" MaxWidth="390" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="430" />
                </Grid.ColumnDefinitions>

            <!-- Fluxo do operador: montagem, aquisição, condições e validação. -->
            <TabControl Grid.Column="0" Style="{StaticResource SingleLineSegmentedControlStyle}">
                <TabItem Header="Montagem" ToolTip="1. Selecione o ensaio e descreva fluido, vaso e impelidores">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                        <StackPanel>
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Ensaio" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Novo" Padding="10,3" HorizontalAlignment="Right"
                                        Command="{Binding CreateTestCommand}" />
                            </Grid>

                            <!-- Subcard 1: qual ensaio está aberto e o que se pode fazer com ele -->
                            <Border Style="{StaticResource PowerSubCard}" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ensaio aberto" Style="{StaticResource PowerLabel}" />
                                    <ComboBox Margin="0,3,0,0" ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}"
                                              DisplayMemberPath="Name" ToolTip="Ensaios autocontidos em Testes-Potencia" />
                                    <Button Content="Carregar Ensaio" Margin="0,6,0,0" Padding="8,4"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding LoadSelectedTestCommand}"
                                            ToolTip="Carrega o ensaio escolhido acima: fluido, geometria, tabela de condições e pontos já medidos" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Renomear" Command="{Binding RenameTestCommand}"
                                                IsEnabled="{Binding CanManageTest}" Padding="8,3" ToolTip="Renomeia o ensaio aberto e sua pasta" />
                                        <Button Grid.Column="2" Content="Reabrir" Command="{Binding ReopenTestCommand}"
                                                IsEnabled="{Binding CanReopenTest}" Padding="8,3"
                                                ToolTip="Volta um ensaio concluído a 'Interrompido': tabela editável e sequência continuável, pontos aceitos mantidos" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Duplicar" Command="{Binding DuplicateTestCommand}"
                                                IsEnabled="{Binding CanManageTest}" Padding="8,3"
                                                ToolTip="Novo ensaio com o mesmo fluido, geometria, calibração, tara, critérios e tabela — contadores zerados, sem pontos" />
                                        <Button Grid.Column="2" Content="Excluir" Command="{Binding DeleteTestCommand}"
                                                IsEnabled="{Binding CanManageTest}" Padding="8,3" Style="{StaticResource DangerButtonStyle}"
                                                ToolTip="Move o ensaio aberto para a lixeira interna" />
                                    </Grid>
                                    <TextBlock Margin="0,7,0,0" Text="{Binding TestStatusLabel}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               ToolTip="Rascunhos e ensaios interrompidos podem ter sua tabela editada enquanto estão parados" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding TestRootDirectory}" Style="{StaticResource CaptionTextStyle}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TestRootDirectory}" />
                                </StackPanel>
                            </Border>

                            <!-- Subcard 2: a tara que este ensaio aplica -->
                            <Border Style="{StaticResource PowerSubCard}" Margin="0,6,0,0" IsEnabled="{Binding CanEditPlan}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Tara do ensaio" Style="{StaticResource PowerLabel}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource DocHelpButton}"
                                                Command="{Binding DataContext.OpenDocumentationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="potencia-tara" />
                                    </Grid>
                                    <ComboBox Margin="0,3,0,0" ItemsSource="{Binding TareProfiles}" SelectedItem="{Binding SelectedTareProfile}" DisplayMemberPath="Name" />
                                    <Button Content="Usar tara selecionada" Command="{Binding ApplyTareProfileCommand}" Padding="8,3" Margin="0,6,0,0" />
                                    <Button Content="Sem tara (relativo)" Command="{Binding UseNoTareCommand}" Padding="8,3" Margin="0,5,0,0" />
                                    <TextBlock Margin="0,7,0,0" Text="{Binding TareStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <!-- Aviso de preflight: aparece quando necessário (qualquer aviso de bloqueio) embaixo da string do path -->
                            <Border Margin="0,6,0,0" Padding="8,4" CornerRadius="4"
                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource StateWarningBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding HasPreflightWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PreflightMessage}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StateWarningTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7" IsEnabled="{Binding CanEditPlan}">
                        <StackPanel>
                            <TextBlock Text="Fluido e vaso" FontSize="15" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,7,0,6">
                                <Button Content="Água 20 °C" Padding="8,3" Margin="0,0,5,0" Command="{Binding ApplyWaterPresetCommand}" CommandParameter="20" />
                                <Button Content="Água 25 °C" Padding="8,3" Margin="0,0,5,0" Command="{Binding ApplyWaterPresetCommand}" CommandParameter="25" />
                                <Button Content="Água 30 °C" Padding="8,3" Command="{Binding ApplyWaterPresetCommand}" CommandParameter="30" />
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="ρ (kg/m³)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding DensityKgM3, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="μ (Pa·s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding ViscosityPaS, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Temperatura (°C)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding TemperatureC, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="T vaso (mm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding VesselDiameterMm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Volume de trabalho (L)" Style="{StaticResource PowerLabel}" /><TextBox Width="145" HorizontalAlignment="Left" Style="{StaticResource CompactField}" Text="{Binding LiquidVolumeL, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <CheckBox Grid.Column="1" Content="Com chicanas" IsChecked="{Binding IsBaffled}" VerticalAlignment="Bottom" Margin="8,0,0,5" />
                            </Grid>
                            <TextBlock Margin="0,7,0,0" Text="{Binding VortexWarning}" Foreground="{DynamicResource StateWarningTextBrush}" TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Impelidores no eixo" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ImpellerSetHash, StringFormat=hash {0}}" Style="{StaticResource CaptionTextStyle}" />
                            </Grid>
                            <DataGrid Margin="0,7,0,5" Height="150" ItemsSource="{Binding Impellers}" SelectedItem="{Binding SelectedImpeller}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" IsEnabled="{Binding CanEditPlan}"
                                      HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding StageIndex}" Width="28" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Nome" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectImpellerForStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.CanEditPlan, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="6,2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="Clique para selecionar modelo do catálogo">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="▾" DockPanel.Dock="Right" Margin="4,0,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Np" Binding="{Binding LiteratureNp, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="58" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <Button Content="+" Width="34" Margin="0,0,5,0" Command="{Binding AddImpellerCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Adicionar estágio" />
                                <Button Content="−" Width="34" Margin="0,0,5,0" Command="{Binding RemoveImpellerCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Remover estágio selecionado" />
                                <Button Content="↑" Width="34" Margin="0,0,5,0" Command="{Binding MoveImpellerUpCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Mover para cima" />
                                <Button Content="↓" Width="34" Margin="0,0,0,0" Command="{Binding MoveImpellerDownCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Mover para baixo" />
                            </WrapPanel>
                            <Button Content="📖 Catálogo de impelidores..." Margin="0,7,0,0" Padding="10,5" HorizontalAlignment="Left" Command="{Binding OpenImpellerCatalogCommand}" ToolTip="Abrir biblioteca de modelos de impelidores para gerenciar ou adicionar ao eixo" />
                        </StackPanel>
                    </Border>

                    <Button Content="Salvar Preferências" Margin="0,0,0,7" Padding="10,5" HorizontalAlignment="Right"
                            Command="{Binding SaveSetupCommand}" IsEnabled="{Binding CanEditPlan}"
                            ToolTip="Salva fluido, vaso, impelidores, critérios e tabela do ensaio aberto" />

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Aquisição" ToolTip="2. Configure parâmetros de captura automática e gerencie a tabela de condições">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                        <StackPanel>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7" IsEnabled="{Binding CanEditPlan}">
                        <StackPanel>
                            <TextBlock Text="Captura automática" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                                       Text="Define as faixas de rotação e vazão para a geração da grade de condições e os critérios estatísticos de parada." />
                            <!-- Faixa de Agitação (N) -->
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="N mín. (rpm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MinRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="N máx. (rpm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Passo N (rpm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StepRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <!-- Faixa de Vazão de Ar (Qg) -->
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Qg mín. (L/min)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MinFlowLpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Qg máx. (L/min)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxFlowLpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Passo Qg (L/min)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StepFlowLpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <!-- Botões de Ação da Tabela -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Gerar tabela" Padding="8,4" Command="{Binding GenerateConditionsPlanCommand}" IsEnabled="{Binding CanEditPlan}"
                                        ToolTip="Gera a grade N × Qg com os parâmetros definidos acima" />
                                <Button Grid.Column="2" Content="Limpar tabela" Padding="8,4" Command="{Binding ClearAllConditionsCommand}" IsEnabled="{Binding CanEditPlan}"
                                        ToolTip="Limpa todos os pontos da tabela de condições" />
                            </Grid>
                            <Button Margin="0,6,0,0" Content="⚙ Critérios de parada e opções..." Padding="8,4" Command="{Binding OpenCaptureSettingsCommand}"
                                    ToolTip="Abre mini janela com critérios estatísticos de parada (§12), estabilização no alívio e captura manual de energia" />
                        </StackPanel>
                    </Border>

                    <!-- Card de Condições de Ensaio -->
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="Condições do ensaio" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                                       Text="Sequência de pontos planejados para o ensaio. Edite as células ou use os botões abaixo; as alterações são salvas automaticamente. Durante o ensaio a tabela fica somente leitura e acompanha a condição em curso." />
                            <!-- Navigable during the assay: read-only, not disabled, so the operator can scroll and select
                                 to see where the sequence is. Selection alone never persists (§N). -->
                            <DataGrid x:Name="ConditionsGrid" Margin="0,7,0,5" Height="220" ItemsSource="{Binding Conditions}" SelectedItem="{Binding SelectedCondition}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="{Binding CanEditPlan, Converter={StaticResource InverseBool}}"
                                      HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.ScrollChanged="OnConditionsGridScrollChanged">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static power:PowerConditionStatus.InProgress}">
                                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="Auto" MinWidth="34" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="N" Binding="{Binding AgitationRpm, UpdateSourceTrigger=LostFocus}" Width="55" />
                                    <DataGridTextColumn Header="Qg" Binding="{Binding GasFlowLpm, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}, TargetNullValue='0'}" Width="55" />
                                    <DataGridTextColumn Header="Rep." Binding="{Binding ReplicatesDisplay, UpdateSourceTrigger=LostFocus}" Width="52" />
                                    <DataGridTemplateColumn Header="Status" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Pendente" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="{x:Static power:PowerConditionStatus.InProgress}"><Setter Property="Text" Value="Em curso" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static power:PowerConditionStatus.Completed}"><Setter Property="Text" Value="Concluída" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static power:PowerConditionStatus.Skipped}"><Setter Property="Text" Value="Pulada" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <Button Content="+" Width="34" Margin="0,0,4,0" Command="{Binding AddConditionCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Adicionar ponto" />
                                <Button Content="−" Width="34" Margin="0,0,4,0" Command="{Binding RemoveConditionCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Remover ponto selecionado" />
                                <Button Content="↑" Width="34" Margin="0,0,4,0" Command="{Binding MoveConditionUpCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Mover para cima" />
                                <Button Content="↓" Width="34" Margin="0,0,4,0" Command="{Binding MoveConditionDownCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Mover para baixo" />
                                <Button Content="Pular/repor" Padding="8,4" Command="{Binding ToggleSkipConditionCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Alternar pular/repor condição selecionada" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Conferência manual após a tabela de condições -->
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Ponto único" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource DocHelpButton}"
                                        Command="{Binding DataContext.OpenDocumentationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="potencia-ponto-unico" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="N (rpm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding SinglePointRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Qg (L/min)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding SinglePointFlowLpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Comandar" Style="{StaticResource AccentButtonStyle}" Command="{Binding StartSinglePointCommand}" IsEnabled="{Binding IsSinglePointActive, Converter={StaticResource InverseBool}}" Padding="6,4" ToolTip="Liga o motor e o fluxo de ar na condição especificada" />
                                <Button Grid.Column="2" Content="Parar eixo" Command="{Binding StopSinglePointCommand}" IsEnabled="{Binding IsSinglePointActive}" Padding="6,4" ToolTip="Para o motor com segurança" />
                            </Grid>
                            <Button Margin="0,6,0,0" Content="Adicionar à tabela de condições" Command="{Binding AddSinglePointToTestCommand}" Padding="6,3" ToolTip="Insere este ponto (N e Qg) na grade do ensaio" />
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Validação" ToolTip="3. Meça a tara do eixo, realize conferências manuais e avalie correlações">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                        <StackPanel>

                    <!-- Card 1: Tara do Eixo (Calibração do Sistema) -->
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Tara do eixo" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource DocHelpButton}"
                                        Command="{Binding DataContext.OpenDocumentationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="potencia-tara" />
                            </Grid>

                            <!-- Estado e ação em linhas próprias: na coluna de 340 DIP os dois
                                 lado a lado cortavam o texto do estado. -->
                            <TextBlock Margin="0,7,0,0" Text="{Binding TareStatus}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       ToolTip="Status da tara do eixo aplicada no ensaio." />
                            <Button Margin="0,6,0,6" Content="Medir nova tara" Padding="8,4" HorizontalAlignment="Stretch"
                                    Command="{Binding TareMeasurementInfoCommand}"
                                    ToolTip="Abre os controles de varredura estatística no ar com vaso seco" />

                            <!-- Assistente de varredura no ar -->
                            <Border Visibility="{Binding IsTareAssistantOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="8" Margin="0,4,0,6">
                                <StackPanel>
                                    <TextBlock Text="Varredura no ar · vaso seco" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                                        <Run Text="Perfil: " />
                                        <Run Text="{Binding TareProfileName}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="N ini" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding TareStartRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="N fim" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding TareEndRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Passo" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding TareStepRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                    </Grid>

                                    <TextBlock Margin="0,6,0,4" Text="{Binding TareProgressMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <!-- Larguras proporcionais, não fixas: sete colunas fixas somavam mais
                                         que a coluna inteira e o operador lia cabeçalho cortado. -->
                                    <DataGrid Height="140" Margin="0,3,0,4" ItemsSource="{Binding CurrentTarePoints}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N" Binding="{Binding Rpm, StringFormat={}{0:F0}}" Width="*" MinWidth="34" />
                                            <DataGridTextColumn Header="N méd" Binding="{Binding MeanRpmMeasured, StringFormat={}{0:F1}}" Width="*" MinWidth="44" />
                                            <DataGridTextColumn Header="P₀ (W)" Binding="{Binding PVoidW, StringFormat={}{0:F3}}" Width="*" MinWidth="48" />
                                            <DataGridTextColumn Header="±IC95" Binding="{Binding PVoidCi95W, StringFormat={}{0:F3}}" Width="*" MinWidth="46" />
                                            <DataGridTextColumn Header="στ %" Binding="{Binding SigmaTauPercent, StringFormat={}{0:F3}}" Width="*" MinWidth="40" />
                                            <DataGridTextColumn Header="n" Binding="{Binding SampleCount}" Width="Auto" MinWidth="26" />
                                            <DataGridTextColumn Header="Tent" Binding="{Binding Attempts}" Width="Auto" MinWidth="30" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Iniciar ensaio no ar" Style="{StaticResource AccentButtonStyle}" Command="{Binding StartTareSweepCommand}" IsEnabled="{Binding IsTareRunning, Converter={StaticResource InverseBool}}" Padding="8,4" />
                                        <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelTareSweepCommand}" IsEnabled="{Binding IsTareRunning}" Padding="8,4" />
                                        <Button Grid.Column="4" Content="Fechar" Command="{Binding CloseTareAssistantCommand}" IsEnabled="{Binding IsTareRunning, Converter={StaticResource InverseBool}}" Padding="8,4" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Biblioteca de taras: uma curva por eixo, compartilhada entre ensaios -->
                            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="7" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Perfis de tara por eixo" FontWeight="SemiBold" Margin="0,0,0,5" />

                                    <!-- Perfil existente na biblioteca -->
                                    <TextBlock Text="Perfil existente:" Style="{StaticResource PowerLabel}" Margin="0,2,0,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding TareProfiles}" SelectedItem="{Binding SelectedTareProfile}" DisplayMemberPath="Name" ToolTip="Selecione um perfil de tara arquivado" />
                                        <Button Grid.Column="2" Content="Usar no ensaio" Padding="8,4" Command="{Binding ApplyTareProfileCommand}"
                                                IsEnabled="{Binding IsTareRunning, Converter={StaticResource InverseBool}}"
                                                ToolTip="Usa a curva arquivada deste eixo no ensaio aberto, sem repetir a varredura no ar" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Renomear" Padding="8,3" Command="{Binding RenameTareProfileCommand}"
                                                IsEnabled="{Binding IsTareRunning, Converter={StaticResource InverseBool}}"
                                                ToolTip="Renomeia o perfil de tara selecionado na biblioteca" />
                                        <Button Grid.Column="2" Content="Excluir" Padding="8,3" Command="{Binding DeleteTareProfileCommand}"
                                                IsEnabled="{Binding IsTareRunning, Converter={StaticResource InverseBool}}"
                                                ToolTip="Exclui o perfil selecionado da biblioteca de taras" />
                                    </Grid>

                                    <TextBlock Margin="0,6,0,0" Text="Uma nova medição é arquivada automaticamente com o nome informado antes do ensaio." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <DataGrid Height="140" Margin="0,4,0,0" ItemsSource="{Binding SelectedTareProfilePoints}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTareProfilePoints.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N (rpm)" Binding="{Binding Rpm, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="46" />
                                    <DataGridTextColumn Header="P vaz (W)" Binding="{Binding PVoidW, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" Width="*" MinWidth="46" />
                                    <DataGridTextColumn Header="στ %" Binding="{Binding SigmaTauPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" Width="*" MinWidth="40" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Correlação de Potência Elétrica Externa -->
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Correlação elétrica" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource DocHelpButton}"
                                        Command="{Binding DataContext.OpenDocumentationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="potencia-correlacao-eletrica" />
                            </Grid>
                            <TextBlock Text="{Binding EnergyCorrelationSummary}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,6" />
                            <!-- Cabeçalhos curtos e larguras proporcionais: "Pot. Mecânica (W)" em
                                 112 DIP fixos não cabia na coluna e chegava cortado ao operador. -->
                            <DataGrid Height="125" ItemsSource="{Binding ManualEnergyReadings}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N" Binding="{Binding Rpm, StringFormat={}{0:F0}}" Width="Auto" MinWidth="34" />
                                    <DataGridTextColumn Header="P mec (W)" Binding="{Binding PowerMechanicalWAtReading, StringFormat={}{0:F1}}" Width="*" MinWidth="66" />
                                    <DataGridTextColumn Header="P elét (W)" Binding="{Binding PowerElectricalW, StringFormat={}{0:F1}}" Width="*" MinWidth="66" />
                                    <DataGridTextColumn Header="Instrumento" Binding="{Binding Instrument}" Width="*" MinWidth="72" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <!-- WrapPanel, not nine star columns: on a narrow results area the columns
                             squeezed every metric to ~65 DIP and cut the units off. Wrapping keeps
                             each reading whole and simply uses a second line. -->
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,6" MinWidth="86"><TextBlock Text="N medida" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentRpmText}" Style="{StaticResource PowerMetric}" /><TextBlock Text="rpm" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                            <StackPanel Margin="0,0,16,6" MinWidth="86"><TextBlock Text="Torque" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentTorqueNmText}" Style="{StaticResource PowerMetric}" /><TextBlock Style="{StaticResource CaptionTextStyle}"><Run Text="N·m · " /><Run Text="{Binding CurrentTorquePercentText, Mode=OneWay}" /><Run Text=" %" /></TextBlock></StackPanel>
                            <StackPanel Margin="0,0,16,6" MinWidth="86"><TextBlock Text="P líquida" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentPowerWText}" Style="{StaticResource PowerMetric}" /><TextBlock Text="W" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                            <StackPanel Margin="0,0,16,6" MinWidth="86">
                                <TextBlock Text="Qg medida" Style="{StaticResource PowerLabel}" />
                                <TextBlock Text="{Binding CurrentFlowText}" Style="{StaticResource PowerMetric}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"><Run Text="L/min · " /><Run Text="{Binding CurrentFlowVvmText, Mode=OneWay}" /><Run Text=" vvm" /></TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,6" MinWidth="86"><TextBlock Text="Np" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentNpText}" Style="{StaticResource PowerMetric}" /></StackPanel>
                            <StackPanel Margin="0,0,16,6" MinWidth="86"><TextBlock Text="Re" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentReText}" Style="{StaticResource PowerMetric}" /></StackPanel>
                            <StackPanel Margin="0,0,16,6" MinWidth="86"><TextBlock Text="Fr" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentFrText, Mode=OneWay}" Style="{StaticResource PowerMetric}" /></StackPanel>
                            <StackPanel Margin="0,0,16,6" MinWidth="86"><TextBlock Text="PG / P₀ inst." Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentPowerRatioText}" Style="{StaticResource PowerMetric}" /></StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="Malha de gás" Style="{StaticResource PowerLabel}" />
                                <Border Padding="8,4" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Reator (A)">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Ar por C · estabilizando">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateWarningBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Descarga + N₂ (B/C)">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateWarningBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Gás sem destino">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="A e B/C abertas">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding GasLoopStatusBadge}" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Reator (A)">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Ar por C · estabilizando">
                                                        <Setter Property="Foreground" Value="{DynamicResource StateWarningTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Descarga + N₂ (B/C)">
                                                        <Setter Property="Foreground" Value="{DynamicResource StateWarningTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Gás sem destino">
                                                        <Setter Property="Foreground" Value="{DynamicResource StateAlarmBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="A e B/C abertas">
                                                        <Setter Property="Foreground" Value="{DynamicResource StateAlarmBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Precisão adaptativa" FontWeight="SemiBold" />
                                <ProgressBar Margin="0,7,0,3" Height="12" Minimum="0" Maximum="100" Value="{Binding CiProgressPercent, Mode=OneWay}" />
                                <TextBlock Text="{Binding CiLabel}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Progresso da sequência" FontWeight="SemiBold" />
                                <ProgressBar Margin="0,7,0,3" Height="12" Minimum="0" Maximum="100" Value="{Binding SequenceProgressPercent, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SequenceProgressLabel}" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text=" · " Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{Binding EtaLabel}" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Below 900 DIP the two plots would be ~290 DIP each: an axis, a legend
                         and no room for the curve. One at a time instead, picked here. -->
                    <StackPanel x:Name="PowerChartTabs" Orientation="Horizontal" Margin="0,0,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=PowerChartsRow}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <RadioButton x:Name="PowerChartTabLive" GroupName="PowerCharts" Style="{StaticResource CompactSectionTabStyle}"
                                     Content="Torque e rotação" IsChecked="True" ToolTip="Torque e rotação medidos ao longo do ensaio" />
                        <RadioButton x:Name="PowerChartTabCurves" GroupName="PowerCharts" Style="{StaticResource CompactSectionTabStyle}"
                                     Content="Np × Re" ToolTip="Curva adimensional do ensaio" />
                    </StackPanel>

                    <Grid x:Name="PowerChartsRow" ctl:Responsive.NarrowBelow="900" MinHeight="330" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="6">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PowerCard}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=PowerChartsRow}" Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=PowerChartTabLive}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=PowerChartsRow}" Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=PowerChartTabLive}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <DockPanel Margin="5,2,5,4">
                                    <TextBlock Text="Torque e rotação vs. tempo" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Width="14" Height="3" Background="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="Torque" Style="{StaticResource CaptionTextStyle}" />
                                        <Border Width="14" Height="3" Background="{DynamicResource StateOkBrush}" Margin="10,0,4,0" VerticalAlignment="Center" /><TextBlock Text="rpm" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="LiveChartHost" Grid.Row="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsAccumulating}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Padding="6">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PowerCard}">
                                    <!-- In the style, not as an attribute: a local Grid.Column
                                         would outrank the compact-mode setter below. -->
                                    <Setter Property="Grid.Column" Value="2" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=PowerChartsRow}" Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=PowerChartTabCurves}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=PowerChartsRow}" Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=PowerChartTabCurves}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="5,2,5,4">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Np × Re" GroupName="PowerResultCharts"
                                                     IsChecked="{Binding ShowPowerRatioChart, Converter={StaticResource InverseBool}, Mode=OneWay}"
                                                     Checked="NpChart_Checked"
                                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <RadioButton Content="P_G/P₀ × Fl_G / Fr" GroupName="PowerResultCharts"
                                                     IsChecked="{Binding ShowPowerRatioChart, Mode=OneWay}"
                                                     Checked="PowerRatioChart_Checked"
                                                     VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <Border x:Name="NpChartHost" Visibility="{Binding ShowPowerRatioChart, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    <Border x:Name="PowerRatioChartHost" Visibility="{Binding ShowPowerRatioChart, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource PowerCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pontos capturados" FontSize="15" FontWeight="SemiBold" />
                                    <Border Margin="8,0,0,0" Padding="7,2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4"><TextBlock Text="{Binding PrecisionBadge}" FontSize="10" /></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Exportar CSV" Click="ExportCsv_Click" Padding="10,4" IsEnabled="{Binding HasActiveTest}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,7,0,7" Orientation="Horizontal" Visibility="{Binding CanAcceptRun, Converter={StaticResource BoolToVis}}">
                                <Button Content="Aceitar" Style="{StaticResource AccentButtonStyle}" Command="{Binding AcceptRunCommand}" Margin="0,0,6,0" />
                                <Button Content="Rejeitar" Command="{Binding RejectRunCommand}" Margin="0,0,6,0" />
                                <Button Content="Repetir" Command="{Binding RepeatRunCommand}" />
                            </StackPanel>
                            <!-- A run that stopped before capturing is not a result: no accept, no P/IC95/Np (D-050). -->
                            <Border Grid.Row="1" Margin="0,7,0,7" Padding="10,8" Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                                    Visibility="{Binding IsReviewingUnperformedRun, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="Repetir" Style="{StaticResource AccentButtonStyle}" Command="{Binding RepeatRunCommand}" Margin="0,0,6,0" />
                                        <Button Content="Rejeitar" Command="{Binding RejectRunCommand}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Corrida não realizada" FontWeight="SemiBold" Foreground="{DynamicResource StateWarningTextBrush}" />
                                        <TextBlock Text="{Binding ReviewNoCaptureText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Margin="0,7,0,7" Style="{StaticResource PowerCard}" Padding="10" Visibility="{Binding IsWaitingManualEnergy, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Condição mantida (Holding): Registre a leitura do wattímetro da tomada." FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" /><ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="P elétrica (W):" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox Grid.Column="1" Style="{StaticResource CompactField}" Text="{Binding ManualEnergyWattsInput, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="3" Text="Aparelho:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox Grid.Column="4" Style="{StaticResource CompactField}" Text="{Binding ManualEnergyInstrument, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="6" Text="Nota:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox Grid.Column="7" Style="{StaticResource CompactField}" Text="{Binding ManualEnergyNote, UpdateSourceTrigger=LostFocus}" />
                                        <Button Grid.Column="9" Content="Confirmar leitura" Style="{StaticResource AccentButtonStyle}" Command="{Binding ConfirmManualEnergyCommand}" Padding="10,4" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="ResultsDataGrid" Grid.Row="2" Margin="0,8,0,0" Height="220" ItemsSource="{Binding Results}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" Sorting="ResultsDataGrid_Sorting" Loaded="ResultsDataGrid_Loaded">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N (rpm)" Binding="{Binding Rpm}" SortMemberPath="MeanRpm" Width="68" />
                                    <DataGridTextColumn Header="Qg (L/min)" Binding="{Binding GasFlowLpm}" SortMemberPath="GasFlowLpmNumber" Width="80" />
                                    <DataGridTextColumn Header="Torque (N·m)" Binding="{Binding NetTorque}" SortMemberPath="NetTorqueNm" Width="98" />
                                    <DataGridTextColumn Header="Potência (W)" Binding="{Binding Power}" SortMemberPath="NetPowerW" Width="94" />
                                    <DataGridTextColumn Header="PG/P₀ ± IC" Binding="{Binding PowerRatio}" SortMemberPath="Ratio" Width="110" />
                                    <DataGridTextColumn Header="Np ± IC" Binding="{Binding Np}" SortMemberPath="PowerNumber" Width="110" />
                                    <DataGridTextColumn Header="Re" Binding="{Binding Re}" SortMemberPath="ReynoldsNumber" Width="80" />
                                    <DataGridTextColumn Header="Parada" Binding="{Binding StopReason}" SortMemberPath="StopReason" Width="125" />
                                    <DataGridTextColumn Header="Tent." Binding="{Binding Attempts}" Width="48" />
                                    <DataGridTemplateColumn Header="Status" SortMemberPath="SortPhasePriority" Width="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Aceito"><Setter Property="Fill" Value="{DynamicResource StateOkBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Rejeitado"><Setter Property="Fill" Value="{DynamicResource StateAlarmBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Em revisão"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Interrompido"><Setter Property="Fill" Value="{DynamicResource StateAlarmBrush}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Ação" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Mudar status" Padding="6,2" Command="{Binding DataContext.CycleResultStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding DataContext.CanChangeResultStatus, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        ToolTip="Alterna entre Aceito e Rejeitado" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Data e Hora" Binding="{Binding Timestamp}" SortMemberPath="SortTimestamp" Width="145" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <!-- Conteúdo da Aba 2: Modelos e Ajustes (conteúdo de PowerMapView sem cabeçalho duplicado) -->
            <Grid Visibility="{Binding IsModelsTabSelected, Converter={StaticResource BoolToVis}}">
                <views:PowerMapView DataContext="{Binding MapViewModel}" ShowHeader="False" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
