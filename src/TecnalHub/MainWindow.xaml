<Window x:Class="TecnalHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TecnalHub.Converters"
        xmlns:vm="clr-namespace:TecnalHub.ViewModels"
        xmlns:views="clr-namespace:TecnalHub.Views"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TECNAL-Hub"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBaseBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:TrendToGlyphConverter x:Key="TrendToGlyph" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EqualsConverter x:Key="Equals" />

        <!-- KPI tile: one live reading, pinned across every page. -->
        <DataTemplate x:Key="KpiTileTemplate" DataType="{x:Type vm:ProcessVariableViewModel}">
            <Border Margin="0,0,8,0"
                    Padding="12,6"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectVariableCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding FormattedValue}"
                                   FontFamily="{DynamicResource FontNumeric}"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Unit}"
                                   Margin="3,0,0,2"
                                   VerticalAlignment="Bottom"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding Trend, Converter={StaticResource TrendToGlyph}}"
                                   Margin="6,0,0,2"
                                   VerticalAlignment="Bottom"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Agitation has no RPM feedback on the wire, so its figure is a
                         command, not a measurement. Saying so is the honest thing. -->
                    <TextBlock Text="comandado"
                               Style="{StaticResource CaptionTextStyle}"
                               FontSize="9"
                               Visibility="{Binding IsCommandedOnly, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ══ Title bar: identity, run clock, connection chip ══ -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="TECNAL-Hub"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontSize="{DynamicResource FontSizeSubtitle}"
                           FontWeight="SemiBold" />

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Tempo de processo" Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ElapsedText}"
                               FontFamily="{DynamicResource FontNumeric}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Sensor-module health is independent of the PC link: USB can be
                         perfectly healthy while the module's internal UART is down. -->
                    <Border Padding="8,3" Margin="0,0,8,0"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            ToolTip="O ESP32 não está recebendo dados do módulo de sensores."
                            Visibility="{Binding IsSensorModuleOffline, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{DynamicResource StateWarningBrush}" />
                            <TextBlock Text="Módulo de sensores offline"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Connection chip. Clicking opens the popover; Configurações is
                         no longer where anyone goes just to connect. -->
                    <ToggleButton x:Name="ConnectionChip"
                                  Padding="10,4"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                  BorderThickness="1"
                                  Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Fill="{Binding Connection.StateKey, Converter={StaticResource StateToBrush}}" />
                            <TextBlock Text="{Binding Connection.StatusText}" VerticalAlignment="Center" />
                            <TextBlock Text="⌄" Margin="7,-3,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=ConnectionChip, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ConnectionChip}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           HorizontalOffset="-180">
                        <Border Width="320" Margin="8"
                                Padding="16"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
                            </Border.Effect>
                            <StackPanel DataContext="{Binding Connection}">

                                <RadioButton Content="USB" GroupName="Medium" Margin="0,0,0,6"
                                             IsChecked="{Binding UseUsb, Mode=TwoWay}" />
                                <Grid Margin="18,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailablePorts}"
                                              SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="⟳" Margin="6,0,0,0" Padding="8,2"
                                            ToolTip="Atualizar portas"
                                            Command="{Binding RefreshPortsCommand}" />
                                </Grid>

                                <RadioButton Content="Wi-Fi" GroupName="Medium" Margin="0,0,0,6"
                                             IsChecked="{Binding UseWiFi, Mode=TwoWay}" />
                                <TextBox Margin="18,0,0,12"
                                         Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <Separator Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Quadros" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FramesReceived}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Comandos" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommandsSent}"
                                               HorizontalAlignment="Right" FontFamily="{DynamicResource FontNumeric}" FontSize="11" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Último erro" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastError}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               MaxWidth="190" Style="{StaticResource CaptionTextStyle}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Procurar" Margin="0,0,6,0" Padding="10,4"
                                            Command="{Binding DiscoverCommand}" />
                                    <Button Content="Conectar" Margin="0,0,6,0" Padding="10,4"
                                            Command="{Binding ConnectCommand}" />
                                    <Button Content="Parar" Padding="10,4"
                                            Command="{Binding DisconnectCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Content="Tema" Margin="8,0,0,0" Padding="10,4"
                            ToolTip="Alternar entre tema claro e escuro"
                            Command="{Binding ToggleThemeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Navigation rail ══ -->
        <Border DockPanel.Dock="Left"
                Width="132"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0">
            <!-- A ListBox rather than templated RadioButtons: selection is exactly what
                 SelectedValue/SelectedValuePath express, and it avoids binding
                 ConverterParameter, which is not a DependencyProperty and throws at
                 parse time. -->
            <ListBox ItemsSource="{Binding NavigationItems}"
                     SelectedValuePath="Id"
                     SelectedValue="{Binding SelectedNavigationId, Mode=TwoWay}"
                     Margin="8,12"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SurfaceSunkenBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SurfaceSunkenBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavigationItem}">
                        <TextBlock Text="{Binding Label}" Foreground="{Binding
                                       RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                       Path=Foreground}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ══ KPI strip: the safety glance, visible on every page ══ -->
        <Border DockPanel.Dock="Top"
                Padding="16,10"
                Background="{DynamicResource SurfaceBaseBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Variables}"
                          ItemTemplate="{StaticResource KpiTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- ══ Content: synoptic + detail pane ══
             Responsive. At >=1200 px the detail pane sits beside the synoptic so
             process context is never lost while tuning. Below that it becomes a
             drawer over the diagram - the same ViewModel in a different template,
             so behaviour is identical and only presentation changes. -->
        <Grid x:Name="ContentRoot" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SynopticColumn" Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="380" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="DrawerRow" Height="0" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1">
                <views:SynopticView />
            </Border>

            <!-- Side pane: wide windows -->
            <views:DetailPaneView x:Name="SideDetail"
                                  Grid.Row="0" Grid.Column="1"
                                  Margin="16,0,0,0"
                                  DataContext="{Binding SelectedSubsystem}" />

            <!-- Drawer: narrow windows. Collapsed until the layout switches. -->
            <views:DetailPaneView x:Name="DrawerDetail"
                                  Grid.Row="1" Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  Visibility="Collapsed"
                                  DataContext="{Binding SelectedSubsystem}" />
        </Grid>
    </DockPanel>
</Window>
