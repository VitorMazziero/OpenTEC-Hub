<Window x:Class="OpenTECHub.Views.Dialogs.OxygenConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OpenTECHub.Converters"
        xmlns:ctl="clr-namespace:OpenTECHub.Controls"
        xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OxygenConfigViewModel}"
        Title="Configuração do Controle de Oxigênio Dissolvido"
        Width="640" Height="700"
        MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

    </Window.Resources>

    <DockPanel>
        <!-- Custom Top Bar -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionMinimizeButtonStyle}" Click="OnMinimizeWindow" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseWindow" />
                </StackPanel>
                <TextBlock Text="Configuração do Controle de Oxigênio Dissolvido"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header / Mode Selection -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Modo de Operação:"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding SelectedMode}"
                              MinWidth="200"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Setpoint de OD (%):"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                             Text="{Binding OxygenSetpointText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Alvo de oxigênio dissolvido que a cascata deve manter (0–100%)." />
                </Grid>

                <TextBlock Text="{Binding ModeExplanation}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

            <!-- Validation Error Alert Banner -->
            <Border Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StateAlarmBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Padding="12,8"
                    Margin="0,10,0,0"
                    Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ValidationError}"
                           Foreground="{DynamicResource StateAlarmTextBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Scrollable Content Cards -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,12">
            <StackPanel>
                <!-- Card 1: PID Parameters for Selected Mode -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Parâmetros PID (Modo Atual)" Style="{StaticResource SectionHeader}" />

                        <!-- Outer Loop & Prediction -->
                        <TextBlock Text="Loop Externo (Predição &amp; Taxa de OD)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Ganho K_DOT (s⁻¹)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding KDotText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Ganho proporcional do loop externo sobre o erro de oxigênio predito" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Horizonte de Predição T_pred (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TPredText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Horizonte de tempo para predição linear do oxigênio (compensação de tempo morto)" />
                            </StackPanel>
                        </Grid>

                        <!-- Inner Loop PID Gains -->
                        <TextBlock Text="Loop Interno (PID sobre Erro de Taxa)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Kp" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding KpText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Ganho proporcional do loop interno sobre o erro de taxa" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Ki" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding KiText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Ganho integral do loop interno" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                <TextBlock Text="Kd" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding KdText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Ganho derivativo do loop interno" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                <TextBlock Text="Filtro Tau_D (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TauDText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Constante de tempo do filtro passa-baixa da derivada" />
                            </StackPanel>
                        </Grid>

                        <!-- Integrator Anti-windup & Rate Filters -->
                        <TextBlock Text="Anti-Windup &amp; Amostragem" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Integral Mín (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding IMinText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Limite inferior de saturação da ação integral" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Integral Máx (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding IMaxText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Limite superior de saturação da ação integral" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="Janela Integrador (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MWindowText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Janela deslizante de tempo para a integral do erro de taxa" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Janela Derivada J_AVG" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding JAvgText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Número de amostras na regressão para cálculo da taxa de variação" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Janela Preditor N_PRED" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding NPredText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Número de amostras na regressão para predição do oxigênio" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="Período do Loop (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Período nominal de amostragem do loop em segundos" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Physical Limits -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowAgitationLimits, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Limites Físicos dos Atuadores" Style="{StaticResource SectionHeader}" />
                        
                        <Grid Visibility="{Binding ShowAgitationLimits, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Agitação Mínima (RPM)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AgitationMinRpmText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Velocidade mínima comandada ao motor de agitação" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Agitação Máxima (RPM)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AgitationMaxRpmText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Velocidade máxima comandada ao motor de agitação" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding ShowAerationLimits, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Aeração Mínima (L/min)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AerationMinLpmText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Vazão mínima comandada à válvula de aeração" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Aeração Máxima (L/min)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AerationMaxLpmText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Vazão máxima comandada à válvula de aeração" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Effort Windows (Cascata only) -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowEffortWindows, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Janelas de Atuação Sequencial (Saída PID 0–100%)" Style="{StaticResource SectionHeader}" />
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Agitação Início (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AgitationEffortStartText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Esforço inicial do PID em que a agitação começa a subir" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Agitação Fim (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AgitationEffortEndText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Esforço do PID em que a agitação atinge o valor máximo" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                <TextBlock Text="Aeração Início (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AerationEffortStartText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Esforço inicial do PID em que a aeração começa a subir" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                <TextBlock Text="Aeração Fim (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AerationEffortEndText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Esforço do PID em que a aeração atinge o valor máximo" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="As janelas podem se sobrepor para transferência suave de atuação."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Advanced Gains (Cascata only) -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowAdvancedGains, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Ganhos Avançados (Gain Scheduling)" Style="{StaticResource SectionHeader}" />

                        <CheckBox Content="Habilitar Escalonamento de Ganho entre Atuadores"
                                  IsChecked="{Binding HabilitarGainScheduling, Mode=TwoWay}"
                                  Margin="0,4,0,8" />

                        <Grid Margin="0,4,0,0"
                              IsEnabled="{Binding HabilitarGainScheduling}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Fator Ganho Aeração (Agitação = 1.0)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FatorGanhoAeracaoText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Fator multiplicador de ganho quando a aeração está em regime preponderante" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 5: Kla Path Selector (Mapa only) -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowKlaPathSelector, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Trajetória kLa Publicada" Style="{StaticResource SectionHeader}" />

                        <ComboBox ItemsSource="{Binding AvailablePaths}"
                                  SelectedItem="{Binding SelectedPath}"
                                  DisplayMemberPath="Name"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        MinWidth="96"
                        IsCancel="True"
                        Command="{Binding CancelCommand}" />
                <Button Content="Aplicar"
                        MinWidth="110"
                        Margin="10,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Command="{Binding ApplyCommand}" />
            </StackPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
