<UserControl x:Class="TecnalHub.Views.DetailPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SubsystemViewModel}">

    <!-- ══════════════════════════════════════════════════════════════════════
         DETAIL PANE
         The selected subsystem's controls. Only one subsystem's controls are on
         screen at a time - that is what stops twelve of them becoming the wall
         the v.6 card board was.
         ══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceCardBrush}"
            BorderBrush="{DynamicResource StrokeDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}"
            Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Heading ────────────────────────────────────────────── -->
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{Binding Variable.State, Converter={StaticResource StateToBrush}}" />
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold" />
                </StackPanel>

                <!-- ── Live reading ───────────────────────────────────────── -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="{Binding Variable.FormattedValue}"
                               Style="{StaticResource ReadoutTextStyle}" />
                    <TextBlock Text="{Binding Unit}"
                               Margin="6,0,0,5"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Agitation reports no feedback, so its figure is what was
                     commanded. Saying so beats implying a measurement. -->
                <TextBlock Text="Valor comandado — o equipamento não informa leitura desta variável."
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Visibility="{Binding Variable.IsCommandedOnly, Converter={StaticResource BoolToVis}}" />

                <Separator Margin="0,16,0,16" />

                <!-- ── Setpoint entry ─────────────────────────────────────── -->
                <TextBlock Text="Setpoint" Style="{StaticResource CaptionTextStyle}" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SetpointText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{DynamicResource FontNumeric}"
                             FontSize="15">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <!-- Invalid input is shown as invalid. It is never
                                         quietly replaced with a plausible default. -->
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Grid.Column="1" Text="{Binding Unit}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>

                <TextBlock Text="{Binding RangeHint}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0" />

                <!-- Validation message -->
                <TextBlock Text="{Binding ValidationError}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource StateAlarmBrush}"
                           Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}" />

                <!-- A typed value the device has not acknowledged looks different
                     from one it has. v.6 gave no indication at all. -->
                <Border Margin="0,10,0,0" Padding="8,5"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        Visibility="{Binding HasPendingChange, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"
                                 Fill="{DynamicResource StateWarningBrush}" />
                        <TextBlock Text="Não aplicado" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <CheckBox Content="Subsistema ativo"
                          Margin="0,14,0,0"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Aplicar"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ApplyCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Reverter"
                            Command="{Binding RevertCommand}"
                            IsEnabled="{Binding HasPendingChange}" />
                </StackPanel>

                <Separator Margin="0,18,0,14" />

                <!-- ── Acknowledged state ─────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Aplicado"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               HorizontalAlignment="Right"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="11"
                               Text="{Binding AppliedSetpoint, TargetNullValue=—}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Confirmado pelo equipamento"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               HorizontalAlignment="Right"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="11"
                               Text="{Binding Variable.FormattedSetpoint}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
