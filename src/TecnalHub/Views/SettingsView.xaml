<UserControl x:Class="TecnalHub.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <!-- Everything that is genuinely configuration. v.6 put connecting in the same
         window as all of this, so every operator walked past calibration coefficients
         to do the one thing they came for. Connecting now lives on the chip; nothing
         here was removed, it is just no longer in the way. -->

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="NumericBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
            <Setter Property="Width" Value="190" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- Action bar stays pinned: edits are staged, so the operator must always be
             able to see whether anything is waiting to be applied. -->
        <Border DockPanel.Dock="Bottom"
                Padding="16,12"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Reverter" Margin="0,0,8,0"
                            Command="{Binding RevertCommand}"
                            IsEnabled="{Binding HasChanges}" />
                    <Button Content="Aplicar"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ValidationError}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource StateAlarmBrush}"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <!-- ── Conexão ────────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Conexão" Style="{StaticResource SectionHeading}" />

                        <CheckBox Content="Conectar automaticamente ao iniciar"
                                  Margin="0,0,0,8"
                                  IsChecked="{Binding AutoConnect, Mode=TwoWay}" />
                        <CheckBox Content="Alternar de meio automaticamente ao perder o link"
                                  Margin="0,0,0,14"
                                  IsChecked="{Binding BackupEnabled, Mode=TwoWay}" />

                        <TextBlock Text="Endereço Wi-Fi" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,12"
                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Período de telemetria (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}"
                                 Text="{Binding DataDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Enviado ao equipamento ao aplicar. O tempo limite de silêncio do app deve acomodá-lo."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ── Calibração ─────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Calibração das sondas" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="O equipamento envia contagens brutas; a conversão para unidades de engenharia é feita aqui."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="Oxigênio — coeficiente A" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,8"
                                 Text="{Binding OxygenA, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Oxigênio — coeficiente B" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,4"
                                 Text="{Binding OxygenB, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Live preview: 0.0305473419314 looks exactly as plausible as
                             0.305473419314, and only the decoded value tells them apart. -->
                        <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="8,5" Margin="0,0,0,14" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding OxygenPreview}"
                                       FontFamily="{DynamicResource FontNumeric}"
                                       FontSize="11" />
                        </Border>

                        <TextBlock Text="pH — inclinação" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,8"
                                 Text="{Binding PHSlope, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="pH — intercepto" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,4"
                                 Text="{Binding PHIntercept, UpdateSourceTrigger=PropertyChanged}" />

                        <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="8,5" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding PHPreview}"
                                       FontFamily="{DynamicResource FontNumeric}"
                                       FontSize="11" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Filtros de spike ───────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Filtros de spike" Style="{StaticResource SectionHeading}" />

                        <!-- Surfaced rather than hidden: an operator changing calibration
                             needs to know these move with it. -->
                        <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="10,7" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Estes limiares estão em contagens brutas do conversor, não em unidades de engenharia. Recalibrar uma sonda altera, portanto, o que o filtro considera um spike." />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="pH" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <TextBlock Text="Limiar absoluto" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150" Margin="0,0,0,8"
                                         Text="{Binding PHAbsoluteThreshold, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Tolerância de acompanhamento" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150" Margin="0,0,0,8"
                                         Text="{Binding PHFollowTolerance, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Confirmações" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150"
                                         Text="{Binding PHConfirmRuns, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Oxigênio" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <TextBlock Text="Limiar absoluto" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150" Margin="0,0,0,8"
                                         Text="{Binding OxygenAbsoluteThreshold, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Tolerância de acompanhamento" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150" Margin="0,0,0,8"
                                         Text="{Binding OxygenFollowTolerance, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Confirmações" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150"
                                         Text="{Binding OxygenConfirmRuns, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Registro e aparência ───────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Registro e aparência" Style="{StaticResource SectionHeading}" />

                        <TextBlock Text="Arquivo de registro da sessão" Style="{StaticResource FieldLabel}" />
                        <TextBox Margin="0,0,0,4"
                                 Text="{Binding SessionLogPath, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Formato separado por tabulação, compatível com os scripts de análise da v.6. Vazio usa um arquivo por sessão."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Text="Tema" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="190" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- ── Equipamento ────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Equipamento" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Estes comandos agem imediatamente sobre o equipamento e não dependem de aplicar as configurações."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Resetar variáveis do módulo" Margin="0,0,8,0"
                                    Command="{Binding ResetDeviceVariablesCommand}" />
                            <Button Content="Reiniciar comunicações" Margin="0,0,8,0"
                                    Command="{Binding RestartDeviceCommsCommand}" />
                            <Button Content="Valores de fábrica"
                                    Command="{Binding RestoreDefaultsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
