<UserControl x:Class="OpenTECHub.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenTECHub.Converters"
             xmlns:ctl="clr-namespace:OpenTECHub.Controls"
             xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:EqualsToVisibilityConverter x:Key="EqualsToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,4" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <!-- Documentação: um DataTemplate por tipo de bloco. O catálogo decide o que é
             parágrafo, item ou observação; a view só sabe desenhar os três. -->
        <DataTemplate x:Key="DocParagraphTemplate">
            <TextBlock ctl:InlineMarkup.Text="{Binding Markup}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="19" />
        </DataTemplate>

        <DataTemplate x:Key="DocBulletTemplate">
            <Grid Margin="2,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" ctl:InlineMarkup.Text="{Binding Markup}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="19" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DocNoteTemplate">
            <Border Margin="0,2,0,10" Padding="10,7"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
                <TextBlock ctl:InlineMarkup.Text="{Binding Markup}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="19" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DocFieldTemplate">
            <TextBlock ctl:InlineMarkup.Text="{Binding Markup}" TextWrapping="Wrap"
                       Margin="0,0,0,7" LineHeight="19"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="DocFormulaTemplate">
            <Border Margin="0,4,0,12" Padding="14,10"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock ctl:InlineMarkup.Text="{Binding Caption}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}"
                               Visibility="{Binding HasCaption, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <ctl:DocumentationBlockTemplateSelector x:Key="DocBlockSelector"
                                                ParagraphTemplate="{StaticResource DocParagraphTemplate}"
                                                BulletTemplate="{StaticResource DocBulletTemplate}"
                                                FieldTemplate="{StaticResource DocFieldTemplate}"
                                                FormulaTemplate="{StaticResource DocFormulaTemplate}"
                                                NoteTemplate="{StaticResource DocNoteTemplate}" />

        <Style x:Key="NumericBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
            <Setter Property="Width" Value="190" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SettingsRoot" ctl:Responsive.NarrowBelow="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- The section list is a card, not a column width: collapsing the card takes
                 its Auto column to zero and hands the whole page to the form. -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- WP7 in-page navigation: one stable list, one focused form section. -->
        <Border Grid.Row="0" Grid.Column="0" Width="230"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=SettingsRoot,
                                     Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Configurações"
                           FontWeight="SemiBold" Margin="10,8,0,10" />
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Seções de configurações">
                                        <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Border x:Name="Marker" Width="3"
                                                        HorizontalAlignment="Left" Margin="-6,0,0,0"
                                                        CornerRadius="2"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Visibility="Collapsed" />
                                                <ContentPresenter />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsSection}">
                            <StackPanel Orientation="Horizontal">
                                <ctl:Icon Key="{Binding Glyph}" Size="18" Margin="0,0,9,0" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="175" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="520" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Below 1000 DIP the section list becomes a selector above the form. The
                 same Sections/SelectedSection binding drives both, so switching layout
                 never changes which section the operator is editing. -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="16,12,16,0"
                    Visibility="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=SettingsRoot,
                                         Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Seção:" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Sections}"
                              SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                              MinHeight="32" MaxWidth="360" HorizontalAlignment="Left"
                              AutomationProperties.Name="Seções de configurações">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsSection}">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto" Padding="18">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=SettingsRoot}" Value="True">
                                <!-- The illustration column is gone; the form takes the width it left. -->
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDocumentationSelected}" Value="True">
                                <!-- Same reason at any width: the manual is prose, and prose
                                     held to half the page is prose read twice as slowly. -->
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid HorizontalAlignment="Stretch">

                <!-- Conexão -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SelectedSection.Id, Converter={StaticResource EqualsToVis},
                                             ConverterParameter=connection}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="?" Width="26" Padding="0,4" FontWeight="SemiBold"
                                    ToolTip="Abrir a documentação desta seção"
                                    Command="{Binding DataContext.OpenDocumentationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="configuracoes-conexao" />
                            <TextBlock Text="Conexão" Style="{StaticResource SectionHeading}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <CheckBox Content="Conectar automaticamente ao iniciar" Margin="0,0,0,8"
                                  IsChecked="{Binding AutoConnect, Mode=TwoWay}" />
                        <CheckBox Content="Alternar de meio automaticamente ao perder o link" Margin="0,0,0,14"
                                  IsChecked="{Binding BackupEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Endereço Wi-Fi" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,12"
                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Período de telemetria (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}"
                                 Text="{Binding DataDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="O período só chega ao equipamento quando Aplicar é acionado."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" />

                        <!-- Nós na rede do Hub (Hub 10.2). Identity comes from the aggregate frame and /nodes;
                             health comes from cached /nodeDiag on Wi-Fi or serial nodeDiag on USB. Five fixed rows - an unknown node reads "—", never
                             disappears, so an empty network is never mistaken for a missing feature. -->
                        <Separator Margin="0,16,0,12" />
                        <Grid DataContext="{Binding HubNodes}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nós na rede do Hub" Style="{StaticResource SectionHeading}" Margin="0" />
                                <TextBlock Grid.Column="1" Text="{Binding RegisteredCountText}"
                                           Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Grid.Column="2" Content="Atualizar saúde" Padding="10,3"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="{Binding DirectoryAvailabilityText}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding LegacyHubNoticeText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource StateWarningTextBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding ShowLegacyHubNotice, Converter={StaticResource BoolToVis}}" />
                            <ListView Grid.Row="2" ItemsSource="{Binding Nodes}" Margin="0,8,0,0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      AutomationProperties.Name="Nós na rede do Hub">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Dispositivo" Width="130" DisplayMemberBinding="{Binding DisplayName}" />
                                        <GridViewColumn Header="IP" Width="110" DisplayMemberBinding="{Binding IpText}" />
                                        <GridViewColumn Header="MAC" Width="140" DisplayMemberBinding="{Binding MacText}" />
                                        <GridViewColumn Header="Firmware" Width="80" DisplayMemberBinding="{Binding FirmwareText}" />
                                        <GridViewColumn Header="Estado" Width="130" DisplayMemberBinding="{Binding StateText}" />
                                        <GridViewColumn Header="Visto há" Width="70" DisplayMemberBinding="{Binding SeenText}" />
                                        <GridViewColumn Header="RSSI" Width="75" DisplayMemberBinding="{Binding RssiText}" />
                                        <GridViewColumn Header="Heap" Width="70" DisplayMemberBinding="{Binding HeapText}" />
                                        <GridViewColumn Header="Uptime" Width="70" DisplayMemberBinding="{Binding UptimeText}" />
                                        <GridViewColumn Header="Falhas c/ Hub" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding HubFailuresText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasHubFailureWarning}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource StateWarningTextBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                        <Setter Property="ToolTip" Value="O nó atingiu o limiar de reassociação com o Hub; aviso informativo, não alarme." />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="OTA" Width="90" DisplayMemberBinding="{Binding OtaText}" />
                                        <GridViewColumn Header="Métricas do nó" Width="280" DisplayMemberBinding="{Binding DiagnosticText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                                <TextBlock Text="{Binding LastDirectoryText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastDiagnosticsText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding DirectoryAvailabilityText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Calibração -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SelectedSection.Id, Converter={StaticResource EqualsToVis},
                                             ConverterParameter=calibration}">
                    <StackPanel>
                        <TextBlock Text="Calibração das sondas" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Os pares são aplicados juntos; a prévia usa a leitura bruta atual."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Oxigênio — coeficiente A" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,8"
                                         Text="{Binding OxygenA, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Oxigênio — coeficiente B" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,8"
                                         Text="{Binding OxygenB, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="8,5">
                                    <TextBlock Text="{Binding OxygenPreview}" FontFamily="{DynamicResource FontNumeric}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="pH — inclinação" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,8"
                                         Text="{Binding PHSlope, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="pH — intercepto" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Margin="0,0,0,8"
                                         Text="{Binding PHIntercept, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="8,5">
                                    <TextBlock Text="{Binding PHPreview}" FontFamily="{DynamicResource FontNumeric}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Aquisição -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SelectedSection.Id, Converter={StaticResource EqualsToVis},
                                             ConverterParameter=acquisition}">
                    <StackPanel>
                        <TextBlock Text="Aquisição · filtros de spike" Style="{StaticResource SectionHeading}" />
                        <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="10,7" Margin="0,0,0,14">
                            <TextBlock Text="Valores em contagens brutas, não em unidades de engenharia. Uma nova calibração altera o significado destes limiares."
                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="pH" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Limiar absoluto" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150" Margin="0,0,0,8"
                                         Text="{Binding PHAbsoluteThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Tolerância de acompanhamento" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150" Margin="0,0,0,8"
                                         Text="{Binding PHFollowTolerance, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Confirmações" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150"
                                         Text="{Binding PHConfirmRuns, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Oxigênio" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Limiar absoluto" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150" Margin="0,0,0,8"
                                         Text="{Binding OxygenAbsoluteThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Tolerância de acompanhamento" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150" Margin="0,0,0,8"
                                         Text="{Binding OxygenFollowTolerance, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Confirmações" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource NumericBox}" Width="150"
                                         Text="{Binding OxygenConfirmRuns, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Unidades -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SelectedSection.Id, Converter={StaticResource EqualsToVis},
                                             ConverterParameter=units}">
                    <StackPanel>
                        <TextBlock Text="Unidades" Style="{StaticResource SectionHeading}" />
                        <Border Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="10,8" Margin="0,0,0,16">
                            <TextBlock Text="Conversão somente de apresentação. Telemetria, arquivos de sessão e JSON continuam em °C e kPa."
                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                        </Border>

                        <TextBlock Text="Temperatura" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="210" HorizontalAlignment="Left" Margin="0,0,0,14"
                                  ItemsSource="{Binding TemperatureUnitOptions}"
                                  SelectedItem="{Binding TemperatureUnit, Mode=TwoWay}" />

                        <TextBlock Text="Pressão" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="210" HorizontalAlignment="Left" Margin="0,0,0,14"
                                  ItemsSource="{Binding PressureUnitOptions}"
                                  SelectedItem="{Binding PressureUnit, Mode=TwoWay}" />

                        <TextBlock Text="Volume nominal da dorna (L)" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource NumericBox}"
                                 Text="{Binding VesselVolumeLitres, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="A geometria e o volume derivado serão habilitados quando o sensor de nível entrar na Fase 2."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <!-- Aparência -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SelectedSection.Id, Converter={StaticResource EqualsToVis},
                                             ConverterParameter=logging}">
                    <StackPanel>
                        <TextBlock Text="Aparência" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Tema da Interface" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="190" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}" />
                        <TextBlock Text="Selecione o esquema de cores visual (Claro, Escuro ou Seguir o Sistema)."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Gerenciamento e Backup de Dados -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SelectedSection.Id, Converter={StaticResource EqualsToVis},
                                             ConverterParameter=backup}">
                    <StackPanel>
                        <TextBlock Text="Gerenciamento de Dados e Backup" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Exporte ou importe todas as predefinições de controle, receitas e mapeamentos kLa experimentais em um único arquivo compactado para portabilidade entre computadores e restauração do sistema."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <!-- Diretório de Trabalho (Workspace / Sessão Global) -->
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Diretório de Trabalho (Workspace / Sessão Global)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Pasta raiz padrão compartilhada onde o sistema organiza e salva todos os dados em subpastas dedicadas. Ao alterar a pasta, os dados atuais são copiados para o novo destino (nada é apagado) e o aplicativo reinicia nele."
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                    <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Button Content="Alterar Pasta..." Margin="0,0,8,8"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Command="{Binding ChangeWorkspaceDirectoryCommand}" />
                                        <Button Content="Abrir no Explorer" Margin="0,0,0,8"
                                                Command="{Binding OpenWorkspaceFolderCommand}" />
                                    </WrapPanel>
                                    <TextBox Text="{Binding WorkspaceDirectory, Mode=OneWay}"
                                             IsReadOnly="True"
                                             MinWidth="260"
                                             FontFamily="{DynamicResource FontNumeric}"
                                             VerticalAlignment="Center" Margin="0,0,0,8" />
                                </WrapPanel>

                                <!-- Subdiretórios estruturados (Simulação Windows Explorer) -->
                                <TextBlock Text="Estrutura de Subdiretórios:" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" />

                                <ItemsControl ItemsSource="{Binding WorkspaceFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WorkspaceFolderInfo}">
                                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ctl:Icon Key="Folder" Size="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                                              Stroke="{DynamicResource AccentBrush}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding RelativePath}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontFamily="{DynamicResource FontNumeric}"
                                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                                                CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileTypes}"
                                                                       FontFamily="{DynamicResource FontNumeric}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <Button Content="Abrir" Padding="8,3"
                                                                Command="{Binding DataContext.OpenSubfolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding FullPath}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Exportar Backup do Sistema" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Gera um pacote com as predefinições de controle, todas as receitas salvas e mapas de kLa publicados."
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button Content="Exportar Backup..." HorizontalAlignment="Left"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding ExportBackupCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Importar e Restaurar Backup" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Restaura receitas, mapas de kLa e parâmetros de controle a partir de um arquivo .tecbkp ou .zip."
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button Content="Importar Backup..." HorizontalAlignment="Left"
                                        Command="{Binding ImportBackupCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Equipamento -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SelectedSection.Id, Converter={StaticResource EqualsToVis},
                                             ConverterParameter=device}">
                    <StackPanel>
                        <TextBlock Text="Comandos do equipamento" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Agem imediatamente e podem destruir o estado de processo. A confirmação mostra o JSON exato antes do envio."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <WrapPanel>
                            <Button Content="Resetar variáveis do módulo" Margin="0,0,8,8"
                                    Command="{Binding ResetDeviceVariablesCommand}" />
                            <Button Content="Reiniciar comunicações" Margin="0,0,0,8"
                                    Command="{Binding RestartDeviceCommsCommand}" />
                        </WrapPanel>
                        <Separator Margin="0,10,0,14" />
                        <Button Content="Carregar valores de fábrica para revisão"
                                HorizontalAlignment="Left"
                                Command="{Binding RestoreDefaultsCommand}" />
                    </StackPanel>
                </Border>

                <!-- Documentação: o manual dentro do aplicativo. As páginas deixaram de
                     imprimir a própria explicação; ela é escrita uma vez, aqui, e cada
                     card aponta para o tópico que lhe corresponde. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SelectedSection.Id, Converter={StaticResource EqualsToVis},
                                             ConverterParameter=documentation}">
                    <StackPanel>
                        <TextBlock Text="Documentação" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="O manual do aplicativo, página por página. Os botões “?” espalhados pelo programa abrem direto o assunto correspondente."
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="Assunto" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DocumentationTopics}"
                                  SelectedItem="{Binding SelectedDocumentationTopic, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  HorizontalAlignment="Left" MinWidth="320"
                                  AutomationProperties.Name="Assunto da documentação" />

                        <Border Margin="0,14,0,0" Padding="0,12,0,0"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="0,1,0,0">
                            <StackPanel DataContext="{Binding SelectedDocumentationTopic}">
                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeSubtitle}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap" Margin="0,4,0,14" />

                                <ItemsControl ItemsSource="{Binding Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,0,0,7" />
                                                <ItemsControl ItemsSource="{Binding Blocks}"
                                                              ItemTemplateSelector="{StaticResource DocBlockSelector}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- O tópico de gás reúne a explicação, o esquema e os controles
                                     que antes ficavam em uma aba separada de Configurações. -->
                                <Border Margin="0,2,0,0" Padding="12"
                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Visibility="{Binding Id, Converter={StaticResource EqualsToVis},
                                                     ConverterParameter=configuracoes-gas-valvulas}">
                                    <StackPanel>
                                        <TextBlock Text="Conferência da montagem de gás" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBlock Text="Use o esquema e o resumo abaixo para confirmar a rota física do gás antes de um ensaio. O único ajuste desta página é a entrada do fluxômetro que aciona a válvula A."
                                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                        <Border BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceCardBrush}" Padding="6"
                                                HorizontalAlignment="Left" Cursor="Hand"
                                                ToolTip="Clique para ampliar ou reduzir o esquema das válvulas">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ToggleGasDiagramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Border.InputBindings>
                                            <Image Source="pack://application:,,,/Resources/Images/valvulas-abc.png"
                                                   Stretch="Uniform" AutomationProperties.Name="Esquema da ligação das válvulas A, B e C">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="MaxWidth" Value="420" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsGasDiagramEnlarged, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="MaxWidth" Value="1200" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>
                                        <TextBlock Text="Esquema de ligação do gás: A leva ar ao reator; B conduz nitrogênio; C libera ar para descarga ou purga; B e C abrem juntas. Clique na imagem para ampliar e compare a legenda com as mangueiras instaladas."
                                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />

                                        <TextBlock Text="Entrada do ar no reator" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding DataContext.GasInputOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding DataContext.GasAirInletInput, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                                  HorizontalAlignment="Left" MinWidth="220"
                                                  AutomationProperties.Name="Entrada da válvula A" />
                                        <TextBlock Text="{Binding DataContext.GasVentInputText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding DataContext.GasRigSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontWeight="SemiBold" Margin="0,2,0,10" />
                                        <Button Content="Restaurar padrão (A na entrada 2)" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.RestoreGasRigDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.IsGasRigDefault, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                   Text="A alteração vale para os próximos comandos e corridas e é registrada no histórico. Faça-a com receitas e ensaios parados; uma corrida já iniciada mantém a montagem com que foi criada." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Decorative only. On a laptop the form needs this space more than the page
             needs a picture of the vessel - and the manual needs it at any width. -->
        <ContentControl Grid.Row="1" Grid.Column="1"
                        Visibility="{Binding IsDocumentationSelected,
                                     Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
        <Viewbox Stretch="Uniform" Margin="24,18,24,18"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=SettingsRoot,
                                      Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <Canvas Width="430" Height="470">
                <Image Canvas.Left="5" Canvas.Top="25" Width="420" Height="420"
                       Source="/OpenTECHub;component/Resources/Images/Imagem_biorreator_side.png"
                       Stretch="Uniform" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="Biorreator OpenTEC" />
            </Canvas>
        </Viewbox>
        </ContentControl>
    </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16,12"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Reverter" Margin="0,0,8,0"
                            Command="{Binding RevertCommand}" IsEnabled="{Binding HasChanges}" />
                    <Button Content="Aplicar" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>
                
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                        <Run Text="Desenvolvido por " FontSize="11" FontStyle="Italic"/>
                        <Run Text="Vítor Teixeira Mazziero" FontWeight="Bold" FontSize="13"/>
                        <Run Text="FAPESP (2026/04877-4)" FontSize="11" FontWeight="SemiBold"/>
                    </TextBlock>
                    <Image Source="{Binding UnespLogoSource}" Height="24" Margin="16,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image Source="{Binding FapespLogoSource}" Height="24" Margin="0,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
                </StackPanel>
                
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource StateAlarmTextBrush}"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
