<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         LIGHT THEME TOKENS  -  Fluent / Windows 11
         Only COLOURS live here. Every brush, typography and control style is in
         Tokens.Shared.xaml and resolves these keys via DynamicResource, so the
         theme can be swapped at runtime without rebuilding the visual tree.
         Never hard-code a colour in a View - add a token here instead.
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- Surfaces: layered background -> card -> elevated popover -->
    <Color x:Key="SurfaceBaseColor">#F3F3F3</Color>
    <Color x:Key="SurfaceCardColor">#FBFBFB</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSunkenColor">#EDEDED</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#5D5D5D</Color>
    <Color x:Key="TextDisabledColor">#9D9D9D</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- Accent: interactive affordances only. Never used to encode process data. -->
    <Color x:Key="AccentColor">#0067C0</Color>
    <Color x:Key="AccentHoverColor">#0078D4</Color>
    <Color x:Key="AccentPressedColor">#005494</Color>

    <!-- Strokes -->
    <Color x:Key="StrokeDefaultColor">#E1E1E1</Color>
    <Color x:Key="StrokeStrongColor">#C8C8C8</Color>

    <!-- Process state. These four are the ONLY colours allowed to carry meaning
         about the equipment; see docs/UI_DESIGN.md section "Colour discipline". -->
    <Color x:Key="StateOkColor">#0F7B0F</Color>       <!-- at setpoint / healthy -->
    <Color x:Key="StateActuatingColor">#0067C0</Color><!-- controller is moving  -->
    <Color x:Key="StateWarningColor">#9D5D00</Color>  <!-- out of band           -->
    <Color x:Key="StateAlarmColor">#C42B1C</Color>    <!-- alarm / link lost     -->
    <Color x:Key="StateIdleColor">#8A8A8A</Color>     <!-- disabled / no data    -->

    <!-- Chart series. Distinct in both themes and colour-blind safe (Okabe-Ito). -->
    <Color x:Key="Series1Color">#0072B2</Color>
    <Color x:Key="Series2Color">#E69F00</Color>
    <Color x:Key="Series3Color">#009E73</Color>
    <Color x:Key="Series4Color">#CC79A7</Color>
    <Color x:Key="Series5Color">#56B4E9</Color>
    <Color x:Key="Series6Color">#D55E00</Color>

</ResourceDictionary>
