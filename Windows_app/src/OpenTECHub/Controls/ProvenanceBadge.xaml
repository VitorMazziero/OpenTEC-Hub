<UserControl x:Class="OpenTECHub.Controls.ProvenanceBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Deliberately colourless. This marks where a number CAME FROM, which is a
         different question from how the equipment is behaving; giving it a state
         colour would put a sixth vocabulary on screen and weaken the five that
         carry meaning. -->

    <Border Background="{DynamicResource SurfaceSunkenBrush}"
            BorderBrush="{DynamicResource StrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="5,1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            ToolTip="{Binding Explanation, ElementName=Root}">
        <TextBlock Text="{Binding Text, ElementName=Root}"
                   FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}" />
    </Border>
</UserControl>
