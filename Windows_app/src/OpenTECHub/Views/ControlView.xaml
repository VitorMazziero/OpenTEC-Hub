<UserControl x:Class="OpenTECHub.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenTECHub.Converters"
             xmlns:ctl="clr-namespace:OpenTECHub.Controls"
             xmlns:views="clr-namespace:OpenTECHub.Views"
             xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ControlViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ExternalDeviceStateConverter x:Key="ExternalDeviceState" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:ActiveToStateConverter x:Key="ActiveToState" />
        <conv:ActiveVariableStateConverter x:Key="ActiveVariableState" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

        <!-- An external device that is not on the wire cannot be commanded, so its
             switch and its setpoint box stay dead rather than accepting an order that
             goes nowhere. -->
        <Style x:Key="ExternalDeviceToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanActuate, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Style>
        <Style x:Key="ExternalDeviceEntryStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanActuate, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Style>
        <Style x:Key="ConnectedExternalDeviceToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ExternalDeviceToggleStyle}">
            <Setter Property="IsEnabled" Value="{Binding Status.IsOnline}" />
        </Style>
        <Style x:Key="ConnectedExternalDeviceEntryStyle" TargetType="TextBox" BasedOn="{StaticResource ExternalDeviceEntryStyle}">
            <Setter Property="IsEnabled" Value="{Binding Status.IsOnline}" />
        </Style>
        <Style x:Key="DosingFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Every variable starts at the same left edge, with an 8 px icon-to-label gap. -->
        <Style x:Key="ProcessRowIconStyle" TargetType="ctl:Icon">
            <Setter Property="Size" Value="18" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSmall}">
                            <Path x:Name="Chevron"
                                  Data="M 0 0 L 4 4.5 L 8 0"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Controle"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold" />

            <!-- Recipe Running Lockout Banner -->
            <Border Visibility="{Binding IsRecipeRunning, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource StateWarningBrush}"
                    BorderBrush="{DynamicResource StateWarningTextBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Padding="16,10"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ctl:Icon Key="NodeGraph" Size="20" Margin="0,0,10,0" Stroke="{DynamicResource StateWarningTextBrush}" />
                    <TextBlock Text="{Binding RecipeRunningNotice}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StateWarningTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                    <!-- Unified Process Parameters Card -->
                    <Border Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource StrokeDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Padding="16,14">
                        <StackPanel>

                            <!-- Table Header -->
                            <Grid Margin="0,0,0,6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="20" />
                                    <!-- Name and range breathe with the window instead of pinning the table to a
                                         fixed 938 DIP; MinWidth keeps them readable at the 1024 DIP minimum and
                                         MaxWidth stops the name drifting away from its reading on a wide screen. -->
                                    <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="Variável" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Valor Lido" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Setpoint" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="Novo Setpoint" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="Unidade" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="Faixa" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="8" Text="Ativo" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource StrokeDefaultBrush}" Margin="0,0,0,6" />

                            <!-- 1. Agitação (com o servo drive na gaveta) -->
                            <StackPanel DataContext="{Binding AgitationRow}">
                            <Grid Margin="0,4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                              IsChecked="{Binding DataContext.IsExpandedServoDrive, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              ToolTip="Servo drive: telemetria do eixo e controles" />
                                <ctl:StateDot Grid.Column="1" Size="8" VerticalAlignment="Center" Label="{Binding Subsystem.DisplayName}" State="{Binding EffectiveActive, Converter={StaticResource ActiveToState}}" />
                                <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.OpenVariableFromControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Subsystem.Variable}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:Icon Key="{Binding IconKey}" Style="{StaticResource ProcessRowIconStyle}" />
                                        <TextBlock Text="{Binding Subsystem.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}" Style="{StaticResource NumericTextStyle}" />
                                        <TextBlock Text="{Binding Subsystem.Unit}" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <!-- Torque under the speed. The two come off the same shaft and only
                                         mean something together: 600 rpm at 2 % is a free impeller,
                                         600 rpm at 40 % is a vessel fighting back. -->
                                    <StackPanel Orientation="Horizontal"
                                                DataContext="{Binding DataContext.ServoDrive, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="{Binding TorquePercentText}" Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="% torque" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Subsystem.FormattedAppliedSetpoint}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="90" VerticalAlignment="Center"
                                             Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding Subsystem.ValidationError}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <ctl:ProvenanceBadge Text="{Binding OwnerBadgeText}" Explanation="{Binding OwnerLockReason}" Margin="4,0,0,0" Visibility="{Binding HasOwnerBadge, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="6" Text="{Binding Subsystem.Unit}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="7" Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subsystem.RangeHint}" />
                                <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding EffectiveActive, Mode=TwoWay}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>
                                <Border Visibility="{Binding DataContext.IsExpandedServoDrive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="Servo drive — Delta ASDA-B2"
                                               FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <!-- Under Agitação rather than among the external devices: the
                                         drive is inside the module, the operator does not switch it
                                         on, and it measures the very shaft this row commands. Listing
                                         it as a peripheral would suggest a choice nobody has. -->
                                    <TextBlock Text="Interno ao módulo. Mede o eixo que esta linha comanda; a rotação continua sendo comandada pelo CN1."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <!-- Rotation setpoint, repeated here so the drawer is the whole
                                         agitation surface: what was asked for, what the shaft is
                                         doing, and what it costs, without going back to the row. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Setpoint de rotação" Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding Subsystem.ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Text="rpm" Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" Margin="6,0,12,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <ctl:ProvenanceBadge Text="{Binding OwnerBadgeText}" Explanation="{Binding OwnerLockReason}" Margin="8,0,0,0"
                                                             Visibility="{Binding HasOwnerBadge, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- The route selector does not create a second setpoint. It only
                                         chooses where the existing agitation setpoint is delivered. -->
                                    <StackPanel DataContext="{Binding DataContext.ServoDrive, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Border Margin="0,0,0,10" Padding="10,8"
                                                Background="{DynamicResource SurfaceSunkenBrush}"
                                                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSmall}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Via do setpoint de agitação"
                                                           FontWeight="SemiBold" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="UART / CN1 (módulo e visor)"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ToggleButton Style="{StaticResource ConnectedExternalDeviceToggleStyle}"
                                                                  IsChecked="{Binding IsMotorControlViaModbus, Mode=TwoWay}"
                                                                  IsEnabled="{Binding IsMotorControlRouteAvailable}"
                                                                  ToolTip="Desligado: o Hub envia o valor sem PI à placa original por UART/CN1. Ligado: o ESP32S3-driver escreve P1-09 diretamente por Modbus." />
                                                    <TextBlock Text="Modbus direto"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="2" Text="{Binding MotorControlRouteText}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                                           ToolTip="Trocar a via envia setpoint zero, desabilita o servo e exige um novo setpoint após a confirmação." />
                                            </Grid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ctl:ExternalDeviceChips Status="{Binding Status}" />
                                            <TextBlock Text="{Binding StateText, StringFormat='Estado: {0}'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>

                                        <Border Visibility="{Binding IsInAlarm, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,0,10" Padding="10,8"
                                                Background="{DynamicResource SurfaceSunkenBrush}"
                                                BorderBrush="{DynamicResource StateAlarmTextBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSmall}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AlarmText, StringFormat='Alarme do drive: {0}'}"
                                                           Foreground="{DynamicResource StateAlarmTextBrush}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="consulte o código no manual do ASDA-B2"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Em dash for a missing reading, never a zero: zero rpm and
                                             zero power are real readings from a stopped motor. -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding RpmText, StringFormat='Rotação medida: {0} rpm'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding TorquePercentText, StringFormat='Torque: {0} %'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding TorqueNewtonMetreText, StringFormat='Torque: {0} N·m'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0"
                                                       ToolTip="Derivado do torque percentual e do torque nominal de placa do motor (1,27 N·m para o ECMA-C20604ES). Trocar o motor sem trocar essa constante produz números plausíveis e errados." />
                                            <TextBlock Text="{Binding LoadPercentText, StringFormat='Carga média: {0} %'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0"
                                                       ToolTip="Taxa de carga média do drive. Não é a mesma grandeza que o torque instantâneo." />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding PowerWattText, StringFormat='Potência mecânica estimada: {0} W'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0"
                                                       ToolTip="T·ω no eixo, derivado do torque e da rotação. Não é consumo elétrico: não inclui perdas do drive, do motor nem da eletrônica." />
                                            <TextBlock Text="{Binding EnergyWattHourText, StringFormat='Energia mecânica acumulada: {0} Wh'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       ToolTip="Integrada no próprio nó. Zera quando o nó reinicia e quando a zeragem é comandada, então pode andar para trás." />
                                        </WrapPanel>

                                        <!-- Link diagnostics. The rate, not the total: the bench saw one
                                             error in 256 reads on the first transaction after boot, and a
                                             total that never clears would leave a healthy link looking
                                             sick forever. -->
                                        <Border Margin="0,0,0,10" Padding="10,8"
                                                Background="{DynamicResource SurfaceSunkenBrush}"
                                                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSmall}">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding ErrorRateText, StringFormat='Erros Modbus: {0}'}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0"
                                                               ToolTip="Fração de transações com falha numa janela móvel. Um erro isolado no boot é normal; o que importa é a taxa se manter alta." />
                                                    <TextBlock Text="{Binding CounterText, StringFormat='Contadores: {0}'}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding QueueDepthText, StringFormat='Fila no Hub: {0}'}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               ToolTip="Comandos aguardando coleta pelo nó. Ele puxa um a cada 2 s, então uma fila cheia leva até 16 s para esvaziar." />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Status.StatusText}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Amostragem" Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Style="{StaticResource ConnectedExternalDeviceEntryStyle}"
                                                     Width="80"
                                                     Text="{Binding PollIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Intervalo de amostragem Modbus no nó, de 250 a 10000 ms. Valores fora da faixa são recusados, não ajustados. Confirma ao sair do campo ou com Enter, como as demais entradas da página." />
                                            <TextBlock Text="ms" Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" Margin="6,0,12,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="Habilitado no Hub" Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ToggleButton VerticalAlignment="Center"
                                                          Style="{StaticResource ConnectedExternalDeviceToggleStyle}"
                                                          IsChecked="{Binding IsRoutingEnabled, Mode=TwoWay}"
                                                          ToolTip="Interruptor do servo no Hub: ligado, o Hub encaminha comandos e publica valores; desligado, descarta comandos e para de publicar. Desligar não para o nó: ele continua presente." />
                                        </StackPanel>
                                        <TextBlock Text="{Binding PollIntervalError}"
                                                   Visibility="{Binding PollIntervalError, Converter={StaticResource NullToVis}}"
                                                   Foreground="{DynamicResource StateAlarmTextBrush}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextWrapping="Wrap" Margin="0,0,0,4" />

                                        <!-- Fenced off below a rule. This clears a data accumulator and
                                             does nothing to the process; beside a control that does act
                                             it would invite the wrong click on a running reactor. -->
                                        <Border BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,1,0,0"
                                                Margin="0,10,0,0" Padding="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Zerar energia acumulada"
                                                        Command="{Binding ResetEnergyCommand}"
                                                        ToolTip="Zera apenas o acumulador de energia no nó. Não altera nada no processo, e a confirmação é a queda do valor acumulado." />
                                                <TextBlock Text="Somente o acumulador de dados. Não afeta o processo."
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 2. Temperatura -->
                            <StackPanel DataContext="{Binding TemperatureRow}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedTemperature, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Saúde do sensor de temperatura" />
                                    <ctl:StateDot Grid.Column="1" Size="8" VerticalAlignment="Center" Label="{Binding Subsystem.DisplayName}" State="{Binding EffectiveActive, Converter={StaticResource ActiveToState}}" />
                                    <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenVariableFromControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Subsystem.Variable}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ctl:Icon Key="{Binding IconKey}" Style="{StaticResource ProcessRowIconStyle}" />
                                            <TextBlock Text="{Binding Subsystem.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Subsystem.Variable.FormattedValue}" Style="{StaticResource NumericTextStyle}" />
                                            <TextBlock Text="{Binding Subsystem.Unit}" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding Subsystem.FormattedAppliedSetpoint}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding Subsystem.SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding Subsystem.ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Subsystem.HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Subsystem.IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <ctl:ProvenanceBadge Text="{Binding OwnerBadgeText}" Explanation="{Binding OwnerLockReason}" Margin="4,0,0,0" Visibility="{Binding HasOwnerBadge, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="{Binding Subsystem.Unit}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="{Binding Subsystem.RangeHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subsystem.RangeHint}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding EffectiveActive, Mode=TwoWay}" ToolTip="Habilitar controle de temperatura">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>

                                <!-- Dropdown Drawer: Temperatura.  One drawer for both routes: the row
                                     setpoint above is the only temperature entry; this drawer chooses
                                     where it is delivered (original board over UART, or the external C404
                                     bath through the Hub cascade), the same way the agitation drawer
                                     chooses UART/CN1 or Modbus. -->
                                <Border Visibility="{Binding DataContext.IsExpandedTemperature, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <!-- Header: process description left, two-line sensor health right. -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Temperatura do reator" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <TextBlock Text="Tempval é a temperatura real lida pelo sensor do módulo; o setpoint da linha é sempre a referência do reator."
                                                           Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ctl:SensorHealthView Grid.Column="1" IsCompact="True" VerticalAlignment="Center"
                                                                  DataContext="{Binding Subsystem.Variable}"
                                                                  ToolTip="Saúde estatística do sensor de temperatura do reator" />
                                        </Grid>

                                        <StackPanel DataContext="{Binding DataContext.ExternalBath, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <!-- Route box: same style as "Via do setpoint de agitação". -->
                                            <Border Margin="0,0,0,10" Padding="10,8"
                                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                                    BorderBrush="{DynamicResource StrokeSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource RadiusSmall}">
                                                <StackPanel>
                                                    <TextBlock Text="Via do setpoint de temperatura" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="Banho original (placa do módulo, UART)"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ToggleButton Style="{StaticResource ConnectedExternalDeviceToggleStyle}"
                                                                      IsChecked="{Binding IsTempControlViaBath, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanChangeRoute}"
                                                                      ToolTip="Desligado: o Hub envia o setpoint à placa original por UART. Ligado: o setpoint vira a referência do reator e a cascata do Hub comanda o banho externo C404. Exige o banho habilitado no Hub e online; trocar a via exige novo setpoint." />
                                                        <TextBlock Text="Banho externo (Contemp C404, Wi-Fi)"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding RouteText}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    <TextBlock Text="{Binding PreferenceMismatchText}"
                                                               Visibility="{Binding PreferenceMismatchText, Converter={StaticResource NullToVis}}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <ctl:ExternalDeviceChips Status="{Binding Status}" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>

                                            <!-- C404 and cascade details: only while the Hub routes to the bath. -->
                                            <StackPanel Visibility="{Binding ShowBathDetails, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding OwnershipText}"
                                                           Visibility="{Binding OwnershipText, Converter={StaticResource NullToVis}}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,0,8" />
                                                <Border Margin="0,0,0,10" Padding="10,8"
                                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                                        BorderBrush="{DynamicResource StrokeSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusSmall}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <!-- C404 -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="C404 PV" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding BathPvText}" Style="{StaticResource NumericTextStyle}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="C404 SP" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BathSpText}" Style="{StaticResource NumericTextStyle}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Alvo do nó" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BathTargetText}" Style="{StaticResource NumericTextStyle}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Sequência / fase" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center">
                                                            <Run Text="{Binding BathStateText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding BathPhaseText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Guarda" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding BathGuardText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                                        <!-- Cascade -->
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cascata" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding CascadeStateText}" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="PV filtrada / erro" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericTextStyle}">
                                                            <Run Text="{Binding CascadePvFilteredText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding CascadeErrorText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="SP calculado / confirmado" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource NumericTextStyle}">
                                                            <Run Text="{Binding CascadeOutputText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding CascadeConfirmationText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="P / I" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding CascadePIText}" Style="{StaticResource CaptionTextStyle}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Motivo" Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding CascadePauseText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>

                                                <!-- Actions: no second setpoint entry here. -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Guarda automática (C404)" Style="{StaticResource CaptionTextStyle}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ToggleButton Style="{StaticResource ConnectedExternalDeviceToggleStyle}"
                                                                  IsChecked="{Binding IsAutomatic, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanChangeMode}"
                                                                  ToolTip="Automático: o nó desfaz mudanças feitas no painel do C404. A cascata só controla com a guarda em automático; em manual ela aguarda." />
                                                    <Button Content="Parar banho" Command="{Binding StopCommand}" Margin="16,0,0,0"
                                                            ToolTip="Desliga a cascata e deixa o C404 em manual no último SP; via e habilitação não mudam." />
                                                    <Button Content="Reset falha" Command="{Binding ResetFaultCommand}" Margin="6,0,0,0"
                                                            ToolTip="Limpa a falha da cascata depois de corrigida a causa e devolve a guarda ao automático." />
                                                </StackPanel>
                                                <TextBlock Text="Parar a cascata não desliga o C404: ele permanece no último SP."
                                                           Foreground="{DynamicResource StateAlarmTextBrush}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding CascadeFaultText}" Visibility="{Binding CascadeFaultText, Converter={StaticResource NullToVis}}"
                                                           Foreground="{DynamicResource StateAlarmTextBrush}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                                <Expander Header="Sintonia da cascata e manutenção do C404" Margin="0,8,0,0">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <UniformGrid Columns="6" Margin="0,0,0,6">
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Kp" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeKpText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Ti (s)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeTiText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Bias (°C)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeBiasText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Período (ms)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadePeriodText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Filtro (s)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeFilterText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,0,6"><TextBlock Text="Comando mínimo (ms)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeMinCommandText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Banda (°C)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeBandText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Slew (°C/min)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeSlewText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Offset alto (°C)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeOffsetHighText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Offset baixo (°C)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeOffsetLowText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,6"><TextBlock Text="Saída mínima (°C)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeOutputMinText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                            <StackPanel Margin="0,0,0,6"><TextBlock Text="Saída máxima (°C)" Style="{StaticResource CaptionTextStyle}" /><TextBox Text="{Binding CascadeOutputMaxText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                        </UniformGrid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Enviar sintonia" Style="{StaticResource AccentButtonStyle}" Command="{Binding ApplyTuningCommand}" />
                                                            <TextBlock Text="{Binding TuningStatusText}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0" />
                                                        </StackPanel>
                                                        <!-- Maintenance, fenced off: it declares the SP read on the C404 panel;
                                                             it is not a second temperature setpoint. -->
                                                        <Border BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,1,0,0"
                                                                Margin="0,10,0,0" Padding="0,10,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="SP lido no painel do C404" Style="{StaticResource CaptionTextStyle}"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBox Width="80" Text="{Binding BathSyncText, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="Valor que o painel do C404 mostra agora; só atualiza a memória do nó, não move o banho." />
                                                                <Button Content="Sincronizar" Command="{Binding SynchronizeCommand}" Margin="6,0,0,0" />
                                                                <TextBlock Text="Manutenção: só corrige a memória do nó; não é setpoint do processo."
                                                                           Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>

                                            <TextBlock Text="{Binding LastActionText}" Visibility="{Binding LastActionText, Converter={StaticResource NullToVis}}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                                            <!-- Same place and wording as the servo drawer. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="Banho externo habilitado no Hub" Style="{StaticResource CaptionTextStyle}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ToggleButton VerticalAlignment="Center"
                                                              Style="{StaticResource ConnectedExternalDeviceToggleStyle}"
                                                              IsChecked="{Binding IsCommEnabled, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanChangeCommunication}"
                                                              ToolTip="Interruptor do banho no Hub (bathComm): ligado, o Hub troca comandos com o nó do C404 e a cascata pode atuar; desligado, o Hub não envia nada ao banho. Com a cascata ativa, desligar equivale a Parar banho. É pré-requisito para escolher a via externa." />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 3. pH (com dropdown) -->
                            <StackPanel DataContext="{Binding PHControl}">
                                <Grid Margin="0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="300" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource RowExpanderToggleStyle}" Tag="ExpanderToggle"
                                                  IsChecked="{Binding DataContext.IsExpandedPH, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                  ToolTip="Configurações detalhadas de pH" />
                                    <ctl:StateDot Grid.Column="1" State="{Binding IsEnabled, Converter={StaticResource ActiveToState}}" Size="8" VerticalAlignment="Center" Label="pH" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ctl:Icon Key="Ph" Style="{StaticResource ProcessRowIconStyle}" />
                                        <TextBlock Text="pH" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LivePHText}" Style="{StaticResource NumericTextStyle}" />
                                        <TextBlock Text="pH" Margin="4,0,0,0" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding AppliedSetpoint, TargetNullValue='—', StringFormat='F2'}" Style="{StaticResource NumericTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="90" VerticalAlignment="Center"
                                                 Text="{Binding SetpointText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ValidationError}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <ctl:ProvenanceBadge Text="{Binding OwnerBadgeText}" Explanation="{Binding OwnerLockReason}" Margin="4,0,0,0" Visibility="{Binding HasOwnerBadge, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Text="pH" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="7" Text="1,00–14,00" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                    <ToggleButton Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Habilitar controle de pH">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwnedByOther}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="ToolTip" Value="{Binding OwnerLockReason}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>

                                <!-- Dropdown Drawer: pH -->
                                <Border Visibility="{Binding DataContext.IsExpandedPH, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}"
                                        Margin="28,4,8,8"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: pH Parameters -->
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <WrapPanel IsEnabled="{Binding IsOwnedByOther, Converter={StaticResource InverseBool}}">
                                                <StackPanel Width="130" Margin="0,0,12,6">
                                                    <TextBlock Text="Histerese (±)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Text="{Binding InactiveBandText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Banda inativa: 0,01 a 2,00 pH" />
                                                </StackPanel>
                                                <StackPanel Width="140" Margin="0,0,12,6">
                                                    <TextBlock Text="Operação da bomba (s)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Text="{Binding OperationSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s" />
                                                </StackPanel>
                                                <StackPanel Width="130" Margin="0,0,12,6">
                                                    <TextBlock Text="Mistura (s)" Style="{StaticResource DosingFieldLabel}" />
                                                    <TextBox Text="{Binding MixSecondsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 a 999 s" />
