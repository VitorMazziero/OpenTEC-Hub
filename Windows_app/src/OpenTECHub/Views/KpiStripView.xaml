<UserControl x:Class="OpenTECHub.Views.KpiStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OpenTECHub.Controls"
             xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}">

    <!-- ═══════════════════════════════════════════════════════════════════════
         KPI STRIP - Receitas only, per D-011.

         Placed on the shell originally, which gave Painel two viewers of the same
         six variables: this strip and the variable rail, a few hundred pixels
         apart. It belongs where the contrast is the point - over the recipe
         canvas, which describes the INTENDED process, while this shows the actual
         one.

         Built, tested and currently unplaced: Phase 3 hosts it on Receitas.
         Scrolls rather than wrapping or truncating - six tiles today, roughly
         twelve after Phase 3, and a strip that silently drops tiles off the edge
         is worse than one that admits it cannot fit them.
         ═══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <!-- KPI tile: one live reading, pinned across every page. -->
        <DataTemplate x:Key="KpiTileTemplate" DataType="{x:Type vm:ProcessVariableViewModel}">
            <Border Margin="0,0,8,0"
                    Padding="12,7"
                    MinWidth="118"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectVariableCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ctl:StateDot State="{Binding State}" Size="7" Margin="0,0,6,0"
                                      Label="{Binding DisplayName}" />
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding FormattedValue}"
                                   FontFamily="{DynamicResource FontNumeric}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Unit}"
                                   Margin="4,0,0,3"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontSizeCaption}" />
                        <!-- No trend arrow for a commanded figure: there is no series to
                             have a direction. See docs/UI_DESIGN.md section 2. -->
                        <TextBlock Text="{Binding Trend, Converter={StaticResource TrendToGlyph}}"
                                   Margin="6,0,0,3"
                                   VerticalAlignment="Bottom"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding IsCommandedOnly,
                                                Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    </StackPanel>

                    <!-- Omitted entirely when there is no setpoint. "SP —" on every tile
                         before a run starts is a row of noise, and the em dash is
                         supposed to mean "no reading", not "not applicable". -->
                    <TextBlock Text="{Binding FormattedSetpoint, StringFormat='SP {0}'}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding Setpoint, Converter={StaticResource NullToVis}}" />

                    <ctl:ProvenanceBadge Margin="0,3,0,0"
                                         Visibility="{Binding IsCommandedOnly, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Padding="16,10"
            Background="{DynamicResource SurfaceBaseBrush}"
            BorderBrush="{DynamicResource StrokeDefaultBrush}"
            BorderThickness="0,0,0,1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                <ToggleButton x:Name="KpiConfigButton"
                              Style="{StaticResource IconToggleStyle}"
                              AutomationProperties.Name="Configurar indicadores"
                              ToolTip="Configurar indicadores">
                    <ctl:Icon Key="Sliders" Size="18" />
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=KpiConfigButton, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=KpiConfigButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Width="300" Margin="8"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource StrokeDefaultBrush}"
                            BorderThickness="1"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="Configurar indicadores"
                                       FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Um indicador fixado sem dados mostra um traço; nunca desaparece." />

                            <ItemsControl ItemsSource="{Binding KpiOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:KpiOption}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsPinned, Mode=TwoWay}" />
                                            <Button Grid.Column="1" Content="↑" Padding="7,1" MinWidth="26"
                                                    ToolTip="Mover para cima"
                                                    Command="{Binding DataContext.MoveKpiUpCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Content="↓" Padding="7,1" MinWidth="26"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Mover para baixo"
                                                    Command="{Binding DataContext.MoveKpiDownCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,12,0,10" />

                            <CheckBox Content="Mostrar barra de variáveis"
                                      IsChecked="{Binding IsVariableRailVisible, Mode=TwoWay}" />
                            <Button Content="Restaurar padrão" Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ResetKpisCommand}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly">
                <ItemsControl ItemsSource="{Binding PinnedVariables}"
                              ItemTemplate="{StaticResource KpiTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
