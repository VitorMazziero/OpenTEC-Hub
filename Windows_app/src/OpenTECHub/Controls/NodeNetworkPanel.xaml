<UserControl x:Class="OpenTECHub.Controls.NodeNetworkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenTECHub.Converters"
             xmlns:ctl="clr-namespace:OpenTECHub.Controls"
             x:Name="Root">

    <!-- Who the node is on the Hub's network and how to get to it. One block, reused by the
         five external-device drawers, so the wording and the enable rule cannot drift. Identity
         is never a chip and never an alarm: unknown reads as unknown, in words. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <ctl:NodeReachabilityToolTipConverter x:Key="ReachToolTip" />
        <Style x:Key="NodeActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="ToolTip" Value="{Binding CanReachNodes, ElementName=Root, Converter={StaticResource ReachToolTip}}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status.IsNodeReachable, ElementName=Root}" Value="True" />
                        <Condition Binding="{Binding CanReachNodes, ElementName=Root}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding Status, ElementName=Root}" Margin="0,8,0,0">
        <TextBlock Text="Rede" FontWeight="SemiBold" />
        <TextBlock Text="{Binding NetworkSummaryText}"
                   Style="{StaticResource CaptionTextStyle}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   ToolTip="{Binding NodeMacText, StringFormat='MAC {0}'}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />
        <TextBlock Text="{Binding FirmwareAdvisoryText}"
                   Style="{StaticResource CaptionTextStyle}"
                   Foreground="{DynamicResource StateWarningTextBrush}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasFirmwareAdvisory, Converter={StaticResource BoolToVis}}"
                   Margin="0,2,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Abrir diagnóstico"
                    Style="{StaticResource NodeActionButtonStyle}"
                    Command="{Binding OpenCommand, ElementName=Root}"
                    CommandParameter="{Binding}" />
            <Button Content="Copiar IP"
                    Style="{StaticResource NodeActionButtonStyle}"
                    Command="{Binding CopyCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
