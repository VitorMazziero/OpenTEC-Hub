<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         DARK THEME TOKENS  -  Scientific Control Interface
         A RE-MAPPED palette, not an inversion. Offered for low-light rooms;
         light is the primary theme. See docs/UI_DESIGN.md section 3.6.

         Must define EXACTLY the same key set as Tokens.Light.xaml. A key present
         in one file and missing in the other is a runtime crash on theme switch,
         so they are asserted against each other in TokenParityTests.
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Surfaces ─────────────────────────────────────────────────────────-->
    <Color x:Key="SurfaceBaseColor">#11161D</Color>
    <Color x:Key="SurfaceCardColor">#181E26</Color>
    <Color x:Key="SurfaceElevatedColor">#202731</Color>
    <Color x:Key="SurfaceSunkenColor">#0E131A</Color>
    <Color x:Key="SurfaceHoverColor">#232C38</Color>
    <Color x:Key="SurfaceSelectedColor">#1B2B45</Color>
    <!-- Overlay drawer scrim: darker than the light theme so the drawer edge
         still reads against an already dark page. -->
    <Color x:Key="OverlayScrimColor">#59060A10</Color>

    <!-- Semantic control surfaces - see the note in Tokens.Light.xaml. The two
         values INVERT relative to the card here: an input sinks below it, a
         button rises above it. Pointing both at the card colour, as the light
         theme does, would make every field and button vanish into its panel. -->
    <Color x:Key="SurfaceInputColor">#0E131A</Color>   <!-- below the card: a well  -->
    <Color x:Key="SurfaceControlColor">#202731</Color> <!-- above the card: a button -->
    <!-- Stays light - see the note in Tokens.Light.xaml. A knob that followed
         the surface scale would be dark-on-dark against the off-state track. -->
    <Color x:Key="ControlThumbColor">#E7ECF2</Color>

    <!-- ── Text ─────────────────────────────────────────────────────────────-->
    <Color x:Key="TextPrimaryColor">#E7ECF2</Color>
    <Color x:Key="TextSecondaryColor">#A8B2BF</Color>
    <Color x:Key="TextMutedColor">#7E8A99</Color>
    <Color x:Key="TextDisabledColor">#5F6A78</Color>
    <!-- Near-black on the light accent blue: white would be ~2.6:1 and fail. -->
    <Color x:Key="TextOnAccentColor">#0B1220</Color>

    <!-- ── Accent ───────────────────────────────────────────────────────────-->
    <Color x:Key="AccentColor">#5B9CFF</Color>
    <Color x:Key="AccentHoverColor">#7CB1FF</Color>
    <Color x:Key="AccentPressedColor">#3B7FE0</Color>
    <Color x:Key="AccentBorderColor">#2E4A73</Color>
    <Color x:Key="AccentSelectionColor">#1B2B45</Color>
    <Color x:Key="AccentSubtleColor">#151E2B</Color>

    <!-- ── Strokes ──────────────────────────────────────────────────────────-->
    <Color x:Key="StrokeDefaultColor">#303946</Color>
    <Color x:Key="StrokeSubtleColor">#262E39</Color>
    <Color x:Key="StrokeStrongColor">#3D4756</Color>

    <!-- ── Process state ────────────────────────────────────────────────────
         Same hues as light, brightened for contrast against a dark surface.

         The fill and text variants CONVERGE here: every fill below already
         clears 4.5:1 on SurfaceCard #181E26, so no darkened text variant is
         needed. The keys still exist because the light theme needs them and the
         two files must agree - see the header. -->
    <Color x:Key="StateOkColor">#3DD07A</Color>
    <Color x:Key="StateOkTextColor">#3DD07A</Color>
    <Color x:Key="StateActuatingColor">#5B9CFF</Color>
    <Color x:Key="StateActuatingTextColor">#5B9CFF</Color>
    <Color x:Key="StateWarningColor">#F0B429</Color>
    <Color x:Key="StateWarningTextColor">#F0B429</Color>
    <Color x:Key="StateAlarmColor">#F1707B</Color>
    <Color x:Key="StateAlarmTextColor">#F1707B</Color>
    <Color x:Key="StateIdleColor">#8A94A3</Color>
    <Color x:Key="StateIdleTextColor">#8A94A3</Color>
    <Color x:Key="StateDisabledColor">#4A5462</Color>
    <Color x:Key="StateDisabledTextColor">#5F6A78</Color>

    <!-- ── Synoptic paths ───────────────────────────────────────────────────-->
    <Color x:Key="PathPipingColor">#7A879A</Color>
    <Color x:Key="PathSelectedColor">#5B9CFF</Color>
    <Color x:Key="PathGasColor">#5AA0F5</Color>
    <Color x:Key="PathHeatingColor">#F0736E</Color>
    <Color x:Key="PathCoolingColor">#6BA6E8</Color>
    <Color x:Key="PathFeedColor">#5CBF83</Color>
    <Color x:Key="PathAntifoamColor">#B48AE8</Color>
    <Color x:Key="PathInstrumentColor">#8E9CB0</Color>

    <!-- ── Window caption ─────────────────────────────────────────────────── -->
    <Color x:Key="CaptionCloseHoverColor">#D13438</Color>
    <Color x:Key="CaptionCloseGlyphColor">#FFFFFF</Color>

    <!-- ── Chart: ROLE palette ──────────────────────────────────────────────-->
    <Color x:Key="ChartPvColor">#5B9CFF</Color>
    <Color x:Key="ChartSetpointColor">#4ECB77</Color>
    <Color x:Key="ChartOutputColor">#F0A44E</Color>
    <Color x:Key="ChartLimitColor">#E88A8A</Color>
    <Color x:Key="ChartMutedColor">#7E8A99</Color>

    <!-- ── Chart: IDENTITY palette ──────────────────────────────────────────
         Okabe-Ito, lifted for a dark ground. -->
    <Color x:Key="Series1Color">#56B4E9</Color>
    <Color x:Key="Series2Color">#E69F00</Color>
    <Color x:Key="Series3Color">#00C896</Color>
    <Color x:Key="Series4Color">#F09FC8</Color>
    <Color x:Key="Series5Color">#8FD3FF</Color>
    <Color x:Key="Series6Color">#FF8C42</Color>

</ResourceDictionary>
