<UserControl x:Class="TecnalHub.Views.SynopticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:ctl="clr-namespace:TecnalHub.Controls"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             d:DesignWidth="1024" d:DesignHeight="700"
             AutomationProperties.Name="Sinóptico operacional do biorreator">

    <UserControl.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:ActiveToStateConverter x:Key="ActiveToState" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="InstrumentTagTemplate">
            <Grid Margin="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctl:StateDot Grid.Column="0" Size="7" Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  State="{Binding IsEnabled, Converter={StaticResource ActiveToState}}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                               FontSize="10" FontWeight="SemiBold"
                               LineHeight="13" TextWrapping="Wrap" MaxHeight="26"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <Grid Grid.Row="1" Margin="12,2,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}"
                                   FontFamily="{DynamicResource FontNumeric}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Unit}" Margin="3,0,0,2"
                                   VerticalAlignment="Bottom" FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="InstrumentTagStyle" TargetType="ContentControl">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="85" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate" Value="{StaticResource InstrumentTagTemplate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Horizontal scroll bar with all parameter & external device cards -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      Focusable="False"
                      Padding="8,4,8,6">
            <StackPanel Orientation="Horizontal">

                <!-- Parâmetros Internos -->
                <Border Padding="8,6" Margin="0,0,8,0"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource StrokeSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="3,0,0,4">
                            <TextBlock Text="PARÂMETROS INTERNOS"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text=" · Arraste para o gráfico"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Agitação"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Motor}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize a rotação comandada" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Temperatura"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Temperature}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize a temperatura" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="pH"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Ph}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize o pH" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Oxigênio"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Oxygen}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize o oxigênio dissolvido" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Alívio de Pressão"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Pressure}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize a pressão" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Dosagem de Nutrientes"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Nutrient}" Content="{Binding}"
                                            ToolTip="Bomba de nutrientes do módulo TECNAL" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Dosagem de Antiespumante"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Antifoam}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize o antiespumante" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dispositivos Externos -->
                <Border Padding="8,6"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource StrokeSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="3,0,0,4">
                            <TextBlock Text="DISPOSITIVOS EXTERNOS"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text=" · Arraste para o gráfico"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Vazão de Ar"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Flow}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize a vazão de aeração" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Sensor de Distância"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Level}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize a distância/nível" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Sensor de Biomassa"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Biomass}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize a absorbância de biomassa" />
                            <ContentControl Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Bomba Dosadora Externa"
                                            MouseMove="Card_MouseMove"
                                            DataContext="{Binding Pump}" Content="{Binding}"
                                            ToolTip="Arraste para o gráfico ou visualize a bomba externa" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Main Chart Area (Supports 1, 2, or 4 plots) -->
        <Grid x:Name="ChartArea" Grid.Row="1" Margin="8,0,8,4">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="*" />
                <RowDefinition x:Name="BottomRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Plot 1: Top-Left Host & Drop Target -->
            <Border x:Name="LeftDropTarget" Grid.Row="0" Grid.Column="0"
                    Margin="0,0,3,3"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    DragEnter="Plot_DragEnter"
                    DragOver="Plot_DragOver"
                    DragLeave="Plot_DragLeave"
                    Drop="Plot_Drop">
                <Grid>
                    <Border x:Name="LeftHost" />
                    <!-- Drag feedback & sub-selection overlay -->
                    <Border x:Name="LeftOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="{DynamicResource SurfaceCardBrush}" Opacity="0.96"
                            CornerRadius="{DynamicResource RadiusMedium}">
                        <ContentPresenter x:Name="LeftOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Plot 2: Top-Right Host & Drop Target -->
            <Border x:Name="RightDropTarget" Grid.Row="0" Grid.Column="1"
                    Margin="3,0,0,3"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    DragEnter="Plot_DragEnter"
                    DragOver="Plot_DragOver"
                    DragLeave="Plot_DragLeave"
                    Drop="Plot_Drop">
                <Grid>
                    <Border x:Name="RightHost" />
                    <!-- Drag feedback & sub-selection overlay -->
                    <Border x:Name="RightOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="{DynamicResource SurfaceCardBrush}" Opacity="0.96"
                            CornerRadius="{DynamicResource RadiusMedium}">
                        <ContentPresenter x:Name="RightOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Plot 3: Bottom-Left Host & Drop Target -->
            <Border x:Name="BottomLeftDropTarget" Grid.Row="1" Grid.Column="0"
                    Margin="0,3,3,0"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    DragEnter="Plot_DragEnter"
                    DragOver="Plot_DragOver"
                    DragLeave="Plot_DragLeave"
                    Drop="Plot_Drop">
                <Grid>
                    <Border x:Name="BottomLeftHost" />
                    <!-- Drag feedback & sub-selection overlay -->
                    <Border x:Name="BottomLeftOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="{DynamicResource SurfaceCardBrush}" Opacity="0.96"
                            CornerRadius="{DynamicResource RadiusMedium}">
                        <ContentPresenter x:Name="BottomLeftOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Plot 4: Bottom-Right Host & Drop Target -->
            <Border x:Name="BottomRightDropTarget" Grid.Row="1" Grid.Column="1"
                    Margin="3,3,0,0"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    DragEnter="Plot_DragEnter"
                    DragOver="Plot_DragOver"
                    DragLeave="Plot_DragLeave"
                    Drop="Plot_Drop">
                <Grid>
                    <Border x:Name="BottomRightHost" />
                    <!-- Drag feedback & sub-selection overlay -->
                    <Border x:Name="BottomRightOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="{DynamicResource SurfaceCardBrush}" Opacity="0.96"
                            CornerRadius="{DynamicResource RadiusMedium}">
                        <ContentPresenter x:Name="BottomRightOverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Chart Controls & Status Toolbar (Enclosed Card) -->
        <Border Grid.Row="2"
                Margin="8,2,8,6"
                Padding="10,6"
                CornerRadius="{DynamicResource RadiusMedium}"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                BorderThickness="1">
            <DockPanel>
                <!-- Right status info -->
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Charts.DataSourceText}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Charts.SampleCountText}" Margin="12,0,0,0"
                               FontSize="11"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding Charts.CursorText}" Margin="12,0,0,0"
                               FontSize="11"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource AccentBrush}" />
                </WrapPanel>

                <!-- Left control buttons -->
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="{Binding Charts.PanelModeLabel}" Margin="0,0,8,0" Padding="8,4"
                            ToolTip="Alternar exibição entre 1, 2 ou 4 gráficos simultâneos"
                            Command="{Binding Charts.ToggleSecondPanelCommand}" />

                    <TextBlock Text="Janela:" Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" Margin="6,0,6,0" />
                    <ComboBox Width="90" Margin="0,0,10,0"
                              ItemsSource="{Binding Charts.Windows}"
                              SelectedItem="{Binding Charts.SelectedWindow, Mode=TwoWay}" />

                    <Button Content="{Binding Charts.PauseLabel}" Margin="0,0,6,0"
                            Command="{Binding Charts.TogglePauseCommand}" />

                    <Button Content="{Binding Charts.CursorLabel}" Margin="0,0,10,0"
                            Command="{Binding Charts.ToggleCursorCommand}" />

                    <Button Content="Nova Etapa" Margin="0,0,6,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding Charts.NewSessionCommand}"
                            ToolTip="Inicia um novo arquivo de sessão para nova condição de processo e zera a contagem relativa." />

                    <Button Content="Marcar Evento" Margin="0,0,10,0"
                            Command="{Binding Charts.AnnotateEventCommand}"
                            ToolTip="Adiciona uma anotação textual no registro de eventos do processo." />

                    <Button Content="Exportar PNG" Margin="0,0,6,0"
                            Click="ExportPng_Click" />
                    <Button Content="Exportar CSV" Margin="0,0,6,0"
                            Click="ExportCsv_Click" />

                    <Button Content="Voltar ao tempo real" Margin="6,0,0,0"
                            Visibility="{Binding Charts.IsSessionLoaded, Converter={StaticResource BoolToVis}}"
                            Command="{Binding Charts.ReturnToLiveCommand}" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
