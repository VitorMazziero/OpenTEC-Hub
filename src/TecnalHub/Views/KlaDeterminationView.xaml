<UserControl x:Class="TecnalHub.Views.KlaDeterminationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:kla="clr-namespace:TecnalHub.Services.KlaTesting"
             xmlns:ctl="clr-namespace:TecnalHub.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:KlaDeterminationViewModel}"
             d:DesignHeight="850" d:DesignWidth="1500">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

        <Style x:Key="KlaHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="KlaHeaderValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="KlaCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Top Header Strip ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,6" Style="{StaticResource KlaCard}" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Active Test info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Determinação de kLa" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Margin="10,0,0,0" Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayPhase}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <Border Margin="8,0,0,0" Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="8,2" Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SIMULAÇÃO" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource StateWarningTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding StatusMessage}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding SimulationDescription}" FontWeight="SemiBold"
                               Foreground="{DynamicResource StateWarningTextBrush}"
                               Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Middle: Telemetry & Timers -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="OD Dissolvido" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding CurrentDO, StringFormat={}{0:F1} %}" Style="{StaticResource KlaHeaderValue}" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Vazão Atual" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding CurrentFlow, StringFormat={}{0:F2} L/min}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Tempo da Fase" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding FormattedPhaseTime}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Padding="10,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Tempo Total" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBlock Text="{Binding FormattedTotalTime}" Style="{StaticResource KlaHeaderValue}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Novo Teste" Margin="3,0" Style="{StaticResource AccentButtonStyle}" Command="{Binding OpenCreateDialogCommand}" />
                    <Button Content="Importar Teste" Margin="3,0" Command="{Binding OpenLoadTestDialogCommand}" ToolTip="Carregar ensaio salvo para visualização e reanálise de curvas" />
                    <Button Content="Parar e Revisar" Margin="3,0" Command="{Binding StopRunCommand}" IsEnabled="{Binding IsRunning}" />
                    <Button Content="Concluir Teste" Margin="3,0" Command="{Binding CompleteTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                    <Button Content="Abortar" Margin="3,0" Command="{Binding AbortTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Area: Split View ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" MinWidth="360" MaxWidth="540" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left Column: Scrollable Cards (Conditions, Settings & Scientific Review) ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <!-- 1. Matriz de Condições Experimentais -->
                    <Border Style="{StaticResource KlaCard}" Margin="0,0,0,10" Padding="14,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Matriz de Condições Experimentais" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Executar Sequência" HorizontalAlignment="Right"
                                        Height="32" Padding="14,4" FontSize="12" FontWeight="SemiBold"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding OpenStartSequenceDialogCommand}"
                                        IsEnabled="{Binding CanStartSequence}" />
                            </DockPanel>

                            <!-- Condition Table with individual replicate rows -->
                            <DataGrid ItemsSource="{Binding MatrixRows}" SelectedItem="{Binding SelectedMatrixRow}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      Height="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      BorderThickness="1" BorderBrush="{DynamicResource StrokeDefaultBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="28" IsReadOnly="True" />
                                    <DataGridTextColumn Header="N (rpm)" Binding="{Binding AgitationRpm, StringFormat={}{0:F0}}" Width="62" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Q (L/min)" Binding="{Binding AirflowLpm, StringFormat={}{0:F2}}" Width="68" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="kLa (h⁻¹)" Binding="{Binding DisplayKla}" Width="70" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Ações" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Width="26" Height="22" Padding="0" Margin="2,0"
                                                            Background="Transparent" BorderThickness="0"
                                                            ToolTip="Carregar curva e resultados deste ensaio"
                                                            Command="{Binding DataContext.LoadMatrixRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding HasRunData}">
                                                        <ctl:Icon Key="Trend" Size="14" Stroke="{DynamicResource AccentBrush}" />
                                                    </Button>
                                                    <Button Width="26" Height="22" Padding="0" Margin="4,0,2,0"
                                                            Background="Transparent" BorderThickness="0"
                                                            ToolTip="Remover condição da matriz (exige confirmação)"
                                                            Command="{Binding DataContext.RemoveMatrixRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}">
                                                        <ctl:Icon Key="Trash" Size="13" Stroke="{DynamicResource StateAlarmBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Integrated Manual Add Row (Inline Labels & Synchronized Alignment) -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="KlaLbl1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="KlaLbl2" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="KlaLbl3" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="KlaBtnCol" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="N (rpm):" Style="{StaticResource KlaHeaderLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" />
                                <TextBox Grid.Column="1" Text="{Binding NewConditionRpm, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,3" FontSize="11.5" Margin="0,0,8,0" />

                                <TextBlock Grid.Column="2" Text="Q (L/min):" Style="{StaticResource KlaHeaderLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" />
                                <TextBox Grid.Column="3" Text="{Binding NewConditionFlow, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,3" FontSize="11.5" Margin="0,0,8,0" />

                                <TextBlock Grid.Column="4" Text="Reps:" Style="{StaticResource KlaHeaderLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" />
                                <TextBox Grid.Column="5" Text="{Binding NewConditionReplicates, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,3" FontSize="11.5" Margin="0,0,6,0" />

                                <Button Grid.Column="6" Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                                        Command="{Binding AddManualConditionCommand}" IsEnabled="{Binding CanStartSequence}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTip="Adicionar condição manual à matriz">
                                    <ctl:Icon Key="Plus" Size="14" Stroke="{DynamicResource TextOnAccentBrush}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Card de Revisão Científica e Aceite (Posicionado Centralmente) -->
                    <Border Style="{StaticResource KlaCard}" Margin="0,0,0,10" Padding="14,10">
                        <StackPanel>
                            <!-- Header -->
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Revisão Científica e Aceite" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Content="Aceite Automático" IsChecked="{Binding AutoAcceptRuns}"
                                              FontSize="11.5" Margin="12,0,0,0" VerticalAlignment="Center"
                                              ToolTip="Calcula a faixa 45%—70% e avança automaticamente a sequência de ensaios" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,3">
                                    <TextBlock Text="{Binding DisplayReviewQuality}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </DockPanel>

                            <!-- Parâmetros de Ajuste: Região Linear e Região C* -->
                            <Grid Margin="0,0,0,10" IsEnabled="{Binding IsReviewOpen}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Região Linear (s): [ Start ] – [ End ] | Botão Recalcular -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Recalcular"
                                            Height="30" Padding="14,4" FontSize="11.5" FontWeight="SemiBold"
                                            Command="{Binding RecomputeReviewAnalysisCommand}" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Região Linear (s):" Style="{StaticResource KlaHeaderLabel}" Width="100" VerticalAlignment="Center" FontSize="11" />
                                        <TextBox Text="{Binding ReviewTStart, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Width="58" Height="30" Padding="4,3" FontSize="11.5" TextAlignment="Center" />
                                        <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                                        <TextBox Text="{Binding ReviewTEnd, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Width="58" Height="30" Padding="4,3" FontSize="11.5" TextAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Row 1: Região C* (s): [ Start ] – [ End ] | Ceq (%): [x] [ Ceq ] -->
                                <DockPanel Grid.Row="1">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Ceq (%):" Style="{StaticResource KlaHeaderLabel}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                                        <CheckBox IsChecked="{Binding ReviewCeqIsManual}" ToolTip="Ajuste manual de Ceq" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding ReviewCeq, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ReviewCeqIsManual}" Width="60" Height="30" Padding="4,3" FontSize="11.5" TextAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Região C* (s):" Style="{StaticResource KlaHeaderLabel}" Width="100" VerticalAlignment="Center" FontSize="11" />
                                        <TextBox Text="{Binding ReviewCeqTStart, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Width="58" Height="30" Padding="4,3" FontSize="11.5" TextAlignment="Center" />
                                        <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" />
                                        <TextBox Text="{Binding ReviewCeqTEnd, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" Width="58" Height="30" Padding="4,3" FontSize="11.5" TextAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <!-- Métricas Científicas em Grande Destaque (Fontes Ampliadas) -->
                            <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: kLa Principal em Grande Destaque e IC 95% -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="kLa Estimado" Style="{StaticResource KlaHeaderLabel}" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DisplayReviewKla}"
                                                   FontSize="26" FontWeight="Bold"
                                                   FontFamily="{DynamicResource FontMono}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,2,0,2" />
                                        <TextBlock Text="{Binding DisplayReviewCi95}"
                                                   FontSize="11.5"
                                                   FontFamily="{DynamicResource FontMono}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Col 1: R² e Qualidade do Ajuste -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayReviewR2}"
                                                   FontSize="15" FontWeight="Bold"
                                                   FontFamily="{DynamicResource FontMono}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding DisplayReviewRmse}"
                                                   FontSize="11"
                                                   FontFamily="{DynamicResource FontMono}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,2" />
                                        <DockPanel>
                                            <TextBlock Text="Sensib.:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,3,0" />
                                            <TextBlock Text="{Binding DisplayReviewSens}"
                                                       FontSize="11"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Action Buttons (Proportional & Breathable) -->
                            <Grid IsEnabled="{Binding IsReviewOpen}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Repetir" Margin="0,0,4,0" Height="36" FontSize="12" Command="{Binding RepeatCurrentRunCommand}" />
                                <Button Grid.Column="1" Content="Rejeitar" Margin="4,0,4,0" Height="36" FontSize="12" Command="{Binding RejectCurrentRunCommand}" />
                                <Button Grid.Column="2" Content="Aceitar Corrida" Margin="4,0,0,0" Height="36" FontSize="12.5" FontWeight="SemiBold" Style="{StaticResource AccentButtonStyle}" Command="{Binding AcceptCurrentRunCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. Limiares de Operação (Posicionado Abaixo da Revisão) -->
                    <Border Style="{StaticResource KlaCard}" Margin="0,0,0,6" Padding="14,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Limiares de Operação" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Width="30" Height="30" Padding="0"
                                        Command="{Binding OpenAdvancedSettingsDialogCommand}"
                                        ToolTip="Configurações Adicionais de Limiares"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <ctl:Icon Key="Gear" Size="14" Stroke="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                            </DockPanel>

                            <!-- DO Mín, DO Máx, Rot. N2 (1 Linha Compacta) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="KlaLbl1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="KlaLbl2" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="KlaLbl3" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="KlaBtnCol" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Desligar N₂ (%):" Style="{StaticResource KlaHeaderLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                                <TextBox Grid.Column="1" Text="{Binding SettingDOMin, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,3" FontSize="11.5" Margin="0,0,8,0" />

                                <TextBlock Grid.Column="2" Text="DO Máx (%):" Style="{StaticResource KlaHeaderLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                                <TextBox Grid.Column="3" Text="{Binding SettingDOMax, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,3" FontSize="11.5" Margin="0,0,8,0" />

                                <TextBlock Grid.Column="4" Text="Rot. N₂ (rpm):" Style="{StaticResource KlaHeaderLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                                <TextBox Grid.Column="5" Grid.ColumnSpan="2" Text="{Binding SettingDegassingAgitation, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,3" FontSize="11.5" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Right Column: Scrollable 3 Synchronized Plots ────────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                <Grid MinHeight="620">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" MinHeight="190" />
                        <RowDefinition Height="1*" MinHeight="190" />
                        <RowDefinition Height="1*" MinHeight="190" />
                    </Grid.RowDefinitions>

                    <!-- Chart 1: DO vs Time -->
                    <Border Grid.Row="0" Margin="0,0,0,4"
                            Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource StrokeDefaultBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}"
                            Padding="4,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- External Legend Strip (Above Plot) -->
                            <DockPanel Grid.Row="0" Margin="4,2,4,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Oxigênio Dissolvido" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource Series5Brush}" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="9.5" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource Series5Brush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Região C*: [{0:F1}s — {1:F1}s]">
                                                    <Binding Path="ReviewCeqTStart" />
                                                    <Binding Path="ReviewCeqTEnd" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- OD Bruto -->
                                    <Border Width="12" Height="2" Background="{DynamicResource Series5Brush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                    <TextBlock Text="OD Bruto" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <!-- OD Filtrado -->
                                    <Border Width="14" Height="3" Background="{DynamicResource ChartPvBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                                    <TextBlock Text="OD Filtrado" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <!-- DO Mín -->
                                    <Border Width="12" Height="2" Background="{DynamicResource StateAlarmBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                                    <TextBlock Text="DO Mín" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <!-- DO Máx -->
                                    <Border Width="12" Height="2" Background="{DynamicResource StateOkBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                                    <TextBlock Text="DO Máx" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <!-- Ajuste Exp kLa (Pink dashed) -->
                                    <Border Width="14" Height="2" Background="{DynamicResource Series4Brush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                                    <TextBlock Text="Ajuste Exp (kLa)" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Plot Host -->
                            <Border x:Name="ChartDoHost" Grid.Row="1" />

                            <!-- Interactive RangeSlider Strip: C* Region Selection (Aligned with Plot X Axis) -->
                            <Grid Grid.Row="2" Margin="0,0,0,2"
                                  Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVis}}">
                                <ctl:RangeSlider Margin="37,0,7,0"
                                                 Minimum="{Binding ReviewMinTime}" Maximum="{Binding ReviewMaxTime}"
                                                 LowerValue="{Binding ReviewCeqTStart, Mode=TwoWay}"
                                                 UpperValue="{Binding ReviewCeqTEnd, Mode=TwoWay}"
                                                 RangeBrush="{DynamicResource Series5Brush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Chart 2: Log-Linear OLS Fit -->
                    <Border Grid.Row="1" Margin="0,0,0,4"
                            Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource StrokeDefaultBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}"
                            Padding="4,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- External Legend Strip (Above Plot) -->
                            <DockPanel Grid.Row="0" Margin="4,2,4,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Regressão Log-Linear: ln(Ceq - C)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="9.5" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource StateWarningBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Região Linear: [{0:F1}s — {1:F1}s]">
                                                    <Binding Path="ReviewTStart" />
                                                    <Binding Path="ReviewTEnd" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- ln(Ceq - C) -->
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PathAntifoamBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                    <TextBlock Text="ln(Ceq - C)" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <!-- Ajuste OLS -->
                                    <Border Width="16" Height="3" Background="{DynamicResource StateAlarmBrush}" VerticalAlignment="Center" Margin="10,0,3,0" />
                                    <TextBlock Text="Ajuste OLS" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Plot Host -->
                            <Border x:Name="ChartLogLinearHost" Grid.Row="1" />

                            <!-- Interactive RangeSlider Strip: Linear Region Selection (Aligned with Plot X Axis) -->
                            <Grid Grid.Row="2" Margin="0,0,0,2"
                                  Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVis}}">
                                <ctl:RangeSlider Margin="37,0,7,0"
                                                 Minimum="{Binding ReviewMinTime}" Maximum="{Binding ReviewMaxTime}"
                                                 LowerValue="{Binding ReviewTStart, Mode=TwoWay}"
                                                 UpperValue="{Binding ReviewTEnd, Mode=TwoWay}"
                                                 RangeBrush="{DynamicResource StateWarningBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Chart 3: Instantaneous kLa -->
                    <Border Grid.Row="2" Margin="0,0,0,4"
                            Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource StrokeDefaultBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}"
                            Padding="4,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- External Legend Strip (Above Plot) -->
                            <DockPanel Grid.Row="0" Margin="4,2,4,2">
                                <TextBlock Text="kLa Instantâneo Diagnóstico" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- kLa Inst -->
                                    <Border Width="14" Height="3" Background="{DynamicResource StateOkBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                    <TextBlock Text="kLa Inst" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <!-- kLa Final -->
                                    <Border Width="14" Height="2" Background="{DynamicResource StateAlarmBrush}" VerticalAlignment="Center" Margin="10,0,3,0" />
                                    <TextBlock Text="kLa Final" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Plot Host -->
                            <Border x:Name="ChartInstantKlaHost" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ── Modal: Novo Teste ──────────────────────────────────────────────── -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVis}}">
            <!-- Scrim / Backdrop -->
            <Border Background="{DynamicResource SurfaceBaseBrush}" Opacity="0.75" />

            <!-- Solid Modal Dialog Card -->
            <Border Style="{StaticResource KlaCard}" Background="{DynamicResource SurfaceElevatedBrush}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Criar Novo Teste de kLa" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                    <TextBlock Text="Nome do Teste (Pasta em Testes-kLa/)" Style="{StaticResource KlaHeaderLabel}" />
                    <TextBox Text="{Binding NewTestName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                    <TextBlock Text="Válvula Conectada ao N₂" Style="{StaticResource KlaHeaderLabel}" />
                    <ComboBox SelectedValue="{Binding SelectedN2Valve}" SelectedValuePath="Tag" Margin="0,2,0,10">
                        <ComboBoxItem Content="valve_1" Tag="{x:Static kla:NitrogenValve.Valve1}" />
                        <ComboBoxItem Content="valve_2" Tag="{x:Static kla:NitrogenValve.Valve2}" />
                    </ComboBox>

                    <TextBlock Text="Importar Condições de Mapa Existente (Opcional)" Style="{StaticResource KlaHeaderLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableMaps}" SelectedItem="{Binding SelectedMapForImport}" DisplayMemberPath="Snapshot.Name" Margin="0,2,0,10" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Desligar N₂ em DO (%)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDOMin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="DO Máx (%)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDOMax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="Rotação Nitrogênio (rpm)" Style="{StaticResource KlaHeaderLabel}" />
                            <TextBox Text="{Binding SettingDegassingAgitation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Margin="0,0,8,0" Command="{Binding CloseCreateDialogCommand}" />
                        <Button Content="Criar Teste" Style="{StaticResource AccentButtonStyle}" Command="{Binding CreateNewTestCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Modal: Configurações Avançadas de Limiares ─────────────────────── -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsAdvancedSettingsDialogOpen, Converter={StaticResource BoolToVis}}">
            <!-- Scrim / Backdrop -->
            <Border Background="{DynamicResource SurfaceBaseBrush}" Opacity="0.75" />

            <!-- Solid Modal Dialog Card -->
            <Border Style="{StaticResource KlaCard}" Background="{DynamicResource SurfaceElevatedBrush}" Width="680" MaxHeight="760" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ctl:Icon Key="Gear" Size="18" Stroke="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Parâmetros Avançados do Teste" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <TextBlock Text="Alterações válidas são aplicadas ao vivo." Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Concluir" Style="{StaticResource AccentButtonStyle}" Height="32" Padding="16,4" Command="{Binding SaveAdvancedSettingsCommand}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Operação e gases" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Desligar N₂ em DO (%)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingDOMin, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="Encerrar em DO (%)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingDOMax, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Rotação com N₂ (rpm)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingDegassingAgitation, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Válvula do N₂" Style="{StaticResource KlaHeaderLabel}" />
                                    <ComboBox SelectedValue="{Binding SelectedN2Valve}" SelectedValuePath="Tag" IsEnabled="{Binding CanChangeNitrogenValve}">
                                        <ComboBoxItem Content="valve_1" Tag="{x:Static kla:NitrogenValve.Valve1}" />
                                        <ComboBoxItem Content="valve_2" Tag="{x:Static kla:NitrogenValve.Valve2}" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="Máx. desoxigenação (min)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingMaxDegassingMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Máx. reoxigenação (min)" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBox Text="{Binding SettingMaxReoxygenationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Espera após desligar N₂" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Atraso mínimo (s)" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingPostNitrogenMinimumDelaySeconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Janela da derivada (s)" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingStabilityDerivativeSpanSeconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="|dDO/dt| estável (%/s)" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingStabilityDerivativeThreshold, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Confirmações consecutivas" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingStabilityRequiredSamples, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Espera máxima pós-N₂ (s)" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingMaxPostNitrogenStabilizationSeconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Leitura atual" Style="{StaticResource KlaHeaderLabel}" />
                                    <TextBlock Text="{Binding DisplayDODerivative}" FontFamily="{DynamicResource FontMono}" FontWeight="SemiBold" Margin="2,7,0,0" />
                                    <TextBlock Text="{Binding DisplayStabilityProgress, StringFormat='Confirmações: {0}'}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Análise automática e revisão" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Suavização (pontos ímpares)" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingSmoothingWindow, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Ceq inicial (%)" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingDefaultCeq, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Bottom"><CheckBox Content="Aceite automático" IsChecked="{Binding AutoAcceptRuns}" Margin="0,0,0,7" /></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Faixa linear inicial (%)" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingAutoLinearStartPercent, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Faixa linear final (%)" Style="{StaticResource KlaHeaderLabel}" /><TextBox Text="{Binding SettingAutoLinearEndPercent, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Modal: Importar / Carregar Teste ───────────────────────────────── -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsLoadTestDialogOpen, Converter={StaticResource BoolToVis}}">
            <!-- Scrim / Backdrop -->
            <Border Background="{DynamicResource SurfaceBaseBrush}" Opacity="0.75" />

            <!-- Solid Modal Dialog Card -->
            <Border Style="{StaticResource KlaCard}" Background="{DynamicResource SurfaceElevatedBrush}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ctl:Icon Key="FolderOpen" Size="20" Stroke="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Importar Ensaio de kLa" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Selecione um ensaio gravado em Testes-kLa/ para carregar curvas e resultados:" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10" />

                    <ListBox ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTestSummary}" Height="200" Margin="0,0,0,14" BorderThickness="1" BorderBrush="{DynamicResource StrokeDefaultBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding CreatedUtc, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Importar pasta..." Margin="0,0,8,0" Height="32" Padding="14,4" Command="{Binding ImportTestFolderCommand}" />
                        <Button Content="Cancelar" Margin="0,0,8,0" Height="32" Padding="14,4" Command="{Binding CloseLoadTestDialogCommand}" />
                        <Button Content="Carregar Ensaio" Style="{StaticResource AccentButtonStyle}" Height="32" Padding="14,4" Command="{Binding ConfirmLoadTestCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Modal: Executar Sequência ──────────────────────────────────────── -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsStartSequenceDialogOpen, Converter={StaticResource BoolToVis}}">
            <!-- Scrim / Backdrop -->
            <Border Background="{DynamicResource SurfaceBaseBrush}" Opacity="0.75" />

            <!-- Solid Modal Dialog Card -->
            <Border Style="{StaticResource KlaCard}" Background="{DynamicResource SurfaceElevatedBrush}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ctl:Icon Key="Play" Size="20" Stroke="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Executar Sequência de Ensaios" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Selecione como deseja executar a matriz experimental:" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" />

                    <!-- Options Group -->
                    <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Option 1: Pending Only -->
                            <RadioButton IsChecked="{Binding IsSequenceModePending, Mode=TwoWay}" GroupName="SequenceMode" Margin="0,0,0,8">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Executar apenas testes pendentes (sem resultados)" FontWeight="SemiBold" />
                                    <TextBlock Text="Executa somente as condições que ainda não possuem réplicas aceitas na matriz."
                                               Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Option 2: From Selected Row -->
                            <RadioButton IsChecked="{Binding IsSequenceModeFromSelected, Mode=TwoWay}" GroupName="SequenceMode" IsEnabled="{Binding HasSelectedRowForSequence}" Margin="0,4,0,8">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Executar a partir da linha selecionada na matriz" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SequenceSelectedRowDescription}"
                                               Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Option 3: All -->
                            <RadioButton IsChecked="{Binding IsSequenceModeAll, Mode=TwoWay}" GroupName="SequenceMode" Margin="0,4,0,0">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Executar todos os testes da tabela (do início)" FontWeight="SemiBold" />
                                    <TextBlock Text="Executa sequencialmente todas as condições da matriz a partir da primeira linha."
                                               Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Preview of conditions that will be executed -->
                    <TextBlock Text="{Binding SequenceQueueSummaryText}" Style="{StaticResource KlaHeaderLabel}" Margin="0,0,0,4" />
                    <Border BorderThickness="1" BorderBrush="{DynamicResource StrokeDefaultBrush}" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceCardBrush}" Height="110" Margin="0,0,0,10">
                        <ListBox ItemsSource="{Binding SequencePreviewQueue}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding OrderIndex, StringFormat='{}#{0}'}" FontWeight="Bold" Width="26" Foreground="{DynamicResource AccentBrush}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding AgitationRpm, StringFormat='{}{0:F0} rpm'}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding AirflowLpm, StringFormat='{}{0:F2} L/min'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding RequestedReplicates, StringFormat='{}({0} rep.)'}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <DockPanel Margin="0,0,0,14">
                        <CheckBox Content="Aceite Automático das Corridas (Avançar sem pausa para revisão)"
                                  IsChecked="{Binding AutoAcceptRuns, Mode=TwoWay}"
                                  FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Margin="0,0,8,0" Height="32" Padding="14,4" Command="{Binding CloseStartSequenceDialogCommand}" />
                        <Button Content="Iniciar Sequência" Style="{StaticResource AccentButtonStyle}" Height="32" Padding="14,4" Command="{Binding ConfirmStartSequenceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
