<UserControl x:Class="OpenTECHub.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:OpenTECHub.Converters"
             xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
             xmlns:power="clr-namespace:OpenTECHub.Services.PowerTesting"
             xmlns:views="clr-namespace:OpenTECHub.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PowerTestViewModel}"
             d:DesignHeight="900" d:DesignWidth="1500">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <Style x:Key="PowerCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="PowerLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="PowerMetric" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="CompactField" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PowerTabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Padding="12,4" CornerRadius="{DynamicResource RadiusSmall}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,7" Style="{StaticResource PowerCard}" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <!-- Linha superior: Título, Seletor de abas e Badges contextuais -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Potência" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />

                        <!-- Seletor de abas: Mapeamento de Potência | Modelos e Ajustes -->
                        <Border Margin="14,0,10,0" Padding="2"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Mapeamento de Potência"
                                             GroupName="PowerTopTabs"
                                             IsChecked="{Binding IsMappingTabSelected, Mode=TwoWay}"
                                             Style="{StaticResource PowerTabRadioButton}"
                                             ToolTip="Ensaio e aquisição: montagem, telemetria ao vivo, tabela de condições e validação de kLa" />
                                <RadioButton Content="Modelos e Ajustes"
                                             GroupName="PowerTopTabs"
                                             IsChecked="{Binding IsModelsTabSelected, Mode=TwoWay}"
                                             Style="{StaticResource PowerTabRadioButton}"
                                             ToolTip="Superfície de potência interpolada, correlações kLa, gráficos 2D/3D e comparação de impelidores" />
                            </StackPanel>
                        </Border>

                        <!-- Badges contextuais de Mapeamento de Potência -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}">
                            <Border Margin="6,0,0,0" Padding="8,2" Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="{Binding PhaseLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Border Margin="7,0,0,0" Padding="8,2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4">
                                <TextBlock Text="{Binding ResultModeLabel}" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <!-- Badges contextuais de Modelos e Ajustes -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsModelsTabSelected, Converter={StaticResource BoolToVis}}">
                            <Border Margin="6,0,0,0" Padding="8,2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4">
                                <TextBlock Text="{Binding MapViewModel.GridResolutionLabel}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Margin="7,0,0,0" Padding="8,2" CornerRadius="4"
                                    Background="{DynamicResource StateWarningBrush}"
                                    Visibility="{Binding MapViewModel.IsSurfaceStale, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Malha desatualizada — reconstrua" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource StateWarningTextBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Linha de status para Mapeamento de Potência -->
                    <StackPanel Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,3,0,0" Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <!-- Preflight ao vivo: o operador le o que falta antes de apertar Iniciar -->
                        <Border Margin="0,5,0,0" Padding="8,3" CornerRadius="4" HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource StateWarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReadyToStart}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource StateOkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PreflightMessage}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource StateWarningTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReadyToStart}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource StateOkTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Linha de status para Modelos e Ajustes -->
                    <StackPanel Visibility="{Binding IsModelsTabSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,4,0,0" Text="{Binding MapViewModel.StatusMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- Ações contextuais de Mapeamento de Potência -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}">
                    <Button Content="Novo" Margin="3,0" Command="{Binding CreateTestCommand}" />
                    <Button Content="Salvar setup" Margin="3,0" Command="{Binding SaveSetupCommand}" IsEnabled="{Binding CanEditPlan}" />
                    <Button Content="▶ Iniciar/continuar" Margin="3,0" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding StartOrContinueCommand}" IsEnabled="{Binding CanStartOrContinue}" />
                    <Button Content="{Binding PauseButtonLabel}" Margin="3,0" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding CanPause}" />
                    <Button Content="Pular" Margin="3,0" Command="{Binding SkipCurrentCommand}" IsEnabled="{Binding CanSkipCurrent}" />
                    <Button Content="Parar e revisar" Margin="3,0" Command="{Binding StopAndReviewCommand}" IsEnabled="{Binding CanStop}" />
                </StackPanel>

                <!-- Ações contextuais de Modelos e Ajustes -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsModelsTabSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Novo mapa" VerticalAlignment="Center" Margin="3,0,5,0" Style="{StaticResource PowerLabel}" />
                    <TextBox Width="180" Margin="0,0,5,0" VerticalAlignment="Center" Style="{StaticResource CompactField}"
                             Text="{Binding MapViewModel.NewMapName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nome do mapa que será criado" />
                    <Button Content="Novo mapa" Margin="3,0" Command="{Binding MapViewModel.CreateMapCommand}" />
                    <Button Content="Salvar" Margin="3,0" Command="{Binding MapViewModel.SaveMapCommand}"
                            IsEnabled="{Binding MapViewModel.HasMap}" />
                    <Button Content="↻ Reconstruir superfície" Margin="3,0" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding MapViewModel.ReconstructSurfaceCommand}" IsEnabled="{Binding MapViewModel.HasMap}" />
                    <Button Content="Excluir" Margin="3,0" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding MapViewModel.DeleteMapCommand}" IsEnabled="{Binding MapViewModel.HasMap}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- Conteúdo da Aba 1: Mapeamento de Potência (ensaio, montagem, aquisição, gráficos ao vivo, tabela) -->
            <Grid Visibility="{Binding IsMappingTabSelected, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="320" MaxWidth="390" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="430" />
                </Grid.ColumnDefinitions>

            <!-- Fluxo do operador: montagem, aquisição, condições e validação. -->
            <TabControl Grid.Column="0" Style="{StaticResource SegmentedControlStyle}">
                <TabItem Header="Montagem" ToolTip="1. Selecione o ensaio e descreva fluido, vaso e impelidores">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                        <StackPanel>
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="Ensaio" FontSize="15" FontWeight="SemiBold" />
                            <ComboBox Margin="0,8,0,5" ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}"
                                      DisplayMemberPath="Name" ToolTip="Ensaios autocontidos em Testes-Potencia" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{Binding TestStatusLabel}" FontWeight="SemiBold"
                                           ToolTip="Rascunhos e ensaios interrompidos podem ter sua tabela editada enquanto estão parados" />
                                <Button Grid.Column="1" Content="Abrir" Command="{Binding LoadSelectedTestCommand}" Padding="10,4"
                                        ToolTip="Carrega o ensaio escolhido acima: fluido, geometria, tabela de condições e pontos já medidos" />
                            </Grid>
                            <WrapPanel Margin="0,5,0,0" HorizontalAlignment="Right">
                                <Button Content="Renomear" Command="{Binding RenameTestCommand}"
                                        IsEnabled="{Binding CanManageTest}" Padding="8,4" ToolTip="Renomeia o ensaio aberto e sua pasta" />
                                <Button Content="Excluir" Margin="5,0,0,0" Command="{Binding DeleteTestCommand}"
                                        IsEnabled="{Binding CanManageTest}" Padding="8,4" Style="{StaticResource DangerButtonStyle}"
                                        ToolTip="Move o ensaio aberto para a lixeira interna" />
                            </WrapPanel>
                            <TextBlock Margin="0,6,0,0" Text="{Binding TestRootDirectory}" Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TestRootDirectory}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7" IsEnabled="{Binding CanEditPlan}">
                        <StackPanel>
                            <TextBlock Text="Fluido e vaso" FontSize="15" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,7,0,6">
                                <Button Content="Água 20 °C" Padding="8,3" Margin="0,0,5,0" Command="{Binding ApplyWaterPresetCommand}" CommandParameter="20" />
                                <Button Content="Água 25 °C" Padding="8,3" Margin="0,0,5,0" Command="{Binding ApplyWaterPresetCommand}" CommandParameter="25" />
                                <Button Content="Água 30 °C" Padding="8,3" Command="{Binding ApplyWaterPresetCommand}" CommandParameter="30" />
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="ρ (kg/m³)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding DensityKgM3, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="μ (Pa·s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding ViscosityPaS, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Temperatura (°C)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding TemperatureC, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="T vaso (mm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding VesselDiameterMm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Volume de trabalho (L)" Style="{StaticResource PowerLabel}" /><TextBox Width="145" HorizontalAlignment="Left" Style="{StaticResource CompactField}" Text="{Binding LiquidVolumeL, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <CheckBox Grid.Column="1" Content="Com chicanas" IsChecked="{Binding IsBaffled}" VerticalAlignment="Bottom" Margin="8,0,0,5" />
                            </Grid>
                            <TextBlock Margin="0,7,0,0" Text="{Binding VortexWarning}" Foreground="{DynamicResource StateWarningTextBrush}" TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Impelidores" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ImpellerSetHash, StringFormat=hash {0}}" Style="{StaticResource CaptionTextStyle}" />
                            </Grid>
                            <DataGrid Margin="0,7,0,5" Height="150" ItemsSource="{Binding Impellers}" SelectedItem="{Binding SelectedImpeller}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" IsEnabled="{Binding CanEditPlan}"
                                      HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding StageIndex}" Width="28" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Tipo" Width="120">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.ImpellerTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="D (m)" Binding="{Binding DiameterM, UpdateSourceTrigger=LostFocus}" Width="62" />
                                    <DataGridTextColumn Header="Pás" Binding="{Binding BladeCount, UpdateSourceTrigger=LostFocus}" Width="42" />
                                    <DataGridTextColumn Header="Folga (m)" Binding="{Binding ClearanceM, UpdateSourceTrigger=LostFocus}" Width="70" />
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Label, UpdateSourceTrigger=LostFocus}" Width="130" />
                                    <DataGridTextColumn Header="Np lit." Binding="{Binding LiteratureNp, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="58" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <Button Content="+" Width="34" Margin="0,0,5,0" Command="{Binding AddImpellerCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Adicionar estágio" />
                                <Button Content="−" Width="34" Margin="0,0,5,0" Command="{Binding RemoveImpellerCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Remover estágio" />
                                <Button Content="↑" Width="34" Margin="0,0,5,0" Command="{Binding MoveImpellerUpCommand}" IsEnabled="{Binding CanEditPlan}" />
                                <Button Content="↓" Width="34" Command="{Binding MoveImpellerDownCommand}" IsEnabled="{Binding CanEditPlan}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Aquisição" ToolTip="2. Configure parâmetros de captura automática e gerencie a tabela de condições">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                        <StackPanel>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7" IsEnabled="{Binding CanEditPlan}">
                        <StackPanel>
                            <TextBlock Text="Captura automática" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                                       Text="Define as faixas de rotação e vazão para a geração da grade de condições e os critérios estatísticos de parada." />
                            <!-- Faixa de Agitação (N) -->
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="N mín. (rpm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MinRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="N máx. (rpm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Passo N (rpm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StepRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <!-- Faixa de Vazão de Ar (Qg) -->
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Qg mín. (L/min)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MinFlowLpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Qg máx. (L/min)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxFlowLpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Passo Qg (L/min)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StepFlowLpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <!-- Botões de Ação da Tabela -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Gerar tabela" Padding="8,4" Command="{Binding GenerateConditionsPlanCommand}" IsEnabled="{Binding CanEditPlan}"
                                        ToolTip="Gera a grade N × Qg com os parâmetros definidos acima" />
                                <Button Grid.Column="2" Content="Remover todos os pontos" Padding="8,4" Command="{Binding ClearAllConditionsCommand}" IsEnabled="{Binding CanEditPlan}"
                                        ToolTip="Limpa todos os pontos da tabela de condições" />
                            </Grid>
                            <!-- Critérios Estatísticos e Janelas de Parada -->
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="IC rel. (%)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding RelativeCiPercent, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Piso στ (×)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding CiFloorSigmaMultiple, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="n mín." Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MinimumSamples, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="t máx. (s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxCaptureSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Tentativas" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding MaxTries, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Janela (s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationarityWindowSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Deriva (%/s)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationaritySlopeTolerance, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Confirmações" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding StationarityRequiredSamples, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            </Grid>
                            <CheckBox Margin="0,8,0,0" Content="Leitura manual de energia após cada ponto" IsChecked="{Binding ManualEnergyCaptureEnabled}" />
                            <CheckBox Margin="0,5,0,0" Content="Estabilização no alívio" IsChecked="{Binding VentStabilizationEnabled}" IsEnabled="{Binding CanEditPlan}" ToolTip="Estabiliza a vazão direcionada ao alívio antes de alimentar o reator" />
                            <Border Visibility="{Binding VentStabilizationEnabled, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource StrokeDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="8"
                                    Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Válvula de alívio:" Style="{StaticResource PowerLabel}" />
                                    <ComboBox Margin="0,0,0,6" ItemsSource="{Binding VentValves}"
                                              SelectedValue="{Binding SelectedVentValve}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label" Height="26" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tol. (L/min)" Style="{StaticResource PowerLabel}" />
                                            <TextBox Style="{StaticResource CompactField}" Text="{Binding VentFlowToleranceLpm, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Amostras" Style="{StaticResource PowerLabel}" />
                                            <TextBox Style="{StaticResource CompactField}" Text="{Binding VentFlowStableSamples, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="N alívio" Style="{StaticResource PowerLabel}" />
                                            <TextBox Style="{StaticResource CompactField}" Text="{Binding VentAgitationRpm, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="t máx. (s)" Style="{StaticResource PowerLabel}" />
                                            <TextBox Style="{StaticResource CompactField}" Text="{Binding MaxVentStabilizationSeconds, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card de Condições de Ensaio -->
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="Condições do ensaio" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                                       Text="Sequência de pontos planejados para o ensaio. Edite as células ou use os botões abaixo; as alterações são salvas automaticamente." />
                            <DataGrid Margin="0,7,0,5" Height="220" ItemsSource="{Binding Conditions}" SelectedItem="{Binding SelectedCondition}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" IsEnabled="{Binding CanEditPlan}" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="28" IsReadOnly="True" />
                                    <DataGridTextColumn Header="N rpm" Binding="{Binding AgitationRpm, UpdateSourceTrigger=LostFocus}" Width="62" />
                                    <DataGridTextColumn Header="L/min" Binding="{Binding GasFlowLpm, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="58" />
                                    <DataGridTextColumn Header="vvm" Binding="{Binding GasFlowVvm, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="52" />
                                    <DataGridTemplateColumn Header="Un." Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.FlowUnits, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FlowUnit}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Modo" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.GasModes, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GasMode}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Rep." Binding="{Binding RequestedReplicates}" Width="42" />
                                    <DataGridTextColumn Header="Feitas" Binding="{Binding CompletedReplicates}" Width="48" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Status" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Pendente" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="{x:Static power:PowerConditionStatus.InProgress}"><Setter Property="Text" Value="Em curso" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static power:PowerConditionStatus.Completed}"><Setter Property="Text" Value="Concluída" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static power:PowerConditionStatus.Skipped}"><Setter Property="Text" Value="Pulada" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Origem" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Manual" /><Style.Triggers><DataTrigger Binding="{Binding Origin}" Value="{x:Static power:PowerConditionOrigin.Map}"><Setter Property="Text" Value="Mapa" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <Button Content="+" Width="34" Margin="0,0,4,0" Command="{Binding AddConditionCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Adicionar ponto" />
                                <Button Content="−" Width="34" Margin="0,0,4,0" Command="{Binding RemoveConditionCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Remover ponto selecionado" />
                                <Button Content="↑" Width="34" Margin="0,0,4,0" Command="{Binding MoveConditionUpCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Mover para cima" />
                                <Button Content="↓" Width="34" Margin="0,0,4,0" Command="{Binding MoveConditionDownCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Mover para baixo" />
                                <Button Content="Pular/repor" Padding="8,4" Command="{Binding ToggleSkipConditionCommand}" IsEnabled="{Binding CanEditPlan}" ToolTip="Alternar pular/repor condição selecionada" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Validação e Eficiência de kLa" ToolTip="3. Calibre o torque, meça a tara, importe o mapa de kLa e avalie a eficiência">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                        <StackPanel>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="Rastreabilidade" FontSize="15" FontWeight="SemiBold" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CalibrationStatus}" VerticalAlignment="Center"
                                           ToolTip="CALIBRAÇÃO: converte o torque em % que o servo reporta para N·m reais, com massa e braço conhecidos. Sem ela o Np carrega o erro do torque de placa e é RELATIVO, não absoluto." />
                                <Button Grid.Column="1" Content="Medir calibração" Padding="8,4" Command="{Binding CalibrationInfoCommand}"
                                        ToolTip="Primeiro passo: aplique um torque conhecido para ajustar escala e offset" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TareStatus}" VerticalAlignment="Center"
                                           ToolTip="TARA: mede no ar o atrito de selo e mancal, o desvio do torque e o IC95 em cada rotação. O app subtrai P_vazio da potência de eixo." />
                                <Button Grid.Column="1" Content="Medir tara" Padding="8,4" Command="{Binding TareMeasurementInfoCommand}"
                                        ToolTip="Segundo passo: ensaio estatístico no ar com estabilização, média, desvio e IC95" />
                            </Grid>
                            <CheckBox Margin="0,8,0,0" Content="Aceitar resultados relativos" IsChecked="{Binding RelativeMode}" IsEnabled="{Binding CanEditPlan}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Ponto único" Padding="4,4" Command="{Binding ToggleSinglePointPanelCommand}" />
                                <Button Grid.Column="2" Content="Correlação P_el" Padding="4,4" Command="{Binding ToggleEnergyCorrelationCommand}" />
                            </Grid>

                            <!-- 8.1 Calibração de torque -->
                            <Border Visibility="{Binding IsCalibrationAssistantOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Calibração estática (1 ponto)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Massa e braço aplicados ao servo (τ_ref = m·g·r):" Style="{StaticResource PowerLabel}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="m (kg)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding CalibrationMassKg, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="r (m)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding CalibrationLeverArmM, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="τ lido (%)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding CalibrationMeasuredTorquePercent, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,5,0,5" Style="{StaticResource CaptionTextStyle}" Text="{Binding CalibrationReferenceNm, StringFormat='{}τ_ref = {0:F4} N·m'}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Gravar calibração" Style="{StaticResource AccentButtonStyle}" Command="{Binding ApplyCalibrationCommand}" Padding="8,4" />
                                        <Button Grid.Column="2" Content="Fechar" Command="{Binding CloseCalibrationAssistantCommand}" Padding="8,4" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 8.2 Tara no ar -->
                            <Border Visibility="{Binding IsTareAssistantOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ensaio de tara no ar (P_vazio + στ)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Após calibrar o torque e com o vaso seco, cada rotação passa por estabilização e coleta até atingir o IC95. As leituras brutas e os desvios ficam registrados na tara." Style="{StaticResource PowerLabel}" TextWrapping="Wrap" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="N ini" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding TareStartRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="N fim" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding TareEndRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Passo" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding TareStepRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,6,0,4" Text="{Binding TareProgressMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <DataGrid Height="155" Margin="0,3,0,4" ItemsSource="{Binding CurrentTarePoints}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N alvo" Binding="{Binding Rpm, StringFormat={}{0:F0}}" Width="52" />
                                            <DataGridTextColumn Header="N média" Binding="{Binding MeanRpmMeasured, StringFormat={}{0:F1}}" Width="58" />
                                            <DataGridTextColumn Header="P vazio" Binding="{Binding PVoidW, StringFormat={}{0:F3}}" Width="58" />
                                            <DataGridTextColumn Header="±IC95 W" Binding="{Binding PVoidCi95W, StringFormat={}{0:F3}}" Width="58" />
                                            <DataGridTextColumn Header="στ %" Binding="{Binding SigmaTauPercent, StringFormat={}{0:F4}}" Width="52" />
                                            <DataGridTextColumn Header="n" Binding="{Binding SampleCount}" Width="38" />
                                            <DataGridTextColumn Header="Tent." Binding="{Binding Attempts}" Width="42" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Iniciar ensaio no ar" Style="{StaticResource AccentButtonStyle}" Command="{Binding StartTareSweepCommand}" IsEnabled="{Binding IsTareRunning, Converter={StaticResource InverseBool}}" Padding="8,4" />
                                        <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelTareSweepCommand}" IsEnabled="{Binding IsTareRunning}" Padding="8,4" />
                                        <Button Grid.Column="4" Content="Fechar" Command="{Binding CloseTareAssistantCommand}" IsEnabled="{Binding IsTareRunning, Converter={StaticResource InverseBool}}" Padding="8,4" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 8.3 Ponto único -->
                            <Border Visibility="{Binding IsSinglePointPanelOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ponto único de conferência" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="N (rpm)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding SinglePointRpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Qg (L/min)" Style="{StaticResource PowerLabel}" /><TextBox Style="{StaticResource CompactField}" Text="{Binding SinglePointFlowLpm, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Comandar" Style="{StaticResource AccentButtonStyle}" Command="{Binding StartSinglePointCommand}" IsEnabled="{Binding IsSinglePointActive, Converter={StaticResource InverseBool}}" Padding="6,4" />
                                        <Button Grid.Column="2" Content="Parar eixo" Command="{Binding StopSinglePointCommand}" IsEnabled="{Binding IsSinglePointActive}" Padding="6,4" />
                                    </Grid>
                                    <Button Margin="0,6,0,0" Content="Adicionar à tabela de condições" Command="{Binding AddSinglePointToTestCommand}" Padding="6,3" />
                                </StackPanel>
                            </Border>

                            <!-- 8.4 Correlação elétrica -->
                            <Border Visibility="{Binding IsEnergyCorrelationOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Correlação P_elétrica × P_mecânica" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding EnergyCorrelationSummary}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <DataGrid Height="120" ItemsSource="{Binding ManualEnergyReadings}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N (rpm)" Binding="{Binding Rpm, StringFormat={}{0:F0}}" Width="52" />
                                            <DataGridTextColumn Header="P_mec (W)" Binding="{Binding PowerMechanicalWAtReading, StringFormat={}{0:F1}}" Width="68" />
                                            <DataGridTextColumn Header="P_el (W)" Binding="{Binding PowerElectricalW, StringFormat={}{0:F1}}" Width="62" />
                                            <DataGridTextColumn Header="Aparelho" Binding="{Binding Instrument}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Importação de mapa de kLa e Avaliação de Eficiência -->
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="Mapa de kLa e Eficiência" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                                       Text="Vincule um mapa de kLa ao ensaio de potência (a tabela de condições é preservada). A eficiência kLa/(P/V) é calculada na região de controle (intersecção das condições)." />
                            <Grid Margin="0,7,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding AvailableKlaMaps}" SelectedItem="{Binding SelectedKlaMapForImport}"
                                          DisplayMemberPath="DisplayText" Height="26" IsEnabled="{Binding CanEditPlan}"
                                          ToolTip="Mapas de kLa salvos no workspace" />
                                <Button Grid.Column="2" Content="↻" Width="30" Height="26"
                                        Command="{Binding RefreshKlaMapsCommand}"
                                        ToolTip="Recarregar a lista de mapas de kLa" />
                            </Grid>
                            <Button Content="Vincular mapa de kLa" Padding="8,4" HorizontalAlignment="Stretch"
                                    Command="{Binding ImportConditionsFromKlaMapCommand}"
                                    IsEnabled="{Binding CanImportFromKlaMap}" />

                            <Border Margin="0,7,0,0" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="8,6"
                                    Visibility="{Binding HasLinkedKlaMap, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ControlRegionSummary}" FontWeight="SemiBold" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}"
                                               Visibility="{Binding AverageKlaEfficiency, Converter={StaticResource NullToVis}}"
                                               Text="{Binding AverageKlaEfficiency, StringFormat='{}Eficiência média na região de controle: {0:F2} h⁻¹ / (kW/m³)'}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,7,0,3" Text="Comparação com kLa interpolado na superfície contínua:" Style="{StaticResource PowerLabel}"
                                       Visibility="{Binding HasLinkedKlaMap, Converter={StaticResource BoolToVis}}" />
                            <DataGrid Margin="0,2,0,4" Height="150" ItemsSource="{Binding KlaEfficiencyItems}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Visibility="{Binding HasLinkedKlaMap, Converter={StaticResource BoolToVis}}" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N (rpm)" Binding="{Binding AgitationRpm, StringFormat={}{0:F0}}" Width="52" />
                                    <DataGridTextColumn Header="Qg (L/min)" Binding="{Binding GasFlowLpm, StringFormat={}{0:F1}}" Width="62" />
                                    <DataGridTextColumn Header="kLa (h⁻¹)" Binding="{Binding KlaInterpolatedPerHour, StringFormat={}{0:F2}, TargetNullValue='—'}" Width="58" />
                                    <DataGridTextColumn Header="P líq (W)" Binding="{Binding NetPowerW, StringFormat={}{0:F2}, TargetNullValue='—'}" Width="58" />
                                    <DataGridTextColumn Header="P/V (W/m³)" Binding="{Binding VolumetricPowerWm3, StringFormat={}{0:F1}, TargetNullValue='—'}" Width="64" />
                                    <DataGridTextColumn Header="η (h⁻¹/kW/m³)" Binding="{Binding SpecificEfficiency, StringFormat={}{0:F2}, TargetNullValue='—'}" Width="82" />
                                    <DataGridTextColumn Header="Região" Binding="{Binding RegionLabel}" Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="N medida" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentRpmText}" Style="{StaticResource PowerMetric}" /><TextBlock Text="rpm" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Torque" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentTorqueNmText}" Style="{StaticResource PowerMetric}" /><TextBlock Style="{StaticResource CaptionTextStyle}"><Run Text="N·m · " /><Run Text="{Binding CurrentTorquePercentText, Mode=OneWay}" /><Run Text=" %" /></TextBlock></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="P líquida" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentPowerWText}" Style="{StaticResource PowerMetric}" /><TextBlock Text="W" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Qg medida" Style="{StaticResource PowerLabel}" />
                                <TextBlock Text="{Binding CurrentFlowText}" Style="{StaticResource PowerMetric}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"><Run Text="L/min · " /><Run Text="{Binding CurrentFlowVvmText, Mode=OneWay}" /><Run Text=" vvm" /></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Np" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentNpText}" Style="{StaticResource PowerMetric}" /></StackPanel>
                            <StackPanel Grid.Column="5"><TextBlock Text="Re" Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentReText}" Style="{StaticResource PowerMetric}" /></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="FlG / Fr" Style="{StaticResource PowerLabel}" /><TextBlock Style="{StaticResource PowerMetric}"><Run Text="{Binding CurrentFlGText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding CurrentFrText, Mode=OneWay}" /></TextBlock></StackPanel>
                            <StackPanel Grid.Column="7"><TextBlock Text="PG / P₀ inst." Style="{StaticResource PowerLabel}" /><TextBlock Text="{Binding CurrentPowerRatioText}" Style="{StaticResource PowerMetric}" /></StackPanel>
                            <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="5,0,0,0">
                                <TextBlock Text="Malha de gás" Style="{StaticResource PowerLabel}" />
                                <Border Padding="8,4" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Reator Aberto">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Alívio Estabilizando">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateWarningBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding GasLoopStatusBadge}" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Reator Aberto">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GasLoopStatusBadge}" Value="Alívio Estabilizando">
                                                        <Setter Property="Foreground" Value="{DynamicResource StateWarningTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PowerCard}" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Precisão adaptativa" FontWeight="SemiBold" />
                                <ProgressBar Margin="0,7,0,3" Height="12" Minimum="0" Maximum="100" Value="{Binding CiProgressPercent, Mode=OneWay}" />
                                <TextBlock Text="{Binding CiLabel}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Progresso da sequência" FontWeight="SemiBold" />
                                <ProgressBar Margin="0,7,0,3" Height="12" Minimum="0" Maximum="100" Value="{Binding SequenceProgressPercent, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SequenceProgressLabel}" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text=" · " Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{Binding EtaLabel}" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Height="390" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PowerCard}" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <DockPanel Margin="5,2,5,4">
                                    <TextBlock Text="Torque e rotação vs. tempo" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Width="14" Height="3" Background="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="Torque" Style="{StaticResource CaptionTextStyle}" />
                                        <Border Width="14" Height="3" Background="{DynamicResource StateOkBrush}" Margin="10,0,4,0" VerticalAlignment="Center" /><TextBlock Text="rpm" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="LiveChartHost" Grid.Row="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsAccumulating}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PowerCard}" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="5,2,5,4">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Np × Re" GroupName="PowerChartTab" IsChecked="{Binding ShowFloodingChart, Converter={StaticResource InverseBool}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <RadioButton Content="PG/P₀ × FlG (Flooding)" GroupName="PowerChartTab" IsChecked="{Binding ShowFloodingChart}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                                <Setter Property="Text" Value="● capturado  ┄ literatura" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowFloodingChart}" Value="True">
                                                        <Setter Property="Text" Value="● experimental  ┄ Nienow  ★ Flooding" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <Border x:Name="NpChartHost" Visibility="{Binding ShowFloodingChart, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    <Border x:Name="PgChartHost" Visibility="{Binding ShowFloodingChart, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <Border Grid.Row="2" Margin="0,6,0,0" Padding="8,5" Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                                        Visibility="{Binding ShowFloodingChart, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Transição de Flooding (Nienow)" FontWeight="SemiBold" FontSize="11" />
                                            <TextBlock Text="{Binding FloodingCoordinates}" Style="{StaticResource CaptionTextStyle}" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding FloodingDeviationText}" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" Background="{DynamicResource AccentSubtleBrush}"
                                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Visibility="{Binding HasFloodingPoint, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="★ Ponto Identificado" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource PowerCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pontos capturados" FontSize="15" FontWeight="SemiBold" />
                                    <Border Margin="8,0,0,0" Padding="7,2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4"><TextBlock Text="{Binding PrecisionBadge}" FontSize="10" /></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Definir Flooding" Command="{Binding SetSelectedAsFloodingPointCommand}" Margin="0,0,6,0" Padding="8,3" IsEnabled="{Binding CanSetManualFlooding}" ToolTip="Define o ponto experimental gaseificado selecionado como ponto oficial de flooding" />
                                    <Button Content="Flooding Auto" Command="{Binding ResetAutomaticFloodingCommand}" Margin="0,0,6,0" Padding="8,3" IsEnabled="{Binding HasActiveTest}" ToolTip="Restaura a detecção matemática automática do ponto de flooding" />
                                    <Button Content="Alternar Aceite" Command="{Binding ToggleAcceptSelectedRowCommand}" Margin="0,0,6,0" Padding="8,3" IsEnabled="{Binding CanToggleRowAcceptance}" ToolTip="Alterna o status do ponto selecionado entre Aceito e Rejeitado" />
                                    <Button Content="Exportar CSV" Click="ExportCsv_Click" Padding="10,4" IsEnabled="{Binding HasActiveTest}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,7,0,7" Orientation="Horizontal" Visibility="{Binding IsInReview, Converter={StaticResource BoolToVis}}">
                                <Button Content="Aceitar" Style="{StaticResource AccentButtonStyle}" Command="{Binding AcceptRunCommand}" Margin="0,0,6,0" />
                                <Button Content="Rejeitar" Command="{Binding RejectRunCommand}" Margin="0,0,6,0" />
                                <Button Content="Repetir" Command="{Binding RepeatRunCommand}" />
                            </StackPanel>
                            <Border Grid.Row="1" Margin="0,7,0,7" Style="{StaticResource PowerCard}" Padding="10" Visibility="{Binding IsWaitingManualEnergy, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Condição mantida (Holding): Registre a leitura do wattímetro da tomada." FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" /><ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="P elétrica (W):" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox Grid.Column="1" Style="{StaticResource CompactField}" Text="{Binding ManualEnergyWattsInput, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="3" Text="Aparelho:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox Grid.Column="4" Style="{StaticResource CompactField}" Text="{Binding ManualEnergyInstrument, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="6" Text="Nota:" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBox Grid.Column="7" Style="{StaticResource CompactField}" Text="{Binding ManualEnergyNote, UpdateSourceTrigger=LostFocus}" />
                                        <Button Grid.Column="9" Content="Confirmar leitura" Style="{StaticResource AccentButtonStyle}" Command="{Binding ConfirmManualEnergyCommand}" Padding="10,4" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="2" Height="220" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResultRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N (rpm)" Binding="{Binding Rpm}" Width="62" />
                                    <DataGridTextColumn Header="τ líqu. (N·m)" Binding="{Binding NetTorque}" Width="82" />
                                    <DataGridTextColumn Header="P líqu. (W)" Binding="{Binding Power}" Width="74" />
                                    <DataGridTextColumn Header="Np" Binding="{Binding Np}" Width="64" />
                                    <DataGridTextColumn Header="Re" Binding="{Binding Re}" Width="74" />
                                    <DataGridTextColumn Header="IC95 Np" Binding="{Binding Ci}" Width="68" />
                                    <DataGridTextColumn Header="Qg (L/min)" Binding="{Binding GasFlowLpm}" Width="72" />
                                    <DataGridTextColumn Header="FlG" Binding="{Binding FlG}" Width="64" />
                                    <DataGridTextColumn Header="Fr" Binding="{Binding Fr}" Width="64" />
                                    <DataGridTextColumn Header="PG (W)" Binding="{Binding PgLiquid}" Width="70" />
                                    <DataGridTextColumn Header="P₀ ref (W)" Binding="{Binding P0Ref}" Width="74" />
                                    <DataGridTextColumn Header="PG/P₀ ± IC" Binding="{Binding PowerRatio}" Width="92" />
                                    <DataGridTextColumn Header="Parada" Binding="{Binding StopReason}" Width="80" />
                                    <DataGridTextColumn Header="Tent." Binding="{Binding Attempts}" Width="48" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                                    <DataGridTextColumn Header="Data/hora" Binding="{Binding Timestamp}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Concluir ensaio" Command="{Binding CompleteTestCommand}" Margin="0,0,6,0" IsEnabled="{Binding HasActiveTest}" />
                                <Button Content="Interromper" Command="{Binding AbortTestCommand}" IsEnabled="{Binding HasActiveTest}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <!-- Conteúdo da Aba 2: Modelos e Ajustes (conteúdo de PowerMapView sem cabeçalho duplicado) -->
            <Grid Visibility="{Binding IsModelsTabSelected, Converter={StaticResource BoolToVis}}">
                <views:PowerMapView DataContext="{Binding MapViewModel}" ShowHeader="False" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
