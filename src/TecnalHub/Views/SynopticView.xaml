<UserControl x:Class="TecnalHub.Views.SynopticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TecnalHub.Converters"
             xmlns:vm="clr-namespace:TecnalHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             d:DesignWidth="760" d:DesignHeight="620"
             AutomationProperties.Name="Sinóptico operacional do biorreator">

    <!-- Process state remains in native WPF cards; the approved reactor side view is
         presentation-only and is the sole equipment figure on this page. -->
    <UserControl.Resources>
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="InstrumentTagTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontSize="10" FontWeight="SemiBold"
                               LineHeight="11" TextWrapping="Wrap" MaxHeight="22"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <Grid Grid.Row="1" Margin="13,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding FormattedValue}"
                                   FontFamily="{DynamicResource FontNumeric}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Unit}" Margin="4,0,0,2"
                                   VerticalAlignment="Bottom" FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Margin="4,1,0,0" Padding="3,1"
                            VerticalAlignment="Center" CornerRadius="2"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            Visibility="{Binding IsCommandedOnly,
                                                 Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Valor comandado; o equipamento não fornece realimentação">
                        <TextBlock Text="COMANDADO" FontSize="7" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Compact, keyboard-accessible instrument card pinned to real hardware. -->
        <Style x:Key="InstrumentTagStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="ContentTemplate" Value="{StaticResource InstrumentTagTemplate}" />
            <Setter Property="AutomationProperties.HelpText"
                    Value="Seleciona a variável e abre seus detalhes operacionais" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SurfaceSelectedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Local process identity remains visible even when the detail pane changes. -->
        <Border Grid.Row="0" Padding="16,12"
                Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="RESUMO DO BIORREATOR"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Visão física · leituras e comandos ao vivo"
                               Margin="0,2,0,0" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding SystemState,
                                                Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding SystemStateText}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastUpdateText,
                                              StringFormat='Atualização: {0}'}"
                               HorizontalAlignment="Right" Margin="0,2,0,0"
                               FontFamily="{DynamicResource FontNumeric}" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cards keep readable text and hit targets. Only the reactor artwork scales. -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <Border Padding="7,6,7,7"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource StrokeSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <StackPanel>
                            <TextBlock Text="PARÂMETROS INTERNOS"
                                       Margin="3,0,0,4"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Agitação"
                                        DataContext="{Binding Motor}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Rotação comandada; sem realimentação de RPM"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="motor" />
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Temperatura"
                                        DataContext="{Binding Temperature}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Temperatura do processo e da camisa térmica"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="temperature" />
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="pH"
                                        DataContext="{Binding Ph}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Sonda de pH"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="ph" />
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Oxigênio"
                                        DataContext="{Binding Oxygen}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Sonda de oxigênio dissolvido"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="oxygen" />
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Alívio de Pressão"
                                        DataContext="{Binding Pressure}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Alívio e leitura da pressão do headspace"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="pressure" />
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Sensor de Distância"
                                        DataContext="{Binding Level}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Sensor de distância usado para nível e espuma"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="level" />
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Sensor de Biomassa"
                                        DataContext="{Binding Biomass}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Sensor óptico de biomassa (absorbância)"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="biomass" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,7,0,0" Padding="7,6,7,7"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource StrokeSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <StackPanel>
                            <TextBlock Text="DISPOSITIVOS EXTERNOS"
                                       Margin="3,0,0,4"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Dosagem de Nutrientes"
                                        DataContext="{Binding Nutrient}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Dosagem de nutrientes (comando sem realimentação)"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="nutrient" />
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Dosagem de Antiespumante"
                                        DataContext="{Binding Antifoam}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="Dosagem de antiespumante"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="antifoam" />
                                <Grid>
                                    <Button Style="{StaticResource InstrumentTagStyle}"
                                            Tag="Vazão de Ar"
                                            DataContext="{Binding Flow}" Content="{Binding}"
                                            AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                            ToolTip="Aeração pelo sparger anular"
                                            Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="flow" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                            Padding="4,1" CornerRadius="3" IsHitTestVisible="False"
                                            Background="{DynamicResource SurfaceSunkenBrush}"
                                            BorderBrush="{DynamicResource StateWarningBrush}" BorderThickness="1"
                                            Visibility="{Binding FlowControl.ShowPendingChip, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="aguardando" FontSize="8" Foreground="{DynamicResource StateWarningTextBrush}" />
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                            Padding="4,1" CornerRadius="3" IsHitTestVisible="False"
                                            Background="{DynamicResource SurfaceSunkenBrush}"
                                            BorderBrush="{DynamicResource StateAlarmBrush}" BorderThickness="1"
                                            Visibility="{Binding FlowControl.IsFlowmeterOffline, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="desconectado" FontSize="8" Foreground="{DynamicResource StateAlarmTextBrush}" />
                                    </Border>
                                </Grid>
                                <Button Style="{StaticResource InstrumentTagStyle}"
                                        Tag="Bomba Dosadora Externa"
                                        DataContext="{Binding Pump}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                        ToolTip="bomba externa em mL/min (vazão informada)"
                                        Command="{Binding DataContext.SelectByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="pump" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Viewbox Grid.Column="2" Stretch="Uniform" Margin="0,0,4,0">
                <Canvas Width="430" Height="470">
                    <Image x:Name="ReactorRender"
                           Canvas.Left="5" Canvas.Top="25" Width="420" Height="420"
                           Source="/TecnalHub;component/Resources/Images/Imagem_biorreator_side.png"
                           Stretch="Uniform" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Biorreator TECNAL" />
                </Canvas>
            </Viewbox>
        </Grid>

        <!-- Honest process legend: the generated equipment carries no live state. -->
        <Border Grid.Row="2" Padding="14,8"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathInstrumentBrush}" />
                    <TextBlock Text="Instrumentação" Margin="0,0,12,0"
                               FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathGasBrush}" />
                    <TextBlock Text="Aeração" Margin="0,0,12,0"
                               FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathHeatingBrush}" />
                    <TextBlock Text="Utilidade térmica" Margin="0,0,12,0" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathFeedBrush}" />
                    <TextBlock Text="Alimentação" Margin="0,0,12,0" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Rectangle Width="14" Height="2" Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource PathAntifoamBrush}" />
                    <TextBlock Text="Antiespuma" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Nível/espuma pelo sensor de distância, quando ativo · agitador de frasco em Controle"
                           Margin="16,0,0,0" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
