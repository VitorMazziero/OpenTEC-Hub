<UserControl x:Class="OpenTECHub.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenTECHub.Converters"
             xmlns:ctl="clr-namespace:OpenTECHub.Controls"
             xmlns:vm="clr-namespace:OpenTECHub.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CalibrationViewModel}">

    <UserControl.Resources>
        <!-- The certified-points column keeps its comfortable width on a wide screen and
             gives ~110 DIP back to the curve on a laptop, rather than pinning 470 DIP
             whatever is left for the chart. -->
        <Style x:Key="CalibrationSidePanelStyle" TargetType="ScrollViewer"
               BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="Width" Value="470" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(ctl:Responsive.IsNarrow), ElementName=CalibrationRoot}" Value="True">
                    <Setter Property="Width" Value="360" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <Style x:Key="CalibrationCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CalibrationLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16" x:Name="CalibrationRoot" ctl:Responsive.NarrowBelow="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- Auto, so the column disappears entirely when the side panel is collapsed. -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ctl:Icon Key="Target" Size="26" Margin="0,0,10,0" />
                <TextBlock Text="Calibrações"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold" />
                <Button Content="?" Width="22" Height="22" Padding="0" Margin="10,0,0,0" FontWeight="SemiBold"
                        VerticalAlignment="Center" ToolTip="Abrir a documentação desta página"
                        Command="{Binding DataContext.OpenDocumentationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="calibracoes" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Grid.Column="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Style="{StaticResource SegmentedControlStyle}">            <!-- pH calibration -->
            <TabItem Header="pH" Style="{StaticResource SegmentedItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0" DataContext="{Binding PH}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CalibrationCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Leitura ao vivo" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                                    <UniformGrid Columns="2" Margin="0,12,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Raw ADC" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding CurrentRawText}" Style="{StaticResource NumericTextStyle}" FontSize="24" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="pH calibrado" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding CurrentCalibratedText}" Style="{StaticResource NumericTextStyle}" FontSize="24" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Desvio padrão (σ)" Style="{StaticResource CalibrationLabel}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CurrentStandardDeviationText}" Style="{StaticResource NumericTextStyle}" FontSize="24" />
                                    
                                    <ProgressBar Minimum="0" Maximum="100" Height="8" Value="{Binding ProgressPercent}" Margin="0,16,0,16" />

                                    <TextBlock Text="Curva vigente" Style="{StaticResource CalibrationLabel}" />
                                    <TextBlock Text="{Binding CurrentEquationText}" FontFamily="{DynamicResource FontNumeric}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CalibrationCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcedureTitle}"
                                               FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProcedureHint}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding CanStart}">
                                        <RadioButton Content="Dois pontos"
                                                     IsChecked="{Binding IsTwoPoint, Mode=TwoWay}"
                                                     VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <RadioButton Content="Um ponto (só intercepto)"
                                                     IsChecked="{Binding IsOnePoint, Mode=TwoWay}"
                                                     VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid IsEnabled="{Binding CanStart}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="12" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="Ponto 1 (Tampão)" FontWeight="SemiBold" />
                                                <TextBlock Text="Referência (pH)" Style="{StaticResource CalibrationLabel}" Margin="0,8,0,4" />
                                                <TextBox Text="{Binding Reference1Text, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding FirstPointText}" TextWrapping="Wrap" Margin="0,7,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="12" Margin="5,0,0,0"
                                                IsEnabled="{Binding IsTwoPoint}">
                                            <StackPanel>
                                                <TextBlock Text="Ponto 2 (Tampão)" FontWeight="SemiBold" />
                                                <TextBlock Text="Referência (pH)" Style="{StaticResource CalibrationLabel}" Margin="0,8,0,4" />
                                                <TextBox Text="{Binding Reference2Text, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding SecondPointText}" TextWrapping="Wrap" Margin="0,7,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    
                                    <TextBlock Text="Critério de aquisição (raw ADC)" FontWeight="SemiBold" Margin="0,14,0,8" />
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Janela" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding StabilityWindowText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="3,0">
                                            <TextBlock Text="σ máximo" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding StabilityThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Média final" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding AverageSamplesText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border Background="{DynamicResource SurfaceSelectedBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,8">
                                        <TextBlock Text="{Binding ProposedEquationText}"
                                                   FontFamily="{DynamicResource FontNumeric}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,6,0" />
                                        <Button Content="Iniciar" Command="{Binding StartProcedureCommand}" Margin="0,0,6,0" />
                                        <Button Content="Confirmar" Command="{Binding ConfirmPointCommand}" Margin="0,0,6,0" />
                                        <Button Content="Aplicar no app" Style="{StaticResource AccentButtonStyle}" Command="{Binding ApplyProposalCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Oxygen calibration -->
            <TabItem Header="Oxigênio" Style="{StaticResource SegmentedItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0" DataContext="{Binding Oxygen}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CalibrationCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Leitura ao vivo" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                                    <UniformGrid Columns="2" Margin="0,12,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Raw ADC" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding CurrentRawText}" Style="{StaticResource NumericTextStyle}" FontSize="24" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="O₂ calibrado (%)" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding CurrentCalibratedText}" Style="{StaticResource NumericTextStyle}" FontSize="24" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Desvio padrão (σ)" Style="{StaticResource CalibrationLabel}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CurrentStandardDeviationText}" Style="{StaticResource NumericTextStyle}" FontSize="24" />
                                    
                                    <ProgressBar Minimum="0" Maximum="100" Height="8" Value="{Binding ProgressPercent}" Margin="0,16,0,16" />

                                    <TextBlock Text="Curva vigente" Style="{StaticResource CalibrationLabel}" />
                                    <TextBlock Text="{Binding CurrentEquationText}" FontFamily="{DynamicResource FontNumeric}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CalibrationCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcedureTitle}"
                                               FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProcedureHint}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding CanStart}">
                                        <RadioButton Content="Dois pontos"
                                                     IsChecked="{Binding IsTwoPoint, Mode=TwoWay}"
                                                     VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <RadioButton Content="Um ponto (só intercepto)"
                                                     IsChecked="{Binding IsOnePoint, Mode=TwoWay}"
                                                     VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid IsEnabled="{Binding CanStart}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="12" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="Ponto 1 (Padrão)" FontWeight="SemiBold" />
                                                <TextBlock Text="Referência (%)" Style="{StaticResource CalibrationLabel}" Margin="0,8,0,4" />
                                                <TextBox Text="{Binding Reference1Text, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding FirstPointText}" TextWrapping="Wrap" Margin="0,7,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="12" Margin="5,0,0,0"
                                                IsEnabled="{Binding IsTwoPoint}">
                                            <StackPanel>
                                                <TextBlock Text="Ponto 2 (Padrão)" FontWeight="SemiBold" />
                                                <TextBlock Text="Referência (%)" Style="{StaticResource CalibrationLabel}" Margin="0,8,0,4" />
                                                <TextBox Text="{Binding Reference2Text, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding SecondPointText}" TextWrapping="Wrap" Margin="0,7,0,0" Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    
                                    <TextBlock Text="Critério de aquisição (raw ADC)" FontWeight="SemiBold" Margin="0,14,0,8" />
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Janela" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding StabilityWindowText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="3,0">
                                            <TextBlock Text="σ máximo" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding StabilityThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Média final" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding AverageSamplesText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border Background="{DynamicResource SurfaceSelectedBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,8">
                                        <TextBlock Text="{Binding ProposedEquationText}"
                                                   FontFamily="{DynamicResource FontNumeric}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,6,0" />
                                        <Button Content="Iniciar" Command="{Binding StartProcedureCommand}" Margin="0,0,6,0" />
                                        <Button Content="Confirmar" Command="{Binding ConfirmPointCommand}" Margin="0,0,6,0" />
                                        <Button Content="Aplicar no app" Style="{StaticResource AccentButtonStyle}" Command="{Binding ApplyProposalCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Airflow calibration -->
            <TabItem x:Name="AirflowTab" Header="Vazão de ar" Style="{StaticResource SegmentedItemStyle}">
                <Grid Margin="0,12,0,0" DataContext="{Binding Flow}">
                    <!-- The certified-points panel is not here: it is a page-level side column
                         (below), so it can span the heading and the tab strip and use the whole
                         window height. -->

                    <!-- Binding the content's MinHeight to the viewport makes it fill the window
                         when there is room and scroll when there is not: inside a ScrollViewer a
                         star row would otherwise collapse to its content, because measure passes
                         infinite height. -->
                    <ScrollViewer x:Name="FlowLeftScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=FlowLeftScroll}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="340" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CalibrationCard}" Padding="8">
                            <Border x:Name="FlowPlotHost" />
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CalibrationCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Curva do fluxômetro" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurveStateText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8" />
                                <TextBlock Text="{Binding LowEquationText}" FontFamily="{DynamicResource FontNumeric}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HighEquationText}" FontFamily="{DynamicResource FontNumeric}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding ContinuityText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="Restaurar padrão de fábrica" Command="{Binding RestoreFirmwareDefaultCommand}" Margin="0,0,6,0" />
                                    <Button Content="Salvar pontos" Command="{Binding SavePointsCommand}" Margin="0,0,6,0" />
                                    <Button Content="Salvar e enviar curva" Style="{StaticResource AccentButtonStyle}" Command="{Binding SendCurveCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>


            <!-- Biomass blank / threshold procedure (Phase 3 WP1) -->
            <TabItem Header="Sensor de Biomassa" Style="{StaticResource SegmentedItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0" DataContext="{Binding Biomass}">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource StrokeSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="12"
                                Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="A biomassa não tem coeficiente no aplicativo: a calibração é capturar o branco (absorbância zero) contra um meio claro e definir os limiares de integração (contagens brutas). O firmware não expõe um modo HD, portanto ele não é mostrado." />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: guided blank capture -->
                            <Border Grid.Column="0" Style="{StaticResource CalibrationCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Branco"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Com o meio de branco no caminho óptico, ative o sensor e capture o branco. Confirme que a absorbância se aproxima de zero."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,12" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding SensorEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsConnected}"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Text="Sensor de biomassa ativo" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Absorbância ao vivo" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding CurrentAbsorbanceText}" Style="{StaticResource NumericTextStyle}"
                                                       FontSize="{DynamicResource FontSizeSubtitle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Raw" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding CurrentRawText}" Style="{StaticResource NumericTextStyle}"
                                                       FontSize="{DynamicResource FontSizeSubtitle}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Capturar branco"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Command="{Binding CaptureBlankCommand}" Margin="0,0,6,0" />
                                        <Button Content="Iniciar" Command="{Binding StartCommand}" Margin="0,0,6,0" />
                                        <Button Content="Parar" Command="{Binding StopCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right: integration thresholds -->
                            <Border Grid.Column="1" Style="{StaticResource CalibrationCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Limiares de integração"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Contagens brutas. O baixo deve ser menor que o alto e o ótimo deve ficar entre eles."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,12" />

                                    <!-- Always editable: gating these on validity would trap the
                                         operator with a value they could no longer correct. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Baixo" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding LowThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="Alto" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding HighThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Ótimo" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding OptimalThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding ThresholdError}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />

                                    <Button Content="Aplicar limiares"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Right" Margin="0,12,0,0"
                                            Command="{Binding ApplyThresholdsCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- External Pump linear calibration -->
            <TabItem Header="Bomba Externa" Style="{StaticResource SegmentedItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0" DataContext="{Binding Pump}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Live readouts & Node echoes -->
                            <Border Grid.Column="0" Style="{StaticResource CalibrationCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Leitura e ecos do nó" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="Valores medidos e parâmetros de calibração atualmente aplicados na bomba peristáltica."
                                               Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,12" />

                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,6,8">
                                            <TextBlock Text="Vazão atual" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding CurrentFlowText}" Style="{StaticResource NumericTextStyle}" FontSize="20" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,8">
                                            <TextBlock Text="Volume acumulado" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding CurrentVolumeText}" Style="{StaticResource NumericTextStyle}" FontSize="20" />
                                        </StackPanel>
                                        <StackPanel Margin="0,4,6,0">
                                            <TextBlock Text="Slope aplicado (nó)" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding AppliedSlopeText}" Style="{StaticResource NumericTextStyle}" FontSize="16" />
                                        </StackPanel>
                                        <StackPanel Margin="6,4,0,0">
                                            <TextBlock Text="Intercepto aplicado (nó)" Style="{StaticResource CalibrationLabel}" />
                                            <TextBlock Text="{Binding AppliedInterceptText}" Style="{StaticResource NumericTextStyle}" FontSize="16" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Button Content="Zerar volume acumulado"
                                            Command="{Binding ResetVolumeCommand}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Right: Curve calibration and flow preview -->
                            <Border Grid.Column="1" Style="{StaticResource CalibrationCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Calibração linear: Q = slope · S + intercept"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="S é a velocidade interna da bomba (0..1000); o firmware a converte em duty PWM depois da calibração."
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,12" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Ganho (mL/min por unidade S)" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding SlopeText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditCalibration}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Deslocamento (intercept: mL/min)" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding InterceptText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditCalibration}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Firmware 3.9 maps speed S=1..1000 to duty PWM 155..1023. -->
                                    <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Pré-visualização da vazão calculada:" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,6" />
                                            <UniformGrid Columns="3">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="S 250 (PWM ≈ 371)" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Preview250Text}" Style="{StaticResource NumericTextStyle}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,4,0">
                                                    <TextBlock Text="S 500 (PWM ≈ 589)" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Preview500Text}" Style="{StaticResource NumericTextStyle}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="S 1000 (PWM 1023)" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Preview1000Text}" Style="{StaticResource NumericTextStyle}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding ValidationError}"
                                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Button Content="Reverter" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                                        <Button Content="Aplicar calibração"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Command="{Binding ApplyCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Volumetric runs: the same shape as the airflow tab's "send a setpoint,
                             read the meter" loop, with the vessel as the meter. One run = hold S for
                             T seconds (the app stops it), type the mL collected, get a point. -->
                        <Border Style="{StaticResource CalibrationCard}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: one run -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Acionamento volumétrico" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="A bomba gira à velocidade S pelo tempo escolhido e para sozinha. Recolha a saída num recipiente graduado e informe o volume: Q = V / Δt vira um ponto (S, Q)."
                                               Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,12" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Velocidade S (1..1000)" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding RunSpeedText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditRuns}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Duração (s)" Style="{StaticResource CalibrationLabel}" />
                                            <TextBox Text="{Binding RunDurationText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEditRuns}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding RunValidationError}"
                                               Visibility="{Binding RunValidationError, Converter={StaticResource NullToVis}}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource StateAlarmTextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Acionar bomba"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Command="{Binding StartRunCommand}" Margin="0,0,8,0" />
                                        <Button Content="Abortar"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding AbortRunCommand}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                        <ProgressBar Minimum="0" Maximum="100" Height="8" Value="{Binding RunProgressPercent}" />
                                        <TextBlock Text="{Binding RunCountdownText}" Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- After the stop: the vessel reading closes the point -->
                                    <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="10"
                                            Visibility="{Binding HasPendingRun, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RunSummaryText}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" />
                                            <TextBlock Text="Volume coletado (mL)" Style="{StaticResource CalibrationLabel}" Margin="0,8,0,0" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Registrar ponto"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Command="{Binding AddRunPointCommand}" Margin="8,0,0,0" />
                                                <TextBox Text="{Binding MeasuredVolumeText, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Leitura do recipiente graduado em mL (ponto ou vírgula)." />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right: the runs and the line through them -->
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="Pontos e ajuste linear" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding FitSummaryText}"
                                               Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,8" />

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Ganho ajustado" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding FitSlopeText}" Style="{StaticResource NumericTextStyle}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,4,0">
                                                <TextBlock Text="Deslocamento ajustado" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding FitInterceptText}" Style="{StaticResource NumericTextStyle}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="R²" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding FitRSquaredText}" Style="{StaticResource NumericTextStyle}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding FitWarning}"
                                                   Visibility="{Binding FitWarning, Converter={StaticResource NullToVis}}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource StateWarningTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Limpar pontos" Command="{Binding ClearRunsCommand}" Margin="0,0,8,0" />
                                            <Button Content="Usar ajuste nos coeficientes"
                                                    Command="{Binding UseFitCommand}"
                                                    ToolTip="Copia ganho e deslocamento do ajuste para os campos acima. Nada é enviado ao nó até 'Aplicar calibração'." />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="1" CornerRadius="4" MinHeight="120">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Background="{DynamicResource SurfaceSunkenBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="S" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="8,5" />
                                                <TextBlock Grid.Column="1" Text="Δt" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="8,5" />
                                                <TextBlock Grid.Column="2" Text="V" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="8,5" />
                                                <TextBlock Grid.Column="3" Text="Q" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="8,5" />
                                                <TextBlock Grid.Column="4" Text="Resíduo" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="8,5" />
                                                <TextBlock Grid.Column="5" Text="" Width="28" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Runs}" Margin="0,2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PumpCalibrationRunViewModel}">
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SpeedText}" Style="{StaticResource NumericTextStyle}" Margin="8,3" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SecondsText}" Style="{StaticResource NumericTextStyle}" Margin="8,3" />
                                                            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Style="{StaticResource NumericTextStyle}" Margin="8,3" />
                                                            <TextBlock Grid.Column="3" Text="{Binding FlowText}" Style="{StaticResource NumericTextStyle}" FontWeight="SemiBold" Margin="8,3" />
                                                            <TextBlock Grid.Column="4" Text="{Binding ResidualText}" Style="{StaticResource NumericTextStyle}" Margin="8,3"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <Button Grid.Column="5" Content="✕" Width="28" Height="24" Padding="0" Margin="0,0,4,0"
                                                                    ToolTip="Remover este ponto"
                                                                    Command="{Binding DataContext.RemoveRunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ── Certified points: a page-level side column ──────────────────────
             Promoted out of the airflow tab so it spans the heading and the tab
             strip and reaches the top of the page. It only exists while that tab
             is selected; collapsed, the Auto column takes no width at all and the
             other tabs get the full width back. -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                      x:Name="FlowRightScroll"
                      Margin="12,0,0,0"
                      Style="{StaticResource CalibrationSidePanelStyle}"
                      DataContext="{Binding Flow}"
                      Visibility="{Binding IsSelected, ElementName=AirflowTab, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CalibrationCard}"
                    MinHeight="{Binding ViewportHeight, ElementName=FlowRightScroll}">
                <!-- Grid rather than StackPanel: the table row is the one that takes
                     the slack, so the point list grows with the window. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- The table takes all the slack, so it shows ten-plus rows at
                             any normal window size. The floor is deliberately lower
                             than that: forcing ten rows here pushed the card past the
                             viewport, and the panel scrolled its own heading away. -->
                        <RowDefinition Height="*" MinHeight="230" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Pontos certificados" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold" />
                        <TextBlock Text="Envie um setpoint de vazão, leia o valor real no padrão externo e capture a tensão."
                                   Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,8" />
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource StrokeDefaultBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{DynamicResource SurfaceSunkenBrush}" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Vazão real (L/min)"
                                           Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="8,5" />
                                <TextBlock Grid.Column="1" Text="Tensão média (V)"
                                           Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="8,5" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Points}"
                                     SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                                     BorderThickness="0"
                                     IsEnabled="{Binding CanEditPoints}"
                                     Background="{DynamicResource SurfaceCardBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="5,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FlowCalibrationPointViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- The shared style's 8,5 padding leaves a
                                                 30 px box too little room for the glyphs,
                                                 so the vertical half goes and the text
                                                 centres itself instead. -->
                                            <TextBox Grid.Column="0" Margin="0,0,5,0" Height="30"
                                                     Padding="8,0" VerticalContentAlignment="Center"
                                                     Text="{Binding FlowText, UpdateSourceTrigger=PropertyChanged}" />
                                            <!-- The voltage can be captured from telemetry or typed (§O); a typed
                                                 value is marked so the report tells measurement from transcription. -->
                                            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SourceLabel}" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBox Height="30" Padding="8,0" VerticalContentAlignment="Center"
                                                         Text="{Binding VoltageText, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Tensão medida (V); capture da telemetria ou digite (ponto ou vírgula). Fora de 0–3,3 V o ponto sai do ajuste.">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVoltageOutOfRange}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StateAlarmBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,7,0,8">
                        <Button Content="Adicionar ponto" Command="{Binding AddEmptyPointCommand}" Margin="0,0,6,0" />
                        <Button Content="Remover selecionado" Command="{Binding RemoveSelectedPointCommand}" />
                    </StackPanel>

                    <Border Grid.Row="3" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FlowVoltage atual" Style="{StaticResource CalibrationLabel}" />
                                    <TextBlock Text="{Binding LiveVoltageText}" Style="{StaticResource NumericTextStyle}" FontSize="18" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Setpoint de ensaio" Style="{StaticResource CalibrationLabel}" />
                                    <TextBlock Text="{Binding CommandedSetpointText}" Style="{StaticResource NumericTextStyle}" FontSize="14" />
                                </StackPanel>
                            </Grid>

                            <!-- Aim at a convenient flow; the certified standard tells
                                 the operator what the real value is. -->
                            <Grid Margin="0,10,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Setpoint (L/min)" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                                         Text="{Binding SetpointText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Enviar" Height="30" Padding="12,0" Margin="6,0,0,0"
                                        Command="{Binding SendSetpointCommand}" />
                            </Grid>

                            <!-- Nudge the commanded setpoint until the standard reads
                                 the exact flow the operator wants to record. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Passo" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                                         Text="{Binding AdjustmentStepText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="−" Width="36" Height="30" Padding="0" Margin="6,0,3,0" Command="{Binding DecreaseSetpointCommand}" />
                                <Button Grid.Column="3" Content="+" Width="36" Height="30" Padding="0" Command="{Binding IncreaseSetpointCommand}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Cancelar captura" Command="{Binding CancelCaptureCommand}" Margin="0,0,6,0" />
                                <Button Content="Capturar tensão"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding CaptureVoltageCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
