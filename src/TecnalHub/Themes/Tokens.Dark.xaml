<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         DARK THEME TOKENS  -  Fluent / Windows 11
         Must define EXACTLY the same key set as Tokens.Light.xaml. A key present
         in one file and missing in the other is a runtime crash on theme switch,
         so they are asserted against each other in TecnalHub.Tests.
         ══════════════════════════════════════════════════════════════════════ -->

    <Color x:Key="SurfaceBaseColor">#202020</Color>
    <Color x:Key="SurfaceCardColor">#2B2B2B</Color>
    <Color x:Key="SurfaceElevatedColor">#323232</Color>
    <Color x:Key="SurfaceSunkenColor">#1A1A1A</Color>

    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#C5C5C5</Color>
    <Color x:Key="TextDisabledColor">#7A7A7A</Color>
    <Color x:Key="TextOnAccentColor">#000000</Color>

    <Color x:Key="AccentColor">#60CDFF</Color>
    <Color x:Key="AccentHoverColor">#7ED6FF</Color>
    <Color x:Key="AccentPressedColor">#42B8ED</Color>

    <Color x:Key="StrokeDefaultColor">#3D3D3D</Color>
    <Color x:Key="StrokeStrongColor">#545454</Color>

    <Color x:Key="StateOkColor">#6CCB5F</Color>
    <Color x:Key="StateActuatingColor">#60CDFF</Color>
    <Color x:Key="StateWarningColor">#FCE100</Color>
    <Color x:Key="StateAlarmColor">#FF99A4</Color>
    <Color x:Key="StateIdleColor">#8A8A8A</Color>

    <Color x:Key="Series1Color">#56B4E9</Color>
    <Color x:Key="Series2Color">#E69F00</Color>
    <Color x:Key="Series3Color">#00C896</Color>
    <Color x:Key="Series4Color">#F09FC8</Color>
    <Color x:Key="Series5Color">#8FD3FF</Color>
    <Color x:Key="Series6Color">#FF8C42</Color>

</ResourceDictionary>
